{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "habitica-companion-workspace-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "WORKSPACE_ENABLED": false,
    "EXECUTOR_ENABLED": false,
    "PARTY_ENABLED": false,
    "SPELLS_ENABLED": false,
    "CRON_ENABLED": false
  },
  "d1_databases": [
    {
      "binding": "WORKSPACE_DB",
      "database_name": "companion-workspace-local",
      "database_id": "00000000-0000-4000-8000-000000000101",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "AUTH_IDENTITY",
      "service": "habitica-chatgpt-auth-local",
      "entrypoint": "WorkspaceIdentityService"
    },
    {
      "binding": "AUTH_PROJECTION",
      "service": "habitica-chatgpt-auth-local",
      "entrypoint": "ProjectionService"
    },
    {
      "binding": "AUTH_PARTY",
      "service": "habitica-chatgpt-auth-local",
      "entrypoint": "PartyService"
    },
    {
      "binding": "AUTH_SPELL",
      "service": "habitica-chatgpt-auth-local",
      "entrypoint": "SpellService"
    },
    {
      "binding": "AUTH_CRON",
      "service": "habitica-chatgpt-auth-local",
      "entrypoint": "CronService"
    }
  ],
  "env": {
    "preview": {
      "name": "habitica-companion-workspace-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "WORKSPACE_ENABLED": false,
        "EXECUTOR_ENABLED": false,
        "PARTY_ENABLED": false,
        "SPELLS_ENABLED": false,
        "CRON_ENABLED": false
      },
      "d1_databases": [
        {
          "binding": "WORKSPACE_DB",
          "database_name": "companion-workspace-preview",
          "database_id": "00000000-0000-4000-8000-000000000102",
          "migrations_dir": "migrations"
        }
      ],
      "services": [
        {
          "binding": "AUTH_IDENTITY",
          "service": "habitica-chatgpt-auth-preview",
          "entrypoint": "WorkspaceIdentityService"
        },
        {
          "binding": "AUTH_PROJECTION",
          "service": "habitica-chatgpt-auth-preview",
          "entrypoint": "ProjectionService"
        },
        {
          "binding": "AUTH_PARTY",
          "service": "habitica-chatgpt-auth-preview",
          "entrypoint": "PartyService"
        },
        {
          "binding": "AUTH_SPELL",
          "service": "habitica-chatgpt-auth-preview",
          "entrypoint": "SpellService"
        },
        {
          "binding": "AUTH_CRON",
          "service": "habitica-chatgpt-auth-preview",
          "entrypoint": "CronService"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      }
    },
    "production": {
      "name": "habitica-companion-workspace-production",
      "vars": {
        "ENVIRONMENT": "production",
        "WORKSPACE_ENABLED": false,
        "EXECUTOR_ENABLED": false,
        "PARTY_ENABLED": false,
        "SPELLS_ENABLED": false,
        "CRON_ENABLED": false
      },
      "d1_databases": [
        {
          "binding": "WORKSPACE_DB",
          "database_name": "companion-workspace-production",
          "database_id": "00000000-0000-4000-8000-000000000103",
          "migrations_dir": "migrations"
        }
      ],
      "services": [
        {
          "binding": "AUTH_IDENTITY",
          "service": "habitica-chatgpt-auth-production",
          "entrypoint": "WorkspaceIdentityService"
        },
        {
          "binding": "AUTH_PROJECTION",
          "service": "habitica-chatgpt-auth-production",
          "entrypoint": "ProjectionService"
        },
        {
          "binding": "AUTH_PARTY",
          "service": "habitica-chatgpt-auth-production",
          "entrypoint": "PartyService"
        },
        {
          "binding": "AUTH_SPELL",
          "service": "habitica-chatgpt-auth-production",
          "entrypoint": "SpellService"
        },
        {
          "binding": "AUTH_CRON",
          "service": "habitica-chatgpt-auth-production",
          "entrypoint": "CronService"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      }
    }
  },
  "dev": {
    "port": 8789
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
