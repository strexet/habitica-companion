@inherits LayoutComponentBase
@implements IDisposable
@using Habitica.Application.Sync
@using System.Globalization
@inject IAppSessionController SessionController
@inject NavigationManager NavigationManager

<MudLayout>
    <MudAppBar Class="topbar" Dense="true" Elevation="0">
        @if (ShowDrawer)
        {
            <MudIconButton Color="Color.Inherit" Icon="@Icons.Material.Outlined.Menu" OnClick="ToggleDrawer" />
        }
        <div class="topbar-copy">
            <strong>Habitica Tool</strong>
            <span>@GetIdentityText()</span>
        </div>

        @if (!SessionController.State.IsRefreshing && GetHeaderSyncStatus() is { } syncStatus)
        {
            <div class="topbar-sync-slot">
                <span class="sync-chip ui-pill @syncStatus.ClassName" title="@syncStatus.Title">
                    @syncStatus.Text
                </span>
            </div>
        }

        @if (SessionController.State.IsRefreshing)
        {
            <span aria-live="polite" class="refresh-status sync-chip sync-chip--busy ui-pill" id="app-refresh-status" role="status">
                @GetActiveRefreshText()
            </span>
        }
        else
        {
            <MudButton Class="refresh-button" Color="Color.Secondary" Disabled="@(!SessionController.State.IsAuthenticated || SessionController.State.IsBusy)" id="app-refresh" OnClick="RefreshAsync" Variant="Variant.Filled">
                Refresh
            </MudButton>
        }
    </MudAppBar>

    @if (ShowDrawer)
    {
        <MudDrawer @bind-Open="_drawerOpen" Class="app-drawer" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <div class="drawer-hero">
                <p class="section-label">Habitica companion</p>
                <h2>Local-first planning surface</h2>
                <p>Browse cached data, run diagnostics, and keep live mutations behind explicit workflow guardrails.</p>
            </div>

            <AppNavMenu />
        </MudDrawer>
    }

    <MudMainContent>
        <div class="shell-content">
            @if (!string.IsNullOrWhiteSpace(SessionController.State.ErrorMessage))
            {
                <MudAlert Class="inline-banner" Dense="true" Severity="Severity.Warning" Variant="Variant.Filled">
                    @SessionController.State.ErrorMessage
                </MudAlert>
            }

            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool ShowDrawer => SessionController.State.IsAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        SessionController.Changed += HandleStateChanged;
        await SessionController.InitializeAsync();
    }

    private string GetIdentityText()
    {
        if (!SessionController.State.IsAuthenticated)
        {
            return "Local-first Habitica companion";
        }

        if (!string.IsNullOrWhiteSpace(SessionController.State.ClassName) && SessionController.State.Level is not null)
        {
            return $"{SessionController.State.DisplayName} • {SessionController.State.ClassName} lvl {SessionController.State.Level}";
        }

        return SessionController.State.DisplayName ?? "Authenticated session";
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        await SessionController.RefreshForPageAsync(NavigationManager.Uri);
    }

    private HeaderSyncStatus? GetHeaderSyncStatus()
    {
        var state = SessionController.State;

        if (state.HasSyncFailure)
        {
            return new HeaderSyncStatus("Sync failed", "sync-chip--danger", GetFailedSyncTitle());
        }

        if (state.IsCloudSyncing)
        {
            return new HeaderSyncStatus("Cloud syncing", "sync-chip--busy", null);
        }

        if (state.HasStaleSync)
        {
            return new HeaderSyncStatus("Sync stale", "sync-chip--warning", "Some cached data may need refresh.");
        }

        if (state.LastSyncedAtUtc is null)
        {
            return null;
        }

        var localTime = state.LastSyncedAtUtc.Value.ToLocalTime();
        return new HeaderSyncStatus(
            $"Synced {localTime.ToString("h:mm tt", CultureInfo.CurrentCulture)}",
            "sync-chip--muted",
            $"Last synced {localTime.ToString("f", CultureInfo.CurrentCulture)}");
    }

    private string GetActiveRefreshText()
    {
        var activeDomains = GetActiveRefreshDomains();

        return activeDomains.Length switch
        {
            0 => "Syncing...",
            1 => $"Syncing {GetDomainLabel(activeDomains[0])}...",
            _ => $"Syncing {activeDomains.Length} areas..."
        };
    }

    private RefreshDomain[] GetActiveRefreshDomains()
    {
        return SessionController.State.DomainStates?
            .Values
            .Where(static state => state.IsFetching && state.Domain is not RefreshDomain.CloudSync and not RefreshDomain.PartySync)
            .Select(static state => state.Domain)
            .Distinct()
            .OrderBy(static domain => domain)
            .ToArray() ?? Array.Empty<RefreshDomain>();
    }

    private string? GetFailedSyncTitle()
    {
        var failedDomains = SessionController.State.DomainStates?
            .Values
            .Where(static state => !string.IsNullOrWhiteSpace(state.LastError))
            .Select(static state => GetDomainLabel(state.Domain))
            .Distinct()
            .OrderBy(static label => label)
            .ToArray();

        return failedDomains is { Length: > 0 }
            ? $"Failed: {string.Join(", ", failedDomains)}"
            : null;
    }

    private static string GetDomainLabel(RefreshDomain domain)
    {
        return domain switch
        {
            RefreshDomain.UserProfile => "account",
            RefreshDomain.Tasks => "tasks",
            RefreshDomain.Party => "party",
            RefreshDomain.GearCatalog => "gear",
            RefreshDomain.CloudSync => "cloud",
            RefreshDomain.PartySync => "party sync",
            _ => "data"
        };
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }

    private sealed record HeaderSyncStatus(string Text, string ClassName, string? Title);
}
