@page "/"
@page "/sign-in"
@implements IDisposable
@inject IAppSessionController SessionController
@inject NavigationManager NavigationManager

<PageTitle>Sign In</PageTitle>

<div class="landing-shell">
    <section class="hero-panel card-surface">
        <p class="section-label">Habitica companion</p>
        <h1>Habitica data, safer login, faster decisions.</h1>
        <p class="hero-copy">
            Sign in with your own Habitica API credentials to turn cached account data into focused dashboards, quest planning, gear choices, spell decisions, and task views.
        </p>

        <div class="feature-grid feature-card-grid">
            <div class="feature-chip">Dashboard stats and account health</div>
            <div class="feature-chip">Party quest queue and CRON timing</div>
            <div class="feature-chip">Inventory gear comparison and presets</div>
            <div class="feature-chip">Spell, buff, and task-value helpers</div>
            <div class="feature-chip">Local snapshots for offline reading</div>
            <div class="feature-chip">Device-only credential opt-in</div>
        </div>
    </section>

    <MudPaper Class="card-surface sign-in-card" Elevation="0">
        <p class="section-label">Connect this browser</p>
        <h2>Sign in with Habitica API credentials</h2>
        <p class="panel-copy">
            Use your Habitica User ID and API Token. The token works like a password, so this app keeps it in your browser and never sends it to Cloudflare sync, exports, diagnostics, or logs.
        </p>

        <div class="sign-in-help-grid">
            <section class="sign-in-help-card">
                <span class="dashboard-stat-label">Where to find them</span>
                <ol>
                    <li>Website: User icon menu -> Settings -> API.</li>
                    <li>Android: Settings -> API.</li>
                    <li>iOS: Settings -> Account Details.</li>
                    <li>Copy User ID and API Token into this form.</li>
                </ol>
                <a class="inline-link" href="https://habitica.com/user/settings/api" target="_blank" rel="noopener noreferrer">Open Habitica API settings</a>
            </section>

            <section class="sign-in-help-card safe-card">
                <span class="dashboard-stat-label">Safety model</span>
                <ul>
                    <li>Your API Token is a password. Keep it private.</li>
                    <li>Sign in sends credentials only to Habitica.</li>
                    <li>Sign in and refresh read data; Habitica-changing actions are explicit.</li>
                    <li>Session-only sign-in is the default.</li>
                    <li>Remembering credentials is optional and stored only in this browser.</li>
                    <li>Credentials are never saved in exports, diagnostics, logs, or Cloudflare sync.</li>
                </ul>
            </section>
        </div>

        <EditForm Model="_request" OnSubmit="HandleSubmitAsync">
            <div class="field-grid">
                <label class="field-row">
                    <span>Habitica User ID</span>
                    <input class="app-input" name="user-id" @bind="_request.UserId" />
                    <span class="field-hint">Shown on Habitica Settings -> API.</span>
                </label>

                <label class="field-row">
                    <span>Habitica API Token</span>
                    <input class="app-input" name="api-token" type="password" @bind="_request.ApiToken" />
                    <span class="field-hint">Treat this like a password. It is sent only to Habitica for authentication.</span>
                </label>
            </div>

            <label class="checkbox-row">
                <input name="persist-locally" type="checkbox" @bind="_request.PersistLocally" />
                <span>Remember credentials on this device for future sessions. Leave unchecked for this tab only. Sign out ends the current tab session; Clear local data removes saved credentials and all synced local snapshots.</span>
            </label>

            <p class="panel-copy compact-copy">
                <a href="/privacy">Privacy and data handling</a>
            </p>

            <div class="action-row">
                <MudButton ButtonType="ButtonType.Submit" Class="action-button" Color="Color.Primary" Disabled="@SessionController.State.IsBusy" Variant="Variant.Filled">
                    @(SessionController.State.IsBusy ? "Signing In..." : "Sign In")
                </MudButton>

                @if (SessionController.State.HasCachedTasks || SessionController.State.HasCachedUserSnapshot)
                {
                    <MudButton Class="action-button" Href="/dashboard" Variant="Variant.Outlined">
                        Open Cached Data
                    </MudButton>
                }
            </div>
        </EditForm>

        @if ((SessionController.State.HasCachedTasks || SessionController.State.HasCachedUserSnapshot) && !SessionController.State.IsAuthenticated)
        {
            <MudAlert Class="inline-banner" Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
                Cached Habitica data is already available locally. You can browse it now or sign in to refresh it.
            </MudAlert>
        }
    </MudPaper>
</div>

@code {
    private readonly SignInRequest _request = new();

    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private async Task HandleSubmitAsync()
    {
        await SessionController.SignInAsync(_request);

        if (SessionController.State.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }
}
