@page "/settings"
@using System.Text.Json
@using Habitica.Application.Sync
@using Habitica.WebApp.Theme
@inject IAppSessionController SessionController
@inject ColorSchemeService ColorSchemeService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Settings</PageTitle>

<div class="settings-shell">
    <section class="card-surface settings-card">
        <p class="section-label">Session controls</p>
        <h1>Local data and sign-in behavior</h1>
        <p class="panel-copy">
            Use the actions below to sign out, check connections, manage saved browser data, or sync supported data between your devices.
        </p>

        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
            If the app keeps showing an old version, clear this site's browser data and refresh the page once.
        </MudAlert>

        <div class="settings-grid">
            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Sign out for this tab</h2>
                <p>Ends the current sign-in session without deleting saved app data in this browser.</p>
                <MudButton Color="Color.Primary" OnClick="HandleLogoutAsync" Variant="Variant.Filled">Sign Out</MudButton>
            </MudPaper>

            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Check app connections</h2>
                <p>Open safe connection checks and the optional reversible gear check.</p>
                <MudButton Color="Color.Secondary" Href="/live-tests" Variant="Variant.Filled">Open Checks</MudButton>
            </MudPaper>

        </div>
    </section>

    <section class="card-surface settings-card">
        <p class="section-label">Appearance</p>
        <h2>Color scheme</h2>
        <p class="panel-copy">
            Choose a built-in palette or save a custom scheme. The active scheme is stored locally for fast reload and included in portable app data.
        </p>

        <div class="settings-grid">
            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Active scheme</h2>
                <label class="field-row compact">
                    <span>Scheme</span>
                    <select class="app-input" data-testid="color-scheme-select" value="@_colorSchemeState.ActiveScheme.Id" @onchange="eventArgs => SelectColorSchemeAsync(eventArgs.Value?.ToString())">
                        <optgroup label="Built in">
                            @foreach (var scheme in _colorSchemeState.BuiltInSchemes)
                            {
                                <option value="@scheme.Id">@scheme.Name</option>
                            }
                        </optgroup>
                        @if (_colorSchemeState.CustomSchemes.Count > 0)
                        {
                            <optgroup label="Custom">
                                @foreach (var scheme in _colorSchemeState.CustomSchemes)
                                {
                                    <option value="@scheme.Id">@scheme.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <div class="color-scheme-preview" aria-hidden="true">
                    @foreach (var swatch in GetActiveSchemeSwatches())
                    {
                        <span style="@($"background: {swatch};")"></span>
                    }
                </div>
                <div class="action-row">
                    <MudButton Color="Color.Secondary" data-testid="create-custom-scheme" OnClick="CreateCustomScheme" Variant="Variant.Filled">
                        Create Custom Copy
                    </MudButton>
                    @if (!_colorSchemeState.ActiveScheme.IsBuiltIn)
                    {
                        <MudButton Color="Color.Error" data-testid="delete-custom-scheme" OnClick="DeleteActiveCustomSchemeAsync" Variant="Variant.Outlined">
                            Delete Custom
                        </MudButton>
                    }
                </div>
            </MudPaper>

            @if (_colorSchemeEditor is not null)
            {
                <MudPaper Class="card-surface action-card" Elevation="0">
                    <h2>Edit custom scheme</h2>
                    <label class="field-row compact">
                        <span>Name</span>
                        <input class="app-input"
                               data-testid="custom-scheme-name"
                               value="@_colorSchemeEditor.Name"
                               @onchange="eventArgs => SetCustomSchemeName(eventArgs.Value?.ToString())" />
                    </label>
                    <div class="color-token-grid">
                        @foreach (var token in ColorSchemeCatalog.EditableTokens)
                        {
                            <label class="field-row compact">
                                <span>@token.Label</span>
                                <input class="app-input"
                                       data-testid="@($"color-token-{token.Name}")"
                                       value="@_colorSchemeEditor.Tokens[token.Name]"
                                       @onchange="eventArgs => SetCustomSchemeToken(token.Name, eventArgs.Value?.ToString())" />
                            </label>
                        }
                    </div>
                    <div class="action-row">
                        <MudButton Color="Color.Primary" data-testid="save-custom-scheme" OnClick="SaveCustomSchemeAsync" Variant="Variant.Filled">
                            Save Scheme
                        </MudButton>
                        <MudButton Color="Color.Secondary" OnClick="CancelCustomSchemeEdit" Variant="Variant.Outlined">
                            Cancel
                        </MudButton>
                    </div>
                </MudPaper>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_colorSchemeMessage))
        {
            <div class="@($"import-status {(_colorSchemeSucceeded ? "success-pill" : "danger-pill")}")" data-testid="color-scheme-message">
                @_colorSchemeMessage
            </div>
        }
    </section>

    <section class="card-surface settings-card">
        <p class="section-label">Portable app data</p>
        <h2>Backup, restore, and private sync</h2>
        <p class="panel-copy">
            Backup files include saved Habitica data, party CRON history, app messages, gear information, and equipment presets. Habitica API tokens are not included.
            <a href="/privacy">Privacy and data handling</a>
        </p>

        <div class="settings-grid">
            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Download backup</h2>
                <p>Downloads a readable backup of this browser's saved app data. Keep the file private.</p>
                <MudButton Color="Color.Primary"
                           data-testid="export-local-data"
                           Disabled="@SessionController.State.IsBusy"
                           OnClick="HandleExportAsync"
                           Variant="Variant.Filled">
                    Export
                </MudButton>
            </MudPaper>

            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Restore backup</h2>
                <p>Imports a Habitica Tool backup. If this browser already has app data, choose merge before importing.</p>
                <InputFile class="app-input"
                           data-testid="import-local-data"
                           OnChange="HandleImportFileSelectedAsync" />
            </MudPaper>

            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Private device sync</h2>
                <p>Your browser encrypts the upload before it leaves this device. The sync server stores only encrypted data.</p>
                <span class="dashboard-stat-note">@GetCloudSyncSummary()</span>
                <div class="action-row">
                    <MudButton Color="Color.Primary"
                               data-testid="push-cloud-sync"
                               Disabled="@(!SessionController.State.IsAuthenticated || IsCloudSyncBusy)"
                               OnClick="HandleCloudUploadAsync"
                               Variant="Variant.Filled">
                        Upload
                    </MudButton>
                    <MudButton Color="Color.Secondary"
                               data-testid="download-cloud-sync"
                               Disabled="@(!SessionController.State.IsAuthenticated || IsCloudSyncBusy)"
                               OnClick="HandleCloudDownloadAsync"
                               Variant="Variant.Filled">
                        Download
                    </MudButton>
                </div>
            </MudPaper>

            <MudPaper Class="card-surface action-card danger-card" Elevation="0">
                <h2>Clear this browser</h2>
                <p>Removes saved credentials, saved Habitica data, party history, app messages, and local app setup from this browser.</p>
                <MudButton Color="Color.Error"
                           data-testid="clear-local-data"
                           OnClick="HandleClearLocalDataAsync"
                           Variant="Variant.Filled">
                    Clear Local Data
                </MudButton>
            </MudPaper>
        </div>

        @if (!string.IsNullOrWhiteSpace(_dataMessage))
        {
            <div class="@($"import-status {(_dataSucceeded ? "success-pill" : "danger-pill")}")" data-testid="local-data-message">
                @_dataMessage
            </div>
        }

        <div class="sync-status-panel" data-testid="cloud-sync-status">
            <div>
                <h3>Cloud sync sections</h3>
                <p class="panel-copy">Each section uploads independently. Excluded sections stay only in this browser.</p>
            </div>
            <div class="sync-section-list">
                @foreach (var section in GetVisibleCloudSyncSections())
                {
                    var status = GetSectionStatus(section);
                    var excluded = SessionController.State.ExcludedCloudSyncSections.Contains(section);
                    <div class="sync-section-row">
                        <div>
                            <strong>@GetSectionLabel(section)</strong>
                            <span>@(status?.Message ?? "No sync activity yet")</span>
                            @if (status?.PayloadBytes is not null)
                            {
                                <small>@FormatBytes(status.PayloadBytes.Value) at @status.UpdatedAtUtc.ToLocalTime():g</small>
                            }
                        </div>
                        <span class="@GetSectionStatusClass(status, excluded)">
                            @(excluded ? "Excluded" : GetSectionStatusLabel(status))
                        </span>
                        @if (CanToggleSection(section))
                        {
                            <label class="checkbox-row compact-checkbox-row">
                                <input checked="@excluded"
                                       type="checkbox"
                                       @onchange="eventArgs => ToggleCloudSyncSectionAsync(section, eventArgs)" />
                                <span>Exclude</span>
                            </label>
                        }
                    </div>
                }
            </div>
        </div>

        @if (_pendingImportPreview is not null)
        {
            <div class="import-warning" data-testid="import-conflict-warning">
                <h3>Existing app data found</h3>
                <p>
                    The incoming data has @_pendingImportPreview.IncomingRecordCount records. This browser has @_pendingImportPreview.LocalRecordCount records,
                    with @_pendingImportPreview.ConflictingKeys.Count matching saved sections.
                </p>
                @if (_pendingImportPreview.ConflictingKeys.Count > 0)
                {
                    <div class="conflict-choice-list">
                        @foreach (var key in _pendingImportPreview.ConflictingKeys)
                        {
                            <label class="field-row">
                                <span>@GetStorageKeyLabel(key)</span>
                                <select class="app-input"
                                        value="@GetConflictDecisionValue(key)"
                                        @onchange="eventArgs => SetConflictDecision(key, eventArgs.Value?.ToString())">
                                    <option value="@CloudSyncSectionImportDecision.Merge">Merge</option>
                                    <option value="@CloudSyncSectionImportDecision.KeepLocal">Keep local</option>
                                    <option value="@CloudSyncSectionImportDecision.UseRemote">Use remote</option>
                                </select>
                            </label>
                        }
                    </div>
                }
                <div class="action-row">
                    <MudButton Color="Color.Secondary" OnClick="MergePendingImportAsync" Variant="Variant.Filled">
                        Merge
                    </MudButton>
                    <MudButton Color="Color.Primary" OnClick="UseRemotePendingImportAsync" Variant="Variant.Outlined">
                        Use remote
                    </MudButton>
                    @if (_pendingImportPreview.ConflictingKeys.Count > 0)
                    {
                        <MudButton Color="Color.Secondary" OnClick="ApplySectionChoicesAsync" Variant="Variant.Outlined">
                            Apply choices
                        </MudButton>
                    }
                    <MudButton Color="Color.Default" OnClick="CancelPendingImport" Variant="Variant.Outlined">
                        Keep local
                    </MudButton>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private const long ImportFileLimitBytes = 4 * 1024 * 1024;
    private IJSObjectReference? _exportModule;
    private string? _pendingImportJson;
    private LocalUserDataImportPreview? _pendingImportPreview;
    private string? _dataMessage;
    private bool _dataSucceeded = true;
    private string? _colorSchemeMessage;
    private bool _colorSchemeSucceeded = true;
    private ColorSchemeState _colorSchemeState = new(
        ColorSchemeCatalog.Alpha,
        ColorSchemeCatalog.BuiltInSchemes,
        Array.Empty<ColorSchemeDefinition>());
    private ColorSchemeEditorModel? _colorSchemeEditor;
    private readonly Dictionary<string, CloudSyncSectionImportDecision> _sectionDecisions = new(StringComparer.Ordinal);

    private bool IsCloudSyncBusy => SessionController.State.IsBusy || SessionController.State.IsCloudSyncing;

    protected override async Task OnInitializedAsync()
    {
        _colorSchemeState = await ColorSchemeService.LoadAsync();
    }

    private async Task HandleLogoutAsync()
    {
        await SessionController.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    private async Task HandleClearLocalDataAsync()
    {
        await SessionController.ClearLocalDataAsync();
        NavigationManager.NavigateTo("/");
    }

    private async Task HandleExportAsync()
    {
        var result = await SessionController.ExportLocalDataAsync();
        SetDataMessage(result);
        if (result.Succeeded && !string.IsNullOrWhiteSpace(result.JsonText))
        {
            var module = await GetExportModuleAsync();
            await module.InvokeVoidAsync(
                "downloadTextFile",
                $"habitica-tool-data-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.json",
                result.JsonText,
                "application/json;charset=utf-8");
        }
    }

    private async Task HandleImportFileSelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        var file = eventArgs.File;
        await using var stream = file.OpenReadStream(ImportFileLimitBytes);
        using var reader = new StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        var result = await SessionController.PreviewImportLocalDataAsync(json);
        await StartImportFromPreviewAsync(result);
    }

    private async Task HandleCloudUploadAsync()
    {
        var result = await SessionController.PushCloudSyncAsync();
        SetDataMessage(result);
    }

    private async Task HandleCloudDownloadAsync()
    {
        var result = await SessionController.DownloadCloudSyncAsync();
        await StartImportFromPreviewAsync(result);
    }

    private async Task StartImportFromPreviewAsync(LocalDataActionResult result)
    {
        SetDataMessage(result);
        if (!result.Succeeded || string.IsNullOrWhiteSpace(result.JsonText) || result.ImportPreview is null)
        {
            return;
        }

        if (result.ImportPreview.HasLocalData)
        {
            _pendingImportJson = result.JsonText;
            _pendingImportPreview = result.ImportPreview;
            _sectionDecisions.Clear();
            foreach (var key in result.ImportPreview.ConflictingKeys)
            {
                _sectionDecisions[key] = CloudSyncSectionImportDecision.Merge;
            }
            return;
        }

        var importResult = await SessionController.ImportLocalDataAsync(result.JsonText, LocalDataImportMode.Merge);
        SetDataMessage(importResult);
    }

    private async Task CompleteImportAsync(LocalDataImportMode mode)
    {
        if (string.IsNullOrWhiteSpace(_pendingImportJson))
        {
            CancelPendingImport();
            return;
        }

        var importResult = await SessionController.ImportLocalDataAsync(_pendingImportJson, mode);
        _pendingImportJson = null;
        _pendingImportPreview = null;
        SetDataMessage(importResult);
    }

    private Task MergePendingImportAsync()
    {
        return CompleteImportAsync(LocalDataImportMode.Merge);
    }

    private Task UseRemotePendingImportAsync()
    {
        return CompleteImportAsync(LocalDataImportMode.Override);
    }

    private async Task ApplySectionChoicesAsync()
    {
        if (string.IsNullOrWhiteSpace(_pendingImportJson))
        {
            CancelPendingImport();
            return;
        }

        var decisions = BuildSectionDecisions(_pendingImportJson);
        var importResult = await SessionController.ImportCloudSyncSectionsAsync(_pendingImportJson, decisions);
        _pendingImportJson = null;
        _pendingImportPreview = null;
        _sectionDecisions.Clear();
        SetDataMessage(importResult);
    }

    private void CancelPendingImport()
    {
        _pendingImportJson = null;
        _pendingImportPreview = null;
        _sectionDecisions.Clear();
        _dataSucceeded = true;
        _dataMessage = "Import cancelled.";
    }

    private void SetDataMessage(LocalDataActionResult result)
    {
        _dataSucceeded = result.Succeeded;
        _dataMessage = result.Message;
    }

    private async Task<IJSObjectReference> GetExportModuleAsync()
    {
        _exportModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/diagnosticsExport.js");
        return _exportModule;
    }

    private IReadOnlyDictionary<string, CloudSyncSectionImportDecision> BuildSectionDecisions(string jsonText)
    {
        var decisions = new Dictionary<string, CloudSyncSectionImportDecision>(StringComparer.Ordinal);
        using var document = JsonDocument.Parse(jsonText);
        if (!document.RootElement.TryGetProperty("records", out var records) || records.ValueKind != JsonValueKind.Array)
        {
            return decisions;
        }

        foreach (var record in records.EnumerateArray())
        {
            var storageKey = record.TryGetProperty("key", out var keyProperty)
                ? keyProperty.GetString()
                : null;
            if (string.IsNullOrWhiteSpace(storageKey))
            {
                continue;
            }

            var sectionKey = GetSectionKeyForStorageKey(storageKey);
            decisions[sectionKey] = _sectionDecisions.GetValueOrDefault(storageKey, CloudSyncSectionImportDecision.Merge);
        }

        return decisions;
    }

    private void SetConflictDecision(string storageKey, string? value)
    {
        if (Enum.TryParse<CloudSyncSectionImportDecision>(value, out var decision))
        {
            _sectionDecisions[storageKey] = decision;
        }
    }

    private string GetConflictDecisionValue(string storageKey)
    {
        return _sectionDecisions.GetValueOrDefault(storageKey, CloudSyncSectionImportDecision.Merge).ToString();
    }

    private async Task ToggleCloudSyncSectionAsync(CloudSyncSection section, ChangeEventArgs eventArgs)
    {
        await SessionController.SetCloudSyncSectionExcludedAsync(section, eventArgs.Value is true);
    }

    private static IReadOnlyList<CloudSyncSection> GetVisibleCloudSyncSections()
    {
        return CloudSyncSectionMapping.AllSections
            .Where(static section => section != CloudSyncSection.SyncMetadata)
            .ToArray();
    }

    private CloudSyncSectionStatus? GetSectionStatus(CloudSyncSection section)
    {
        var sectionKey = CloudSyncSectionMapping.KvSuffix(section);
        return SessionController.State.CloudSyncStatuses
            .FirstOrDefault(status => string.Equals(status.SectionKey, sectionKey, StringComparison.Ordinal));
    }

    private static bool CanToggleSection(CloudSyncSection section)
    {
        return section != CloudSyncSection.SyncMetadata && !CloudSyncSectionMapping.IsCritical(section);
    }

    private static string GetSectionLabel(CloudSyncSection section)
    {
        return section switch
        {
            CloudSyncSection.UserProfile => "User profile",
            CloudSyncSection.TasksCurrent => "Tasks",
            CloudSyncSection.TaskOrderPreferences => "Task order",
            CloudSyncSection.InventoryCatalog => "Inventory catalog",
            CloudSyncSection.SavedPresets => "Saved presets",
            CloudSyncSection.PartyCurrent => "Party",
            CloudSyncSection.PartyCronHistory => "Party CRON history",
            CloudSyncSection.ColorSchemes => "Color schemes",
            CloudSyncSection.Diagnostics => "Diagnostics",
            _ => section.ToString()
        };
    }

    private static string GetStorageKeyLabel(string storageKey)
    {
        var section = CloudSyncSectionMapping.SectionForStorageKey(storageKey);
        return section is null ? storageKey : GetSectionLabel(section.Value);
    }

    private static string GetSectionKeyForStorageKey(string storageKey)
    {
        var section = CloudSyncSectionMapping.SectionForStorageKey(storageKey);
        return section is null ? storageKey : CloudSyncSectionMapping.KvSuffix(section.Value);
    }

    private string GetCloudSyncSummary()
    {
        if (SessionController.State.IsCloudSyncing)
        {
            return "Syncing encrypted sections...";
        }

        var latest = SessionController.State.CloudSyncStatuses
            .Where(static status => status.Section != CloudSyncSection.SyncMetadata)
            .OrderByDescending(static status => status.UpdatedAtUtc)
            .FirstOrDefault();
        return latest is null
            ? "No cloud sync activity in this session."
            : $"{GetSectionStatusLabel(latest)} {GetSectionLabel(latest.Section).ToLowerInvariant()} at {latest.UpdatedAtUtc.ToLocalTime():g}.";
    }

    private static string GetSectionStatusLabel(CloudSyncSectionStatus? status)
    {
        return status?.Status switch
        {
            CloudSyncSectionStatusKind.Pending => "Pending",
            CloudSyncSectionStatusKind.Succeeded => status.Direction == CloudSyncDirection.Download ? "Downloaded" : "Uploaded",
            CloudSyncSectionStatusKind.Failed => "Failed",
            CloudSyncSectionStatusKind.Skipped => "Skipped",
            CloudSyncSectionStatusKind.Excluded => "Excluded",
            CloudSyncSectionStatusKind.Conflict => "Conflict",
            _ => "Idle"
        };
    }

    private static string GetSectionStatusClass(CloudSyncSectionStatus? status, bool excluded)
    {
        if (excluded || status?.Status is CloudSyncSectionStatusKind.Excluded or CloudSyncSectionStatusKind.Skipped)
        {
            return "sync-status-pill warning-pill";
        }

        return status?.Status switch
        {
            CloudSyncSectionStatusKind.Succeeded => "sync-status-pill success-pill",
            CloudSyncSectionStatusKind.Failed or CloudSyncSectionStatusKind.Conflict => "sync-status-pill danger-pill",
            _ => "sync-status-pill ui-pill"
        };
    }

    private static string FormatBytes(int bytes)
    {
        return bytes < 1024
            ? $"{bytes} B"
            : $"{Math.Round(bytes / 1024d, 1):0.#} KB";
    }

    private IReadOnlyList<string> GetActiveSchemeSwatches()
    {
        var tokens = _colorSchemeState.ActiveScheme.Tokens;
        return new[]
        {
            tokens.Background,
            tokens.CardBackground,
            tokens.Primary,
            tokens.Accent,
            tokens.Danger,
            tokens.Success
        };
    }

    private async Task SelectColorSchemeAsync(string? schemeId)
    {
        if (string.IsNullOrWhiteSpace(schemeId))
        {
            return;
        }

        _colorSchemeState = await ColorSchemeService.SelectAsync(schemeId);
        _colorSchemeEditor = _colorSchemeState.ActiveScheme.IsBuiltIn
            ? null
            : ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Using {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private void CreateCustomScheme()
    {
        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(
            ColorSchemeCatalog.CreateCustomCopy(
                _colorSchemeState.ActiveScheme,
                $"{_colorSchemeState.ActiveScheme.Name} custom"));
        SetColorSchemeMessage("Edit and save the custom scheme.", true);
    }

    private void CancelCustomSchemeEdit()
    {
        _colorSchemeEditor = _colorSchemeState.ActiveScheme.IsBuiltIn
            ? null
            : ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage("Custom scheme edit cancelled.", true);
    }

    private void SetCustomSchemeName(string? value)
    {
        if (_colorSchemeEditor is not null)
        {
            _colorSchemeEditor.Name = value?.Trim() ?? string.Empty;
        }
    }

    private void SetCustomSchemeToken(string tokenName, string? value)
    {
        if (_colorSchemeEditor is not null)
        {
            _colorSchemeEditor.Tokens[tokenName] = value?.Trim() ?? string.Empty;
        }
    }

    private async Task SaveCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        var scheme = _colorSchemeEditor.ToScheme();
        var result = await ColorSchemeService.SaveCustomAsync(scheme, true);
        _colorSchemeState = result.State;
        if (result.Errors.Count > 0)
        {
            SetColorSchemeMessage(string.Join(" ", result.Errors), false);
            return;
        }

        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Saved {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task DeleteActiveCustomSchemeAsync()
    {
        if (_colorSchemeState.ActiveScheme.IsBuiltIn)
        {
            return;
        }

        var deletedName = _colorSchemeState.ActiveScheme.Name;
        _colorSchemeState = await ColorSchemeService.DeleteCustomAsync(_colorSchemeState.ActiveScheme.Id);
        _colorSchemeEditor = null;
        SetColorSchemeMessage($"Deleted {deletedName}.", true);
    }

    private void SetColorSchemeMessage(string message, bool succeeded)
    {
        _colorSchemeMessage = message;
        _colorSchemeSucceeded = succeeded;
    }

    private sealed class ColorSchemeEditorModel
    {
        public string Id { get; private init; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public Dictionary<string, string> Tokens { get; } = new(StringComparer.Ordinal);

        public static ColorSchemeEditorModel FromScheme(ColorSchemeDefinition scheme)
        {
            var editor = new ColorSchemeEditorModel
            {
                Id = scheme.Id,
                Name = scheme.Name
            };
            foreach (var token in ColorSchemeCatalog.EditableTokens)
            {
                editor.Tokens[token.Name] = ColorSchemeCatalog.GetTokenValue(scheme.Tokens, token.Name);
            }

            return editor;
        }

        public ColorSchemeDefinition ToScheme()
        {
            var tokens = ColorSchemeCatalog.EditableTokens
                .Aggregate(ColorSchemeCatalog.Alpha.Tokens, (current, token) =>
                    ColorSchemeCatalog.WithTokenValue(current, token.Name, Tokens.GetValueOrDefault(token.Name, string.Empty)));
            return new ColorSchemeDefinition(
                Id,
                ColorSchemeCatalog.NormalizeName(Name, "Custom scheme"),
                false,
                tokens);
        }
    }
}
