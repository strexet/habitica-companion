@page "/settings"
@implements IDisposable
@using System.Text.Json
@using Habitica.Application.Sync
@using Habitica.Application.Integration
@inject IAppSessionController SessionController
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PageTitle>Settings</PageTitle>

<div class="settings-shell">
    <PwaInstallPanel />
    <section class="card-surface settings-card">
        <p class="section-label">Session controls</p>
        <h1>Local data and sign-in behavior</h1>
        <p class="panel-copy">
            Use the actions below to sign out, check connections, manage saved browser data, or sync supported data between your devices.
        </p>

        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
            If the app looks old, refresh first. Before clearing browser data, export any browser-only Notes from Notes and local workspaces from Todo Sync.
        </MudAlert>

        <div class="settings-grid settings-session-actions" data-testid="settings-session-actions">
            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Sign out for this tab</h2>
                <p>Ends the current sign-in session without deleting saved app data in this browser.</p>
                <MudButton data-testid="settings-sign-out" Color="Color.Primary" OnClick="HandleLogoutAsync" Variant="Variant.Filled">Sign Out</MudButton>
            </MudPaper>

            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Check app connections</h2>
                <p>Open safe connection checks and the optional reversible gear check.</p>
                <MudButton data-testid="settings-open-checks" data-layout-primary="true" Color="Color.Secondary" Href="/live-tests" Variant="Variant.Outlined">Open Checks</MudButton>
            </MudPaper>

        </div>
    </section>

    <section class="card-surface settings-card dashboard-appearance">
        <div class="dashboard-appearance-head">
            <div>
                <p class="section-label">Appearance</p>
                <h2>Color scheme</h2>
            </div>
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       data-testid="settings-appearance-toggle"
                       OnClick="@(() => _appearanceCollapsed = !_appearanceCollapsed)"
                       EndIcon="@(_appearanceCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.Done)">
                @(_appearanceCollapsed ? "Customize theme" : "Done")
            </MudButton>
        </div>
        @if (!_appearanceCollapsed)
        {
            <p class="panel-copy">
                Choose a built-in palette or save a custom scheme. The active scheme is stored locally for fast reload and included in portable app data.
            </p>
            <ColorSchemePanel />
        }
    </section>

    <section class="card-surface settings-card">
        <p class="section-label">Optional connection</p>
        <h2>Codex and ChatGPT</h2>
        <p>Enabling this connection sends the Habitica credentials to the Companion integration server for encrypted storage. Codex and ChatGPT receive separate access only after you approve permissions for each client. Browser-only use and private device sync do not require this connection.</p>
        <p>The integration stores credentials until disconnect or profile deletion. Linking codes expire within ten minutes; operational audit metadata is limited to thirty days. Companion does not store conversation text. <a href="/privacy">Privacy and data handling</a></p>
        @if (!SessionController.IsChatGptIntegrationAvailable)
        {
            <p data-testid="integration-unavailable">ChatGPT linking is not enabled on this app.</p>
        }
        else if (!SessionController.State.IsAuthenticated)
        {
            <p>Sign in with Habitica before enabling a connection.</p>
        }
        else if (!SessionController.HasChatGptConnection)
        {
            <p role="status" data-testid="integration-unverified">@(_integrationDisconnected ? "Disconnected from this tab. Verify the account before checking current server status." : "Server connection status is unverified in this tab. Closing another tab or using another device does not disable the server connection.")</p>
            <p>Verify the account to restore management access. Verification sends the current Habitica credentials to the integration server and can create an encrypted profile if none exists. Existing client permissions are retained; verification grants no new permissions.</p>
            <label class="checkbox-row">
                <input data-testid="integration-consent" type="checkbox" @bind="_integrationConsent" />
                <span>I consent to sending my Habitica credentials to the Companion integration server for encrypted storage and the lifecycle described above.</span>
            </label>
            <MudButton Color="Color.Secondary" data-testid="integration-restore-access" Disabled="@(!_integrationConsent || _integrationBusy || SessionController.State.IsBusy)" OnClick="RestoreIntegrationAsync" Variant="Variant.Filled">Verify account and restore access</MudButton>
            <MudButton data-testid="integration-enroll" Disabled="@(!_integrationConsent || _integrationBusy || SessionController.State.IsBusy)" OnClick="EnableIntegrationAsync" Variant="Variant.Filled">Enable agent connection</MudButton>
        }
        else
        {
            <p data-testid="integration-tab-access">A management credential is present in this tab. Signing out or closing the tab forgets local access without disconnecting the server account.</p>
            @if (_integrationStatus?.Succeeded != true)
            {
                <p role="status" data-testid="integration-status-unverified">Server permissions and credential status are unverified. Check integration status or revalidate stored credentials.</p>
            }
            <p>Revoke client access keeps stored credentials and separate Workspace/background access. Disconnect or disable the Workspace separately to pause its executor. To replace a Habitica API token, update the browser sign-in credentials, then revalidate.</p>
            <div class="action-row">
                <MudButton data-testid="integration-status" Disabled="@_integrationBusy" OnClick="LoadIntegrationStatusAsync" Variant="Variant.Outlined">Check integration status</MudButton>
                <MudButton data-testid="integration-revoke-grants" Disabled="@_integrationBusy" OnClick="@(() => _integrationManagementAction = "revoke")" Variant="Variant.Outlined">Revoke Codex/ChatGPT access</MudButton>
                <MudButton data-testid="integration-rotate-management" Disabled="@_integrationBusy" OnClick="@(() => _integrationManagementAction = "rotate")" Variant="Variant.Outlined">Replace tab management credential</MudButton>
                <MudButton data-testid="integration-revalidate" Disabled="@(_integrationBusy || SessionController.State.IsBusy)" OnClick="@(() => _integrationManagementAction = "revalidate")" Variant="Variant.Outlined">Revalidate stored Habitica credentials</MudButton>
            </div>
            @if (_integrationStatus is not null)
            {
                <p role="status">@_integrationStatus.Message</p>
                @if (_integrationStatus.Succeeded)
                {
                    <dl data-testid="integration-status-details">
                        <dt>Connected account</dt><dd>@_integrationStatus.DisplayName</dd>
                        <dt>Permissions</dt><dd>@(_integrationStatus.Permissions?.Length > 0 ? string.Join(", ", _integrationStatus.Permissions) : "No active client permissions")</dd>
                        <dt>Credential status</dt><dd>@(_integrationStatus.CredentialStatus == "repair_needed" ? "Repair needed" : "Verified at the time shown below")</dd>
                        <dt>Last verified</dt><dd>@(_integrationStatus.LastVerifiedAtUtc?.ToLocalTime().ToString("g") ?? "Unavailable")</dd>
                        <dt>Last client tool authorization</dt><dd>@(_integrationStatus.LastUsedAtUtc?.ToLocalTime().ToString("g") ?? "No recorded use")</dd>
                    </dl>
                    @if (_integrationStatus.PermissionsTruncated) { <p>The permission list is incomplete. Revoke access to remove all previous grants.</p> }
                }
            }
            @if (_integrationManagementAction is not null)
            {
                <p>@(_integrationManagementAction == "revoke" ? "Revoke all Codex and ChatGPT grants and invalidate old unaccepted previews? Stored credentials and separate Workspace access remain available." : _integrationManagementAction == "rotate" ? "Replace the management credential for this tab? Other tab management credentials stop working. Client access remains available." : "Send the current browser sign-in credentials to verify and replace the encrypted server credential? No new client access is granted.")</p>
                <MudButton data-testid="integration-confirm-management" Disabled="@_integrationBusy" OnClick="ConfirmIntegrationManagementAsync" Variant="Variant.Filled">Confirm</MudButton>
                <MudButton data-testid="integration-cancel-management" Disabled="@_integrationBusy" OnClick="@(() => _integrationManagementAction = null)" Variant="Variant.Outlined">Cancel</MudButton>
            }
            <div class="integration-linking-guide" data-testid="integration-linking-guide">
                <h3>Connect Codex or ChatGPT</h3>
                <ol>
                    <li>Start the connection in your client: <strong>Authenticate</strong> in Codex Settings → MCP servers, or <strong>Connect</strong> in ChatGPT. Keep the browser authorization page open.</li>
                    <li>Generate a fresh code here, then enter it in <strong>One-time Companion code</strong> on that browser page.</li>
                    <li>Verify the account and choose the permissions you want to grant. Select <strong>Allow selected access</strong> to return to the client.</li>
                </ol>
                <p><strong>Never paste a code into MCP server settings or chat.</strong> The code works once for ten minutes. If it expires or the browser reports a lost session, restart Authenticate/Connect and generate a new code.</p>
            </div>
            <div class="action-row">
                <MudButton data-testid="integration-new-code" Disabled="@_integrationBusy" OnClick="NewIntegrationCodeAsync" Variant="Variant.Filled">Generate new code</MudButton>
                <MudButton data-testid="integration-disconnect" Disabled="@_integrationBusy" OnClick="@(() => _integrationCleanup = false)" Variant="Variant.Outlined">Disconnect</MudButton>
                <MudButton data-testid="integration-delete" Disabled="@_integrationBusy" OnClick="@(() => _integrationCleanup = true)" Variant="Variant.Outlined">Delete integration profile</MudButton>
            </div>
            @if (_integrationCleanup is not null)
            {
                <p>@(_integrationCleanup.Value ? "Delete the integration profile, stored credentials, cloud Notes and retained Notes versions? Export any cloud Notes first." : "Disconnect and remove stored integration credentials? Cloud Notes become inaccessible until connection is restored; retained cloud content is not deleted.") Browser data and the Habitica account remain available.</p>
                <MudButton data-testid="integration-confirm-cleanup" Disabled="@_integrationBusy" OnClick="ConfirmIntegrationCleanupAsync" Color="Color.Error" Variant="Variant.Filled">Confirm</MudButton>
                <MudButton data-testid="integration-cancel-cleanup" OnClick="@(() => _integrationCleanup = null)" Variant="Variant.Outlined">Cancel</MudButton>
            }
        }
        @if (_integrationResult is not null)
        {
            <p role="status">@_integrationResult.Message</p>
            @if (_integrationResult.Code is not null)
            {
                <div class="integration-code-card" data-testid="integration-code-card">
                    <strong>One-time Companion code</strong>
                    <code data-testid="integration-link-code">@_integrationResult.Code</code>
                    <MudButton data-testid="integration-copy-code" Variant="Variant.Outlined" OnClick="CopyIntegrationCodeAsync">Copy code</MudButton>
                    <span>Expires @_integrationResult.ExpiresAtUtc?.ToLocalTime().ToString("g"). Enter it on the browser page opened by Authenticate or Connect.</span>
                    @if (_integrationCopyMessage is not null) { <span role="status">@_integrationCopyMessage</span> }
                </div>
            }
        }
    </section>

    <section class="card-surface settings-card"><p class="section-label">Todo connections</p><h2>Task source and sync</h2><p>Choose a workspace, review pending game effects, manage Habitica tags, and back up or transfer local tasks in <a href="/todo/sync" data-testid="settings-todo-sync">Todo Sync</a>. Cloud task consent and background execution have separate controls there.</p></section>
    <PartyPlanningSettingsPanel />

    <section class="card-surface settings-card">
        <p class="section-label">Portable app data</p>
        <h2>Backup, restore, and private sync</h2>
        <p class="panel-copy">
            Backup files include saved Habitica data, party CRON history, app messages, gear information, and equipment presets. Export personal Notes from Notes and workspaces from Todo Sync separately. Habitica API tokens are not included.
            <a href="/privacy">Privacy and data handling</a>
        </p>

        <div class="settings-grid">
            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Download backup</h2>
                <p>Downloads a readable backup of this browser's saved app data. Keep the file private.</p>
                <MudButton Color="Color.Primary"
                           data-testid="export-local-data"
                           Disabled="@SessionController.State.IsBusy"
                           OnClick="HandleExportAsync"
                           Variant="Variant.Filled">
                    Export
                </MudButton>
            </MudPaper>

            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Restore backup</h2>
                <p>Imports a Habitica Tool backup. If this browser already has app data, choose merge before importing.</p>
                <InputFile class="app-input"
                           data-testid="import-local-data"
                           OnChange="HandleImportFileSelectedAsync" />
            </MudPaper>

            <MudPaper Class="card-surface action-card" Elevation="0">
                <h2>Private device sync</h2>
                <p>Your browser encrypts the upload before it leaves this device. The sync server stores only encrypted data.</p>
                <span class="dashboard-stat-note">@GetCloudSyncSummary()</span>
                <div class="action-row">
                    <MudButton Color="Color.Primary"
                               data-testid="push-cloud-sync"
                               Disabled="@(!SessionController.State.IsAuthenticated || IsCloudSyncBusy)"
                               OnClick="HandleCloudUploadAsync"
                               Variant="Variant.Filled">
                        Upload
                    </MudButton>
                    <MudButton Color="Color.Secondary"
                               data-testid="download-cloud-sync"
                               Disabled="@(!SessionController.State.IsAuthenticated || IsCloudSyncBusy)"
                               OnClick="HandleCloudDownloadAsync"
                               Variant="Variant.Outlined">
                        Download
                    </MudButton>
                </div>
            </MudPaper>

            <MudPaper Class="card-surface action-card danger-card" Elevation="0">
                <h2>Clear this browser</h2>
                <p>Removes saved credentials, saved Habitica data, party history, app messages, all browser Notes and local workspaces from this browser. Export Notes and workspaces separately first. Push device bindings and original pending-command references are also removed. Revoke push devices in Todo Sync first; local removal does not revoke cloud push consent or browser permission.</p>
                <MudButton Color="Color.Error"
                           data-testid="clear-local-data"
                           OnClick="@(() => _clearLocalReview = true)"
                           Variant="Variant.Filled">
                    Clear Local Data
                </MudButton>
            </MudPaper>
        </div>
        @if (_clearLocalReview)
        {
            <div class="card-surface danger-card" role="group" aria-label="Review browser data removal" data-testid="clear-local-review">
                <p>Clear this browser now? All browser Notes, including deleted versions, local workspaces, saved credentials and other local app data will be removed. The general app backup does not include Notes or workspace journals. Push bindings and pending-command references will also be removed. Cloud push consent, device registrations and browser notification permission remain separate; revoke devices in Todo Sync first. Cloud Notes, cloud workspaces and Habitica records have separate controls.</p>
                <MudButton Color="Color.Error" OnClick="HandleClearLocalDataAsync" data-testid="clear-local-confirm" Variant="Variant.Filled">Confirm browser removal</MudButton>
                <MudButton OnClick="@(() => _clearLocalReview = false)" data-testid="clear-local-cancel" Variant="Variant.Outlined">Cancel</MudButton>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_dataMessage))
        {
            <div class="@($"import-status {(_dataSucceeded ? "success-pill" : "danger-pill")}")" data-testid="local-data-message">
                @_dataMessage
            </div>
        }

        <div class="sync-status-panel" data-testid="cloud-sync-status">
            <div>
                <h3>Cloud sync sections</h3>
                <p class="panel-copy">Each section uploads independently. Excluded sections stay only in this browser.</p>
            </div>
            <div class="sync-section-list">
                @foreach (var section in GetVisibleCloudSyncSections())
                {
                    var status = GetSectionStatus(section);
                    var excluded = SessionController.State.ExcludedCloudSyncSections.Contains(section);
                    <div class="sync-section-row">
                        <div>
                            <strong>@GetSectionLabel(section)</strong>
                            <span>@(status?.Message ?? "No sync activity yet")</span>
                            @if (status?.PayloadBytes is not null)
                            {
                                <small>@FormatBytes(status.PayloadBytes.Value) at @status.UpdatedAtUtc.ToLocalTime():g</small>
                            }
                        </div>
                        <span class="@GetSectionStatusClass(status, excluded)">
                            @(excluded ? "Excluded" : GetSectionStatusLabel(status))
                        </span>
                        @if (CanToggleSection(section))
                        {
                            <label class="checkbox-row compact-checkbox-row">
                                <input checked="@excluded"
                                       type="checkbox"
                                       @onchange="eventArgs => ToggleCloudSyncSectionAsync(section, eventArgs)" />
                                <span>Exclude</span>
                            </label>
                        }
                    </div>
                }
            </div>
        </div>

        @if (_pendingImportPreview is not null)
        {
            <div class="import-warning" data-testid="import-conflict-warning">
                <h3>Existing app data found</h3>
                <p>
                    The incoming data has @_pendingImportPreview.IncomingRecordCount records. This browser has @_pendingImportPreview.LocalRecordCount records,
                    with @_pendingImportPreview.ConflictingKeys.Count matching saved sections.
                </p>
                @if (_pendingImportPreview.ConflictingKeys.Count > 0)
                {
                    <div class="conflict-choice-list">
                        @foreach (var key in _pendingImportPreview.ConflictingKeys)
                        {
                            <label class="field-row">
                                <span>@GetStorageKeyLabel(key)</span>
                                <select class="app-input"
                                        value="@GetConflictDecisionValue(key)"
                                        @onchange="eventArgs => SetConflictDecision(key, eventArgs.Value?.ToString())">
                                    <option value="@CloudSyncSectionImportDecision.Merge">Merge</option>
                                    <option value="@CloudSyncSectionImportDecision.KeepLocal">Keep local</option>
                                    <option value="@CloudSyncSectionImportDecision.UseRemote">Use remote</option>
                                </select>
                            </label>
                        }
                    </div>
                }
                <div class="action-row">
                    <MudButton Color="Color.Secondary" OnClick="MergePendingImportAsync" Variant="Variant.Filled">
                        Merge
                    </MudButton>
                    <MudButton Color="Color.Primary" OnClick="UseRemotePendingImportAsync" Variant="Variant.Outlined">
                        Use remote
                    </MudButton>
                    @if (_pendingImportPreview.ConflictingKeys.Count > 0)
                    {
                        <MudButton Color="Color.Secondary" OnClick="ApplySectionChoicesAsync" Variant="Variant.Outlined">
                            Apply choices
                        </MudButton>
                    }
                    <MudButton Color="Color.Default" OnClick="CancelPendingImport" Variant="Variant.Outlined">
                        Keep local
                    </MudButton>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private bool _appearanceCollapsed = true, _clearLocalReview;
    private bool _integrationConsent, _integrationBusy, _integrationDisconnected, _disposed;
    private bool? _integrationCleanup;
    private IntegrationLinkResult? _integrationResult;
    private string? _integrationCopyMessage;
    private IntegrationStatusResult? _integrationStatus;
    private string? _integrationManagementAction;
    private (bool Authenticated, string? UserId) _integrationOwner;
    private int _integrationGeneration;

    protected override void OnInitialized()
    {
        _integrationOwner = (SessionController.State.IsAuthenticated, SessionController.State.UserId);
        SessionController.Changed += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        if (_disposed) return;
        var owner = (SessionController.State.IsAuthenticated, SessionController.State.UserId);
        if (owner != _integrationOwner)
        {
            _integrationOwner = owner;
            _integrationGeneration++;
            _integrationConsent = _integrationBusy = _integrationDisconnected = _clearLocalReview = false;
            _integrationCleanup = null; _integrationResult = null; _integrationStatus = null; _integrationManagementAction = null; _integrationCopyMessage = null;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private bool CurrentIntegration(int generation) => !_disposed && generation == _integrationGeneration
        && SessionController.State.IsAuthenticated
        && _integrationOwner == (SessionController.State.IsAuthenticated, SessionController.State.UserId);

    public void Dispose()
    {
        _disposed = true;
        SessionController.Changed -= OnSessionChanged;
    }

    private async Task LoadIntegrationStatusAsync()
    {
        if (_integrationBusy || !SessionController.State.IsAuthenticated) return;
        var generation = _integrationGeneration;
        _integrationBusy = true; _integrationStatus = null;
        try
        {
            var result = await SessionController.GetChatGptStatusAsync();
            if (CurrentIntegration(generation)) _integrationStatus = result;
        }
        catch { if (CurrentIntegration(generation)) _integrationStatus = new(false, "Integration status is unavailable. Verify the account before trying again."); }
        finally { if (CurrentIntegration(generation)) _integrationBusy = false; }
    }

    private async Task RunIntegrationAsync(Func<Task<IntegrationLinkResult>> action, bool readStatus = false)
    {
        if (_integrationBusy || !SessionController.State.IsAuthenticated) return;
        var generation = _integrationGeneration;
        _integrationBusy = true; _integrationStatus = null; _integrationResult = null; _integrationCopyMessage = null;
        try
        {
            var result = await action();
            if (!CurrentIntegration(generation)) return;
            _integrationResult = result;
            if (result.Succeeded && SessionController.HasChatGptConnection)
            {
                _integrationDisconnected = false;
                if (readStatus)
                {
                    var status = await SessionController.GetChatGptStatusAsync();
                    if (CurrentIntegration(generation)) _integrationStatus = status;
                }
            }
        }
        catch { if (CurrentIntegration(generation)) _integrationResult = new(false, "The integration action could not be confirmed. Verify account access before trying again."); }
        finally { if (CurrentIntegration(generation)) _integrationBusy = false; }
    }

    private async Task ConfirmIntegrationManagementAsync()
    {
        if (_integrationBusy || _integrationManagementAction is not { } action) return;
        var generation = _integrationGeneration;
        await RunIntegrationAsync(() => action switch
        {
            "revoke" => SessionController.RevokeChatGptGrantsAsync(),
            "rotate" => SessionController.RotateChatGptManagementAsync(),
            _ => SessionController.RevalidateChatGptAsync()
        }, action == "revalidate");
        if (CurrentIntegration(generation)) _integrationManagementAction = null;
    }

    private async Task EnableIntegrationAsync()
    {
        if (!_integrationConsent || _integrationBusy) return;
        var generation = _integrationGeneration;
        await RunIntegrationAsync(() => SessionController.EnrollChatGptAsync(true), true);
        if (CurrentIntegration(generation)) _integrationConsent = false;
    }

    private async Task RestoreIntegrationAsync()
    {
        if (!_integrationConsent || _integrationBusy) return;
        var generation = _integrationGeneration;
        await RunIntegrationAsync(() => SessionController.RevalidateChatGptAsync(), true);
        if (CurrentIntegration(generation)) _integrationConsent = false;
    }

    private Task NewIntegrationCodeAsync() => RunIntegrationAsync(() => SessionController.CreateChatGptLinkAsync());

    private async Task CopyIntegrationCodeAsync()
    {
        var code = _integrationResult?.Code;
        if (code is null || !SessionController.State.IsAuthenticated) return;
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _integrationCopyMessage = "Code copied. Paste it into the Companion authorization page.";
        }
        catch
        {
            _integrationCopyMessage = "Copy unavailable. Select the code above and copy it manually.";
        }
    }

    private async Task ConfirmIntegrationCleanupAsync()
    {
        if (_integrationCleanup is not { } delete || _integrationBusy) return;
        var generation = _integrationGeneration;
        await RunIntegrationAsync(() => SessionController.DisconnectChatGptAsync(delete));
        if (CurrentIntegration(generation))
        {
            _integrationDisconnected = _integrationResult?.Succeeded == true;
            _integrationCleanup = null;
        }
    }

    private const long ImportFileLimitBytes = 4 * 1024 * 1024;
    private IJSObjectReference? _exportModule;
    private string? _pendingImportJson;
    private LocalUserDataImportPreview? _pendingImportPreview;
    private string? _dataMessage;
    private bool _dataSucceeded = true;
    private readonly Dictionary<string, CloudSyncSectionImportDecision> _sectionDecisions = new(StringComparer.Ordinal);

    private bool IsCloudSyncBusy => SessionController.State.IsBusy || SessionController.State.IsCloudSyncing;

    private async Task HandleLogoutAsync()
    {
        await SessionController.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    private async Task HandleClearLocalDataAsync()
    {
        if (!_clearLocalReview) return;
        _clearLocalReview = false;
        await SessionController.ClearLocalDataAsync();
        NavigationManager.NavigateTo("/");
    }

    private async Task HandleExportAsync()
    {
        var result = await SessionController.ExportLocalDataAsync();
        SetDataMessage(result);
        if (result.Succeeded && !string.IsNullOrWhiteSpace(result.JsonText))
        {
            var module = await GetExportModuleAsync();
            await module.InvokeVoidAsync(
                "downloadTextFile",
                $"habitica-tool-data-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.json",
                result.JsonText,
                "application/json;charset=utf-8");
        }
    }

    private async Task HandleImportFileSelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        var file = eventArgs.File;
        await using var stream = file.OpenReadStream(ImportFileLimitBytes);
        using var reader = new StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        var result = await SessionController.PreviewImportLocalDataAsync(json);
        await StartImportFromPreviewAsync(result);
    }

    private async Task HandleCloudUploadAsync()
    {
        var result = await SessionController.PushCloudSyncAsync();
        SetDataMessage(result);
    }

    private async Task HandleCloudDownloadAsync()
    {
        var result = await SessionController.DownloadCloudSyncAsync();
        await StartImportFromPreviewAsync(result);
    }

    private async Task StartImportFromPreviewAsync(LocalDataActionResult result)
    {
        SetDataMessage(result);
        if (!result.Succeeded || string.IsNullOrWhiteSpace(result.JsonText) || result.ImportPreview is null)
        {
            return;
        }

        if (result.ImportPreview.HasLocalData)
        {
            _pendingImportJson = result.JsonText;
            _pendingImportPreview = result.ImportPreview;
            _sectionDecisions.Clear();
            foreach (var key in result.ImportPreview.ConflictingKeys)
            {
                _sectionDecisions[key] = CloudSyncSectionImportDecision.Merge;
            }
            return;
        }

        var importResult = await SessionController.ImportLocalDataAsync(result.JsonText, LocalDataImportMode.Merge);
        SetDataMessage(importResult);
    }

    private async Task CompleteImportAsync(LocalDataImportMode mode)
    {
        if (string.IsNullOrWhiteSpace(_pendingImportJson))
        {
            CancelPendingImport();
            return;
        }

        var importResult = await SessionController.ImportLocalDataAsync(_pendingImportJson, mode);
        _pendingImportJson = null;
        _pendingImportPreview = null;
        SetDataMessage(importResult);
    }

    private Task MergePendingImportAsync()
    {
        return CompleteImportAsync(LocalDataImportMode.Merge);
    }

    private Task UseRemotePendingImportAsync()
    {
        return CompleteImportAsync(LocalDataImportMode.Override);
    }

    private async Task ApplySectionChoicesAsync()
    {
        if (string.IsNullOrWhiteSpace(_pendingImportJson))
        {
            CancelPendingImport();
            return;
        }

        var decisions = BuildSectionDecisions(_pendingImportJson);
        var importResult = await SessionController.ImportCloudSyncSectionsAsync(_pendingImportJson, decisions);
        _pendingImportJson = null;
        _pendingImportPreview = null;
        _sectionDecisions.Clear();
        SetDataMessage(importResult);
    }

    private void CancelPendingImport()
    {
        _pendingImportJson = null;
        _pendingImportPreview = null;
        _sectionDecisions.Clear();
        _dataSucceeded = true;
        _dataMessage = "Import cancelled.";
    }

    private void SetDataMessage(LocalDataActionResult result)
    {
        _dataSucceeded = result.Succeeded;
        _dataMessage = result.Message;
    }

    private async Task<IJSObjectReference> GetExportModuleAsync()
    {
        _exportModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/diagnosticsExport.js");
        return _exportModule;
    }

    private IReadOnlyDictionary<string, CloudSyncSectionImportDecision> BuildSectionDecisions(string jsonText)
    {
        var decisions = new Dictionary<string, CloudSyncSectionImportDecision>(StringComparer.Ordinal);
        using var document = JsonDocument.Parse(jsonText);
        if (!document.RootElement.TryGetProperty("records", out var records) || records.ValueKind != JsonValueKind.Array)
        {
            return decisions;
        }

        foreach (var record in records.EnumerateArray())
        {
            var storageKey = record.TryGetProperty("key", out var keyProperty)
                ? keyProperty.GetString()
                : null;
            if (string.IsNullOrWhiteSpace(storageKey))
            {
                continue;
            }

            var sectionKey = GetSectionKeyForStorageKey(storageKey);
            decisions[sectionKey] = _sectionDecisions.GetValueOrDefault(storageKey, CloudSyncSectionImportDecision.Merge);
        }

        return decisions;
    }

    private void SetConflictDecision(string storageKey, string? value)
    {
        if (Enum.TryParse<CloudSyncSectionImportDecision>(value, out var decision))
        {
            _sectionDecisions[storageKey] = decision;
        }
    }

    private string GetConflictDecisionValue(string storageKey)
    {
        return _sectionDecisions.GetValueOrDefault(storageKey, CloudSyncSectionImportDecision.Merge).ToString();
    }

    private async Task ToggleCloudSyncSectionAsync(CloudSyncSection section, ChangeEventArgs eventArgs)
    {
        await SessionController.SetCloudSyncSectionExcludedAsync(section, eventArgs.Value is true);
    }

    private static IReadOnlyList<CloudSyncSection> GetVisibleCloudSyncSections()
    {
        return CloudSyncSectionMapping.AllSections
            .Where(static section => section != CloudSyncSection.SyncMetadata)
            .ToArray();
    }

    private CloudSyncSectionStatus? GetSectionStatus(CloudSyncSection section)
    {
        var sectionKey = CloudSyncSectionMapping.KvSuffix(section);
        return SessionController.State.CloudSyncStatuses
            .FirstOrDefault(status => string.Equals(status.SectionKey, sectionKey, StringComparison.Ordinal));
    }

    private static bool CanToggleSection(CloudSyncSection section)
    {
        return section != CloudSyncSection.SyncMetadata && !CloudSyncSectionMapping.IsCritical(section);
    }

    private static string GetSectionLabel(CloudSyncSection section)
    {
        return section switch
        {
            CloudSyncSection.UserProfile => "User profile",
            CloudSyncSection.TasksCurrent => "Tasks",
            CloudSyncSection.TaskOrderPreferences => "Task order",
            CloudSyncSection.InventoryCatalog => "Inventory catalog",
            CloudSyncSection.SavedPresets => "Saved presets",
            CloudSyncSection.PartyCurrent => "Party",
            CloudSyncSection.PartyCronHistory => "Party CRON history",
            CloudSyncSection.ColorSchemes => "Color schemes",
            CloudSyncSection.Diagnostics => "Diagnostics",
            _ => section.ToString()
        };
    }

    private static string GetStorageKeyLabel(string storageKey)
    {
        var section = CloudSyncSectionMapping.SectionForStorageKey(storageKey);
        return section is null ? storageKey : GetSectionLabel(section.Value);
    }

    private static string GetSectionKeyForStorageKey(string storageKey)
    {
        var section = CloudSyncSectionMapping.SectionForStorageKey(storageKey);
        return section is null ? storageKey : CloudSyncSectionMapping.KvSuffix(section.Value);
    }

    private string GetCloudSyncSummary()
    {
        if (SessionController.State.IsCloudSyncing)
        {
            return "Syncing encrypted sections...";
        }

        var latest = SessionController.State.CloudSyncStatuses
            .Where(static status => status.Section != CloudSyncSection.SyncMetadata)
            .OrderByDescending(static status => status.UpdatedAtUtc)
            .FirstOrDefault();
        return latest is null
            ? "No cloud sync activity in this session."
            : $"{GetSectionStatusLabel(latest)} {GetSectionLabel(latest.Section).ToLowerInvariant()} at {latest.UpdatedAtUtc.ToLocalTime():g}.";
    }

    private static string GetSectionStatusLabel(CloudSyncSectionStatus? status)
    {
        return status?.Status switch
        {
            CloudSyncSectionStatusKind.Pending => "Pending",
            CloudSyncSectionStatusKind.Succeeded => status.Direction == CloudSyncDirection.Download ? "Downloaded" : "Uploaded",
            CloudSyncSectionStatusKind.Failed => "Failed",
            CloudSyncSectionStatusKind.Skipped => "Skipped",
            CloudSyncSectionStatusKind.Excluded => "Excluded",
            CloudSyncSectionStatusKind.Conflict => "Conflict",
            _ => "Idle"
        };
    }

    private static string GetSectionStatusClass(CloudSyncSectionStatus? status, bool excluded)
    {
        if (excluded || status?.Status is CloudSyncSectionStatusKind.Excluded or CloudSyncSectionStatusKind.Skipped)
        {
            return "sync-status-pill warning-pill";
        }

        return status?.Status switch
        {
            CloudSyncSectionStatusKind.Succeeded => "sync-status-pill success-pill",
            CloudSyncSectionStatusKind.Failed or CloudSyncSectionStatusKind.Conflict => "sync-status-pill danger-pill",
            _ => "sync-status-pill ui-pill"
        };
    }

    private static string FormatBytes(int bytes)
    {
        return bytes < 1024
            ? $"{bytes} B"
            : $"{Math.Round(bytes / 1024d, 1):0.#} KB";
    }

}
