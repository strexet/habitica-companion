    private async Task StartNewDayAsync()
    {
        var recommendation = new EquipmentRecommendationFactory().Create(
            SessionController.State.UserSnapshot!,
            SessionController.State.GearCatalogSnapshot,
            _startNewDayGearGoal);
        var request = _startNewDayAutoEquip && recommendation.HasRecommendation
            ? new StartNewDayRequest(true, recommendation.Slots, recommendation.GoalLabel)
            : new StartNewDayRequest();
        var result = await SessionController.StartNewDayAsync(request);
        _showCronConfirmation = false;
        _startNewDayResultSucceeded = result.Succeeded;
        _startNewDayResultMessage = result.Message;
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private void ToggleStartNewDayAutoEquip(ChangeEventArgs eventArgs)
    {
        _startNewDayAutoEquip = eventArgs.Value as bool? == true;
        _showCronConfirmation = false;
    }

    private void SetStartNewDayGearGoal(string? rawValue)
    {
        _startNewDayGearGoal = Enum.TryParse<EquipmentRecommendationGoal>(rawValue, out var goal)
            ? goal
            : EquipmentRecommendationGoal.Intelligence;
        _showCronConfirmation = false;
    }

    private static Severity GetPendingDamageSeverity(PendingDamageRisk risk)
    {
        return risk switch
        {
            PendingDamageRisk.Danger => Severity.Error,
            PendingDamageRisk.Warning => Severity.Warning,
            PendingDamageRisk.Info => Severity.Info,
            _ => Severity.Normal
        };
    }

    private static string GetPendingDamageWarning(PendingDamageRisk risk)
    {
        return risk switch
        {
            PendingDamageRisk.Danger => "You may be knocked out after Cron. Estimated incoming damage is close to or higher than your current HP.",
            PendingDamageRisk.Warning => "Estimated incoming damage is high compared with your current HP. Consider completing Dailies, healing, or buying a health potion.",
            _ => "Estimated incoming damage is based on synced data."
        };
    }

    private bool CanBuyHealthPotion(UserSnapshot snapshot)
    {
        return SessionController.State.IsAuthenticated
            && !SessionController.State.IsBusy
            && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh
            && snapshot.Gold >= HealthPotionGoldCost
            && (snapshot.MaxHealth <= 0m || snapshot.Health < snapshot.MaxHealth);
    }

    private string GetHealthPotionStatus(UserSnapshot snapshot)
    {
        if (!SessionController.State.IsAuthenticated)
        {
            return "Sign in before buying a health potion.";
        }

        if (SessionController.State.UserFreshness != SnapshotFreshnessState.Fresh)
        {
            return "Refresh account data before buying a health potion.";
        }

        if (SessionController.State.IsBusy)
        {
            return "Another action is running.";
        }

        if (snapshot.MaxHealth > 0m && snapshot.Health >= snapshot.MaxHealth)
        {
            return "Health is already full.";
        }

        return snapshot.Gold < HealthPotionGoldCost
            ? "Needs 25 GP."
            : "Costs 25 GP and refreshes account health and gold after purchase.";
    }

