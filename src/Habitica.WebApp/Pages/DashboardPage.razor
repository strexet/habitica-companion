@page "/dashboard"
@implements IDisposable
@using System.Globalization
@using Habitica.Rules.Stats
@inject IAppSessionController SessionController
@inject CharacterStatsViewModelFactory StatsViewModelFactory
@inject ISnackbar Snackbar

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Account overview</p>
            <h1>Local Habitica dashboard</h1>
            <p class="panel-copy">
                This view summarizes the latest Habitica data saved on this device: class stats, current companion,
                task counts, and what is ready to explore next.
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            No saved account data is available yet. Sign in or refresh to load the data needed for the dashboard.
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.UserSnapshot;

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.UserFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.UserFreshness)
        </MudAlert>

        @if (snapshot.UnallocatedStatPoints > 0)
        {
            <MudAlert Class="inline-banner" Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                <a href="#stats">@snapshot.UnallocatedStatPoints unspent stat points</a> are available for allocation.
            </MudAlert>
        }

        <section class="dashboard-card-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Account</span>
                <strong>@snapshot.DisplayName</strong>
                <span class="dashboard-stat-value">Level @snapshot.Level</span>
                <span class="dashboard-stat-note">@FormatReadableName(snapshot.ClassName, "No class data")</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">HP</span>
                <strong>@FormatStat(snapshot.Health, snapshot.MaxHealth)</strong>
                <span class="dashboard-stat-note">Health</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">MP</span>
                <strong>@FormatStat(snapshot.Mana, snapshot.MaxMana)</strong>
                <span class="dashboard-stat-note">Mana</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">XP</span>
                <strong>@FormatStat(snapshot.Experience, snapshot.ToNextLevel)</strong>
                <span class="dashboard-stat-note">@(snapshot.ToNextLevel > 0 ? "Current / to next level" : "Current XP")</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Gold</span>
                <strong>@snapshot.Gold.ToString("0.##") GP</strong>
                <span class="dashboard-stat-note">Synced currency</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Open tasks</span>
                <strong>@GetOpenTaskCount()</strong>
                <span class="dashboard-stat-note">Across saved tasks</span>
            </article>
        </section>

        <section id="stats" class="card-surface dashboard-panel stats-panel">
            @{
                var statsViewModel = StatsViewModelFactory.Create(snapshot, SessionController.State.GearCatalogSnapshot);
                var pendingTotal = GetPendingTotal();
                var remainingPoints = Math.Max(0, statsViewModel.UnallocatedPoints - pendingTotal);
                var canMutate = SessionController.State.IsAuthenticated
                    && !SessionController.State.IsBusy
                    && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh;
            }
            <div class="stats-panel-head">
                <div>
                    <p class="section-label">Character stats</p>
                    <h2>Stats and allocation</h2>
                </div>
                <div class="stats-points-summary">
                    <strong>@remainingPoints</strong>
                    <span>points available</span>
                </div>
            </div>

            <div class="stats-table-wrap">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>Stat</th>
                            <th>Base</th>
                            <th>Equipment</th>
                            <th>Buffs</th>
                            <th>Effective</th>
                            <th>Allocate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in statsViewModel.Rows)
                        {
                            var pending = GetPendingAllocation(row.Key);
                            <tr>
                                <th scope="row">
                                    <span>@row.Label</span>
                                    <small>@row.Name</small>
                                </th>
                                <td>@FormatDecimal(row.BaseValue)</td>
                                <td>@FormatSignedDecimal(row.EquipmentValue)</td>
                                <td>@FormatSignedDecimal(row.BuffValue)</td>
                                <td><strong>@FormatDecimal(row.EffectiveValue + pending)</strong></td>
                                <td>
                                    <div class="stat-allocation-cell">
                                        <span>@(pending > 0 ? $"+{pending}" : "0")</span>
                                        <MudButton Color="Color.Primary"
                                                   Disabled="@(!canMutate || remainingPoints <= 0)"
                                                   OnClick="() => AddPendingAllocation(row.Key)"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   data-testid="@($"allocate-{row.Key}-plus")">
                                            +
                                        </MudButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="stats-actions">
                <MudButton Color="Color.Primary"
                           Disabled="@(!canMutate || pendingTotal <= 0 || pendingTotal > statsViewModel.UnallocatedPoints)"
                           OnClick="ApplyStatAllocationAsync"
                           Variant="Variant.Filled"
                           data-testid="apply-stat-allocation">
                    Apply allocation
                </MudButton>
                @if (pendingTotal > 0)
                {
                    <MudButton Color="Color.Default" OnClick="ClearPendingAllocation" Variant="Variant.Text">
                        Clear
                    </MudButton>
                }
            </div>
        </section>

        <section class="dashboard-detail-grid">
            <article class="card-surface dashboard-panel">
                <p class="section-label">Companion state</p>
                <h2>Current pet, mount, and party</h2>

                <dl class="dashboard-definition-list">
                    <div>
                        <dt>Pet</dt>
                        <dd>@FormatReadableName(snapshot.CurrentPetKey, "None equipped")</dd>
                    </div>

                    <div>
                        <dt>Mount</dt>
                        <dd>@FormatReadableName(snapshot.CurrentMountKey, "None equipped")</dd>
                    </div>

                    <div>
                        <dt>Party</dt>
                        <dd>@(string.IsNullOrWhiteSpace(snapshot.PartyId) ? "No active party" : "Active party")</dd>
                    </div>
                </dl>
            </article>

            <article class="card-surface dashboard-panel">
                <p class="section-label">Inventory</p>
                <h2>Saved inventory counts</h2>

                <dl class="dashboard-definition-list">
                    <div>
                        <dt>Owned gear</dt>
                        <dd>@snapshot.Inventory.OwnedGearKeys.Length</dd>
                    </div>

                    <div>
                        <dt>Eggs</dt>
                        <dd>@snapshot.Inventory.EggCount</dd>
                    </div>

                    <div>
                        <dt>Food</dt>
                        <dd>@snapshot.Inventory.FoodCount</dd>
                    </div>

                    <div>
                        <dt>Hatching potions</dt>
                        <dd>@snapshot.Inventory.HatchingPotionCount</dd>
                    </div>

                    <div>
                        <dt>Quest scrolls</dt>
                        <dd>@snapshot.Inventory.QuestCount</dd>
                    </div>

                    <div>
                        <dt>Owned pets / mounts</dt>
                        <dd>@snapshot.Inventory.OwnedPetCount / @snapshot.Inventory.OwnedMountCount</dd>
                    </div>
                </dl>
            </article>
        </section>
    }
</div>

@code {
    private readonly Dictionary<string, int> _pendingAllocation = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private static string FormatStat(decimal current, decimal maxOrTarget)
    {
        if (maxOrTarget <= 0)
        {
            return current.ToString("0.##");
        }

        return $"{current:0.##} / {maxOrTarget:0.##}";
    }

    private static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##");
    }

    private static string FormatSignedDecimal(decimal value)
    {
        return value > 0m ? $"+{value:0.##}" : value.ToString("0.##");
    }

    private static string FormatReadableName(string? value, string emptyLabel)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return emptyLabel;
        }

        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' ').Replace('-', ' '));
    }

    private int GetPendingAllocation(string key)
    {
        return _pendingAllocation.TryGetValue(key, out var value) ? value : 0;
    }

    private int GetPendingTotal()
    {
        return _pendingAllocation.Values.Sum();
    }

    private void AddPendingAllocation(string key)
    {
        if (SessionController.State.UserSnapshot is null)
        {
            return;
        }

        var available = SessionController.State.UserSnapshot.UnallocatedStatPoints;
        if (GetPendingTotal() >= available)
        {
            return;
        }

        _pendingAllocation[key] = GetPendingAllocation(key) + 1;
    }

    private void ClearPendingAllocation()
    {
        _pendingAllocation.Clear();
    }

    private async Task ApplyStatAllocationAsync()
    {
        var result = await SessionController.AllocateStatsAsync(new StatAllocation(
            Strength: GetPendingAllocation("str"),
            Intelligence: GetPendingAllocation("int"),
            Constitution: GetPendingAllocation("con"),
            Perception: GetPendingAllocation("per")));
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
        if (result.Succeeded)
        {
            _pendingAllocation.Clear();
        }
    }

    private int GetOpenTaskCount()
    {
        return SessionController.State.TaskSnapshot?.Items.Count(static task => !task.IsCompleted) ?? 0;
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Account data is up to date",
            SnapshotFreshnessState.Stale => "Account data may need refresh",
            SnapshotFreshnessState.Expired => "Account data needs refresh",
            _ => "No saved account data"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }
}
