    {
        return SessionController.State.TaskSnapshot?.Items.Count(static task => !task.IsCompleted) ?? 0;
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Account data is up to date",
            SnapshotFreshnessState.Stale => "Account data may need refresh",
            SnapshotFreshnessState.Expired => "Account data needs refresh",
            _ => "No saved account data"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private DomainRefreshState? GetDomainState(RefreshDomain domain)
    {
        return SessionController.State.DomainStates?.TryGetValue(domain, out var state) == true
            ? state
            : null;
    }

    private bool IsDomainFetching(RefreshDomain domain)
    {
        return GetDomainState(domain)?.IsFetching == true;
    }

    private static string GetDomainStatusText(DomainRefreshState? state)
    {
        if (state?.IsFetching == true)
        {
            return "refreshing";
        }

        if (!string.IsNullOrWhiteSpace(state?.LastError))
        {
            return "failed";
        }

        return state?.LastRefreshedAtUtc is null
            ? "not refreshed"
            : $"updated {state.LastRefreshedAtUtc.Value.ToLocalTime():g}";
    }

    private static string GetDomainStatusClass(DomainRefreshState? state)
    {
        if (state?.IsFetching == true)
        {
            return "ui-pill refresh-status-pill";
        }

        if (!string.IsNullOrWhiteSpace(state?.LastError))
        {
            return "ui-pill refresh-status-pill danger-pill";
        }

        return "ui-pill refresh-status-pill success-pill";
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }
