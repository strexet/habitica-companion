@page "/dashboard"
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@using Habitica.Application.Dashboard
@using Habitica.Application.Sync
@using Habitica.Domain.Auth
@using Habitica.Domain.Dashboard
@using Habitica.Domain.Party
@using Habitica.Rules.Equipment
@using Habitica.Rules.Stats
@inject IAppSessionController SessionController
@inject CharacterStatsViewModelFactory StatsViewModelFactory
@inject PendingDamageEstimateFactory PendingDamageEstimateFactory
@inject ISnackbar Snackbar

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Account overview</p>
            <h1>Local Habitica dashboard</h1>
            <p class="panel-copy">
                This view summarizes the latest Habitica data saved on this device: class stats, current companion,
                task counts, and what is ready to explore next.
            </p>
        </div>
    </section>

    <section class="card-surface dashboard-panel dashboard-appearance">
        <div class="dashboard-appearance-head">
            <p class="section-label">Appearance</p>
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       data-testid="dashboard-appearance-toggle"
                       OnClick="@(() => _appearanceCollapsed = !_appearanceCollapsed)"
                       EndIcon="@(_appearanceCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.Close)">
                @(_appearanceCollapsed ? "Customize theme" : "Cancel")
            </MudButton>
        </div>
        @if (!_appearanceCollapsed)
        {
            <ColorSchemePanel Compact="true" />
        }
    </section>

    @if (SessionController.State.UserSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            No saved account data is available yet. Sign in or refresh to load the data needed for the dashboard.
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.UserSnapshot;
        var statAllocation = new StatAllocationUnlockViewModelFactory().Create(snapshot);

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.UserFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.UserFreshness)
        </MudAlert>

        <div class="dashboard-refresh-strip" data-testid="dashboard-refresh-status">
            @RenderDomainStatus(RefreshDomain.UserProfile, "Account")
            @RenderDomainStatus(RefreshDomain.Tasks, "Tasks")
            @RenderDomainStatus(RefreshDomain.GearCatalog, "Gear")
        </div>

        @if (!string.IsNullOrWhiteSpace(_startNewDayResultMessage))
        {
            <MudAlert Class="inline-banner" Dense="true" Severity="@(_startNewDayResultSucceeded ? Severity.Success : Severity.Error)" Variant="Variant.Filled">
                @_startNewDayResultMessage
            </MudAlert>
        }

        @if (statAllocation.HasAllocatablePoints)
        {
            <MudAlert Class="inline-banner" Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                <a href="#stats">@statAllocation.UnallocatedPoints unspent stat points</a> are available for allocation.
            </MudAlert>
        }

        @if (HasPendingQuestInvitation())
        {
            <MudAlert Class="inline-banner" Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                You have not responded to the current party quest invitation.
                <MudButton Color="Color.Primary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RespondToQuestInvitationAsync(true))" Variant="Variant.Filled">
                    Accept
                </MudButton>
                <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RespondToQuestInvitationAsync(false))" Variant="Variant.Outlined">
                    Reject
                </MudButton>
                <MudButton Href="/party" Variant="Variant.Text">
                    Open Party
                </MudButton>
            </MudAlert>
        }

        @if (snapshot.NeedsCron == true)
        {
            var cronGearRecommendation = new EquipmentRecommendationFactory().Create(
                snapshot,
                SessionController.State.GearCatalogSnapshot,
                _startNewDayGearGoal);
            var autoEquipBlocked = _startNewDayAutoEquip && !cronGearRecommendation.HasRecommendation;
            var canStartNewDay = SessionController.State.IsAuthenticated
                && !SessionController.State.IsBusy
                && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh
                && !autoEquipBlocked;

            <section class="card-surface dashboard-panel cron-action-panel">
                <div>
                    <p class="section-label">Habitica day</p>
                    <h2>Start New Day</h2>
                    <p class="panel-copy">
                        Habitica has not processed today for this account yet. Starting a new day uses Habitica's documented daily reset for this account, then refreshes account, tasks, and party data.
                    </p>
                </div>

                <div class="cron-gear-optimizer">
                    <div class="task-group-header">
                        <div>
                            <span class="dashboard-stat-label">Gear before CRON</span>
                            <strong>@cronGearRecommendation.GoalLabel</strong>
                            <span class="dashboard-stat-note">@cronGearRecommendation.Description</span>
                        </div>
                        <label class="checkbox-row compact">
                            <input checked="@_startNewDayAutoEquip"
                                   data-testid="start-new-day-auto-equip"
                                   type="checkbox"
                                   @onchange="ToggleStartNewDayAutoEquip" />
                            <span>Auto equip</span>
                        </label>
                    </div>

                    <label class="field-row compact">
                        <span>Optimize</span>
                        <select class="app-input" value="@_startNewDayGearGoal.ToString()" @onchange="eventArgs => SetStartNewDayGearGoal(eventArgs.Value?.ToString())" data-testid="start-new-day-gear-goal">
                            <option value="@EquipmentRecommendationGoal.Intelligence.ToString()">INT for mana</option>
                            <option value="@EquipmentRecommendationGoal.Constitution.ToString()">CON for less damage</option>
                            <option value="@EquipmentRecommendationGoal.Survival.ToString()">Survival</option>
                        </select>
                    </label>

                    <div class="optimizer-stat-grid">
                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Current</span>
                            @RenderGearStats(cronGearRecommendation.CurrentStats)
                        </article>
                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Recommended</span>
                            @RenderGearStats(cronGearRecommendation.RecommendedStats)
                        </article>
                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Delta</span>
                            @RenderGearStatDelta(cronGearRecommendation.Delta)
                        </article>
                    </div>

                    @if (!cronGearRecommendation.HasRecommendation)
                    {
                        <p class="panel-copy">No stat-bearing owned battle gear is available for this recommendation.</p>
                    }
                    else
                    {
                        <div class="preset-item-strip optimizer-item-strip">
                            @foreach (var item in cronGearRecommendation.Items)
                            {
                                <article class="preset-mini-item">
                                    <span class="dashboard-stat-label">@item.SlotTitle</span>
                                    <div class="habitica-item-identity">
                                        <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                        <div>
                                            <strong>@item.DisplayName</strong>
                                            @RenderGearStats(item.TotalStats)
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                        <span class="dashboard-stat-note">
                            @(cronGearRecommendation.IsEquipped ? "Recommended gear is already equipped." : "Changed slots will be equipped before CRON after confirmation.")
                        </span>
                    }
                </div>

                @if (_showCronConfirmation)
                {
                    <div class="confirmation-panel">
                        <p>
                            Start new Habitica day? This will run Habitica's daily reset for your account.
                            Missed Dailies may be processed, active quest progress may update, and your temporary buffs may expire.
                            Party buffs expire separately for each member on that member's next CRON.
                            @if (_startNewDayAutoEquip && cronGearRecommendation.HasRecommendation)
                            {
                                <span> Recommended gear will be equipped first.</span>
                            }
                        </p>
                        <div class="confirmation-actions">
                            <MudButton Color="Color.Default" Disabled="@SessionController.State.IsBusy" OnClick="CancelStartNewDay" Variant="Variant.Text">
                                Cancel
                            </MudButton>
                            <MudButton Color="Color.Primary" Disabled="@(!canStartNewDay)" OnClick="StartNewDayAsync" Variant="Variant.Filled" data-testid="confirm-start-new-day">
                                Start New Day
                            </MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cron-action-row">
                        <span class="dashboard-stat-note">@FormatHabiticaDay(snapshot)</span>
                        <MudButton Color="Color.Primary"
                                   Disabled="@(!canStartNewDay)"
                                   OnClick="ShowStartNewDayConfirmation"
                                   Variant="Variant.Filled"
                                   data-testid="start-new-day">
                            Start New Day
                        </MudButton>
                    </div>
                }
            </section>
        }

        <section class="dashboard-card-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Account</span>
                <strong>@snapshot.DisplayName</strong>
                <span class="dashboard-stat-value">Level @snapshot.Level</span>
                <span class="dashboard-stat-note">@FormatReadableName(snapshot.ClassName, "No class data")</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">HP</span>
                <strong>@FormatStat(snapshot.Health, snapshot.MaxHealth)</strong>
                <div class="dashboard-stat-meter health-meter" aria-hidden="true">
                    <span style="@GetMeterWidthStyle(snapshot.Health, snapshot.MaxHealth)"></span>
                </div>
                <span class="dashboard-stat-note">Health</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">MP</span>
                <strong>@FormatStat(snapshot.Mana, snapshot.MaxMana)</strong>
                <div class="dashboard-stat-meter mana-meter" aria-hidden="true">
                    <span style="@GetMeterWidthStyle(snapshot.Mana, snapshot.MaxMana)"></span>
                </div>
                <span class="dashboard-stat-note">Mana</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">XP</span>
                <strong>@FormatStat(snapshot.Experience, snapshot.ToNextLevel)</strong>
                <div class="dashboard-stat-meter xp-meter" aria-hidden="true">
                    <span style="@GetMeterWidthStyle(snapshot.Experience, snapshot.ToNextLevel)"></span>
                </div>
                <span class="dashboard-stat-note">@(snapshot.ToNextLevel > 0 ? "Current / to next level" : "Current XP")</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Gold</span>
                <strong>@snapshot.Gold.ToString("0.##") GP</strong>
                <span class="dashboard-stat-note">Synced currency</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Open tasks</span>
                <strong>@GetOpenTaskCount()</strong>
                <span class="dashboard-stat-note">Across saved tasks</span>
            </article>
        </section>

        <section class="card-surface dashboard-panel dashboard-navigation-panel" data-testid="dashboard-navigation-panel">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Navigation</p>
                    <h2>Companion and Habitica links</h2>
                </div>
                <a class="secondary-action-button compact" href="https://habitica.com" target="_blank" rel="noopener noreferrer">
                    Open Habitica
                </a>
            </div>

            <div class="dashboard-link-grid">
                @RenderDashboardLink("Tasks", "/tasks", "https://habitica.com/tasks", "Score and inspect cached tasks.")
                @RenderDashboardLink("Inventory", "/inventory", "https://habitica.com/inventory/equipment", "Plan gear and inspect inventory.")
                @RenderDashboardLink("Party", "/party", "https://habitica.com/party", "Manage party quest planning.")
                @RenderDashboardLink("Spells", "/spells", "https://habitica.com/tasks", "Cast class skills against task targets.")
            </div>
        </section>

        var damageEstimate = PendingDamageEstimateFactory.Create(
            snapshot,
            SessionController.State.TaskSnapshot,
            SessionController.State.PartySnapshot);

        <section class="card-surface dashboard-panel pending-damage-panel">
            <div class="pending-damage-head">
                <div>
                    <p class="section-label">Damage risk</p>
                    <h2>Pending damage estimate</h2>
                    <p class="panel-copy">
                        This estimate uses saved task and party data. Habitica's final Cron result can differ if tasks, buffs, party state, or server formulas changed after the last refresh.
                    </p>
                    @if (IsDomainFetching(RefreshDomain.Tasks) || IsDomainFetching(RefreshDomain.Party))
                    {
                        <span class="dashboard-stat-note">Refreshing task or party data in the background.</span>
                    }
                </div>
                <div class="pending-damage-total">
                    <strong>@FormatDecimal(damageEstimate.TotalDamage) HP</strong>
                    <span>estimated incoming damage</span>
                </div>
            </div>

            @if (damageEstimate.Risk is PendingDamageRisk.Danger or PendingDamageRisk.Warning)
            {
                <MudAlert Dense="true" Severity="@GetPendingDamageSeverity(damageEstimate.Risk)" Variant="Variant.Outlined">
                    @GetPendingDamageWarning(damageEstimate.Risk)
                </MudAlert>
            }

            <div class="pending-damage-grid">
                <article class="pending-damage-source-card">
                    <span class="dashboard-stat-label">Included</span>
                    <ul class="pending-damage-list">
                        @foreach (var source in damageEstimate.IncludedSources)
                        {
                            <li>
                                <strong>@source.Label: @FormatDecimal(source.Damage) HP</strong>
                                <span>@source.Detail</span>
                            </li>
                        }
                    </ul>
                </article>

                <article class="pending-damage-source-card">
                    <span class="dashboard-stat-label">Not included</span>
                    <ul class="pending-damage-list muted-list">
                        @foreach (var source in damageEstimate.ExcludedSources)
                        {
                            <li>@source</li>
                        }
                    </ul>
                </article>
            </div>

            <div class="health-potion-panel">
                <div>
                    <span class="dashboard-stat-label">Manual recovery</span>
                    <strong>Buy Health Potion</strong>
                    <span class="dashboard-stat-note">@GetHealthPotionStatus(snapshot)</span>
                </div>
                @if (_showHealthPotionConfirmation)
                {
                    <div class="confirmation-actions">
                        <MudButton Color="Color.Default" Disabled="@SessionController.State.IsBusy" OnClick="CancelHealthPotion" Variant="Variant.Text">
                            Cancel
                        </MudButton>
                        <MudButton Color="Color.Primary"
                                   Disabled="@(!CanBuyHealthPotion(snapshot))"
                                   OnClick="BuyHealthPotionAsync"
                                   Variant="Variant.Filled"
                                   data-testid="confirm-buy-health-potion">
                            Confirm purchase
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudButton Color="Color.Primary"
                               Disabled="@(!CanBuyHealthPotion(snapshot))"
                               OnClick="ShowHealthPotionConfirmation"
                               Variant="Variant.Outlined"
                               data-testid="buy-health-potion">
                        Buy Health Potion
                    </MudButton>
                }
            </div>
        </section>

        var statsViewModel = StatsViewModelFactory.Create(snapshot, SessionController.State.GearCatalogSnapshot);
        var pendingTotal = GetPendingTotal();
        var remainingPoints = statAllocation.IsUnlocked
            ? Math.Max(0, statsViewModel.UnallocatedPoints - pendingTotal)
            : 0;
        var canMutate = SessionController.State.IsAuthenticated
            && !SessionController.State.IsBusy
            && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh;
        var canAllocateStats = canMutate && statAllocation.IsUnlocked;

        <section id="stats" class="card-surface dashboard-panel stats-panel">
            <div class="stats-panel-head">
                <div>
                    <p class="section-label">Character stats</p>
                    <h2>Stats and allocation</h2>
                </div>
                <div class="stats-points-summary">
                    @if (statAllocation.IsUnlocked)
                    {
                        <strong>@remainingPoints</strong>
                        <span>points available</span>
                    }
                    else
                    {
                        <strong>Level @StatAllocationEligibility.UnlockLevel</strong>
                        <span>allocation unlock</span>
                    }
                </div>
            </div>

            @if (!statAllocation.IsUnlocked)
            {
                <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                    @statAllocation.LockedReason
                </MudAlert>
            }

            <div class="stats-table-wrap">
                <table class="stats-table">
                    <thead>
                        <tr>
                            <th>Stat</th>
                            <th>Base</th>
                            <th>Equipment</th>
                            <th>Buffs</th>
                            <th>Effective</th>
                            <th>Allocate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in statsViewModel.Rows)
                        {
                            var pending = GetPendingAllocation(row.Key);
                            <tr>
                                <th scope="row">
                                    <span>@row.Label</span>
                                    <small>@row.Name</small>
                                </th>
                                <td>@FormatDecimal(row.BaseValue)</td>
                                <td>@FormatSignedDecimal(row.EquipmentValue)</td>
                                <td>@FormatSignedDecimal(row.BuffValue)</td>
                                <td><strong>@FormatDecimal(row.EffectiveValue + pending)</strong></td>
                                <td>
                                    <div class="stat-allocation-cell">
                                        <span>@(pending > 0 ? $"+{pending}" : "0")</span>
                                        <MudButton Color="Color.Primary"
                                                   Disabled="@(!canAllocateStats || remainingPoints <= 0)"
                                                   OnClick="() => AddPendingAllocation(row.Key)"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   data-testid="@($"allocate-{row.Key}-plus")">
                                            +
                                        </MudButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="stats-actions">
                <MudButton Color="Color.Primary"
                           Disabled="@(!canAllocateStats || pendingTotal <= 0 || pendingTotal > statsViewModel.UnallocatedPoints)"
                           OnClick="ApplyStatAllocationAsync"
                           Variant="Variant.Filled"
                           data-testid="apply-stat-allocation">
                    Apply allocation
                </MudButton>
                @if (pendingTotal > 0)
                {
                    <MudButton Color="Color.Default" OnClick="ClearPendingAllocation" Variant="Variant.Text">
                        Clear
                    </MudButton>
                }
            </div>
        </section>

        <section class="dashboard-detail-grid">
            <article class="card-surface dashboard-panel">
                <p class="section-label">Spend gold</p>
                <h2>Bulk armoire</h2>
                <p class="panel-copy">
                    Spend 100 GP per opening. Subscriber bonus openings are only offered inside the official Android and iOS apps, so this button spends gold for every opening.
                </p>
                <div class="armoire-controls">
                    <label>
                        <span>Open count</span>
                        <input class="app-input"
                               data-testid="armoire-open-count"
                               min="1"
                               max="@GetMaxArmoirePurchases(snapshot)"
                               type="number"
                               @bind="_armoirePurchaseCount"
                               @bind:event="oninput" />
                    </label>
                    <MudButton Color="Color.Primary"
                               Disabled="@(!CanBuyArmoire(snapshot))"
                               OnClick="BuyArmoireAsync"
                               Variant="Variant.Filled">
                        Open armoire
                    </MudButton>
                </div>
                <span class="dashboard-stat-note">@FormatArmoireCapacity(snapshot)</span>
            </article>

            <article class="card-surface dashboard-panel">
                <p class="section-label">Companion state</p>
                <h2>Current pet, mount, and party</h2>

                <div class="habitica-image-row companion-image-row">
                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Pet(snapshot.CurrentPetKey, FormatReadableName(snapshot.CurrentPetKey, "No pet equipped"))" Loading="eager" />
                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Mount(snapshot.CurrentMountKey, FormatReadableName(snapshot.CurrentMountKey, "No mount equipped"))" Loading="eager" />
                </div>

                <dl class="dashboard-definition-list">
                    <div>
                        <dt>Pet</dt>
                        <dd>@FormatReadableName(snapshot.CurrentPetKey, "None equipped")</dd>
                    </div>

                    <div>
                        <dt>Mount</dt>
                        <dd>@FormatReadableName(snapshot.CurrentMountKey, "None equipped")</dd>
                    </div>

                    <div>
                        <dt>Party</dt>
                        <dd>@(string.IsNullOrWhiteSpace(snapshot.PartyId) ? "No active party" : "Active party")</dd>
                    </div>
                </dl>
            </article>

            <article class="card-surface dashboard-panel">
                <p class="section-label">Inventory</p>
                <h2>Saved inventory counts</h2>

                <div class="habitica-icon-chip-grid inventory-count-icon-grid">
                    @RenderImageCountChip(HabiticaImageAssetResolver.EggSummary(), snapshot.Inventory.EggCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.FoodSummary(), snapshot.Inventory.FoodCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.HatchingPotionSummary(), snapshot.Inventory.HatchingPotionCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.QuestScrollSummary(), snapshot.Inventory.QuestCount)
                </div>

                <dl class="dashboard-definition-list">
                    <div>
                        <dt>Owned gear</dt>
                        <dd>@snapshot.Inventory.OwnedGearKeys.Length</dd>
                    </div>

                    <div>
                        <dt>Eggs</dt>
                        <dd>@snapshot.Inventory.EggCount</dd>
                    </div>

                    <div>
                        <dt>Food</dt>
                        <dd>@snapshot.Inventory.FoodCount</dd>
                    </div>

                    <div>
                        <dt>Hatching potions</dt>
                        <dd>@snapshot.Inventory.HatchingPotionCount</dd>
                    </div>

                    <div>
                        <dt>Quest scrolls</dt>
                        <dd>@snapshot.Inventory.QuestCount</dd>
                    </div>

                    <div>
                        <dt>Owned pets / mounts</dt>
                        <dd>@snapshot.Inventory.OwnedPetCount / @snapshot.Inventory.OwnedMountCount</dd>
                    </div>
                </dl>
            </article>
        </section>
    }

</div>

@code {
    private bool _appearanceCollapsed = true;
    private readonly Dictionary<string, int> _pendingAllocation = new(StringComparer.Ordinal);
    private const decimal HealthPotionGoldCost = 25m;
    private int _armoirePurchaseCount = 1;
    private bool _showCronConfirmation;
    private bool _startNewDayAutoEquip;
    private EquipmentRecommendationGoal _startNewDayGearGoal = EquipmentRecommendationGoal.Intelligence;
    private bool _startNewDayResultSucceeded;
    private string? _startNewDayResultMessage;
    private bool _showHealthPotionConfirmation;

    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private static string FormatStat(decimal current, decimal maxOrTarget)
    {
        if (maxOrTarget <= 0)
        {
            return current.ToString("0.##");
        }

        return $"{current:0.##} / {maxOrTarget:0.##}";
    }

    private static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##");
    }

    private static string GetMeterWidthStyle(decimal value, decimal total)
    {
        if (total <= 0m)
        {
            return "width: 0%;";
        }

        var percent = Math.Clamp(Math.Round(value / total * 100m, 2), 0m, 100m);
        return $"width: {percent.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private static string FormatSignedDecimal(decimal value)
    {
        return value > 0m ? $"+{value:0.##}" : value.ToString("0.##");
    }

    private static RenderFragment RenderGearStats(GearStatBlock stats) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "ui-pill count-pill stat-pill-group");

        if (stats == GearStatBlock.Zero)
        {
            builder.AddContent(sequence++, "No stats");
            builder.CloseElement();
            return;
        }

        var highest = GetHighestPositiveStat(stats);
        RenderGearStatValue(builder, ref sequence, "STR", stats.Strength, highest);
        RenderGearStatSeparator(builder, ref sequence);
        RenderGearStatValue(builder, ref sequence, "INT", stats.Intelligence, highest);
        RenderGearStatSeparator(builder, ref sequence);
        RenderGearStatValue(builder, ref sequence, "CON", stats.Constitution, highest);
        RenderGearStatSeparator(builder, ref sequence);
        RenderGearStatValue(builder, ref sequence, "PER", stats.Perception, highest);
        builder.CloseElement();
    };

    private static RenderFragment RenderGearStatDelta(GearStatBlock delta) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", GetGearDeltaClass(delta));
        RenderGearDeltaValue(builder, ref sequence, "STR", delta.Strength);
        RenderGearStatSeparator(builder, ref sequence);
        RenderGearDeltaValue(builder, ref sequence, "INT", delta.Intelligence);
        RenderGearStatSeparator(builder, ref sequence);
        RenderGearDeltaValue(builder, ref sequence, "CON", delta.Constitution);
        RenderGearStatSeparator(builder, ref sequence);
        RenderGearDeltaValue(builder, ref sequence, "PER", delta.Perception);
        builder.CloseElement();
    };

    private static decimal? GetHighestPositiveStat(GearStatBlock stats)
    {
        var highest = new[] { stats.Strength, stats.Intelligence, stats.Constitution, stats.Perception }.Max();
        return highest > 0m ? highest : null;
    }

    private static void RenderGearStatValue(RenderTreeBuilder builder, ref int sequence, string label, decimal value, decimal? highest)
    {
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", highest is not null && value == highest.Value
            ? "inventory-stat-value highest-stat"
            : "inventory-stat-value");
        builder.AddContent(sequence++, $"{label} {value:0.#}");
        builder.CloseElement();
    }

    private static void RenderGearDeltaValue(RenderTreeBuilder builder, ref int sequence, string label, decimal value)
    {
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", value switch
        {
            > 0m => "inventory-stat-value delta-up",
            < 0m => "inventory-stat-value delta-down",
            _ => "inventory-stat-value"
        });
        builder.AddContent(sequence++, $"{label} {FormatSignedDecimal(value)}");
        builder.CloseElement();
    }

    private static void RenderGearStatSeparator(RenderTreeBuilder builder, ref int sequence)
    {
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "inventory-stat-separator");
        builder.AddContent(sequence++, "/");
        builder.CloseElement();
    }

    private static string GetGearDeltaClass(GearStatBlock delta)
    {
        var total = delta.Strength + delta.Intelligence + delta.Constitution + delta.Perception;
        return total switch
        {
            > 0m => "ui-pill count-pill stat-pill-group stat-delta-positive",
            < 0m => "ui-pill count-pill stat-pill-group stat-delta-negative",
            _ => "ui-pill count-pill stat-pill-group"
        };
    }

    private static string FormatReadableName(string? value, string emptyLabel)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return emptyLabel;
        }

        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' ').Replace('-', ' '));
    }

