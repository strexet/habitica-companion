        if (!allocation.CanGrowIntoMount)
        {
            yield return "This pet cannot be grown into a normal mount from the cached catalog.";
            yield break;
        }

        if (allocation.HasNoSelectedFood)
        {
            yield return "No normal food is assigned. Choose another food or use a saddle if available.";
        }

        if (allocation.SelectedFoodExhaustedByEarlierItems)
        {
            yield return "This food is exhausted by earlier queued pets.";
        }

        if (allocation.UsesLessEfficientFood)
        {
            yield return "Selected food is not this pet's favorite, so it gives less progress.";
