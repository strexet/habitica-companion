    private IEnumerable<GroupFeedQueueCandidate> GetGroupFeedQueueCandidates(
        IReadOnlyList<MountCatalogItem> mounts,
        InventorySnapshot inventory)
    {
        foreach (var mount in mounts)
        {
            if (inventory.Mounts.GetValueOrDefault(mount.Key))
            {
                continue;
            }

            if (!PetsMountsCatalog.TryGetPetKeyForMount(mount.Key, out var petKey)
                || _feedQueue.Any(item => string.Equals(item.PetKey, petKey, StringComparison.Ordinal)))
            {
                continue;
            }

            var plan = GetPetGrowthPlan(petKey, inventory);
            if (!plan.CanGrowIntoMount || string.IsNullOrWhiteSpace(plan.MountKey))
            {
