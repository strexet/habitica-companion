        if (allocation.HasPartialFoodPlan)
        {
            yield return "Available food only gives partial progress; this pet will not reach 100%.";
        }
    }

    private Task AddPetToHatchQueueWithScrollAsync(PetCatalogItem pet, InventorySnapshot inventory)
