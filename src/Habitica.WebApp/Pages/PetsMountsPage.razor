@page "/pets-mounts"
@implements IDisposable
@implements IAsyncDisposable
@using System.Globalization
@using Habitica.Storage
@inject IAppSessionController SessionController
@inject IKeyValueStorage ViewStorage
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<PageTitle>Pets &amp; Mounts</PageTitle>

<div class="inventory-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Pets and mounts</p>
            <h1>Companion collection</h1>
            <p class="panel-copy">
                Review owned and missing companions, hatch ready pets, feed with highest-value food first, equip quickly, and plan safe surplus sales.
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            @if (SessionController.State.IsAuthenticated)
            {
                <span>No saved account data is available yet. Refresh before opening the companion collection.</span>
            }
            else
            {
                <span>No saved account data is available on this device yet. Sign in before opening the companion collection.</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.UserSnapshot;
        var canMutate = SessionController.State.IsAuthenticated
            && !SessionController.State.IsBusy
            && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh;
        var catalogPets = GetCatalogPets(snapshot.Inventory);
        var catalogMounts = GetCatalogMounts(snapshot.Inventory);
        var bulkSellPlan = GetBulkSellPlan(snapshot.Inventory).ToArray();
        var safeBulkSellPlan = bulkSellPlan.Where(static item => item.IsSafe).ToArray();

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.UserFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.UserFreshness)
        </MudAlert>

        <section class="inventory-summary-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Current pet</span>
                <HabiticaImage Asset="@HabiticaImageAssetResolver.Pet(snapshot.CurrentPetKey, FormatName(snapshot.CurrentPetKey, "No pet"))" Loading="eager" />
                <strong>@FormatName(snapshot.CurrentPetKey, "None")</strong>
            </article>
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Current mount</span>
                <HabiticaImage Asset="@HabiticaImageAssetResolver.Mount(snapshot.CurrentMountKey, FormatName(snapshot.CurrentMountKey, "No mount"))" Loading="eager" />
                <strong>@FormatName(snapshot.CurrentMountKey, "None")</strong>
            </article>
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Collection</span>
                <strong>@snapshot.Inventory.Pets.Count pet(s)</strong>
                <span class="dashboard-stat-note">@snapshot.Inventory.Mounts.Count(static item => item.Value) mount(s) owned</span>
            </article>
        </section>

        <section class="card-surface inventory-group-card">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Collection search</p>
                    <h2>Find companions and potions</h2>
                </div>
            </div>
            <input class="app-input"
                   placeholder="Search by name or key"
                   value="@_searchText"
                   @oninput="eventArgs => _searchText = eventArgs.Value?.ToString() ?? string.Empty"
                   data-testid="pets-mounts-search" />
            @{
                var creatureTypeOptions = GetCreatureTypeFilterOptions(catalogPets, catalogMounts);
            }
            <div class="companion-filter-grid">
                <label class="field-row compact">
                    <span>Pet type</span>
                    <select class="app-input" value="@_petTypeFilterKey" @onchange="eventArgs => _petTypeFilterKey = eventArgs.Value?.ToString() ?? string.Empty" data-testid="pet-type-filter">
                        <option value="">All types</option>
                        @foreach (var option in creatureTypeOptions)
                        {
                            <option value="@option.Key">@option.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="field-row compact">
                    <span>Mount type</span>
                    <select class="app-input" value="@_mountTypeFilterKey" @onchange="eventArgs => _mountTypeFilterKey = eventArgs.Value?.ToString() ?? string.Empty" data-testid="mount-type-filter">
                        <option value="">All types</option>
                        @foreach (var option in creatureTypeOptions)
                        {
                            <option value="@option.Key">@option.DisplayName</option>
                        }
                    </select>
                </label>
            </div>
        </section>

        <section class="card-surface inventory-group-card">
            @{
                var hatchAllocations = GetHatchQueueAllocations(snapshot.Inventory).ToArray();
                var executableHatchQueue = hatchAllocations.Where(static item => item.CanExecuteHatch).ToArray();
            }
            <div class="task-group-header">
                <div>
                    <p class="section-label">Hatch planner</p>
                    <h2>Hatch queue</h2>
                </div>
                <span class="ui-pill count-pill">@_hatchQueue.Count queued</span>
            </div>

            @if (_hatchQueue.Count == 0)
            {
                <p class="panel-copy">Choose Add to Hatch Queue on a missing pet to review eggs and hatching potions before hatching.</p>
            }
            else
            {
                <div class="hatch-queue-list" data-testid="hatch-dry-run-preview">
                    @foreach (var selection in _hatchQueue)
                    {
                        var allocation = hatchAllocations.First(item => MatchesHatchQueueItem(item, selection));
                        <article class="hatch-queue-card" data-testid="@($"hatch-queue-card-{allocation.PetKey}")">
                            <div class="task-group-header">
                                <div>
                                    <p class="section-label">Queued hatch</p>
                                    <h3>@allocation.PetDisplayName</h3>
                                    <span class="dashboard-stat-note">@allocation.PetKey</span>
                                    <span class="dashboard-stat-note">@allocation.OwnershipStatus</span>
                                </div>
                                <MudButton OnClick="@(() => RemoveQueuedHatch(selection))" Variant="Variant.Text" data-testid="@($"remove-hatch-queue-{allocation.PetKey}")">
                                    Remove
                                </MudButton>
                            </div>
                            <div class="feed-queue-stats hatch-queue-stats">
                                <span class="ui-pill count-pill">Egg @allocation.EggKey</span>
                                <span class="ui-pill count-pill">Egg available @allocation.EggRemainingBeforeItem / @allocation.EggAvailableCount</span>
                                <span class="ui-pill count-pill">Egg reserved @allocation.EggReservedBeforeItem</span>
                                <span class="ui-pill count-pill">Egg plan @allocation.PlannedEggConsumption</span>
                                <span class="ui-pill count-pill">Potion @allocation.HatchingPotionKey</span>
                                <span class="ui-pill count-pill">Potion available @allocation.PotionRemainingBeforeItem / @allocation.PotionAvailableCount</span>
                                <span class="ui-pill count-pill">Potion reserved @allocation.PotionReservedBeforeItem</span>
                                <span class="ui-pill count-pill">Potion plan @allocation.PlannedPotionConsumption</span>
                            </div>
                            @foreach (var warning in GetHatchQueueWarnings(allocation))
                            {
                                <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">@warning</MudAlert>
                            }
                        </article>
                    }
                </div>
                <div class="action-row inventory-actions">
                    <MudButton Color="Color.Primary"
                               Disabled="@(!canMutate || executableHatchQueue.Length == 0)"
                               OnClick="@(() => _showHatchQueueConfirmation = true)"
                               Variant="Variant.Filled"
                               data-testid="execute-hatch-queue">
                        Hatch queued pets
                    </MudButton>
                    <MudButton OnClick="ClearHatchQueue" Variant="Variant.Text" data-testid="clear-hatch-queue">Clear queue</MudButton>
                </div>
                @if (_showHatchQueueConfirmation)
                {
                    <div class="preset-remove-confirm">
                        <span>Hatch @executableHatchQueue.Length queued pet(s)?</span>
                        <MudButton Color="Color.Primary"
                                   Disabled="@(!canMutate || executableHatchQueue.Length == 0)"
                                   OnClick="@(() => ExecuteHatchQueueAsync(snapshot.Inventory))"
                                   Variant="Variant.Filled"
                                   data-testid="confirm-hatch-queue">
                            Confirm hatch
                        </MudButton>
                        <MudButton OnClick="@(() => _showHatchQueueConfirmation = false)" Variant="Variant.Text">Cancel</MudButton>
                    </div>
                }
            }
        </section>

        <section class="card-surface inventory-group-card">
            @{
                var queueAllocations = GetFeedQueueAllocations(snapshot.Inventory).ToArray();
                var executableQueue = queueAllocations.Where(static item => item.CanExecuteFeed).ToArray();
            }
            <div class="task-group-header">
                <div>
                    <p class="section-label">Feed planner</p>
                    <h2>Feed queue</h2>
                </div>
                <span class="ui-pill count-pill">@_feedQueue.Count queued</span>
            </div>

            @if (_feedQueue.Count == 0)
            {
                <p class="panel-copy">Choose Plan feed on an owned pet or Plan to grow on a missing mount.</p>
            }
            else
            {
                <div class="feed-queue-list" data-testid="feed-dry-run-preview">
                    @foreach (var selection in _feedQueue)
                    {
                        var allocation = queueAllocations.First(item => string.Equals(item.PetKey, selection.PetKey, StringComparison.Ordinal));
                        var growthPlan = GetPetGrowthPlan(selection.PetKey, snapshot.Inventory);
                        var selectedPet = GetCatalogPet(selection.PetKey);
                        var foodOptions = selectedPet is null
                            ? Array.Empty<PetFoodRecommendation>()
                            : PetFeedRecommendationFactory.OrderAvailableFood(selectedPet, snapshot.Inventory.Food, includeGeneric: false);
                        var canUseSaddle = CanUseSaddle(allocation, snapshot.Inventory);
                        <article class="feed-queue-card" data-testid="@($"feed-queue-card-{selection.PetKey}")">
                            <div class="task-group-header">
                                <div>
                                    <p class="section-label">Queued pet</p>
                                    <h3>@FormatName(selection.PetKey, selection.PetKey)</h3>
                                    <span class="dashboard-stat-note">@selection.PetKey</span>
                                </div>
                                <MudButton OnClick="@(() => RemoveQueuedPet(selection.PetKey))" Variant="Variant.Text" data-testid="@($"remove-feed-queue-{selection.PetKey}")">
                                    Remove
                                </MudButton>
                            </div>
                            @RenderPetGrowth(growthPlan, $"feed-growth-{selection.PetKey}", true)
                            <label class="field-row compact">
                                <span>Food</span>
                                <select class="app-input"
                                        value="@selection.FoodKey"
                                        @onchange="eventArgs => ChangeQueuedFood(selection.PetKey, eventArgs.Value?.ToString())"
                                        data-testid="@($"feed-food-select-{selection.PetKey}")">
                                    @if (foodOptions.Count == 0)
                                    {
                                        <option value="">No normal food available</option>
                                    }
                                    else
                                    {
                                        @foreach (var food in foodOptions)
                                        {
                                            <option value="@food.Key">@food.DisplayName (+@FormatProgressPercent(food.ProgressPercent)%, @FormatFoodPriority(food.Priority), owned @food.OwnedCount)</option>
                                        }
                                    }
                                </select>
                            </label>
                            <div class="feed-queue-stats">
                                <span class="ui-pill count-pill">Current @FormatProgressPercent(allocation.CurrentProgressPercent)%</span>
                                <span class="ui-pill count-pill">After plan @FormatProgressPercent(allocation.ExpectedProgressPercent)%</span>
                                <span class="ui-pill count-pill">Use @allocation.PlannedAmount of @allocation.RequiredAmount</span>
                                <span class="ui-pill count-pill">Available @allocation.SelectedFoodRemainingBeforeItem / @allocation.SelectedFoodAvailableCount</span>
                            </div>
                            @foreach (var warning in GetQueueWarnings(allocation))
                            {
                                <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">@warning</MudAlert>
                            }
                            @if (_pendingTransformPetKey == selection.PetKey)
                            {
                                <div class="preset-remove-confirm">
                                    <span>Feed @FormatName(selection.PetKey, selection.PetKey) with @allocation.SelectedFoodDisplayName x @allocation.PlannedAmount?</span>
                                    <MudButton Color="Color.Primary"
                                               Disabled="@(!canMutate || !allocation.CanExecuteFeed)"
                                               OnClick="@(() => ExecuteQueuedPetAsync(selection.PetKey, snapshot.Inventory))"
                                               Variant="Variant.Filled"
                                               data-testid="@($"confirm-transform-mount-{selection.PetKey}")">
                                        Confirm
                                    </MudButton>
                                    <MudButton OnClick="@(() => _pendingTransformPetKey = null)" Variant="Variant.Text">Cancel</MudButton>
                                </div>
                            }
                            else if (_pendingSaddlePetKey == selection.PetKey)
                            {
                                <div class="preset-remove-confirm">
                                    <span>Use one Saddle to instantly transform this pet into a mount? Fed progress is not refunded.</span>
                                    <MudButton Color="Color.Primary"
                                               Disabled="@(!canMutate || !canUseSaddle)"
                                               OnClick="@(() => UseSaddleAsync(selection.PetKey))"
                                               Variant="Variant.Filled"
                                               data-testid="@($"confirm-use-saddle-{selection.PetKey}")">
                                        Confirm saddle
                                    </MudButton>
                                    <MudButton OnClick="@(() => _pendingSaddlePetKey = null)" Variant="Variant.Text">Cancel</MudButton>
                                </div>
                            }
                            else
                            {
                                <div class="action-row inventory-actions">
                                    <MudButton Color="Color.Primary"
                                               Disabled="@(!canMutate || !allocation.CanReachMount || !allocation.CanExecuteFeed)"
                                               OnClick="@(() => _pendingTransformPetKey = selection.PetKey)"
                                               Variant="Variant.Outlined"
                                               data-testid="@($"transform-mount-{selection.PetKey}")">
                                        Transform to Mount
                                    </MudButton>
                                    <MudButton Color="Color.Primary"
                                               Disabled="@(!canMutate || !canUseSaddle)"
                                               OnClick="@(() => _pendingSaddlePetKey = selection.PetKey)"
                                               Variant="Variant.Text"
                                               data-testid="@($"use-saddle-{selection.PetKey}")">
                                        Use Saddle
                                    </MudButton>
                                </div>
                                @if (!canUseSaddle)
                                {
                                    <span class="dashboard-stat-note">No usable saddle for this pet. See the buy saddle block below.</span>
                                }
                            }
                        </article>
                    }
                </div>
                <div class="action-row inventory-actions">
                    <MudButton Color="Color.Primary"
                               Disabled="@(!canMutate || executableQueue.Length == 0)"
                               OnClick="@(() => ExecuteFeedQueueAsync(snapshot.Inventory))"
                               Variant="Variant.Filled"
                               data-testid="execute-feed-queue">
                        Feed queued items
                    </MudButton>
                    <MudButton OnClick="ClearFeedQueue" Variant="Variant.Text">Clear queue</MudButton>
                </div>
            }
        </section>

        @foreach (var group in PetsMountsCatalog.Groups)
        {
            var groupPets = catalogPets
                .Where(item => item.GroupKey == group.Key && MatchesSearch(item.Key, item.DisplayName) && MatchesPetTypeFilter(item))
                .ToArray();
            var groupMounts = catalogMounts
                .Where(item => item.GroupKey == group.Key && MatchesSearch(item.Key, item.DisplayName) && MatchesMountTypeFilter(item))
                .ToArray();
            var hatchCandidates = GetGroupHatchQueueCandidates(groupPets, snapshot.Inventory).ToArray();
            var feedCandidates = GetGroupFeedQueueCandidates(groupMounts, snapshot.Inventory).ToArray();
            var isFolded = IsGroupFolded(group.Key);
            <section class="card-surface inventory-group-card" id="@BuildGroupElementId(group.Key)" data-testid="@($"pets-mounts-group-{group.Key}")">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Companion group</p>
                        <h2>@group.DisplayName</h2>
                    </div>
                    <div class="task-group-actions companion-group-actions">
                        <MudButton Color="Color.Primary"
                                   Disabled="@(hatchCandidates.Length == 0)"
                                   OnClick="@(() => AddGroupToHatchQueueWithScrollAsync(group.Key, groupPets, snapshot.Inventory))"
                                   Variant="Variant.Outlined"
                                   data-testid="@($"add-group-hatch-queue-{group.Key}")">
                            Add All to Hatching Queue
                        </MudButton>
                        <MudButton Color="Color.Primary"
                                   Disabled="@(feedCandidates.Length == 0)"
                                   OnClick="@(() => AddGroupToFeedQueueWithScrollAsync(group.Key, groupMounts, snapshot.Inventory))"
                                   Variant="Variant.Outlined"
                                   data-testid="@($"add-group-feed-queue-{group.Key}")">
                            Add All to Feeding Queue
                        </MudButton>
                        <MudButton OnClick="@(() => ToggleGroupAsync(group.Key))" Variant="Variant.Text" data-testid="@($"toggle-pets-mounts-group-{group.Key}")">
                            @(isFolded ? "Show group" : "Hide group")
                        </MudButton>
                        @if (hatchCandidates.Length == 0 && feedCandidates.Length == 0)
                        {
                            <span class="dashboard-stat-note">No hatchable pets / No growable mounts</span>
                        }
                        else if (hatchCandidates.Length == 0)
                        {
                            <span class="dashboard-stat-note">No hatchable pets</span>
                        }
                        else if (feedCandidates.Length == 0)
                        {
                            <span class="dashboard-stat-note">No growable mounts</span>
                        }
                    </div>
                </div>

                @if (!isFolded)
                {
                    <p class="panel-copy">@BuildMarketHint(group.Key, catalogPets, snapshot.Inventory)</p>
                    @if (groupPets.Length == 0 && groupMounts.Length == 0)
                    {
                        <p class="panel-copy">No matching catalog entries are available in this group.</p>
                    }
                    else
                    {
                        <div class="inventory-item-list">
                            @foreach (var pet in groupPets)
                            {
                                var isOwned = snapshot.Inventory.Pets.ContainsKey(pet.Key);
                                var hatchStatus = GetHatchStatus(pet, snapshot.Inventory);
                                var growthPlan = GetPetGrowthPlan(pet.Key, snapshot.Inventory);
                                <article class="inventory-item-card" id="@BuildPetElementId(pet.Key)" data-testid="@($"pet-card-{pet.Key}")">
                                    <div class="habitica-item-identity">
                                        <HabiticaImage Asset="@HabiticaImageAssetResolver.Pet(pet.Key, pet.DisplayName)" />
                                        <div>
                                            <strong>@pet.DisplayName</strong>
                                            <span class="dashboard-stat-note">@pet.Key</span>
                                            <span class="dashboard-stat-note">@(isOwned ? "Owned pet" : hatchStatus)</span>
                                        </div>
                                    </div>
                                    @RenderPetGrowth(growthPlan, $"pet-growth-{pet.Key}", isOwned)
                                    <div class="action-row inventory-actions">
                                        @if (isOwned)
                                        {
                                            <MudButton Color="Color.Primary" Disabled="@(!canMutate)" OnClick="@(() => EquipPetAsync(pet.Key))" Variant="Variant.Outlined" data-testid="@($"equip-pet-{pet.Key}")">
                                                @(string.Equals(snapshot.CurrentPetKey, pet.Key, StringComparison.Ordinal) ? "Equipped pet" : "Equip pet")
                                            </MudButton>
                                            @if (growthPlan.CanGrowIntoMount)
                                            {
                                                <MudButton OnClick="@(() => AddPetToFeedQueueWithScrollAsync(pet.Key, snapshot.Inventory))" Variant="Variant.Text" data-testid="@($"select-feed-{pet.Key}")">
                                                    Plan feed
                                                </MudButton>
                                            }
                                        }
                                        else if (CanPlanHatch(pet))
                                        {
                                            <MudButton Color="Color.Primary" OnClick="@(() => AddPetToHatchQueueWithScrollAsync(pet, snapshot.Inventory))" Variant="Variant.Outlined" data-testid="@($"select-hatch-{pet.Key}")">
                                                Add to Hatch Queue
                                            </MudButton>
                                        }
                                    </div>
                                </article>
                            }

                            @foreach (var mount in groupMounts)
                            {
                                var isOwned = snapshot.Inventory.Mounts.GetValueOrDefault(mount.Key);
                                <article class="inventory-item-card" id="@BuildMountElementId(mount.Key)" data-testid="@($"mount-card-{mount.Key}")">
                                    <div class="habitica-item-identity">
                                        <HabiticaImage Asset="@HabiticaImageAssetResolver.Mount(mount.Key, mount.DisplayName)" />
                                        <div>
                                            <strong>@mount.DisplayName</strong>
                                            <span class="dashboard-stat-note">@mount.Key</span>
                                            <span class="dashboard-stat-note">@(isOwned ? "Owned mount" : "Missing mount")</span>
                                        </div>
                                    </div>
                                    @if (isOwned)
                                    {
                                        <MudButton Color="Color.Primary" Disabled="@(!canMutate)" OnClick="@(() => EquipMountAsync(mount.Key))" Variant="Variant.Outlined" data-testid="@($"equip-mount-{mount.Key}")">
                                            @(string.Equals(snapshot.CurrentMountKey, mount.Key, StringComparison.Ordinal) ? "Equipped mount" : "Equip mount")
                                        </MudButton>
                                    }
                                    else
                                    {
                                        var missingMountPlan = GetMissingMountPlan(mount.Key, snapshot.Inventory);
                                        <div class="action-row inventory-actions">
                                            @if (missingMountPlan.CanPlan)
                                            {
                                                <MudButton Color="Color.Primary"
                                                           OnClick="@(() => AddMissingMountToFeedQueueWithScrollAsync(mount.Key, missingMountPlan.PetKey!, snapshot.Inventory))"
                                                           Variant="Variant.Text"
                                                           data-testid="@($"plan-grow-mount-{mount.Key}")">
                                                    Plan to grow
                                                </MudButton>
                                            }
                                            <span class="dashboard-stat-note">@missingMountPlan.Message</span>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                }
            </section>
        }

        <section class="card-surface inventory-group-card" data-testid="pets-mounts-group-hatching-potions">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Hatching potions</p>
                    <h2>Potion inventory</h2>
                </div>
                <MudButton OnClick="ToggleHatchingPotionsAsync" Variant="Variant.Text" data-testid="toggle-pets-mounts-group-hatching-potions">
                    @(IsGroupFolded("hatching-potions") ? "Show group" : "Hide group")
                </MudButton>
            </div>
            @if (!IsGroupFolded("hatching-potions"))
            {
                <div class="inventory-item-list">
                    @foreach (var potion in PetsMountsCatalog.HatchingPotions.Where(item => MatchesSearch(item.Key, item.DisplayName)))
                    {
                        <article class="inventory-item-card" data-testid="@($"hatching-potion-{potion.Key}")">
                            <div class="habitica-item-identity">
                                <HabiticaImage Asset="@HabiticaImageAssetResolver.HatchingPotion(potion.Key, potion.DisplayName)" />
                                <div>
                                    <strong>@potion.DisplayName</strong>
                                    <span class="dashboard-stat-note">@potion.Key • owned @snapshot.Inventory.HatchingPotions.GetValueOrDefault(potion.Key)</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="card-surface inventory-group-card" id="buy-saddle-block" data-testid="buy-saddle-block">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Saddles</p>
                    <h2>Instant mount option</h2>
                </div>
                <span class="ui-pill count-pill">@snapshot.Inventory.Food.GetValueOrDefault("Saddle") saddle(s)</span>
            </div>
            <p class="panel-copy">
                Saddles instantly turn one eligible owned pet into its matching mount. Use Saddle stays separate from normal food because fed progress is not refunded.
            </p>
            <p class="dashboard-stat-note">Saddle purchase is not available in this app until Habitica shop behavior is verified for this flow.</p>
        </section>

        <section class="card-surface inventory-group-card bulk-sell-card">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Bulk sell planner</p>
                    <h2>Safe item sell preview</h2>
                </div>
                <label class="field-row compact">
                    <span>Keep count</span>
                    <input class="app-input" min="0" max="99" type="number" value="@_bulkSellKeepCount" @onchange="eventArgs => SetBulkSellKeepCount(eventArgs.Value?.ToString())" data-testid="bulk-sell-keep-count" />
                </label>
            </div>

            @if (bulkSellPlan.Length == 0)
            {
                <p class="panel-copy">No eggs, food, or hatching potions are available in the cached inventory snapshot.</p>
            }
            else
            {
                <div class="bulk-sell-list">
                    @foreach (var item in bulkSellPlan)
                    {
                        <article class="@GetBulkSellItemClass(item)">
                            <div>
                                <strong>@FormatName(item.Key, item.Key)</strong>
                                <span class="dashboard-stat-note">@FormatSellType(item.Type) • owned @item.OwnedCount • sell @item.SellCount</span>
                            </div>
                            <span class="dashboard-stat-note">@item.Explanation</span>
                        </article>
                    }
                </div>
            }

            @if (_showBulkSellConfirmation)
            {
                <div class="preset-remove-confirm">
                    <span>Sell @safeBulkSellPlan.Sum(static item => item.SellCount) planned item(s)?</span>
