    private bool AddPetToHatchQueue(PetCatalogItem pet, InventorySnapshot inventory)
    {
        if (!CanPlanHatch(pet))
        {
            Snackbar.Add("This pet cannot be hatched from the checked-in catalog.", Severity.Warning);
            return false;
        }

        if (inventory.Pets.ContainsKey(pet.Key))
        {
            Snackbar.Add($"{pet.DisplayName} is already owned.", Severity.Info);
            return false;
        }

        var queueItem = new HatchQueueItem(pet.EggKey, pet.HatchingPotionKey);
        if (_hatchQueue.Any(item => MatchesHatchQueueItem(item, queueItem)))
        {
            Snackbar.Add($"{pet.DisplayName} is already queued.", Severity.Info);
            return false;
        }

        _hatchQueue.Add(queueItem);
        _showHatchQueueConfirmation = false;
        return true;
    }

    private bool AddGroupToHatchQueue(
        IReadOnlyList<PetCatalogItem> pets,
        InventorySnapshot inventory)
    {
        var candidates = GetGroupHatchQueueCandidates(pets, inventory).ToArray();
        foreach (var candidate in candidates)
        {
            _hatchQueue.Add(candidate);
        }

        _showHatchQueueConfirmation = false;
        if (candidates.Length > 0)
        {
            Snackbar.Add($"Added {candidates.Length} pet(s) to the hatching queue.", Severity.Success);
        }

        return candidates.Length > 0;
    }

    private IEnumerable<HatchQueueItem> GetGroupHatchQueueCandidates(
        IReadOnlyList<PetCatalogItem> pets,
        InventorySnapshot inventory)
    {
        var queuedPetKeys = new HashSet<string>(
            _hatchQueue.Select(GetHatchPetKey),
            StringComparer.Ordinal);

        foreach (var pet in pets)
        {
            if (!CanPlanHatch(pet)
                || inventory.Pets.ContainsKey(pet.Key)
                || inventory.Eggs.GetValueOrDefault(pet.EggKey) <= 0
                || inventory.HatchingPotions.GetValueOrDefault(pet.HatchingPotionKey) <= 0)
            {
                continue;
            }

            var queueItem = new HatchQueueItem(pet.EggKey, pet.HatchingPotionKey);
            if (!queuedPetKeys.Add(GetHatchPetKey(queueItem)))
            {
                continue;
            }

            yield return queueItem;
        }
    }

    private IEnumerable<HatchQueueAllocation> GetHatchQueueAllocations(InventorySnapshot inventory)
    {
        var remainingEggs = CloneInventoryCounts(inventory.Eggs);
        var remainingPotions = CloneInventoryCounts(inventory.HatchingPotions);
        var queuedPets = new HashSet<string>(StringComparer.Ordinal);

        foreach (var item in _hatchQueue)
        {
            var petKey = GetHatchPetKey(item);
            var catalogPet = PetsMountsCatalog.FindPet(petKey);
            var isSupported = catalogPet is not null && CanPlanHatch(catalogPet);
            var isOwned = inventory.Pets.ContainsKey(petKey);
            var isDuplicate = !queuedPets.Add(petKey);
            var eggAvailableCount = inventory.Eggs.GetValueOrDefault(item.EggKey);
            var potionAvailableCount = inventory.HatchingPotions.GetValueOrDefault(item.HatchingPotionKey);
            var eggRemainingBeforeItem = remainingEggs.GetValueOrDefault(item.EggKey);
            var potionRemainingBeforeItem = remainingPotions.GetValueOrDefault(item.HatchingPotionKey);
            var canReserveResources = isSupported && !isOwned && !isDuplicate;
            var plannedEggConsumption = canReserveResources && eggRemainingBeforeItem > 0 ? 1 : 0;
            var plannedPotionConsumption = canReserveResources && potionRemainingBeforeItem > 0 ? 1 : 0;

            if (plannedEggConsumption > 0)
            {
                remainingEggs[item.EggKey] = eggRemainingBeforeItem - plannedEggConsumption;
            }

            if (plannedPotionConsumption > 0)
            {
                remainingPotions[item.HatchingPotionKey] = potionRemainingBeforeItem - plannedPotionConsumption;
            }

            yield return new HatchQueueAllocation(
                item.EggKey,
                item.HatchingPotionKey,
                petKey,
                FormatName(petKey, petKey),
                isSupported,
                isOwned,
                isDuplicate,
                eggAvailableCount,
                eggRemainingBeforeItem,
                plannedEggConsumption,
                potionAvailableCount,
                potionRemainingBeforeItem,
                plannedPotionConsumption);
        }
    }

    private static Dictionary<string, int> CloneInventoryCounts(IReadOnlyDictionary<string, int> items)
    {
        var clone = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var pair in items)
        {
            clone[pair.Key] = pair.Value;
        }

        return clone;
    }

    private static IEnumerable<string> GetHatchQueueWarnings(HatchQueueAllocation allocation)
    {
        if (!allocation.IsSupported)
        {
            yield return "This pet cannot be hatched from the checked-in catalog.";
            yield break;
        }

        if (allocation.IsOwned)
        {
            yield return "This pet is already owned, so it will not be hatched.";
            yield break;
        }

        if (allocation.IsDuplicate)
        {
            yield return "This pet is already queued earlier.";
            yield break;
        }

        if (allocation.EggAvailableCount <= 0)
        {
            yield return $"Need egg {allocation.EggKey} before hatching.";
        }
        else if (allocation.PlannedEggConsumption == 0)
        {
            yield return $"Egg {allocation.EggKey} is reserved by earlier queued pets.";
        }

        if (allocation.PotionAvailableCount <= 0)
        {
            yield return $"Need potion {allocation.HatchingPotionKey} before hatching.";
        }
        else if (allocation.PlannedPotionConsumption == 0)
        {
            yield return $"Potion {allocation.HatchingPotionKey} is reserved by earlier queued pets.";
        }
    }

    private async Task ExecuteHatchQueueAsync(InventorySnapshot inventory)
    {
        var executable = GetHatchQueueAllocations(inventory)
            .Where(static item => item.CanExecuteHatch)
            .Select(static item => new HatchQueueItem(item.EggKey, item.HatchingPotionKey))
            .ToArray();
        if (executable.Length == 0)
        {
            _showHatchQueueConfirmation = false;
            Snackbar.Add("No queued pet has enough eggs and hatching potions.", Severity.Warning);
            return;
        }

        var hatchedCount = 0;
        foreach (var item in executable)
        {
            var result = await SessionController.HatchPetAsync(item.EggKey, item.HatchingPotionKey);
            ShowFeedback(result);
            if (!result.Succeeded)
            {
                _showHatchQueueConfirmation = false;
                return;
            }

            hatchedCount++;
            RemoveQueuedHatch(item, resetConfirmation: false);
        }

        _showHatchQueueConfirmation = false;
        if (hatchedCount > 0)
        {
            Snackbar.Add($"Hatched {hatchedCount} queued pet(s).", Severity.Success);
        }
    }

    private void RemoveQueuedHatch(HatchQueueItem item, bool resetConfirmation = true)
    {
        _hatchQueue.RemoveAll(queued => MatchesHatchQueueItem(queued, item));
        if (resetConfirmation)
        {
            _showHatchQueueConfirmation = false;
        }
    }

    private void ClearHatchQueue()
    {
        _hatchQueue.Clear();
        _showHatchQueueConfirmation = false;
    }

    private static bool CanUseSaddle(PetGrowthQueueAllocation allocation, InventorySnapshot inventory)
    {
        return allocation.CanGrowIntoMount
            && !string.IsNullOrWhiteSpace(allocation.MountKey)
            && inventory.Food.GetValueOrDefault("Saddle") > 0
            && inventory.Mounts.GetValueOrDefault(allocation.MountKey) != true;
    }

    private static MissingMountPlan GetMissingMountPlan(string mountKey, InventorySnapshot inventory)
    {
        if (!PetsMountsCatalog.TryGetPetKeyForMount(mountKey, out var petKey))
        {
            return new MissingMountPlan(false, null, "No growable pet mapping is available.");
        }

        if (!inventory.Pets.ContainsKey(petKey))
        {
            return new MissingMountPlan(false, petKey, $"Hatch {FormatName(petKey, petKey)} before planning this mount.");
        }

        var plan = GetPetGrowthPlan(petKey, inventory);
        if (!plan.CanGrowIntoMount)
        {
            return new MissingMountPlan(false, petKey, FormatMissingMountUnavailable(plan));
        }

        return new MissingMountPlan(true, petKey, $"Grow from {FormatName(petKey, petKey)}.");
    }

    private static string FormatMissingMountUnavailable(PetGrowthPlan plan)
    {
        return plan.UnavailableReason switch
        {
            PetGrowthUnavailableReason.MountAlreadyOwned => "Matching mount is already owned.",
            PetGrowthUnavailableReason.AlreadyMountReady => "Pet is already mount-ready; refresh before planning.",
            PetGrowthUnavailableReason.NonGrowablePet => "This pet cannot become a normal mount.",
            PetGrowthUnavailableReason.UnknownPet => "Pet is not in the checked-in catalog.",
            PetGrowthUnavailableReason.PetNotOwned => "Corresponding pet is not owned.",
            _ => "This mount cannot be planned from cached data."
        };
    }

    private static IReadOnlyList<CreatureTypeFilterOption> GetCreatureTypeFilterOptions(
        IReadOnlyList<PetCatalogItem> pets,
        IReadOnlyList<MountCatalogItem> mounts)
    {
        return pets
            .Select(static pet => PetsMountsCatalog.TryGetCreatureTypeKey(pet, out var key) ? key : null)
            .Concat(mounts.Select(static mount => PetsMountsCatalog.TryGetCreatureTypeKey(mount, out var key) ? key : null))
            .Where(static key => !string.IsNullOrWhiteSpace(key))
            .Distinct(StringComparer.Ordinal)
            .Select(static key => new CreatureTypeFilterOption(key!, PetsMountsCatalog.ToCreatureTypeDisplayName(key!)))
            .OrderBy(static item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(static item => item.Key, StringComparer.Ordinal)
            .ToArray();
    }

    private async Task EquipPetAsync(string key)
    {
        ShowFeedback(await SessionController.EquipPetAsync(key));
    }

    private async Task EquipMountAsync(string key)
    {
        ShowFeedback(await SessionController.EquipMountAsync(key));
    }

    private static bool CanHatch(PetCatalogItem pet, InventorySnapshot inventory)
    {
        return !string.IsNullOrWhiteSpace(pet.EggKey)
            && !string.IsNullOrWhiteSpace(pet.HatchingPotionKey)
            && inventory.Eggs.GetValueOrDefault(pet.EggKey) > 0
            && inventory.HatchingPotions.GetValueOrDefault(pet.HatchingPotionKey) > 0;
    }

    private static bool CanPlanHatch(PetCatalogItem pet)
    {
        return !string.IsNullOrWhiteSpace(pet.EggKey)
            && !string.IsNullOrWhiteSpace(pet.HatchingPotionKey)
            && PetsMountsCatalog.FindPet(pet.Key) is not null;
    }

    private static string GetHatchPetKey(HatchQueueItem item)
    {
        return $"{item.EggKey}-{item.HatchingPotionKey}";
    }

    private static bool MatchesHatchQueueItem(HatchQueueItem left, HatchQueueItem right)
    {
        return string.Equals(left.EggKey, right.EggKey, StringComparison.Ordinal)
            && string.Equals(left.HatchingPotionKey, right.HatchingPotionKey, StringComparison.Ordinal);
    }

    private static bool MatchesHatchQueueItem(HatchQueueAllocation allocation, HatchQueueItem item)
    {
        return string.Equals(allocation.EggKey, item.EggKey, StringComparison.Ordinal)
            && string.Equals(allocation.HatchingPotionKey, item.HatchingPotionKey, StringComparison.Ordinal);
    }

    private static string GetHatchStatus(PetCatalogItem pet, InventorySnapshot inventory)
    {
        if (string.IsNullOrWhiteSpace(pet.EggKey) || string.IsNullOrWhiteSpace(pet.HatchingPotionKey))
        {
            return "Missing special pet";
        }

        var hasEgg = inventory.Eggs.GetValueOrDefault(pet.EggKey) > 0;
        var hasPotion = inventory.HatchingPotions.GetValueOrDefault(pet.HatchingPotionKey) > 0;
        return (hasEgg, hasPotion) switch
        {
            (true, true) => "Ready to hatch",
            (false, true) => $"Need egg {pet.EggKey}",
            (true, false) => $"Need potion {pet.HatchingPotionKey}",
            _ => $"Need egg {pet.EggKey} and potion {pet.HatchingPotionKey}"
        };
    }

    private static string BuildMarketHint(string groupKey, IReadOnlyList<PetCatalogItem> pets, InventorySnapshot inventory)
    {
        var missing = pets.Where(pet => pet.GroupKey == groupKey && !inventory.Pets.ContainsKey(pet.Key)).ToArray();
        var readyCount = missing.Count(pet => CanHatch(pet, inventory));
        if (readyCount > 0)
        {
            return $"Can hatch {readyCount} pet(s) with current inventory.";
        }

        return missing.FirstOrDefault() is { } pet
            ? GetHatchStatus(pet, inventory)
            : "No missing hatchable pets in this group.";
    }

    private async Task SellBulkPlanAsync(IReadOnlyList<BulkSellPlanItem> plan)
    {
        var soldCount = 0;
        foreach (var item in plan.Where(static item => item.IsSafe && item.SellCount > 0))
        {
            var result = await SessionController.SellInventoryItemAsync(item.Type, item.Key, item.SellCount);
            ShowFeedback(result);
            if (!result.Succeeded)
            {
                _showBulkSellConfirmation = false;
                return;
            }

            soldCount += item.SellCount;
        }

        _showBulkSellConfirmation = false;
        if (soldCount > 0)
        {
            Snackbar.Add($"Sold {soldCount} planned item(s).", Severity.Success);
        }
    }

    private IEnumerable<BulkSellPlanItem> GetBulkSellPlan(InventorySnapshot inventory)
    {
        foreach (var item in BuildBulkSellItems(InventorySellItemType.Egg, inventory.Eggs))
        {
            yield return item;
        }

        foreach (var item in BuildBulkSellItems(InventorySellItemType.Food, inventory.Food))
        {
            yield return item;
        }

        foreach (var item in BuildBulkSellItems(InventorySellItemType.HatchingPotion, inventory.HatchingPotions))
        {
            yield return item;
        }
    }

    private IEnumerable<BulkSellPlanItem> BuildBulkSellItems(InventorySellItemType type, IReadOnlyDictionary<string, int> items)
    {
        foreach (var item in items.OrderBy(static item => item.Key, StringComparer.OrdinalIgnoreCase))
        {
            var sellCount = Math.Max(0, item.Value - _bulkSellKeepCount);
            var isSafe = sellCount > 0;
            yield return new BulkSellPlanItem(
                type,
                item.Key,
                item.Value,
                sellCount,
                isSafe,
                isSafe
                    ? $"Safe by local rule: keep {_bulkSellKeepCount} cached item(s), sell only the surplus through Habitica's supported sell endpoint."
                    : "Unsafe by local rule: cached count is at or below the keep threshold.");
        }
    }

    private void SetBulkSellKeepCount(string? rawValue)
    {
        _bulkSellKeepCount = int.TryParse(rawValue, out var parsed) ? Math.Clamp(parsed, 0, 99) : 1;
        _showBulkSellConfirmation = false;
    }

    private static string GetBulkSellItemClass(BulkSellPlanItem item)
    {
        return item.IsSafe ? "bulk-sell-item safe-sell-item" : "bulk-sell-item unsafe-sell-item";
    }

    private static string FormatSellType(InventorySellItemType type)
    {
        return type switch
        {
            InventorySellItemType.Egg => "Egg",
            InventorySellItemType.Food => "Food",
            InventorySellItemType.HatchingPotion => "Hatching potion",
            _ => type.ToString()
        };
    }

    private static string FormatFoodPriority(PetFoodRecommendationPriority priority)
    {
        return priority switch
        {
            PetFoodRecommendationPriority.Favorite => "favorite",
            PetFoodRecommendationPriority.Generic => "generic",
            _ => "other"
        };
    }

    private static string FormatName(string? value, string emptyLabel)
    {
        return string.IsNullOrWhiteSpace(value) ? emptyLabel : PetsMountsCatalog.ToReadableName(value);
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Account data is up to date",
            SnapshotFreshnessState.Stale => "Account data may need refresh",
            SnapshotFreshnessState.Expired => "Account data needs refresh",
            _ => "No saved account data"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private void ShowFeedback(InventoryActionResult result)
    {
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_petsMountsPageModule is not null)
        {
            await _petsMountsPageModule.DisposeAsync();
        }
    }

    private sealed record BulkSellPlanItem(
        InventorySellItemType Type,
        string Key,
        int OwnedCount,
        int SellCount,
        bool IsSafe,
        string Explanation);

    private sealed record HatchQueueItem(
        string EggKey,
        string HatchingPotionKey);

    private sealed record HatchQueueAllocation(
        string EggKey,
        string HatchingPotionKey,
        string PetKey,
        string PetDisplayName,
        bool IsSupported,
        bool IsOwned,
        bool IsDuplicate,
        int EggAvailableCount,
        int EggRemainingBeforeItem,
        int PlannedEggConsumption,
        int PotionAvailableCount,
        int PotionRemainingBeforeItem,
        int PlannedPotionConsumption)
    {
        public bool CanExecuteHatch =>
            IsSupported
            && !IsOwned
            && !IsDuplicate
            && PlannedEggConsumption > 0
            && PlannedPotionConsumption > 0;

        public int EggReservedBeforeItem => Math.Max(0, EggAvailableCount - EggRemainingBeforeItem);

        public int PotionReservedBeforeItem => Math.Max(0, PotionAvailableCount - PotionRemainingBeforeItem);

        public string OwnershipStatus => IsOwned ? "Owned pet" : "Missing pet";
    }

    private sealed record MissingMountPlan(
        bool CanPlan,
        string? PetKey,
        string Message);

    private sealed record GroupFeedQueueCandidate(string PetKey);

    private sealed record CreatureTypeFilterOption(
        string Key,
        string DisplayName);
}
