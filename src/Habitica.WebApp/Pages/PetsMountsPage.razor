    private static decimal GetVisibleGrowthPercent(PetGrowthPlan plan)
    {
        return plan.UnavailableReason is PetGrowthUnavailableReason.UnknownPet
            or PetGrowthUnavailableReason.PetNotOwned
            or PetGrowthUnavailableReason.NonGrowablePet
            ? 0m
            : plan.CurrentProgressPercent;
    }

    private static string FormatGrowthStatus(PetGrowthPlan plan)
    {
        return plan.UnavailableReason switch
        {
            PetGrowthUnavailableReason.UnknownPet => "No mount progress",
            PetGrowthUnavailableReason.PetNotOwned => "No mount progress",
            PetGrowthUnavailableReason.NonGrowablePet => "No mount progress",
            PetGrowthUnavailableReason.MountAlreadyOwned => "Mount owned",
            PetGrowthUnavailableReason.AlreadyMountReady => "Ready for mount",
            _ => $"{FormatProgressPercent(plan.CurrentProgressPercent)}% grown, {FormatProgressPercent(plan.RemainingProgressPercent)}% to mount"
        };
    }

    private static string FormatGrowthFoodPlan(PetGrowthPlan plan)
    {
        if (plan.UnavailableReason is PetGrowthUnavailableReason.MountAlreadyOwned)
        {
            return "Matching mount already owned.";
        }

        if (plan.UnavailableReason is PetGrowthUnavailableReason.AlreadyMountReady)
        {
            return "Pet already has enough progress for mount conversion.";
        }

        if (!plan.CanGrowIntoMount)
        {
            return "No feedable mount progress is available for this pet.";
        }

        if (plan.FeedPlan.Count == 0)
        {
            return "No food available for mount growth.";
        }

        var foodSummary = string.Join(
            ", ",
            plan.FeedPlan.Select(static item => $"{item.DisplayName} x {item.Amount}"));
        return plan.CanCompleteWithAvailableFood
            ? $"Best available plan: {foodSummary}."
            : $"Available plan: {foodSummary}; still needs {FormatProgressPercent(plan.MissingProgressAfterPlanPercent)}% progress.";
    }

    private static string FormatProgressPercent(decimal value)
