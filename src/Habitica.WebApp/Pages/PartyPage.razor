        };
    }

    private static PartyStatRow BuildStatRow(
        string label,
        string name,
        PartyMemberStatBreakdownSnapshot stats,
        int? level,
        Func<PartyStatSectionSnapshot, decimal?> selector)
    {
        var allocated = stats.BaseAllocated is null ? null : selector(stats.BaseAllocated);
        var baseValue = stats.LevelBonus is null ? CalculateLevelBase(level) : selector(stats.LevelBonus);
        var equipment = stats.Gear is null ? null : selector(stats.Gear);
        var buffs = stats.Buffs is null ? null : selector(stats.Buffs);
        var total = stats.Total is null ? null : selector(stats.Total);
        var effective = total ?? SumCompleteStats(baseValue, allocated, equipment, buffs);

        return new PartyStatRow(label, name, baseValue, allocated, equipment, buffs, effective);
    }

    private static decimal? CalculateLevelBase(int? level)
    {
        return level is null ? null : Math.Floor(Math.Min(level.Value, 100) / 2m);
    }

    private static decimal? SumCompleteStats(params decimal?[] values)
    {
        return values.All(static value => value is not null)
            ? values.Sum(static value => value ?? 0m)
            : null;
    }

