@page "/party"
@implements IDisposable
@implements IAsyncDisposable
@inject IAppSessionController SessionController
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@using System.Globalization
@using Habitica.Domain.Party
@using Habitica.WebApp.Formatting

<PageTitle>@(QuestWorkspaceOnly ? "Quests" : "Party")</PageTitle>

<div class="party-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">@(QuestWorkspaceOnly ? "Quest workspace" : "Party overview")</p>
            <h1>@(QuestWorkspaceOnly ? "Quests" : "Party status")</h1>
            <p class="panel-copy">
                @(QuestWorkspaceOnly
                    ? "Review active quest state, shared scroll availability, queue votes, and recent completions."
                    : "Review the latest saved party summary, CRON timing, and member status without changing party data.")
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot?.PartyId is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            @if (SessionController.State.UserSnapshot is null && SessionController.State.IsAuthenticated)
            {
                <span>No saved account data is available yet. Refresh the account to load current @(QuestWorkspaceOnly ? "quest" : "party") data.</span>
            }
            else if (SessionController.State.UserSnapshot is null)
            {
                <span>No saved account data is available on this device yet. Sign in to load @(QuestWorkspaceOnly ? "quest" : "party") data.</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
            else if (!SessionController.State.IsAuthenticated)
            {
                <span>Your saved account data does not show an active party. Sign in to refresh account and @(QuestWorkspaceOnly ? "quest" : "party") data.</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
            else
            {
                <span>Your saved account data does not show an active party.</span>
            }
        </MudAlert>
    }
    else if (SessionController.State.PartySnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            @if (SessionController.State.IsAuthenticated)
            {
                <span>No saved party data is available yet. Refresh the account to load the current @(QuestWorkspaceOnly ? "quest workspace" : "party overview").</span>
            }
            else
            {
                <span>No saved party data is available on this device yet. Sign in to load the current @(QuestWorkspaceOnly ? "quest workspace" : "party overview").</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.PartySnapshot;
        var members = GetDisplayMembers(snapshot);
        var quest = snapshot.Quest;
        var management = SessionController.State.PartyQuestQueue?.Management;

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.PartyFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.PartyFreshness)
        </MudAlert>

        @if (!QuestWorkspaceOnly)
        {
        <section class="party-detail-grid">
            <article class="card-surface dashboard-panel">
                <p class="section-label">Summary</p>
                <h2>@snapshot.Name</h2>
                <div class="panel-copy party-summary-markdown">@SafeMarkdownRenderer.Render(snapshot.Summary)</div>
            </article>

            <article class="card-surface dashboard-panel party-quest-summary-panel">
                <p class="section-label">Quests</p>
                <h2>@(quest is null ? "No active quest" : GetQuestName(quest))</h2>
                <p class="panel-copy">@GetQuestStateLabel(quest). Open the quest workspace for active quest details, scroll availability, queue votes, and recent completions.</p>
                <a class="secondary-action-button compact" href="/quests">Open quests</a>
            </article>
        </section>
        }
        else
        {
        <section class="party-detail-grid">
            <article class="card-surface dashboard-panel party-quest-panel">
                <div class="party-section-head">
                    <div>
                        <p class="section-label">@GetQuestSectionLabel(quest)</p>
                        <h2>@(quest is null ? "No active quest" : GetQuestName(quest))</h2>
                    </div>
                    @if (quest?.IsActive == true)
                    {
                        <label class="checkbox-row compact party-toggle">
                            <input checked="@SessionController.State.IncludeStalePartyMembersInQuestForecasts"
                                   type="checkbox"
                                   @onchange="HandleIncludeStaleChangedAsync" />
                            <span>Include stale members</span>
                        </label>
                    }
                </div>

                @if (quest is null)
                {
                    <p class="panel-copy">No active quest is saved for this party yet.</p>
                }
                else
                {
                    var appliedProgress = GetAppliedProgress(quest);
                    var pendingUserProgress = GetPendingUserProgress(quest);
                    var pendingPartyProgress = GetPendingPartyProgress(quest);
                    var estimatedPostCronProgress = GetEstimatedPostCronProgress(quest);
                    var startableQuestEntry = GetStartableSelectedQuestEntry(quest);
                    var isAwaitingResponses = IsQuestAwaitingResponses(quest);
                    var currentQuestResponse = GetCurrentUserQuestParticipationStatus(members);
                    var activeQuestMetadata = ResolveActiveQuestMetadata(quest);
                    var activeQuestParticipants = GetQuestResponseMembers(members, PartyQuestParticipationStatus.Accepted);

                    <article class="party-quest-card active-quest-card">
                        <div class="party-quest-card-head">
                            <div class="habitica-quest-identity">
                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Quest(quest.Key, GetQuestName(quest), HabiticaImageSize.Large)" Loading="eager" />
                                <div>
                                    <span class="dashboard-stat-label">@GetQuestTypeLabel(quest)</span>
                                    <strong>@GetQuestName(quest)</strong>
                                    @if (isAwaitingResponses)
                                    {
                                        <div class="dashboard-stat-note party-summary-markdown party-quest-description">
                                            @SafeMarkdownRenderer.Render(quest.Description, "Quest description is not available yet.")
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="party-quest-card-actions">
                                <MudButton Href="https://habitica.com/party" Target="_blank" Variant="Variant.Outlined">Open in Habitica</MudButton>
                                @if (startableQuestEntry is not null)
                                {
                                    <MudButton Color="Color.Primary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => StartSelectedQuestAsync(startableQuestEntry.QueueItemId))" Variant="Variant.Filled">
                                        Start quest
                                    </MudButton>
                                }
                                <MudButton Disabled="@SessionController.State.IsBusy" OnClick="RefreshPartyQuestStateAsync" Variant="Variant.Text">Refresh quest state</MudButton>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_startQuestError))
                        {
                            <MudAlert Dense="true" Severity="Severity.Error" Variant="Variant.Outlined">
                                @_startQuestError
                            </MudAlert>
                        }

                        <dl class="dashboard-definition-list party-quest-definition-list compact-definition-list">
                            @if (!isAwaitingResponses)
                            {
                                <div>
                                    <dt>@activeQuestMetadata.ActorLabel</dt>
                                    <dd>
                                        @if (!string.IsNullOrWhiteSpace(activeQuestMetadata.ActorDisplayName))
                                        {
                                            @if (!string.IsNullOrWhiteSpace(activeQuestMetadata.ActorUserId))
                                            {
                                                <button class="inline-link-button" type="button" @onclick="@(() => FocusMemberDetailsAsync(activeQuestMetadata.ActorUserId!))">
                                                    @activeQuestMetadata.ActorDisplayName
                                                </button>
                                            }
                                            else
                                            {
                                                @activeQuestMetadata.ActorDisplayName
                                            }
                                        }
                                        else
                                        {
                                            <span>Unavailable</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt>Started</dt>
                                    <dd>@FormatQuestStartedAt(activeQuestMetadata.StartedAtUtc)</dd>
                                </div>
                            }
                            <div>
                                <dt>@(isAwaitingResponses ? "Participant status" : "Participants")</dt>
                                <dd>@(isAwaitingResponses ? GetParticipationSummaryLabel(quest) : quest.ParticipantCount)</dd>
                            </div>
                        </dl>

                        @if (isAwaitingResponses)
                        {
                            @RenderRewards(quest.Rewards)
                        }
                        else
                        {
                            <div class="party-quest-card-actions">
                                <button class="secondary-action-button compact" type="button" data-testid="toggle-active-quest-details" @onclick="ToggleActiveQuestDetails">
                                    @(_activeQuestDetailsExpanded ? "Hide details" : quest.Rewards.Count > 0 ? "Show details and rewards" : "Show details")
                                </button>
                                <button class="secondary-action-button compact" type="button" data-testid="toggle-active-quest-participants" @onclick="ToggleActiveQuestParticipants">
                                    @(_activeQuestParticipantsExpanded ? "Hide participants" : "Show participants")
                                </button>
                            </div>

                            @if (_activeQuestDetailsExpanded)
                            {
                                <div data-testid="active-quest-details">
                                    <div class="dashboard-stat-note party-summary-markdown party-quest-description">
                                        @SafeMarkdownRenderer.Render(quest.Description, "Quest description is not available yet.")
                                    </div>
                                    @RenderRewards(quest.Rewards)
                                </div>
                            }

                            @if (_activeQuestParticipantsExpanded)
                            {
                                <div data-testid="active-quest-participants">
                                    @if (activeQuestParticipants.Count == 0)
                                    {
                                        <p class="dashboard-stat-note">Participant details are unavailable.</p>
                                    }
                                    else
                                    {
                                        <ul class="party-quest-response-list">
                                            @foreach (var member in activeQuestParticipants)
                                            {
                                                <li>
                                                    <button class="inline-link-button" type="button" @onclick="@(() => FocusMemberDetailsAsync(member.MemberId))">
                                                        @member.DisplayName
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            }
                        }
                    </article>

                    @if (isAwaitingResponses)
                    {
                        @if (currentQuestResponse == PartyQuestParticipationStatus.Pending)
                        {
                            <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                                You have not responded to this quest invitation.
                                <MudButton Color="Color.Primary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RespondToQuestInvitationAsync(true))" Variant="Variant.Filled">
                                    Accept
                                </MudButton>
                                <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RespondToQuestInvitationAsync(false))" Variant="Variant.Outlined">
                                    Reject
                                </MudButton>
                            </MudAlert>
                        }

                        <div class="party-quest-response-grid">
                            @RenderQuestResponseGroup("Accepted", members, PartyQuestParticipationStatus.Accepted)
                            @RenderQuestResponseGroup("Pending", members, PartyQuestParticipationStatus.Pending)
                            @RenderQuestResponseGroup("Rejected", members, PartyQuestParticipationStatus.Rejected)
                        </div>

                        @if (HasQuestResponseMembers(members, PartyQuestParticipationStatus.Unknown))
                        {
                            <div class="party-quest-response-grid compact">
                                @RenderQuestResponseGroup("Unknown", members, PartyQuestParticipationStatus.Unknown)
                            </div>
                        }
                    }
                    else
                    {
                        <div class="party-quest-metric-grid">
                            <article class="dashboard-stat-card">
                                <span class="dashboard-stat-label">Current progress</span>
                                <strong>@FormatQuestMetric(appliedProgress)</strong>
                                <span class="dashboard-stat-note">@appliedProgress?.Label</span>
                            </article>

                            <article class="dashboard-stat-card">
                                <span class="dashboard-stat-label">Your pending progress</span>
                                <strong>@FormatQuestMetric(pendingUserProgress)</strong>
                                <span class="dashboard-stat-note">@pendingUserProgress?.Label</span>
                            </article>

                            <article class="dashboard-stat-card">
                                <span class="dashboard-stat-label">Pending party progress</span>
                                <strong>@FormatQuestMetric(pendingPartyProgress)</strong>
                                <span class="dashboard-stat-note">@pendingPartyProgress?.Label</span>
                            </article>

                            <article class="dashboard-stat-card">
                                <span class="dashboard-stat-label">Estimated post-CRON</span>
                                <strong>@FormatQuestMetric(estimatedPostCronProgress)</strong>
                                <span class="dashboard-stat-note">@estimatedPostCronProgress?.Label</span>
                            </article>
                        </div>

                        <dl class="dashboard-definition-list party-quest-definition-list">
                            @if (quest.PendingPartyDamage is not null)
                            {
                                <div>
                                    <dt>Pending party damage</dt>
                                    <dd>@FormatDecimal(quest.PendingPartyDamage.Value)</dd>
                                </div>
                            }
                            <div>
                                <dt>Expected finish</dt>
                                <dd>@FormatExpectedFinish(quest.CompletionEstimate)</dd>
                            </div>
                            @if (HasMeaningfulCompletionTiming(quest.CompletionEstimate)
                                && !string.IsNullOrWhiteSpace(quest.CompletionEstimate?.FinishingMemberDisplayName))
                            {
                                <div>
                                    <dt>Finishing member</dt>
                                    <dd>
                                        @if (quest.CompletionEstimate?.FinishingMemberId is { } finishingMemberId)
                                        {
                                            <button class="inline-link-button" type="button" @onclick="@(() => FocusMemberDetailsAsync(finishingMemberId))">
                                                @quest.CompletionEstimate!.FinishingMemberDisplayName
                                            </button>
                                        }
                                        else
                                        {
                                            @quest.CompletionEstimate?.FinishingMemberDisplayName
                                        }
                                    </dd>
                                </div>
                            }
                            @if (HasMeaningfulTimingConfidence(quest.CompletionEstimate))
                            {
                                <div>
                                    <dt>Timing confidence</dt>
                                    <dd>@FormatEstimateConfidence(quest.CompletionEstimate)</dd>
                                </div>
                            }
                        </dl>

                        @if (HasMeaningfulCompletionTiming(quest.CompletionEstimate))
                        {
                            <MudAlert Class="quest-estimate-alert" Dense="true" Severity="@GetEstimateSeverity(quest.CompletionEstimate!)" Variant="Variant.Outlined">
                                @FormatEstimateSummary(quest.CompletionEstimate!)
                            </MudAlert>
                        }
                    }
                }
            </article>
        </section>
        }

        @if (QuestWorkspaceOnly)
        {
        @if (!SessionController.State.IsPartySyncEnabled)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                Shared party sync is disabled for this app build.
            </MudAlert>
        }
        else
        {
        <section class="card-surface dashboard-panel party-quest-workspace">
            <div class="party-section-head">
                <div>
                    <p class="section-label">Party quest queue</p>
                    <h2>Shared quest planning</h2>
                </div>
                <div class="party-member-actions">
                    <label class="checkbox-row compact party-toggle">
                        <input checked="@_hideNotOwnedQuests"
                               data-testid="hide-not-owned-quests"
                               type="checkbox"
                               @onchange="eventArgs => _hideNotOwnedQuests = eventArgs.Value is true" />
                        <span>Hide quests I do not own</span>
                    </label>
                    <MudButton Disabled="@SessionController.State.IsBusy" OnClick="RefreshPartyQuestStateAsync" Variant="Variant.Outlined">
                        Refresh queue
                    </MudButton>
                </div>
            </div>

            @{
                var questState = SessionController.State.PartyQuestQueue;
                var visibleQueueEntries = FilterVisibleQueueEntries(GetOrderedQueueEntries(questState)).ToArray();
                var nextQuestEntry = visibleQueueEntries.FirstOrDefault(IsNextQuestEntry);
                var queueEntries = visibleQueueEntries.Where(entry => !IsNextQuestEntry(entry)).ToArray();
                var poolEntries = FilterVisiblePoolEntries(questState?.QuestPool ?? Array.Empty<PartyQuestPoolEntry>()).ToArray();
                var groupedPoolEntries = FilterPoolGroupsBySearch(GetGroupedPoolEntries(poolEntries)).ToArray();
                var recentEntries = questState?.RecentlyCompleted ?? Array.Empty<PartyRecentlyCompletedQuest>();
            }

            @if (nextQuestEntry is not null)
            {
                <div class="party-quest-section">
                    <div class="party-section-head compact-head">
                        <h3>Next Quest</h3>
                        <span class="ui-pill count-pill">@GetNextQuestStatusLabel(nextQuestEntry)</span>
                    </div>
                    <div class="party-quest-card-list">
                        <article class="@GetQueueCardClass(nextQuestEntry)">
                            <div class="party-quest-card-head">
                                <div class="habitica-quest-identity compact">
                                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Quest(nextQuestEntry.QuestKey, nextQuestEntry.QuestName, HabiticaImageSize.Small)" />
                                    <div>
                                        <span class="dashboard-stat-label">@GetQueueStatusLabel(nextQuestEntry)</span>
                                        <strong>@nextQuestEntry.QuestName</strong>
                                        <span class="dashboard-stat-note">Owner: @nextQuestEntry.OwnerDisplayName</span>
                                    </div>
                                </div>
                                <span class="ui-pill count-pill">@nextQuestEntry.VoteCount votes</span>
                            </div>

                            <dl class="dashboard-definition-list compact-definition-list">
                                <div>
                                    <dt>Type</dt>
                                    <dd>@ResolveQuestType(nextQuestEntry.QuestKey)</dd>
                                </div>
                                <div>
                                    <dt>Recently completed</dt>
                                    <dd>@GetRecentlyCompletedLabel(nextQuestEntry.QuestKey, recentEntries)</dd>
                                </div>
                            </dl>

                            @RenderRewards(nextQuestEntry.Rewards)
                            @RenderVoters(nextQuestEntry.Votes)

                            <div class="party-quest-card-actions">
                                @{
                                    var nextInviteDisabledReason = GetInvitePartyDisabledReason(nextQuestEntry);
                                }
                                <MudButton Color="Color.Secondary" Disabled="@(nextInviteDisabledReason is not null || SessionController.State.IsBusy)" OnClick="@(() => InvitePartyAsync(nextQuestEntry.QueueItemId, nextQuestEntry.Version))" Variant="Variant.Outlined">
                                    Invite party
                                </MudButton>
                                @if (nextInviteDisabledReason is not null)
                                {
                                    <span class="dashboard-stat-note">@nextInviteDisabledReason</span>
                                }
                                @if (CanManageQueueEntry(nextQuestEntry))
                                {
                                    @if (nextQuestEntry.Status == PartyQuestQueueStatus.Selected)
                                    {
                                        <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RequeueItemAsync(nextQuestEntry.QueueItemId, nextQuestEntry.Version))" Variant="Variant.Text">
                                            Return to queue
                                        </MudButton>
                                    }
                                    @if (nextQuestEntry.Status == PartyQuestQueueStatus.Selected)
                                    {
                                        <MudButton Color="Color.Warning" Disabled="@SessionController.State.IsBusy" OnClick="@(() => SkipQueueItemAsync(nextQuestEntry.QueueItemId, nextQuestEntry.Version))" Variant="Variant.Text">
                                            Skip
                                        </MudButton>
                                    }
                                    <MudButton Color="Color.Warning" Disabled="@SessionController.State.IsBusy" OnClick="@(() => ExpireQueueItemAsync(nextQuestEntry.QueueItemId, nextQuestEntry.Version))" Variant="Variant.Text">
                                        Expire
                                    </MudButton>
                                    <MudButton Color="Color.Error" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RemoveQueueItemAsync(nextQuestEntry.QueueItemId, nextQuestEntry.Version))" Variant="Variant.Text">
                                        Remove
                                    </MudButton>
                                }
                                @if (CanMarkCompleted(nextQuestEntry))
                                {
                                    <MudButton Color="Color.Success" Disabled="@SessionController.State.IsBusy" OnClick="@(() => MarkCompletedAsync(nextQuestEntry.QueueItemId, nextQuestEntry.Version))" Variant="Variant.Text">
                                        Mark completed
                                    </MudButton>
                                }
                            </div>
                        </article>
                    </div>
                </div>
            }

            <div class="party-quest-section">
                <div class="party-section-head compact-head">
                    <h3>Party Quest Queue</h3>
                    <span class="ui-pill count-pill">@queueEntries.Length</span>
                </div>

                @if (queueEntries.Length == 0)
                {
                    <p class="panel-copy">@(_hideNotOwnedQuests ? "No owned quest queue entries are visible. Clear the owned-only filter to see other party quests." : "No shared quest queue entries are available yet. Add one of your quest scrolls from the pool below.")</p>
                }
                else
                {
                    <div class="party-quest-card-list">
                        @foreach (var entry in queueEntries)
                        {
                            <article class="@GetQueueCardClass(entry)">
                                <div class="party-quest-card-head">
                                    <div class="habitica-quest-identity compact">
                                        <HabiticaImage Asset="@HabiticaImageAssetResolver.Quest(entry.QuestKey, entry.QuestName, HabiticaImageSize.Small)" />
                                        <div>
                                            <span class="dashboard-stat-label">@entry.Status • Position @GetQueuePosition(queueEntries, entry)</span>
                                            <strong>@entry.QuestName</strong>
                                            <span class="dashboard-stat-note">Owner: @entry.OwnerDisplayName</span>
                                        </div>
                                    </div>
                                    <span class="ui-pill count-pill">@entry.VoteCount votes</span>
                                </div>

                                <dl class="dashboard-definition-list compact-definition-list">
                                    <div>
                                        <dt>Type</dt>
                                        <dd>@ResolveQuestType(entry.QuestKey)</dd>
                                    </div>
                                    <div>
                                        <dt>Queue state</dt>
                                        <dd>@GetQueueStatusLabel(entry)</dd>
                                    </div>
                                    <div>
                                        <dt>Recently completed</dt>
                                        <dd>@GetRecentlyCompletedLabel(entry.QuestKey, recentEntries)</dd>
                                    </div>
                                </dl>

                                @RenderRewards(entry.Rewards)
                                @RenderVoters(entry.Votes)

                                <div class="party-quest-card-actions">
                                    <MudButton Color="Color.Primary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => ToggleVoteAsync(entry.QueueItemId))" Variant="Variant.Outlined">
                                        @(HasCurrentUserVote(entry) ? "Remove vote" : "Vote")
                                    </MudButton>
                                    @if (CanManageQueueEntry(entry))
                                    {
                                        <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => PinQueueItemAsync(entry.QueueItemId, entry.Version, entry.ManualPinRank is null))" Variant="Variant.Text">
                                            @(entry.ManualPinRank is null ? "Pin" : "Unpin")
                                        </MudButton>
                                        @if (entry.Status is PartyQuestQueueStatus.Queued or PartyQuestQueueStatus.Skipped or PartyQuestQueueStatus.Expired)
                                        {
                                            <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => SelectQueueItemAsync(entry.QueueItemId, entry.Version))" Variant="Variant.Text">
                                                Select
                                            </MudButton>
                                        }
                                        @if (entry.Status is PartyQuestQueueStatus.Skipped or PartyQuestQueueStatus.Expired)
                                        {
                                            <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RequeueItemAsync(entry.QueueItemId, entry.Version))" Variant="Variant.Text">
                                                Return to queue
                                            </MudButton>
                                        }
                                        @if (entry.Status is not (PartyQuestQueueStatus.Active or PartyQuestQueueStatus.Expired))
                                        {
                                            <MudButton Color="Color.Warning" Disabled="@SessionController.State.IsBusy" OnClick="@(() => ExpireQueueItemAsync(entry.QueueItemId, entry.Version))" Variant="Variant.Text">
                                                Expire
                                            </MudButton>
                                        }
                                        <MudButton Color="Color.Error" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RemoveQueueItemAsync(entry.QueueItemId, entry.Version))" Variant="Variant.Text">
                                            Remove
                                        </MudButton>
                                    }
                                    @if (CanMarkCompleted(entry))
                                    {
                                        <MudButton Color="Color.Success" Disabled="@SessionController.State.IsBusy" OnClick="@(() => MarkCompletedAsync(entry.QueueItemId, entry.Version))" Variant="Variant.Text">
                                            Mark completed
                                        </MudButton>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="party-quest-section">
                <div class="party-section-head compact-head">
                    <h3>Quest Pool</h3>
                    <div class="party-member-actions">
                        <span class="ui-pill count-pill">@FormatQuestPoolCount(groupedPoolEntries, groupedPoolEntries.Sum(static entry => entry.OwnerEntryCount))</span>
                        <button class="secondary-action-button compact" type="button" data-testid="toggle-quest-pool" @onclick="ToggleQuestPool">
                            @(_questPoolExpanded ? "Hide quest pool" : "Show quest pool")
                        </button>
                    </div>
                </div>
                <p class="panel-copy compact-copy">
                    Quest pool is open by default on this workspace. Hide it when you want to focus on the queue.
                </p>

                @if (_questPoolExpanded)
                {
                    <label class="field-row compact">
                        <span>Search quest pool</span>
                        <input aria-label="Search quest pool"
                               class="app-input"
                               data-testid="quest-pool-search"
                               placeholder="Name, reward, type, or owner"
                               @bind="_questPoolSearchText"
                               @bind:event="oninput" />
                    </label>
                }

                @if (!_questPoolExpanded)
                {
                    <p class="panel-copy">Quest pool is hidden. Use Show quest pool to browse available scrolls.</p>
                }
                else if (groupedPoolEntries.Length == 0)
                {
                    <p class="panel-copy">@(HasQuestPoolSearch() ? "No quests match this search." : _hideNotOwnedQuests ? "No owned quest scrolls are visible. Clear the owned-only filter to see other party scrolls." : "No shared quest scroll availability has been published yet. Refresh after syncing inventory to publish your owned quest scrolls.")</p>
                }
                else
                {
                    <div class="party-quest-card-grid" data-testid="quest-pool-grid">
                        @foreach (var poolEntry in groupedPoolEntries)
                        {
                            <article class="@GetPoolCardClass(poolEntry)">
                                <div class="party-quest-card-head">
                                    <div class="habitica-quest-identity compact">
                                        <HabiticaImage Asset="@HabiticaImageAssetResolver.Quest(poolEntry.QuestKey, poolEntry.QuestName, HabiticaImageSize.Small)" />
                                        <div>
                                            <span class="dashboard-stat-label">@poolEntry.QuestType</span>
                                            <strong>@poolEntry.QuestName</strong>
                                            <span class="dashboard-stat-note">Available from @poolEntry.OwnerNames</span>
                                        </div>
                                    </div>
                                    <span class="ui-pill count-pill">@FormatOwnedScrollCount(poolEntry.TotalAvailableCount)</span>
                                </div>

                                @RenderRewards(poolEntry.Rewards)

                                <div class="party-quest-card-actions">
                                    <MudButton Color="Color.Primary" Disabled="@(!poolEntry.CurrentUserCanQueue || SessionController.State.IsBusy)" OnClick="@(() => AddQuestToQueueAsync(poolEntry.QuestKey))" Variant="Variant.Outlined">
                                        Add to queue
                                    </MudButton>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="party-quest-section">
                <div class="party-section-head compact-head">
                    <h3>Recently Completed</h3>
                    <span class="ui-pill count-pill">@recentEntries.Count</span>
                </div>

                @if (recentEntries.Count == 0)
                {
                    <p class="panel-copy">Completed shared quest history appears here after manual completion or automatic quest-finish detection.</p>
                }
                else
                {
                    <div class="party-quest-card-grid">
                        @foreach (var recent in recentEntries.OrderByDescending(entry => entry.CompletedAtUtc).Take(8))
                        {
                            <article class="party-quest-card neutral-quest-card">
                                <div class="party-quest-card-head">
                                    <div class="habitica-quest-identity compact">
                                        <HabiticaImage Asset="@HabiticaImageAssetResolver.Quest(recent.QuestKey, recent.QuestName, HabiticaImageSize.Small)" />
                                        <div>
                                            <span class="dashboard-stat-label">Completed @FormatDateTime(recent.CompletedAtUtc)</span>
                                            <strong>@recent.QuestName</strong>
                                            <span class="dashboard-stat-note">@GetOwnerLabel(recent.OwnerDisplayName)</span>
                                            <span class="dashboard-stat-note">@GetCompletionSourceLabel(recent)</span>
                                        </div>
                                    </div>
                                    @if (recent.ParticipantsCount is not null)
                                    {
                                        <span class="ui-pill count-pill">@recent.ParticipantsCount participants</span>
                                    }
                                </div>
                                @RenderRewards(recent.Rewards)
                                @if (CanManageRecentlyCompleted())
                                {
                                    <div class="party-quest-card-actions">
                                        <MudButton Color="Color.Error" Disabled="@SessionController.State.IsBusy" OnClick="@(() => RemoveRecentlyCompletedQuestAsync(recent.QuestKey, recent.CompletedAtUtc))" Variant="Variant.Text">
                                            Remove
                                        </MudButton>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </div>
        </section>
        }
        }

        @if (!QuestWorkspaceOnly)
