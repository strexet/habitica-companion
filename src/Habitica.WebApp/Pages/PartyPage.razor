        return entries.Where(entry =>
            entry.QuestName.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || entry.Rewards.Any(reward => reward.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            || entry.QuestType.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || entry.OwnerNames.Contains(searchText, StringComparison.OrdinalIgnoreCase));
