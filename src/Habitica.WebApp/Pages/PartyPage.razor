                                                                    <small>@row.Name</small>
                                                                </th>
                                                                <td><strong>@FormatStat(row.Effective)</strong></td>
                                                                <td>@FormatSignedStat(row.Buffs)</td>
                                                                <td>@FormatSignedStat(row.Equipment)</td>
                                                                <td>@FormatStat(row.Allocated)</td>
                                                                <td>@FormatStat(row.Base)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="party-member-stats">
                                            <div class="party-stat-section">
