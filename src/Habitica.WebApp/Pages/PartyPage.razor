    private IEnumerable<PartyQuestQueueEntry> GetOrderedQueueEntries(PartyQuestQueueSnapshot? questState)
    {
        if (questState is null)
        {
            return Array.Empty<PartyQuestQueueEntry>();
        }

        return questState.Queue
            .Where(static entry => entry.Status is PartyQuestQueueStatus.Queued or PartyQuestQueueStatus.Selected or PartyQuestQueueStatus.Active or PartyQuestQueueStatus.Skipped or PartyQuestQueueStatus.Expired)
            .OrderBy(entry => GetQueueStatusSortOrder(entry.Status))
            .ThenBy(entry => entry.ManualPinRank ?? int.MaxValue)
            .ThenByDescending(entry => CalculateQueuePriority(entry, questState.RecentlyCompleted))
            .ThenBy(entry => entry.CreatedAtUtc);
    }

    private static int GetQueueStatusSortOrder(PartyQuestQueueStatus status)
    {
        return status switch
        {
            PartyQuestQueueStatus.Active => 0,
            PartyQuestQueueStatus.Selected => 1,
            PartyQuestQueueStatus.Queued => 2,
            PartyQuestQueueStatus.Skipped => 3,
            PartyQuestQueueStatus.Expired => 4,
            _ => 9
        };
