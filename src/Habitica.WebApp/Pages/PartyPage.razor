                                            {
                                                <span class="party-login-marker average-marker" style="@BuildTimeMarkerStyle(member.AverageCronTime.Value)" title="@FormatLoginRhythmTitle(member)"></span>
                                            }
                                            @if (member.CronState == PartyCronState.CronedToday && member.LastCronUtc is not null)
                                            {
                                                <span class="party-login-marker last-marker" style="@BuildTimeMarkerStyle(member.LastCronUtc.Value.ToLocalTime().TimeOfDay)" title="Checked in today at @FormatTime(member.LastCronUtc.Value.ToLocalTime().TimeOfDay)"></span>
                                            }
                                        </div>
                                        <div class="party-login-axis" aria-hidden="true">
                                            <span>Night</span>
                                            <span>Morning</span>
                                            <span>Afternoon</span>
                                            <span>Evening</span>
