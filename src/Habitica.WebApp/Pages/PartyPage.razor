    private static string GetRecentlyCompletedLabel(string questKey, IReadOnlyList<PartyRecentlyCompletedQuest> recentlyCompleted)
    {
        var latest = recentlyCompleted
            .Where(entry => string.Equals(entry.QuestKey, questKey, StringComparison.Ordinal))
            .OrderByDescending(entry => entry.CompletedAtUtc)
            .FirstOrDefault();
        if (latest is null)
        {
            return "No recent completion";
        }

        var days = Math.Max(0, (int)Math.Round((DateTimeOffset.UtcNow - latest.CompletedAtUtc).TotalDays));
        return days == 0 ? "Completed today" : $"Completed {days} day(s) ago";
    }

    private static string GetOwnerLabel(string? ownerDisplayName)
    {
        return string.IsNullOrWhiteSpace(ownerDisplayName) ? "Owner unknown" : $"Owner: {ownerDisplayName}";
    }

    private static string GetCompletionSourceLabel(PartyRecentlyCompletedQuest recent)
    {
        if (string.Equals(recent.CompletionSource, "auto", StringComparison.Ordinal))
        {
            return string.IsNullOrWhiteSpace(recent.CompletedByDisplayName)
                ? "Auto-detected"
                : $"Auto-detected by {recent.CompletedByDisplayName}";
        }

        return string.IsNullOrWhiteSpace(recent.CompletedByDisplayName)
            ? "Marked manually"
            : $"Marked manually by {recent.CompletedByDisplayName}";
    }

    private RenderFragment RenderRewards(IReadOnlyList<string> rewards) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "quest-reward-list");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "dashboard-stat-label");
        builder.AddContent(sequence++, "Rewards");
        builder.CloseElement();

        if (rewards.Count == 0)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
            builder.AddContent(sequence++, "Reward details are not available yet.");
            builder.CloseElement();
        }
        else
        {
