    private IEnumerable<PartyQuestQueueEntry> GetOrderedQueueEntries(PartyQuestQueueSnapshot? questState)
    {
        if (questState is null)
        {
            return Array.Empty<PartyQuestQueueEntry>();
        }

        return questState.Queue
            .Where(static entry => entry.Status is PartyQuestQueueStatus.Queued or PartyQuestQueueStatus.Selected or PartyQuestQueueStatus.InviteSent or PartyQuestQueueStatus.Active)
            .OrderByDescending(entry => CalculateQueuePriority(entry, questState.RecentlyCompleted))
            .ThenBy(entry => entry.CreatedAtUtc);
    }

    private static decimal CalculateQueuePriority(PartyQuestQueueEntry entry, IReadOnlyList<PartyRecentlyCompletedQuest> recentlyCompleted)
    {
        var hoursInQueue = Math.Min(72m, (decimal)Math.Max(0d, (DateTimeOffset.UtcNow - entry.CreatedAtUtc).TotalHours));
        var readinessBonus = entry.OwnerReady ? 50m : 0m;
        return entry.VoteCount * 1000m + readinessBonus + hoursInQueue - GetRecentlyCompletedPenalty(entry.QuestKey, recentlyCompleted);
    }

    private static decimal GetRecentlyCompletedPenalty(string questKey, IReadOnlyList<PartyRecentlyCompletedQuest> recentlyCompleted)
    {
        var latest = recentlyCompleted
            .Where(entry => string.Equals(entry.QuestKey, questKey, StringComparison.Ordinal))
            .OrderByDescending(entry => entry.CompletedAtUtc)
            .FirstOrDefault();
        if (latest is null)
        {
            return 0m;
        }

        var age = DateTimeOffset.UtcNow - latest.CompletedAtUtc;
        if (age.TotalDays <= 7)
        {
            return 300m;
        }

        return age.TotalDays <= 30 ? 150m : 0m;
    }

    private static int GetQueuePosition(IReadOnlyList<PartyQuestQueueEntry> orderedEntries, PartyQuestQueueEntry entry)
    {
        for (var index = 0; index < orderedEntries.Count; index++)
        {
            if (string.Equals(orderedEntries[index].QueueItemId, entry.QueueItemId, StringComparison.Ordinal))
            {
                return index + 1;
            }
        }

        return entry.SortOrder;
    }

