    private IEnumerable<QuestPoolGroup> GetGroupedPoolEntries(IReadOnlyList<PartyQuestPoolEntry> entries)
    {
        return entries
            .GroupBy(entry => entry.QuestKey, StringComparer.Ordinal)
            .Select(group =>
            {
                var orderedEntries = group
                    .OrderBy(entry => entry.OwnerDisplayName, StringComparer.OrdinalIgnoreCase)
                    .ToArray();
                var first = orderedEntries.First();
                var ownerNames = orderedEntries
                    .Select(static entry => entry.OwnerDisplayName)
                    .Where(static owner => !string.IsNullOrWhiteSpace(owner))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(static owner => owner, StringComparer.OrdinalIgnoreCase)
                    .ToArray();
                var rewards = orderedEntries.FirstOrDefault(static entry => entry.Rewards.Count > 0)?.Rewards
                    ?? Array.Empty<string>();

                return new QuestPoolGroup(
                    first.QuestKey,
                    first.QuestName,
                    first.QuestType,
                    string.Join(", ", ownerNames),
                    orderedEntries.Sum(static entry => entry.AvailableCount),
                    orderedEntries.Any(entry => IsCurrentUser(entry.OwnerUserId)),
                    orderedEntries.Length,
                    rewards);
            })
            .OrderBy(static entry => entry.QuestName, StringComparer.OrdinalIgnoreCase);
    }

    private IEnumerable<QuestPoolGroup> FilterPoolGroupsBySearch(IEnumerable<QuestPoolGroup> entries)
