            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "ui-pill reward-pill");
                builder.AddContent(sequence++, reward);
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };

