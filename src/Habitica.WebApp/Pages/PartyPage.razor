            || management?.CurrentUserIsOfficer == true
            || IsCurrentUserPartyLeader()
            || SessionController.State.IsAdmin;
    }

    private string? GetInvitePartyDisabledReason(PartyQuestQueueEntry entry)
    {
        if (SessionController.State.PartyFreshness != SnapshotFreshnessState.Fresh)
        {
            return "Refresh party data before inviting.";
        }

        if (!IsCurrentUser(entry.OwnerUserId))
        {
            return "Only the quest owner can invite.";
        }

        if (entry.Status is not PartyQuestQueueStatus.Selected)
        {
            return "Select the quest as Next Quest before inviting.";
        }

        if (HasPartyQuestInHabitica())
        {
            return "Resolve the current Habitica quest before inviting another.";
        }

        return null;
    }

