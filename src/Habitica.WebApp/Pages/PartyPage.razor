    private static string FormatFriendlyDateTime(DateTimeOffset utcTimestamp)
    {
        var local = utcTimestamp.ToLocalTime();
        var today = DateTimeOffset.Now.Date;
        if (local.Date == today)
        {
            return $"Today around {local:HH:mm}";
        }

        if (local.Date == today.AddDays(1))
        {
            return $"Tomorrow around {local:HH:mm}";
        }

        return $"{local:MMM d} around {local:HH:mm}";
    }

    private static string FormatFriendlyDateTimeForSentence(DateTimeOffset utcTimestamp)
    {
        var local = utcTimestamp.ToLocalTime();
        var today = DateTimeOffset.Now.Date;
        if (local.Date == today)
        {
            return $"today around {local:HH:mm}";
        }

        if (local.Date == today.AddDays(1))
        {
            return $"tomorrow around {local:HH:mm}";
        }

        return $"around {local:HH:mm} on {local:MMM d}";
    }

