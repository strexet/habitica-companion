    private static string GetRecentlyCompletedLabel(string questKey, IReadOnlyList<PartyRecentlyCompletedQuest> recentlyCompleted)
    {
        var latest = recentlyCompleted
            .Where(entry => string.Equals(entry.QuestKey, questKey, StringComparison.Ordinal))
            .OrderByDescending(entry => entry.CompletedAtUtc)
            .FirstOrDefault();
        if (latest is null)
        {
            return "No recent completion";
        }

        var days = Math.Max(0, (int)Math.Round((DateTimeOffset.UtcNow - latest.CompletedAtUtc).TotalDays));
        return days == 0 ? "Completed today" : $"Completed {days} day(s) ago";
    }

