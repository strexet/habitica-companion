        builder.OpenElement(sequence++, "details");
        builder.AddAttribute(sequence++, "class", "quest-voter-list");
        builder.OpenElement(sequence++, "summary");
        builder.AddContent(sequence++, votes.Count == 1 ? "1 vote" : $"{votes.Count} votes");
