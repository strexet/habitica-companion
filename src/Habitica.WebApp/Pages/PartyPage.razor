        var hasStarter = !string.IsNullOrWhiteSpace(quest.StarterUserId)
            || !string.IsNullOrWhiteSpace(quest.StarterDisplayName);
        var actorUserId = hasStarter
            ? FirstNotBlank(quest.StarterUserId)
            : FirstNotBlank(quest.OwnerUserId, queueEntry?.OwnerUserId);
        var actorDisplayName = hasStarter
            ? FirstNotBlank(quest.StarterDisplayName)
            : FirstNotBlank(quest.OwnerDisplayName, queueEntry?.OwnerDisplayName);

        if (string.IsNullOrWhiteSpace(actorDisplayName) && !string.IsNullOrWhiteSpace(actorUserId))
        {
            actorDisplayName = ResolveDisplayName(actorUserId);
        }

        return new ActiveQuestMetadata(
            hasStarter ? "Starter" : "Owner",
            actorUserId,
            actorDisplayName,
            quest.StartedAtUtc ?? queueEntry?.StartedAtUtc);
    }

