    private RenderFragment RenderRewards(IReadOnlyList<string> rewards) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "quest-reward-list");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "dashboard-stat-label");
        builder.AddContent(sequence++, "Rewards");
        builder.CloseElement();

        if (rewards.Count == 0)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
            builder.AddContent(sequence++, "Reward metadata is not cached yet.");
            builder.CloseElement();
        }
        else
        {
            foreach (var reward in rewards.Take(6))
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "ui-pill reward-pill");
                builder.AddContent(sequence++, reward);
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    };

    private RenderFragment RenderVoters(IReadOnlyList<PartyQuestVote> votes) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "details");
        builder.AddAttribute(sequence++, "class", "quest-voter-list");
        builder.OpenElement(sequence++, "summary");
        builder.AddContent(sequence++, votes.Count == 1 ? "1 vote" : $"{votes.Count} votes");
        builder.CloseElement();
        if (votes.Count == 0)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
            builder.AddContent(sequence++, "No votes yet.");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(sequence++, "ul");
            foreach (var vote in votes)
            {
                builder.OpenElement(sequence++, "li");
                builder.AddContent(sequence++, vote.VoterDisplayName);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
    };

