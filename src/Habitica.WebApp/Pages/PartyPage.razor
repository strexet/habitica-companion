@page "/party"
@implements IDisposable
@inject IAppSessionController SessionController
@using System.Globalization
@using Habitica.Domain.Party
@using Habitica.WebApp.Formatting

<PageTitle>Party</PageTitle>

<div class="party-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Party overview</p>
            <h1>Cached party state</h1>
            <p class="panel-copy">
                Review the latest synced party summary, quest state, CRON timing, and participant details without mutating party data from this app.
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot?.PartyId is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            The cached account snapshot does not show an active party connection.
        </MudAlert>
    }
    else if (SessionController.State.PartySnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            No cached party snapshot is available yet. Refresh the account to pull the current party overview.
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.PartySnapshot;
        var members = GetDisplayMembers(snapshot);
        var quest = snapshot.Quest;

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.PartyFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.PartyFreshness)
        </MudAlert>

        <section class="party-card-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Party</span>
                <strong>@snapshot.Name</strong>
                <span class="dashboard-stat-note">@snapshot.PartyId</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Members</span>
                <strong>@snapshot.MemberCount</strong>
                <span class="dashboard-stat-note">Cached group size</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Quest</span>
                <strong>@(quest?.Key ?? "No active quest")</strong>
                <span class="dashboard-stat-note">@((quest?.IsActive ?? false) ? "Active" : "Inactive or missing")</span>
            </article>
        </section>

        <section class="party-detail-grid">
            <article class="card-surface dashboard-panel">
                <p class="section-label">Summary</p>
                <h2>Party notes</h2>
                <div class="panel-copy party-summary-markdown">@SafeMarkdownRenderer.Render(snapshot.Summary)</div>
            </article>

            <article class="card-surface dashboard-panel party-quest-panel">
                <div class="party-section-head">
                    <div>
                        <p class="section-label">Quest state</p>
                        <h2>Quest progress snapshot</h2>
                    </div>
                    <label class="checkbox-row compact party-toggle">
                        <input checked="@SessionController.State.IncludeStalePartyMembersInQuestForecasts"
                               type="checkbox"
                               @onchange="HandleIncludeStaleChangedAsync" />
                        <span>Include stale members</span>
                    </label>
                </div>

                @if (quest is null)
                {
                    <p class="panel-copy">No cached active quest state is currently available for this party.</p>
                }
                else
                {
                    var appliedProgress = GetAppliedProgress(quest);
                    var pendingUserProgress = GetPendingUserProgress(quest);
                    var pendingPartyProgress = GetPendingPartyProgress(quest);
                    var estimatedPostCronProgress = GetEstimatedPostCronProgress(quest);

                    <div class="party-quest-metric-grid">
                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Current progress</span>
                            <strong>@FormatQuestMetric(appliedProgress)</strong>
                            <span class="dashboard-stat-note">@appliedProgress?.Label</span>
                        </article>

                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Your pending progress</span>
                            <strong>@FormatQuestMetric(pendingUserProgress)</strong>
                            <span class="dashboard-stat-note">@pendingUserProgress?.Label</span>
                        </article>

                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Pending party progress</span>
                            <strong>@FormatQuestMetric(pendingPartyProgress)</strong>
                            <span class="dashboard-stat-note">@pendingPartyProgress?.Label</span>
                        </article>

                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Estimated post-CRON</span>
                            <strong>@FormatQuestMetric(estimatedPostCronProgress)</strong>
                            <span class="dashboard-stat-note">@estimatedPostCronProgress?.Label</span>
                        </article>
                    </div>

                    <dl class="dashboard-definition-list party-quest-definition-list">
                        <div>
                            <dt>Quest key</dt>
                            <dd>@quest.Key</dd>
                        </div>
                        <div>
                            <dt>Accepted</dt>
                            <dd>@quest.ParticipationSummary?.AcceptedCount</dd>
                        </div>
                        <div>
                            <dt>Pending</dt>
                            <dd>@quest.ParticipationSummary?.PendingCount</dd>
                        </div>
                        <div>
                            <dt>Rejected</dt>
                            <dd>@quest.ParticipationSummary?.RejectedCount</dd>
                        </div>
                        <div>
                            <dt>Unknown</dt>
                            <dd>@quest.ParticipationSummary?.UnknownCount</dd>
                        </div>
                        <div>
                            <dt>In Inn</dt>
                            <dd>@quest.ParticipationSummary?.InnCount</dd>
                        </div>
                        @if (quest.PendingPartyDamage is not null)
                        {
                            <div>
                                <dt>Pending party damage</dt>
                                <dd>@FormatDecimal(quest.PendingPartyDamage.Value)</dd>
                            </div>
                        }
                        <div>
                            <dt>Estimate confidence</dt>
                            <dd>@FormatEstimateConfidence(quest.CompletionEstimate)</dd>
                        </div>
                        <div>
                            <dt>Estimate range</dt>
                            <dd>@FormatCompletionRange(quest.CompletionEstimate)</dd>
                        </div>
                    </dl>

                    @if (quest.CompletionEstimate is not null)
                    {
                        <MudAlert Dense="true" Severity="@GetEstimateSeverity(quest.CompletionEstimate)" Variant="Variant.Outlined">
                            @quest.CompletionEstimate.Summary
                        </MudAlert>
                    }
                }
            </article>
        </section>

        <section class="card-surface dashboard-panel party-cron-summary">
            <div class="party-section-head">
                <div>
                    <p class="section-label">CRON summary</p>
                    <h2>Buff timing window</h2>
                </div>
                <span class="ui-pill count-pill">CRON applied @GetCronedLabel(snapshot)</span>
            </div>

            @if (snapshot.CronDashboard is null)
            {
                <p class="panel-copy">No party CRON statistics are cached yet. Refresh the account to start collecting read-only CRON history.</p>
            }
            else
            {
                <div class="party-cron-stat-grid">
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">CRON applied</span>
                        <strong>@GetCronedLabel(snapshot)</strong>
                        <span class="dashboard-stat-note">@GetCronStateBreakdown(snapshot.CronDashboard)</span>
                    </article>

                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Average best buff time</span>
                        <strong>@FormatTime(snapshot.CronDashboard.AverageBestBuffTime)</strong>
                        <span class="dashboard-stat-note">Viewer-local estimate</span>
                    </article>

                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Self-first buff time</span>
                        <strong>@FormatTime(snapshot.CronDashboard.SelfFirstBuffTime)</strong>
                        <span class="dashboard-stat-note">After your CRON when available</span>
                    </article>

                    @if (HasCronDataGaps(snapshot.CronDashboard))
                    {
                        <article class="dashboard-stat-card">
                            <span class="dashboard-stat-label">Data gaps</span>
                            <strong>@GetCronDataGapLabel(snapshot.CronDashboard)</strong>
                            <span class="dashboard-stat-note">Reduced confidence</span>
                        </article>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(snapshot.CronDashboard.SampleSizeWarning))
                {
                    <MudAlert Dense="true" Severity="Severity.Warning" Variant="Variant.Outlined">
                        @snapshot.CronDashboard.SampleSizeWarning
                    </MudAlert>
                }
            }
        </section>

        <section class="card-surface dashboard-panel party-members-panel">
            <div class="party-section-head">
                <div>
                    <p class="section-label">Members</p>
                    <h2>Party member status</h2>
                </div>
                <span class="ui-pill count-pill">@members.Count visible</span>
            </div>

            @if (members.Count == 0)
            {
                <p class="panel-copy">No cached party member data is available yet.</p>
            }
            else
            {
                <div class="party-member-list party-member-card-grid">
                    @foreach (var member in members)
                    {
                        <article class="party-member-card">
                            <div class="party-member-card-head">
                                <div>
                                    <strong>@member.DisplayName</strong>
                                    <span class="dashboard-stat-note">@member.MemberId</span>
                                </div>
                                <div class="party-member-pill-row">
                                    <span class="@GetCronStateClass(member.CronState)">@GetCronStateLabel(member.CronState)</span>
                                    <span class="ui-pill state-pill">@GetParticipationLabel(member.ParticipationStatus)</span>
                                    @if (member.IsStale)
                                    {
                                        <span class="ui-pill state-pill warning-pill">Stale</span>
                                    }
                                </div>
                            </div>

                            <div class="party-member-classline">
                                <span>@FormatClass(member.ClassName)</span>
                                <span>Level @FormatLevel(member.Level)</span>
                            </div>

                            <dl class="party-member-meta">
                                <div>
                                    <dt>Last CRON</dt>
                                    <dd>@FormatDateTime(member.LastCronUtc)</dd>
                                </div>
                                <div>
                                    <dt>Average CRON</dt>
                                    <dd>@FormatAverageCron(member)</dd>
                                </div>
                                @if (quest?.IsActive == true)
                                {
                                    <div>
                                        <dt>Pending quest</dt>
                                        <dd>@FormatMemberPendingQuest(member)</dd>
                                    </div>
                                }
                            </dl>

                            @if (member.Stats?.HasAnySection == true)
                            {
                                <div class="party-member-stats">
                                    @foreach (var statSection in GetStatSections(member))
                                    {
                                        <div class="party-stat-section">
                                            <span class="dashboard-stat-label">@statSection.Label</span>
                                            <div class="party-stat-grid">
                                                <span>STR @FormatStat(statSection.Stats.Strength)</span>
                                                <span>INT @FormatStat(statSection.Stats.Intelligence)</span>
                                                <span>CON @FormatStat(statSection.Stats.Constitution)</span>
                                                <span>PER @FormatStat(statSection.Stats.Perception)</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="card-surface dashboard-panel party-cron-graph-panel">
            <div class="party-section-head">
                <div>
                    <p class="section-label">CRON statistics</p>
                    <h2>CRONed members by local hour</h2>
                </div>
                @if (snapshot.CronDashboard is not null)
                {
                    <span class="ui-pill count-pill">@snapshot.CronDashboard.SampleCount samples</span>
                }
            </div>

            @if (snapshot.CronDashboard?.GraphPoints.Count > 0)
            {
                <div class="party-cron-legend">
                    <span><i class="legend-line today-line"></i>Today</span>
                    <span><i class="legend-line average-line"></i>Historical average</span>
                    <span>@FormatStoredDayCount(snapshot.CronDashboard.HistoryDayCount)</span>
                </div>

                <svg class="party-cron-chart" viewBox="0 0 640 220" role="img" aria-label="Party CRON statistics by local hour">
                    @{
                        var graphPoints = snapshot.CronDashboard.GraphPoints;
                        var bandPath = BuildBandPath(graphPoints, snapshot.CronDashboard.VisibleMemberCount);
                        var todayPath = BuildChartPath(graphPoints, snapshot.CronDashboard.VisibleMemberCount, static point => point.TodayCount);
                        var averagePath = BuildChartPath(graphPoints, snapshot.CronDashboard.VisibleMemberCount, static point => point.AverageCount);
                    }

                    @if (!string.IsNullOrWhiteSpace(bandPath))
                    {
                        <path d="@bandPath" class="cron-band-path" />
                    }

                    @if (!string.IsNullOrWhiteSpace(averagePath))
                    {
                        <path d="@averagePath" class="cron-average-path" />
                    }

                    @if (!string.IsNullOrWhiteSpace(todayPath))
                    {
                        <path d="@todayPath" class="cron-today-path" />
                    }

                    @foreach (var point in snapshot.CronDashboard.GraphPoints)
                    {
                        var x = ChartX(point.Hour);
                        var todayY = ChartY(point.TodayCount, snapshot.CronDashboard.VisibleMemberCount);
                        var averageY = point.AverageCount is null ? (decimal?)null : ChartY(point.AverageCount.Value, snapshot.CronDashboard.VisibleMemberCount);

                        <circle cx="@FormatChartNumber(x)" cy="@FormatChartNumber(todayY)" r="4" class="cron-point-today" />

                        @if (averageY is not null)
                        {
                            <circle cx="@FormatChartNumber(x)" cy="@FormatChartNumber(averageY.Value)" r="3" class="cron-point-average" />
                        }
                    }

                    @foreach (var tick in new[] { 0, 6, 12, 18, 23 })
                    {
                        <svg:text x="@FormatChartNumber(ChartX(tick))" y="210" class="cron-axis-label" text-anchor="@GetAxisTextAnchor(tick)">@($"{tick:00}:00")</svg:text>
                    }
                </svg>
            }
            else
            {
                <p class="panel-copy">The graph will appear after the first party member CRON timestamp is stored.</p>
            }
        </section>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Fresh local party snapshot",
            SnapshotFreshnessState.Stale => "Stale local party snapshot",
            SnapshotFreshnessState.Expired => "Expired local party snapshot",
            _ => "Missing local party snapshot"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private static IReadOnlyList<PartyMemberSnapshot> GetDisplayMembers(PartySnapshot snapshot)
    {
        if (snapshot.CronDashboard?.Members is not { Count: > 0 } enrichedMembers)
        {
            return snapshot.Members;
        }

        var enrichedById = new Dictionary<string, PartyMemberSnapshot>(StringComparer.Ordinal);
        foreach (var member in enrichedMembers)
        {
            enrichedById[member.MemberId] = member;
        }

        return snapshot.Members
            .Select(member => enrichedById.TryGetValue(member.MemberId, out var enrichedMember)
                ? enrichedMember
                : member)
            .ToArray();
    }

    private static string GetCronedLabel(PartySnapshot snapshot)
    {
        var dashboard = snapshot.CronDashboard;
        if (dashboard is null)
        {
            var cronedCount = snapshot.Members.Count(static member => member.CronState == PartyCronState.CronedToday);
            return $"{cronedCount}/{snapshot.Members.Count}";
        }

        return $"{dashboard.CronedCount}/{dashboard.VisibleMemberCount}";
    }

    private static string GetCronStateBreakdown(PartyCronDashboardSnapshot dashboard)
    {
        return $"{dashboard.AwaitingCount} awaiting, {dashboard.InnCount} in Inn, {dashboard.UnknownCount + dashboard.PossiblyStaleCount} unknown";
    }

    private static bool HasCronDataGaps(PartyCronDashboardSnapshot dashboard)
    {
        return dashboard.UnknownCount > 0 || dashboard.PossiblyStaleCount > 0 || dashboard.StaleCount > 0 || dashboard.InnCount > 0;
    }

    private static string GetCronDataGapLabel(PartyCronDashboardSnapshot dashboard)
    {
        var parts = new List<string>();
        if (dashboard.UnknownCount + dashboard.PossiblyStaleCount > 0)
        {
            parts.Add(FormatCount(dashboard.UnknownCount + dashboard.PossiblyStaleCount, "unknown"));
        }

        if (dashboard.StaleCount > 0)
        {
            parts.Add(FormatCount(dashboard.StaleCount, "stale"));
        }

        if (dashboard.InnCount > 0)
        {
            parts.Add(FormatCount(dashboard.InnCount, "in Inn"));
        }

        return string.Join(", ", parts);
    }

    private static string FormatCount(int count, string label)
    {
        return $"{count} {label}";
    }

    private static string FormatStoredDayCount(int count)
    {
        var dayLabel = count == 1 ? "day" : "days";
        return $"{count} stored observation {dayLabel}";
    }

    private static string GetCronStateLabel(PartyCronState state)
    {
        return state switch
        {
            PartyCronState.CronedToday => "CRON applied",
            PartyCronState.NotCronedYet => "Awaiting CRON",
            PartyCronState.InInn => "In Inn",
            _ => "Unknown"
        };
    }

    private static string GetCronStateClass(PartyCronState state)
    {
        return state switch
        {
            PartyCronState.CronedToday => "ui-pill state-pill success-pill",
            PartyCronState.NotCronedYet => "ui-pill state-pill warning-pill",
            PartyCronState.InInn => "ui-pill state-pill",
            _ => "ui-pill state-pill"
        };
    }

    private static string GetParticipationLabel(PartyQuestParticipationStatus status)
    {
        return status switch
        {
            PartyQuestParticipationStatus.Accepted => "Accepted",
            PartyQuestParticipationStatus.Pending => "Pending",
            PartyQuestParticipationStatus.Rejected => "Rejected",
            _ => "Unknown"
        };
    }

    private static string FormatDateTime(DateTimeOffset? utcTimestamp)
    {
        return utcTimestamp is null
            ? "Unknown"
            : utcTimestamp.Value.ToLocalTime().ToString("MMM d, HH:mm");
    }

    private static string FormatTime(TimeSpan? time)
    {
        return time is null ? "More history needed" : time.Value.ToString(@"hh\:mm");
    }

    private static string FormatAverageCron(PartyMemberSnapshot member)
    {
        if (member.AverageCronTime is null || member.AverageCronSampleCount == 0)
        {
            return "Not enough history";
        }

        var dayLabel = member.AverageCronSampleCount == 1 ? "day" : "days";
        return $"Avg {member.AverageCronTime.Value:hh\\:mm} ({member.AverageCronSampleCount} {dayLabel})";
    }

    private static string FormatQuestMetric(PartyQuestMetricSnapshot? metric)
    {
        if (metric is null)
        {
            return "Unknown";
        }

        var value = FormatDecimal(metric.Value);
        if (metric.Total is null)
        {
            return $"{value} {metric.Unit}";
        }

        return $"{value}/{FormatDecimal(metric.Total.Value)} {metric.Unit}";
    }

    private static PartyQuestMetricSnapshot? GetAppliedProgress(PartyQuestSnapshot quest)
    {
        if (quest.AppliedProgress is not null)
        {
            return quest.AppliedProgress;
        }

        if (quest.BossHealthRemaining is not null)
        {
            return new PartyQuestMetricSnapshot(
                "Current boss HP",
                quest.BossHealthRemaining.Value,
                quest.BossHealthTotal,
                "hp");
        }

        return new PartyQuestMetricSnapshot(
            quest.ProgressLabel,
            quest.ProgressUp,
            quest.CollectionItemsTotal,
            quest.QuestType == PartyQuestType.Collection ? "items" : "points");
    }

    private static PartyQuestMetricSnapshot? GetPendingUserProgress(PartyQuestSnapshot quest)
    {
        return quest.PendingUserProgress;
    }

    private static PartyQuestMetricSnapshot? GetPendingPartyProgress(PartyQuestSnapshot quest)
    {
        if (quest.PendingPartyProgress is not null)
        {
            return quest.PendingPartyProgress;
        }

        if (quest.TotalPendingDamage is not null)
        {
            return new PartyQuestMetricSnapshot("Pending party damage", quest.TotalPendingDamage.Value, null, "damage");
        }

        if (quest.TotalPendingCollectionItems is not null)
        {
            return new PartyQuestMetricSnapshot("Pending party items", quest.TotalPendingCollectionItems.Value, null, "items");
        }

        if (quest.PendingDamage is not null)
        {
            return new PartyQuestMetricSnapshot("Pending damage", quest.PendingDamage.Value, null, "damage");
        }

        return null;
    }

    private static PartyQuestMetricSnapshot? GetEstimatedPostCronProgress(PartyQuestSnapshot quest)
    {
        if (quest.EstimatedPostCronProgress is not null)
        {
            return quest.EstimatedPostCronProgress;
        }

        var pendingPartyProgress = GetPendingPartyProgress(quest);
        if (quest.BossHealthRemaining is not null && pendingPartyProgress is not null)
        {
            return new PartyQuestMetricSnapshot(
                "Estimated boss HP after CRON",
                Math.Max(0m, quest.BossHealthRemaining.Value - pendingPartyProgress.Value),
                quest.BossHealthTotal,
                "hp");
        }

        if (quest.CollectionItemsTotal is not null && pendingPartyProgress is not null)
        {
            return new PartyQuestMetricSnapshot(
                "Estimated items after CRON",
                Math.Min(quest.CollectionItemsTotal.Value, quest.ProgressUp + pendingPartyProgress.Value),
                quest.CollectionItemsTotal,
                "items");
        }

        return null;
    }

    private static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string FormatMemberPendingQuest(PartyMemberSnapshot member)
    {
        if (member.PendingQuestDamage is not null && member.PendingQuestItems is not null)
        {
            return $"{FormatDecimal(member.PendingQuestDamage.Value)} damage, {FormatDecimal(member.PendingQuestItems.Value)} items";
        }

        if (member.PendingQuestDamage is not null)
        {
            return $"{FormatDecimal(member.PendingQuestDamage.Value)} damage";
        }

        if (member.PendingQuestItems is not null)
        {
            return $"{FormatDecimal(member.PendingQuestItems.Value)} items";
        }

        return "Unknown";
    }

    private static string FormatEstimateConfidence(PartyQuestCompletionEstimate? estimate)
    {
        return estimate?.Confidence.ToString() ?? "Unknown";
    }

    private static string FormatCompletionRange(PartyQuestCompletionEstimate? estimate)
    {
        if (estimate?.EarliestCompletionUtc is null)
        {
            return "Unknown";
        }

        if (estimate.LatestCompletionUtc is null || estimate.LatestCompletionUtc == estimate.EarliestCompletionUtc)
        {
            return estimate.EarliestCompletionUtc.Value.ToLocalTime().ToString("MMM d, HH:mm");
        }

        return $"{estimate.EarliestCompletionUtc.Value.ToLocalTime():MMM d, HH:mm} - {estimate.LatestCompletionUtc.Value.ToLocalTime():MMM d, HH:mm}";
    }

    private static Severity GetEstimateSeverity(PartyQuestCompletionEstimate estimate)
    {
        return estimate.Confidence switch
        {
            PartyQuestEstimateConfidence.High => Severity.Success,
            PartyQuestEstimateConfidence.Medium => Severity.Info,
            PartyQuestEstimateConfidence.Low => Severity.Warning,
            _ => Severity.Info
        };
    }

    private static string FormatClass(string? className)
    {
        return string.IsNullOrWhiteSpace(className) ? "Class unknown" : className;
    }

    private static string FormatLevel(int? level)
    {
        return level?.ToString(CultureInfo.InvariantCulture) ?? "Unknown";
    }

    private static string FormatStat(decimal? value)
    {
        return value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "-";
    }

    private static IReadOnlyList<(string Label, PartyStatSectionSnapshot Stats)> GetStatSections(PartyMemberSnapshot member)
    {
        var sections = new List<(string Label, PartyStatSectionSnapshot Stats)>();
        if (member.Stats?.BaseAllocated?.HasAnyValue == true)
        {
            sections.Add(("Base/Allocated", member.Stats.BaseAllocated));
        }

        if (member.Stats?.Gear?.HasAnyValue == true)
        {
            sections.Add(("Gear", member.Stats.Gear));
        }

        if (member.Stats?.Buffs?.HasAnyValue == true)
        {
            sections.Add(("Buffs", member.Stats.Buffs));
        }

        if (member.Stats?.Total?.HasAnyValue == true)
        {
            sections.Add(("Total", member.Stats.Total));
        }

        return sections;
    }

    private static decimal ChartX(int hour)
    {
        return 36m + hour / 23m * 568m;
    }

    private static decimal ChartY(decimal value, int memberCount)
    {
        if (memberCount <= 0)
        {
            return 190m;
        }

        return 190m - Math.Clamp(value / memberCount, 0m, 1m) * 160m;
    }

    private static string BuildChartPath(
        IReadOnlyList<PartyCronGraphPoint> points,
        int memberCount,
        Func<PartyCronGraphPoint, decimal?> valueSelector)
    {
        var coordinates = points
            .Select(point => valueSelector(point) is { } value
                ? $"{FormatChartNumber(ChartX(point.Hour))},{FormatChartNumber(ChartY(value, memberCount))}"
                : null)
            .Where(static coordinate => !string.IsNullOrWhiteSpace(coordinate))
            .ToArray();

        return coordinates.Length < 2 ? string.Empty : $"M {string.Join(" L ", coordinates)}";
    }

    private static string BuildBandPath(IReadOnlyList<PartyCronGraphPoint> points, int memberCount)
    {
        var bandPoints = points
            .Where(static point => point.LowerQuartileCount is not null && point.UpperQuartileCount is not null)
            .ToArray();
        if (bandPoints.Length < 2)
        {
            return string.Empty;
        }

        var upper = bandPoints
            .Select(point => $"{FormatChartNumber(ChartX(point.Hour))},{FormatChartNumber(ChartY(point.UpperQuartileCount!.Value, memberCount))}")
            .ToArray();
        var lower = bandPoints
            .Reverse()
            .Select(point => $"{FormatChartNumber(ChartX(point.Hour))},{FormatChartNumber(ChartY(point.LowerQuartileCount!.Value, memberCount))}")
            .ToArray();

        return $"M {string.Join(" L ", upper)} L {string.Join(" L ", lower)} Z";
    }

    private static string FormatChartNumber(decimal value)
    {
        return value.ToString("0.##", CultureInfo.InvariantCulture);
    }

    private static string GetAxisTextAnchor(int hour)
    {
        return hour switch
        {
            0 => "start",
            23 => "end",
            _ => "middle"
        };
    }

    private async Task HandleIncludeStaleChangedAsync(ChangeEventArgs args)
    {
        await SessionController.SetIncludeStalePartyMembersAsync(args.Value is true);
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }
}
