@page "/tasks"
@implements IDisposable
@using System.Globalization
@using Habitica.Domain.Tasks
@using Habitica.Storage
@inject IAppSessionController SessionController
@inject TaskListViewModelFactory TaskListViewModelFactory
@inject IKeyValueStorage KeyValueStorage

<PageTitle>Tasks</PageTitle>

<div class="tasks-shell">
    <section class="card-surface tasks-header">
        <div>
            <p class="section-label">Read-only workspace</p>
            <h1>Task snapshot</h1>
            <p class="panel-copy">
                Browse the latest tasks stored on this device. Completion and scoring actions stay out of scope here
                until the mutation workflow is wired, so the page is optimized for visibility, filtering, and sync status.
            </p>
        </div>

        <div class="tasks-toolbar">
            <label class="field-row compact">
                <span>Search</span>
                <input class="app-input" name="task-search" @bind="_searchText" />
            </label>
        </div>
    </section>

    @if (SessionController.State.TaskSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            No local task snapshot is available yet. Sign in and run the initial sync to populate this workspace.
        </MudAlert>
    }
    else
    {
        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.TaskFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.TaskFreshness)
        </MudAlert>

        @if (CurrentViewModel.Groups.Count == 0)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                No tasks match the current filter.
            </MudAlert>
        }
        else
        {
            @foreach (var group in CurrentViewModel.Groups)
            {
                var isFolded = IsGroupFolded(group.Type);
                var showCompleted = ShouldShowCompleted(group.Type);
                var visibleItems = GetVisibleItems(group).ToArray();

                <section class="task-group">
                    <div class="task-group-header">
                        <div class="task-group-title">
                            <h2>@group.Title</h2>
                            <span class="ui-pill count-pill">@FormatGroupCount(visibleItems.Length, group.Items.Count)</span>
                        </div>

                        <div class="task-group-actions">
                            <button class="secondary-action-button compact" type="button" @onclick="@(() => ToggleCompletedAsync(group.Type))">
                                @(showCompleted ? "Hide completed" : "Show completed")
                            </button>
                            <button class="secondary-action-button compact icon-toggle" type="button" aria-label="@GetFoldLabel(group.Title, isFolded)" title="@GetFoldLabel(group.Title, isFolded)" @onclick="@(() => ToggleFoldedAsync(group.Type))">
                                @(isFolded ? "+" : "-")
                            </button>
                        </div>
                    </div>

                    @if (!isFolded)
                    {
                        @if (visibleItems.Length == 0)
                        {
                            <p class="task-empty-state">No open tasks in this category.</p>
                        }
                        else
                        {
                            <div class="task-card-grid">
                                @foreach (var item in visibleItems)
                                {
                                    <article class="@GetTaskCardClass(item)" style="@GetTaskCardStyle(item)">
                                        <div class="task-card-head">
                                            <span class="task-title">@item.Text</span>

                                            @if (item.IsCompleted)
                                            {
                                                <span class="ui-pill state-pill success-pill">Done</span>
                                            }
                                            else
                                            {
                                                <span class="ui-pill state-pill warning-pill">Open</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <p class="task-notes">@item.Notes</p>
                                        }

                                        <dl class="task-meta">
                                            <div>
                                                <dt>Value</dt>
                                                <dd>@FormatTaskValue(item.Value)</dd>
                                            </div>

                                            <div>
                                                <dt>Priority</dt>
                                                <dd>@item.Difficulty</dd>
                                            </div>

                                            <div>
                                                <dt>Due</dt>
                                                <dd>@(item.DueDate?.ToString("u") ?? "No due date")</dd>
                                            </div>
                                        </dl>
                                    </article>
                                }
                            </div>
                        }
                    }
                </section>
            }
        }
    }
</div>

@code {
    private readonly Dictionary<TaskType, bool> _foldedCategories = new();
    private readonly Dictionary<TaskType, bool> _showCompletedCategories = new();
    private string? _searchText;
    private string? _loadedPreferenceUserId;

    private TaskListViewModel CurrentViewModel => SessionController.State.TaskSnapshot is null
        ? new TaskListViewModel(Array.Empty<TaskGroupViewModel>(), 0)
        : TaskListViewModelFactory.Create(
            SessionController.State.TaskSnapshot,
            new TaskListFilter(
                SearchText: _searchText,
                IncludeCompleted: true));

    protected override async Task OnInitializedAsync()
    {
        SessionController.Changed += HandleStateChanged;
        await LoadPreferencesAsync();
    }

    private IEnumerable<TaskListItemViewModel> GetVisibleItems(TaskGroupViewModel group)
    {
        return ShouldShowCompleted(group.Type)
            ? group.Items
            : group.Items.Where(static item => !item.IsCompleted);
    }

    private bool IsGroupFolded(TaskType taskType)
    {
        return _foldedCategories.TryGetValue(taskType, out var isFolded) && isFolded;
    }

    private bool ShouldShowCompleted(TaskType taskType)
    {
        return _showCompletedCategories.TryGetValue(taskType, out var showCompleted) && showCompleted;
    }

    private async Task ToggleFoldedAsync(TaskType taskType)
    {
        _foldedCategories[taskType] = !IsGroupFolded(taskType);
        await SavePreferencesAsync();
    }

    private async Task ToggleCompletedAsync(TaskType taskType)
    {
        _showCompletedCategories[taskType] = !ShouldShowCompleted(taskType);
        await SavePreferencesAsync();
    }

    private async Task LoadPreferencesAsync()
    {
        var userId = GetPreferenceUserId();
        _loadedPreferenceUserId = userId;
        var preferences = await KeyValueStorage.GetAsync<TasksPagePreferences>(GetPreferenceStorageKey(userId), CancellationToken.None);
        _foldedCategories.Clear();
        _showCompletedCategories.Clear();
        ApplyPreferences(_foldedCategories, preferences?.FoldedCategories);
        ApplyPreferences(_showCompletedCategories, preferences?.ShowCompletedCategories);
    }

    private async Task SavePreferencesAsync()
    {
        var userId = GetPreferenceUserId();
        _loadedPreferenceUserId = userId;
        var preferences = new TasksPagePreferences(
            ToPreferenceDictionary(_foldedCategories),
            ToPreferenceDictionary(_showCompletedCategories));
        await KeyValueStorage.SetAsync(GetPreferenceStorageKey(userId), preferences, CancellationToken.None);
    }

    private string GetPreferenceUserId()
    {
        return string.IsNullOrWhiteSpace(SessionController.State.UserId)
            ? "local"
            : SessionController.State.UserId;
    }

    private static string GetPreferenceStorageKey(string userId)
    {
        return $"{StorageKeys.TasksPagePreferences}/{userId}";
    }

    private static void ApplyPreferences(Dictionary<TaskType, bool> target, IReadOnlyDictionary<string, bool>? source)
    {
        if (source is null)
        {
            return;
        }

        foreach (var (key, value) in source)
        {
            if (Enum.TryParse<TaskType>(key, ignoreCase: true, out var taskType))
            {
                target[taskType] = value;
            }
        }
    }

    private static Dictionary<string, bool> ToPreferenceDictionary(IReadOnlyDictionary<TaskType, bool> source)
    {
        return source.ToDictionary(pair => pair.Key.ToString(), pair => pair.Value, StringComparer.Ordinal);
    }

    private static string FormatGroupCount(int visibleCount, int totalCount)
    {
        return visibleCount == totalCount ? visibleCount.ToString(CultureInfo.InvariantCulture) : $"{visibleCount}/{totalCount}";
    }

    private static string FormatTaskValue(decimal? value)
    {
        return value?.ToString("0.#", CultureInfo.InvariantCulture) ?? "Unknown";
    }

    private static string GetFoldLabel(string groupTitle, bool isFolded)
    {
        return isFolded ? $"Expand {groupTitle}" : $"Collapse {groupTitle}";
    }

    private static string GetTaskCardClass(TaskListItemViewModel item)
    {
        return item.IsCompleted ? "task-card completed-task" : "task-card";
    }

    private static string GetTaskCardStyle(TaskListItemViewModel item)
    {
        return $"background: {GetTaskBackground(item)};";
    }

    private static string GetTaskBackground(TaskListItemViewModel item)
    {
        if (item.IsCompleted)
        {
            return "rgba(236, 239, 236, 0.78)";
        }

        if (item.Value is null)
        {
            return "rgba(255, 255, 255, 0.75)";
        }

        var normalized = Math.Clamp(((double)item.Value.Value + 20d) / 40d, 0d, 1d);
        var color = InterpolateTaskColor(normalized);
        return $"rgb({color.Red}, {color.Green}, {color.Blue})";
    }

    private static (int Red, int Green, int Blue) InterpolateTaskColor(double normalized)
    {
        var stops = new[]
        {
            (Position: 0d, Red: 252, Green: 235, Blue: 231),
            (Position: 0.35d, Red: 249, Green: 239, Blue: 219),
            (Position: 0.5d, Red: 248, Green: 244, Blue: 226),
            (Position: 0.75d, Red: 229, Green: 242, Blue: 235),
            (Position: 1d, Red: 226, Green: 237, Blue: 249)
        };

        for (var index = 1; index < stops.Length; index++)
        {
            if (normalized <= stops[index].Position)
            {
                var start = stops[index - 1];
                var end = stops[index];
                var progress = (normalized - start.Position) / (end.Position - start.Position);
                return (
                    InterpolateChannel(start.Red, end.Red, progress),
                    InterpolateChannel(start.Green, end.Green, progress),
                    InterpolateChannel(start.Blue, end.Blue, progress));
            }
        }

        return (stops[^1].Red, stops[^1].Green, stops[^1].Blue);
    }

    private static int InterpolateChannel(int start, int end, double progress)
    {
        return (int)Math.Round(start + (end - start) * progress, MidpointRounding.AwayFromZero);
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Fresh local snapshot",
            SnapshotFreshnessState.Stale => "Stale local snapshot",
            SnapshotFreshnessState.Expired => "Expired local snapshot",
            _ => "Missing local snapshot"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (!string.Equals(_loadedPreferenceUserId, GetPreferenceUserId(), StringComparison.Ordinal))
            {
                await LoadPreferencesAsync();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }

    private sealed record TasksPagePreferences(
        Dictionary<string, bool> FoldedCategories,
        Dictionary<string, bool> ShowCompletedCategories);
}
