@page "/tasks"
@implements IDisposable
@implements IAsyncDisposable
@using System.Globalization
@using Habitica.Application.Sync
@using Habitica.Domain.Tasks
@using Habitica.Storage
@using Microsoft.AspNetCore.Components.Rendering
@inject IAppSessionController SessionController
@inject TaskListViewModelFactory TaskListViewModelFactory
@inject TaskOrderPlanner TaskOrderPlanner
@inject IKeyValueStorage KeyValueStorage
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<PageTitle>Tasks</PageTitle>

<div class="tasks-shell" @ref="_tasksRoot">
    <section class="card-surface tasks-header">
        <div>
            <p class="section-label">Task workspace</p>
            <h1>Tasks</h1>
            <p class="panel-copy">
                Browse and score the latest Habitica tasks saved on this device. Mutations require fresh data and refresh account/task state after completion.
            </p>
        </div>

        <div class="tasks-toolbar">
            <label class="field-row compact">
                <span>Search</span>
                <input class="app-input" name="task-search" @bind="_searchText" />
            </label>

            <label class="field-row compact">
                <span>Sort</span>
                <select class="app-input" value="@_sortMode.ToString()" @onchange="eventArgs => SetSortMode(eventArgs.Value?.ToString())">
                    <option value="Name">Name</option>
                    <option value="ValueHigh">Highest value</option>
                    <option value="ValueLow">Lowest value</option>
                    <option value="DueSoon">Due soon</option>
                </select>
            </label>

            <label class="field-row compact">
                <span>Stats period</span>
                <select class="app-input" value="@_analysisPeriod.ToString()" @onchange="eventArgs => SetAnalysisPeriod(eventArgs.Value?.ToString())" data-testid="task-analysis-period">
                    <option value="Week">Week</option>
                    <option value="Month">Month</option>
                    <option value="Year">Year</option>
                </select>
            </label>

            <div class="task-type-filter" aria-label="Task type filters">
                @foreach (var taskType in TaskTypeFilters)
                {
                    <label class="checkbox-row compact">
                        <input type="checkbox"
                               data-testid="@($"task-type-filter-{taskType}")"
                               checked="@IsTaskTypeSelected(taskType)"
                               @onchange="eventArgs => SetTaskTypeSelected(taskType, eventArgs.Value is true)" />
                        <span>@FormatTaskType(taskType)</span>
                    </label>
                }
            </div>
        </div>
    </section>

    @if (SessionController.State.TaskSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            @if (SessionController.State.IsAuthenticated)
            {
                <span>No saved tasks are available yet. Refresh to load this page.</span>
            }
            else
            {
                <span>No saved tasks are available on this device yet. Sign in to load this page.</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
        </MudAlert>
    }
    else
    {
        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.TaskFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.TaskFreshness)
        </MudAlert>
        <section class="card-surface task-statistics-panel" data-testid="task-statistics-panel">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Task statistics</p>
                    <h2>@FormatAnalysisPeriod(_analysisPeriod)</h2>
                </div>
                <span class="ui-pill count-pill">@CurrentViewModel.TotalVisibleTasks visible</span>
            </div>

            <div class="task-stat-grid">
                <article class="dashboard-stat-card">
                    <span class="dashboard-stat-label">Open</span>
                    <strong>@GetVisibleTaskItems().Count(static task => !task.IsCompleted)</strong>
                    <span class="dashboard-stat-note">Visible tasks not completed.</span>
                </article>
                <article class="dashboard-stat-card">
                    <span class="dashboard-stat-label">Due pressure</span>
                    <strong>@GetDuePressureLabel()</strong>
                    <span class="dashboard-stat-note">Overdue / due today.</span>
                </article>
                <article class="dashboard-stat-card">
                    <span class="dashboard-stat-label">History points</span>
                    <strong>@GetVisibleHistoryPoints().Count</strong>
                    <span class="dashboard-stat-note">Cached Habitica history entries.</span>
                </article>
                <article class="dashboard-stat-card">
                    <span class="dashboard-stat-label">Net value</span>
                    <strong>@FormatSignedDecimal(GetVisibleHistoryDelta())</strong>
                    <span class="dashboard-stat-note">First-to-last value movement.</span>
                </article>
            </div>

            <div class="task-chart-grid">
                @RenderTaskHistoryHistogram(GetAggregateHistoryBuckets(), "Task-history histogram")
                @RenderMonthActivityChart(GetAggregateMonthBuckets(), "Month activity")
            </div>
        </section>
        <span class="sr-only" aria-live="polite">@_reorderAnnouncement</span>

        @if (CurrentViewModel.Groups.Count == 0)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                No tasks match the current filter.
            </MudAlert>
        }
        else
        {
            @foreach (var group in CurrentViewModel.Groups)
            {
                var isFolded = IsGroupFolded(group.Type);
                var showCompleted = ShouldShowCompleted(group.Type);
                var isRearranging = IsGroupRearranging(group.Type);
                var visibleItems = GetVisibleItems(group).ToArray();

                <section class="task-group">
                    <div class="task-group-header">
                        <div class="task-group-title">
                            <h2>@group.Title</h2>
                            <span class="ui-pill count-pill">@FormatGroupCount(visibleItems.Length, group.Items.Count)</span>
                        </div>

                        <div class="task-group-actions">
                            <button class="secondary-action-button compact" type="button" data-testid="@($"rearrange-tasks-{group.Type}")" @onclick="@(() => ToggleRearranging(group.Type))">
                                @(isRearranging ? "Done rearranging" : "Rearrange")
                            </button>
                            <button class="secondary-action-button compact" type="button" @onclick="@(() => ToggleCompletedAsync(group.Type))">
                                @(showCompleted ? "Hide completed" : "Show completed")
                            </button>
                            <button class="secondary-action-button compact icon-toggle" type="button" aria-label="@GetFoldLabel(group.Title, isFolded)" title="@GetFoldLabel(group.Title, isFolded)" @onclick="@(() => ToggleFoldedAsync(group.Type))">
                                @(isFolded ? "+" : "-")
                            </button>
                        </div>
                    </div>

                    @if (!isFolded)
                    {
                        @if (visibleItems.Length == 0)
                        {
                            <p class="task-empty-state">No open tasks in this category.</p>
                        }
                        else
                        {
                            <div class="task-card-grid" data-task-type="@group.Type">
                                @foreach (var item in visibleItems)
                                {
                                    var mutationDisabledReason = GetTaskMutationDisabledReason();
                                    var progress = GetTaskProgress(item.Id);
                                    var isMutating = progress is not null;
                                    <article class="@GetTaskCardClass(item)"
                                             id="@BuildTaskElementId(item.Id)"
                                             style="@GetTaskCardStyle(item)"
                                             data-task-id="@item.Id"
                                             data-task-type="@group.Type">
                                        @if (isRearranging)
                                        {
                                            <div class="task-reorder-affordances">
                                                <button class="task-drag-handle"
                                                        type="button"
                                                        aria-label="@($"Reorder {item.Text}")"
                                                        aria-keyshortcuts="ArrowUp ArrowDown"
                                                        title="@($"Drag to reorder {item.Text}; use arrow keys while focused for precise moves.")"
                                                        data-testid="@($"drag-task-{item.Id}")"
                                                        @onkeydown="eventArgs => HandleTaskReorderKeyAsync(group, item.Id, eventArgs)">
                                                    <span aria-hidden="true">::</span>
                                                </button>
                                                <div class="task-reorder-controls" role="group" aria-label="@($"Move {item.Text}")">
                                                    <button class="task-reorder-button"
                                                            type="button"
                                                            disabled="@(!CanMoveTask(visibleItems, item.Id, TaskReorderTarget.Top))"
                                                            aria-label="@($"Move {item.Text} to top")"
                                                            title="@($"Move {item.Text} to top")"
                                                            data-testid="@($"move-task-top-{item.Id}")"
                                                            @onclick="@(() => MoveTaskToVisibleIndexAsync(group, item.Id, 0))">
                                                        <MudIcon Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" />
                                                    </button>
                                                    <button class="task-reorder-button"
                                                            type="button"
                                                            disabled="@(!CanMoveTask(visibleItems, item.Id, TaskReorderTarget.Up))"
                                                            aria-label="@($"Move {item.Text} up")"
                                                            title="@($"Move {item.Text} up")"
                                                            data-testid="@($"move-task-up-{item.Id}")"
                                                            @onclick="@(() => MoveTaskAsync(group, item.Id, -1))">
                                                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" />
                                                    </button>
                                                    <button class="task-reorder-button"
                                                            type="button"
                                                            disabled="@(!CanMoveTask(visibleItems, item.Id, TaskReorderTarget.Down))"
                                                            aria-label="@($"Move {item.Text} down")"
                                                            title="@($"Move {item.Text} down")"
                                                            data-testid="@($"move-task-down-{item.Id}")"
                                                            @onclick="@(() => MoveTaskAsync(group, item.Id, 1))">
                                                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                                                    </button>
                                                    <button class="task-reorder-button"
                                                            type="button"
                                                            disabled="@(!CanMoveTask(visibleItems, item.Id, TaskReorderTarget.Bottom))"
                                                            aria-label="@($"Move {item.Text} to bottom")"
                                                            title="@($"Move {item.Text} to bottom")"
                                                            data-testid="@($"move-task-bottom-{item.Id}")"
                                                            @onclick="@(() => MoveTaskToVisibleIndexAsync(group, item.Id, visibleItems.Length - 1))">
                                                        <MudIcon Icon="@Icons.Material.Filled.VerticalAlignBottom" Size="Size.Small" />
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                        <div class="task-card-head">
                                            <div class="task-card-copy">
                                                <span class="task-title">@item.Text</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                                {
                                                    <p class="task-notes">@item.Notes</p>
                                                }
                                            </div>
                                        </div>

                                        <div class="task-card-actions">
                                            @if (item.Type == TaskType.Habit)
                                            {
                                                <label class="field-row compact habit-score-count">
                                                    <span>Score count</span>
                                                    <input class="app-input"
                                                           data-testid="@($"task-score-count-{item.Id}")"
                                                           disabled="@isMutating"
                                                           min="1"
                                                           max="20"
                                                           type="number"
                                                           value="@GetHabitScoreCount(item.Id)"
                                                           @onchange="eventArgs => SetHabitScoreCount(item.Id, eventArgs.Value?.ToString())" />
                                                </label>

                                                <MudButton Color="Color.Primary"
                                                           Disabled="@(!CanScoreTask(item, TaskScoreDirection.Up, mutationDisabledReason) || isMutating)"
                                                           OnClick="() => ScoreTaskAsync(item, TaskScoreDirection.Up)"
                                                           Size="Size.Small"
                                                           Variant="Variant.Filled"
                                                           data-testid="@($"score-task-up-{item.Id}")">
                                                    Score +@GetHabitScoreCount(item.Id)
                                                </MudButton>

                                                <MudButton Color="Color.Secondary"
                                                           Disabled="@(!CanScoreTask(item, TaskScoreDirection.Down, mutationDisabledReason) || isMutating)"
                                                           OnClick="() => ScoreTaskAsync(item, TaskScoreDirection.Down)"
                                                           Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           data-testid="@($"score-task-down-{item.Id}")">
                                                    Score -@GetHabitScoreCount(item.Id)
                                                </MudButton>
                                            }
                                            else if (item.Type is TaskType.Daily or TaskType.Todo)
                                            {
                                                var direction = item.IsCompleted ? TaskScoreDirection.Down : TaskScoreDirection.Up;
                                                <MudButton Color="Color.Primary"
                                                           Disabled="@(!CanScoreTask(item, direction, mutationDisabledReason) || isMutating)"
                                                           OnClick="() => ScoreTaskAsync(item, direction)"
                                                           Size="Size.Small"
                                                           Variant="Variant.Filled"
                                                           data-testid="@($"score-task-{item.Id}")">
                                                    @(item.IsCompleted ? "Uncomplete" : "Complete")
                                                </MudButton>
                                            }

                                            <button class="secondary-action-button compact task-details-toggle" type="button" @onclick="@(() => ToggleTaskExpanded(item.Id))">
                                                @(IsTaskExpanded(item.Id) ? "Hide details" : "Details")
                                            </button>
                                        </div>

                                        @if (mutationDisabledReason is not null)
                                        {
                                            <span class="task-action-note">@mutationDisabledReason</span>
                                        }

                                        @if (progress is not null)
                                        {
                                            <div class="task-progress">
                                                <span>@FormatTaskProgress(progress)</span>
                                                <MudProgressLinear Class="scheme-progress-primary" Color="Color.Primary" Max="@progress.Total" Value="@progress.Completed" />
                                            </div>
                                        }

                                        @if (IsTaskExpanded(item.Id))
                                        {
                                            <div class="task-expanded-content">
                                                <div class="task-detail-status">
                                                    @if (item.IsCompleted)
                                                    {
                                                        <span class="ui-pill state-pill success-pill">Done</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ui-pill state-pill warning-pill">Open</span>
                                                    }
                                                </div>

                                                <dl class="task-meta">
                                                    <div>
                                                        <dt>Value</dt>
                                                        <dd>@FormatTaskValue(item.Value)</dd>
                                                    </div>

                                                    <div>
                                                        <dt>Priority</dt>
                                                        <dd>@item.Difficulty</dd>
                                                    </div>

                                                    <div>
                                                        <dt>Due</dt>
                                                        <dd>@FormatDueDate(item.DueDate)</dd>
                                                    </div>
                                                </dl>

                                                <div class="task-detail-panel">
                                                    <dl class="task-meta expanded">
                                                        <div>
                                                            <dt>Task type</dt>
                                                            <dd>@FormatTaskType(item.Type)</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Challenge</dt>
                                                            <dd>@(item.IsChallengeTask ? "Yes" : "No")</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Status</dt>
                                                            <dd>@(item.IsCompleted ? "Completed" : "Open")</dd>
                                                        </div>

                                                        <div>
                                                            <dt>Source</dt>
                                                            <dd>Cached snapshot</dd>
                                                        </div>
                                                    </dl>
                                                    <div class="task-detail-charts">
                                                        @RenderTaskHistoryHistogram(GetTaskHistoryBuckets(item), "Task value history")
                                                        @RenderMonthActivityChart(GetTaskMonthBuckets(item), "Task month activity")
                                                    </div>
                                                </div>

                                            </div>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }
                </section>
            }
        }
    }
</div>

@code {
    private readonly Dictionary<TaskType, bool> _foldedCategories = new();
    private readonly Dictionary<TaskType, bool> _showCompletedCategories = new();
    private readonly Dictionary<TaskType, bool> _rearrangingCategories = new();
    private readonly Dictionary<TaskType, bool> _selectedTaskTypes = new();
    private readonly Dictionary<string, bool> _expandedTasks = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _habitScoreCounts = new(StringComparer.Ordinal);
    private readonly Dictionary<TaskType, string[]> _taskOrderPreferences = new();
    private static readonly TaskType[] TaskTypeFilters = [TaskType.Todo, TaskType.Daily, TaskType.Habit, TaskType.Reward];
    private ElementReference _tasksRoot;
    private IJSObjectReference? _tasksPageModule;
    private DotNetObjectReference<TasksPage>? _dotNetReference;
    private string? _searchText;
    private string? _loadedPreferenceUserId;
    private string? _reorderAnnouncement;
    private TaskListSortMode _sortMode = TaskListSortMode.Name;
    private TaskAnalysisPeriod _analysisPeriod = TaskAnalysisPeriod.Week;

    private enum TaskReorderTarget
    {
        Top,
        Up,
        Down,
        Bottom
    }

    private enum TaskAnalysisPeriod
    {
        Week,
        Month,
        Year
    }

    private TaskListViewModel CurrentViewModel => SessionController.State.TaskSnapshot is null
        ? new TaskListViewModel(Array.Empty<TaskGroupViewModel>(), 0)
        : TaskListViewModelFactory.Create(
            SessionController.State.TaskSnapshot,
            new TaskListFilter(
                SearchText: _searchText,
                IncludeCompleted: true,
                SelectedTypes: GetSelectedTaskTypes(),
                SortMode: _sortMode));

    protected override async Task OnInitializedAsync()
    {
        SessionController.Changed += HandleStateChanged;
        await LoadPreferencesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetReference = DotNetObjectReference.Create(this);
        _tasksPageModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/tasksPage.js");
        await _tasksPageModule.InvokeVoidAsync("initializeTaskReorder", _tasksRoot, _dotNetReference);
    }

    private IEnumerable<TaskListItemViewModel> GetVisibleItems(TaskGroupViewModel group)
    {
        var items = ShouldShowCompleted(group.Type)
            ? group.Items
            : group.Items.Where(static item => !item.IsCompleted);

        return ApplyTaskOrder(group.Type, items);
    }

    private bool IsGroupFolded(TaskType taskType)
    {
        return _foldedCategories.TryGetValue(taskType, out var isFolded) && isFolded;
    }

    private bool ShouldShowCompleted(TaskType taskType)
    {
        return _showCompletedCategories.TryGetValue(taskType, out var showCompleted) && showCompleted;
    }

    private bool IsGroupRearranging(TaskType taskType)
    {
        return _rearrangingCategories.TryGetValue(taskType, out var isRearranging) && isRearranging;
    }

    private void ToggleRearranging(TaskType taskType)
    {
        _rearrangingCategories[taskType] = !IsGroupRearranging(taskType);
    }

    private IReadOnlyCollection<TaskType> GetSelectedTaskTypes()
    {
        return _selectedTaskTypes.Count == 0
            ? TaskTypeFilters
            : TaskTypeFilters.Where(IsTaskTypeSelected).ToArray();
    }

    private bool IsTaskTypeSelected(TaskType taskType)
    {
        return !_selectedTaskTypes.TryGetValue(taskType, out var selected) || selected;
    }

    private void SetTaskTypeSelected(TaskType taskType, bool selected)
    {
        _selectedTaskTypes[taskType] = selected;
    }

    private void SetSortMode(string? rawValue)
    {
        _sortMode = Enum.TryParse<TaskListSortMode>(rawValue, out var sortMode)
            ? sortMode
            : TaskListSortMode.Name;
    }

    private void SetAnalysisPeriod(string? rawValue)
    {
        _analysisPeriod = Enum.TryParse<TaskAnalysisPeriod>(rawValue, out var period)
            ? period
            : TaskAnalysisPeriod.Week;
    }

    private IReadOnlyList<TaskListItemViewModel> GetVisibleTaskItems()
    {
        return CurrentViewModel.Groups
            .SelectMany(group => GetVisibleItems(group))
            .ToArray();
    }

    private IReadOnlyList<TaskHistoryPoint> GetVisibleHistoryPoints()
    {
        var periodStart = GetAnalysisPeriodStart();
        return GetVisibleTaskItems()
            .SelectMany(static task => task.HistoryPoints)
            .Where(point => point.Date >= periodStart)
            .OrderBy(static point => point.Date)
            .ToArray();
    }

    private decimal GetVisibleHistoryDelta()
    {
        var points = GetVisibleHistoryPoints();
        return points.Count < 2 ? 0m : points[^1].Value - points[0].Value;
    }

    private string GetDuePressureLabel()
    {
        var today = DateTimeOffset.Now.Date;
        var visibleItems = GetVisibleTaskItems();
        var overdue = visibleItems.Count(task => !task.IsCompleted && task.DueDate?.ToLocalTime().Date < today);
        var todayCount = visibleItems.Count(task => !task.IsCompleted && task.DueDate?.ToLocalTime().Date == today);
        return $"{overdue} / {todayCount}";
    }

    private DateTimeOffset GetAnalysisPeriodStart()
    {
        var now = DateTimeOffset.Now;
        return _analysisPeriod switch
        {
            TaskAnalysisPeriod.Month => now.AddDays(-30),
            TaskAnalysisPeriod.Year => now.AddYears(-1),
            _ => now.AddDays(-7)
        };
    }

    private IReadOnlyList<TaskChartBucket> GetAggregateHistoryBuckets()
    {
        return BuildHistoryBuckets(GetVisibleHistoryPoints());
    }

    private IReadOnlyList<TaskChartBucket> GetTaskHistoryBuckets(TaskListItemViewModel item)
    {
        var periodStart = GetAnalysisPeriodStart();
        return BuildHistoryBuckets(item.HistoryPoints.Where(point => point.Date >= periodStart).OrderBy(static point => point.Date).ToArray());
    }

    private IReadOnlyList<TaskChartBucket> GetAggregateMonthBuckets()
    {
        return BuildMonthBuckets(GetVisibleTaskItems().SelectMany(static task => task.HistoryPoints));
    }

    private IReadOnlyList<TaskChartBucket> GetTaskMonthBuckets(TaskListItemViewModel item)
    {
        return BuildMonthBuckets(item.HistoryPoints);
    }

    private IReadOnlyList<TaskChartBucket> BuildHistoryBuckets(IReadOnlyList<TaskHistoryPoint> points)
    {
        var bucketCount = _analysisPeriod switch
        {
            TaskAnalysisPeriod.Year => 12,
            TaskAnalysisPeriod.Month => 10,
            _ => 7
        };
        var start = GetAnalysisPeriodStart();
        var now = DateTimeOffset.Now;
        var totalTicks = Math.Max(1L, now.UtcDateTime.Ticks - start.UtcDateTime.Ticks);
        var buckets = Enumerable.Range(0, bucketCount)
            .Select(index => new MutableTaskChartBucket(GetPeriodBucketLabel(index, bucketCount), 0m))
            .ToArray();

        foreach (var point in points)
        {
            var offsetTicks = Math.Clamp(point.Date.UtcDateTime.Ticks - start.UtcDateTime.Ticks, 0L, totalTicks);
            var index = Math.Clamp((int)(offsetTicks * bucketCount / totalTicks), 0, bucketCount - 1);
            buckets[index].Value++;
        }

        return buckets.Select(static bucket => new TaskChartBucket(bucket.Label, bucket.Value)).ToArray();
    }

    private static IReadOnlyList<TaskChartBucket> BuildMonthBuckets(IEnumerable<TaskHistoryPoint> points)
    {
        var now = DateTimeOffset.Now;
        var monthStarts = Enumerable.Range(0, 6)
            .Select(offset => new DateTime(now.Year, now.Month, 1).AddMonths(offset - 5))
            .ToArray();
        var buckets = monthStarts
            .Select(month => new MutableTaskChartBucket(month.ToString("MMM", CultureInfo.CurrentCulture), 0m))
            .ToArray();

        foreach (var point in points)
        {
            var month = new DateTime(point.Date.ToLocalTime().Year, point.Date.ToLocalTime().Month, 1);
            var index = Array.FindIndex(monthStarts, candidate => candidate == month);
            if (index >= 0)
            {
                buckets[index].Value++;
            }
        }

        return buckets.Select(static bucket => new TaskChartBucket(bucket.Label, bucket.Value)).ToArray();
    }

    private static string GetPeriodBucketLabel(int index, int count)
    {
        return count == 12
            ? DateTimeOffset.Now.AddMonths(index - count + 1).ToString("MMM", CultureInfo.CurrentCulture)
            : $"{index + 1}";
    }

    private bool IsTaskExpanded(string taskId)
    {
        return _expandedTasks.TryGetValue(taskId, out var expanded) && expanded;
    }

    private void ToggleTaskExpanded(string taskId)
    {
        _expandedTasks[taskId] = !IsTaskExpanded(taskId);
    }

    private IEnumerable<TaskListItemViewModel> ApplyTaskOrder(TaskType taskType, IEnumerable<TaskListItemViewModel> items)
    {
        var orderedItems = items.ToArray();
        if (!_taskOrderPreferences.TryGetValue(taskType, out var taskIds) || taskIds.Length == 0)
        {
            return orderedItems;
        }

        var orderIndex = taskIds
            .Select((id, index) => new { id, index })
            .GroupBy(static entry => entry.id, StringComparer.Ordinal)
            .ToDictionary(static group => group.Key, static group => group.First().index, StringComparer.Ordinal);

        return orderedItems
            .OrderBy(item => orderIndex.TryGetValue(item.Id, out var index) ? index : int.MaxValue)
            .ThenBy(item => Array.IndexOf(orderedItems, item));
    }

    private async Task MoveTaskAsync(TaskGroupViewModel group, string taskId, int direction)
    {
        var visibleItems = GetVisibleItems(group).ToArray();
        var allItems = ApplyTaskOrder(group.Type, group.Items).ToArray();
        var nextOrder = TaskOrderPlanner.MoveVisibleItem(
            allItems.Select(static item => item.Id),
            visibleItems.Select(static item => item.Id),
            taskId,
            direction);
        await PersistTaskOrderAsync(group.Type, allItems.Select(static item => item.Id).ToArray(), nextOrder, taskId, visibleItems.Length);
    }

    private async Task MoveTaskToVisibleIndexAsync(TaskGroupViewModel group, string taskId, int targetIndex)
    {
        var visibleItems = GetVisibleItems(group).ToArray();
        var allItems = ApplyTaskOrder(group.Type, group.Items).ToArray();
        var nextOrder = TaskOrderPlanner.MoveVisibleItemToIndex(
            allItems.Select(static item => item.Id),
            visibleItems.Select(static item => item.Id),
            taskId,
            targetIndex);
        await PersistTaskOrderAsync(group.Type, allItems.Select(static item => item.Id).ToArray(), nextOrder, taskId, visibleItems.Length);
    }

    [JSInvokable]
    public async Task HandleTaskDropped(string taskTypeName, string draggedTaskId, string targetTaskId, bool insertAfter)
    {
        if (!Enum.TryParse<TaskType>(taskTypeName, ignoreCase: true, out var taskType))
        {
            return;
        }

        var group = CurrentViewModel.Groups.FirstOrDefault(candidate => candidate.Type == taskType);
        if (group is null)
        {
            return;
        }

        var visibleItems = GetVisibleItems(group).ToArray();
        var allItems = ApplyTaskOrder(group.Type, group.Items).ToArray();
        var nextOrder = TaskOrderPlanner.ReorderVisibleSubset(
            allItems.Select(static item => item.Id),
            visibleItems.Select(static item => item.Id),
            draggedTaskId,
            targetTaskId,
            insertAfter ? TaskDropPlacement.After : TaskDropPlacement.Before);
        await PersistTaskOrderAsync(group.Type, allItems.Select(static item => item.Id).ToArray(), nextOrder, draggedTaskId, visibleItems.Length);
    }

    private async Task HandleTaskReorderKeyAsync(TaskGroupViewModel group, string taskId, KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "ArrowUp")
        {
            await MoveTaskAsync(group, taskId, -1);
        }
        else if (eventArgs.Key == "ArrowDown")
        {
            await MoveTaskAsync(group, taskId, 1);
        }
    }

    private static bool CanMoveTask(IReadOnlyList<TaskListItemViewModel> visibleItems, string taskId, TaskReorderTarget target)
    {
        var index = -1;
        for (var candidateIndex = 0; candidateIndex < visibleItems.Count; candidateIndex++)
        {
            if (string.Equals(visibleItems[candidateIndex].Id, taskId, StringComparison.Ordinal))
            {
                index = candidateIndex;
                break;
            }
        }

        return target switch
        {
            TaskReorderTarget.Top or TaskReorderTarget.Up => index > 0,
            TaskReorderTarget.Down or TaskReorderTarget.Bottom => index >= 0 && index < visibleItems.Count - 1,
            _ => false
        };
    }

    private async Task PersistTaskOrderAsync(
        TaskType taskType,
        IReadOnlyList<string> currentEffectiveOrder,
        IReadOnlyList<string> nextOrder,
        string movedTaskId,
        int visibleCount)
    {
        if (currentEffectiveOrder.SequenceEqual(nextOrder, StringComparer.Ordinal))
        {
            return;
        }

        _taskOrderPreferences[taskType] = nextOrder.ToArray();
        await SaveTaskOrderPreferencesAsync();

        var position = GetVisiblePosition(taskType, movedTaskId);
        _reorderAnnouncement = position >= 0
            ? $"Task moved to position {Math.Min(position + 1, visibleCount)} of {visibleCount}."
            : "Task order updated.";
        await InvokeAsync(StateHasChanged);
    }

    private int GetVisiblePosition(TaskType taskType, string taskId)
    {
        var group = CurrentViewModel.Groups.FirstOrDefault(candidate => candidate.Type == taskType);
        if (group is null)
        {
            return -1;
        }

        var visibleItems = GetVisibleItems(group).ToArray();
        for (var index = 0; index < visibleItems.Length; index++)
        {
            if (string.Equals(visibleItems[index].Id, taskId, StringComparison.Ordinal))
            {
                return index;
            }
        }

        return -1;
    }

    private int GetHabitScoreCount(string taskId)
    {
        return _habitScoreCounts.TryGetValue(taskId, out var count) ? Math.Clamp(count, 1, 20) : 1;
    }

    private void SetHabitScoreCount(string taskId, string? rawValue)
    {
        _habitScoreCounts[taskId] = int.TryParse(rawValue, out var parsed) ? Math.Clamp(parsed, 1, 20) : 1;
    }

    private TaskMutationProgress? GetTaskProgress(string taskId)
    {
        var progress = SessionController.State.ActiveTaskMutationProgress;
        return progress is not null && string.Equals(progress.TaskId, taskId, StringComparison.Ordinal)
            ? progress
            : null;
    }

    private string? GetTaskMutationDisabledReason()
    {
        if (!SessionController.State.IsAuthenticated)
        {
            return "Sign in to score tasks.";
        }

        if (SessionController.State.TaskFreshness != SnapshotFreshnessState.Fresh)
        {
            return "Refresh tasks before scoring.";
        }

        if (SessionController.State.UserFreshness != SnapshotFreshnessState.Fresh)
        {
            return "Refresh account data before scoring.";
        }

        return null;
    }

    private static bool CanScoreTask(TaskListItemViewModel item, TaskScoreDirection direction, string? disabledReason)
    {
        if (disabledReason is not null)
        {
            return false;
        }

        return item.Type switch
        {
            TaskType.Habit => direction == TaskScoreDirection.Up
                ? item.SupportsPositiveScore != false
                : item.SupportsNegativeScore != false,
            TaskType.Daily or TaskType.Todo => direction == TaskScoreDirection.Up
                ? !item.IsCompleted
                : item.IsCompleted,
            _ => false
        };
    }

    private async Task ScoreTaskAsync(TaskListItemViewModel item, TaskScoreDirection direction)
    {
        var count = item.Type == TaskType.Habit ? GetHabitScoreCount(item.Id) : 1;
        var result = await SessionController.ScoreTaskAsync(new TaskScoreRequest(item.Id, direction, count));
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private async Task ToggleFoldedAsync(TaskType taskType)
    {
        _foldedCategories[taskType] = !IsGroupFolded(taskType);
        await SavePreferencesAsync();
    }

    private async Task ToggleCompletedAsync(TaskType taskType)
    {
        _showCompletedCategories[taskType] = !ShouldShowCompleted(taskType);
        await SavePreferencesAsync();
    }

    private async Task LoadPreferencesAsync()
    {
        var userId = GetPreferenceUserId();
        _loadedPreferenceUserId = userId;
        var preferences = await KeyValueStorage.GetAsync<TasksPagePreferences>(GetPreferenceStorageKey(userId), CancellationToken.None);
        var taskOrderPreferences = await KeyValueStorage.GetAsync<TaskOrderPreferences>(StorageKeys.TaskOrderPreferences, CancellationToken.None);
        _foldedCategories.Clear();
        _showCompletedCategories.Clear();
        _taskOrderPreferences.Clear();
        ApplyPreferences(_foldedCategories, preferences?.FoldedCategories);
        ApplyPreferences(_showCompletedCategories, preferences?.ShowCompletedCategories);
        ApplyTaskOrderPreferences(taskOrderPreferences);
    }

    private async Task SavePreferencesAsync()
    {
        var userId = GetPreferenceUserId();
        _loadedPreferenceUserId = userId;
        var preferences = new TasksPagePreferences(
            ToPreferenceDictionary(_foldedCategories),
            ToPreferenceDictionary(_showCompletedCategories));
        await KeyValueStorage.SetAsync(GetPreferenceStorageKey(userId), preferences, CancellationToken.None);
    }

    private async Task SaveTaskOrderPreferencesAsync()
    {
        var preferences = new TaskOrderPreferences(
            _taskOrderPreferences.ToDictionary(
                pair => pair.Key.ToString(),
                pair => pair.Value,
                StringComparer.Ordinal));
        await KeyValueStorage.SetAsync(StorageKeys.TaskOrderPreferences, preferences, CancellationToken.None);
        _ = SessionController.SyncAppDataSectionAsync(CloudSyncSection.TaskOrderPreferences);
    }

    private string GetPreferenceUserId()
    {
        return string.IsNullOrWhiteSpace(SessionController.State.UserId)
            ? "local"
            : SessionController.State.UserId;
    }

    private static string GetPreferenceStorageKey(string userId)
    {
        return $"{StorageKeys.TasksPagePreferences}/{userId}";
    }

    private static void ApplyPreferences(Dictionary<TaskType, bool> target, IReadOnlyDictionary<string, bool>? source)
    {
        if (source is null)
        {
            return;
        }

        foreach (var (key, value) in source)
        {
            if (Enum.TryParse<TaskType>(key, ignoreCase: true, out var taskType))
            {
                target[taskType] = value;
            }
        }
    }

    private static Dictionary<string, bool> ToPreferenceDictionary(IReadOnlyDictionary<TaskType, bool> source)
    {
        return source.ToDictionary(pair => pair.Key.ToString(), pair => pair.Value, StringComparer.Ordinal);
    }

    private void ApplyTaskOrderPreferences(TaskOrderPreferences? preferences)
    {
        if (preferences?.OrdersByType is null)
        {
            return;
        }

        foreach (var (key, value) in preferences.OrdersByType)
        {
            if (Enum.TryParse<TaskType>(key, ignoreCase: true, out var taskType))
            {
                _taskOrderPreferences[taskType] = value
                    .Where(static id => !string.IsNullOrWhiteSpace(id))
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
            }
        }
    }

    private static RenderFragment RenderTaskHistoryHistogram(IReadOnlyList<TaskChartBucket> buckets, string title) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "article");
        builder.AddAttribute(sequence++, "class", "task-chart-card");
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "task-chart-head");
        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, title);
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
        builder.AddContent(sequence++, $"{buckets.Sum(static bucket => bucket.Value):0} event(s)");
        builder.CloseElement();
        builder.CloseElement();
        RenderBars(builder, ref sequence, buckets, "task-history-bars");
        builder.CloseElement();
    };

    private static RenderFragment RenderMonthActivityChart(IReadOnlyList<TaskChartBucket> buckets, string title) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "article");
        builder.AddAttribute(sequence++, "class", "task-chart-card compact-chart-card");
        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, title);
        builder.CloseElement();
        RenderBars(builder, ref sequence, buckets, "task-month-activity-grid");
        builder.CloseElement();
    };

    private static void RenderBars(RenderTreeBuilder builder, ref int sequence, IReadOnlyList<TaskChartBucket> buckets, string className)
    {
        var max = Math.Max(1m, buckets.Count == 0 ? 0m : buckets.Max(static bucket => bucket.Value));
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", className);
        foreach (var bucket in buckets)
        {
            var percent = Math.Clamp(bucket.Value / max * 100m, 0m, 100m);
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "task-history-bar");
            builder.AddAttribute(sequence++, "title", $"{bucket.Label}: {bucket.Value:0}");
            builder.OpenElement(sequence++, "i");
            builder.AddAttribute(sequence++, "style", $"height: {percent.ToString("0.##", CultureInfo.InvariantCulture)}%;");
            builder.CloseElement();
            builder.OpenElement(sequence++, "small");
            builder.AddContent(sequence++, bucket.Label);
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    }

    private static string FormatGroupCount(int visibleCount, int totalCount)
    {
        return visibleCount == totalCount ? visibleCount.ToString(CultureInfo.InvariantCulture) : $"{visibleCount}/{totalCount}";
    }

    private static string FormatTaskValue(decimal? value)
    {
        return value?.ToString("0.#", CultureInfo.InvariantCulture) ?? "Unknown";
    }

    private static string FormatSignedDecimal(decimal value)
    {
        return value > 0m ? $"+{value:0.#}" : value.ToString("0.#", CultureInfo.InvariantCulture);
    }

    private static string FormatAnalysisPeriod(TaskAnalysisPeriod period)
    {
        return period switch
        {
            TaskAnalysisPeriod.Month => "Last 30 days",
            TaskAnalysisPeriod.Year => "Last year",
            _ => "Last 7 days"
        };
    }

    private static string FormatTaskType(TaskType taskType)
    {
        return taskType switch
        {
            TaskType.Todo => "To-Do",
            TaskType.Daily => "Daily",
            TaskType.Habit => "Habit",
            TaskType.Reward => "Reward",
            _ => taskType.ToString()
        };
    }

    private static string FormatTaskProgress(TaskMutationProgress progress)
    {
        var direction = progress.Direction == TaskScoreDirection.Up ? "+" : "-";
        return $"Scoring {direction}: {progress.Completed} of {progress.Total}";
    }

    private static string FormatDueDate(DateTimeOffset? dueDate)
    {
        if (dueDate is null)
        {
            return "No due date";
        }

        var localDate = dueDate.Value.ToLocalTime().Date;
        var today = DateTimeOffset.Now.Date;
        if (localDate == today)
        {
            return "Today";
        }

        if (localDate == today.AddDays(1))
        {
            return "Tomorrow";
        }

        if (localDate == today.AddDays(-1))
        {
            return "Yesterday";
        }

        return dueDate.Value.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture);
    }

    private static string GetFoldLabel(string groupTitle, bool isFolded)
    {
        return isFolded ? $"Expand {groupTitle}" : $"Collapse {groupTitle}";
    }

    private static string GetTaskCardClass(TaskListItemViewModel item)
    {
        return item.IsCompleted ? "task-card completed-task" : "task-card";
    }

    private static string GetTaskCardStyle(TaskListItemViewModel item)
    {
        return $"background: {GetTaskBackground(item)};";
    }

    private static string GetTaskBackground(TaskListItemViewModel item)
    {
        if (item.IsCompleted)
        {
            return "var(--surface)";
        }

        if (item.Value is null)
        {
            return "var(--surface)";
        }

        var value = Math.Abs((double)item.Value.Value);
        if (value < 0.05d)
        {
            return "var(--task-neutral)";
        }

        var intensity = Math.Clamp(Math.Log(value + 1d) / Math.Log(21d), 0d, 1d);
        var weight = 12d + intensity * 68d;
        var target = item.Value.Value < 0m ? "var(--task-negative)" : "var(--task-positive)";
        return string.Create(
            CultureInfo.InvariantCulture,
            $"color-mix(in srgb, {target} {weight:0.##}%, var(--task-neutral))");
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Tasks are up to date",
            SnapshotFreshnessState.Stale => "Tasks may need refresh",
            SnapshotFreshnessState.Expired => "Tasks need refresh",
            _ => "No saved tasks"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (!string.Equals(_loadedPreferenceUserId, GetPreferenceUserId(), StringComparison.Ordinal))
            {
                await LoadPreferencesAsync();
            }

            StateHasChanged();
        });
    }

    private static string BuildTaskElementId(string taskId)
    {
        return $"task-card-{Uri.EscapeDataString(taskId)}";
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        if (_tasksPageModule is not null)
        {
            await _tasksPageModule.InvokeVoidAsync("disposeTaskReorder", _tasksRoot);
            await _tasksPageModule.DisposeAsync();
        }

        _dotNetReference?.Dispose();
    }

