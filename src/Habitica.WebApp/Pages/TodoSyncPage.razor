@inject IServiceProvider Services
@page "/todo/sync"

<PageTitle>Todo Sync</PageTitle>
<div class="settings-shell">
    <section class="card-surface settings-card"><h1>Todo Sync</h1><p>Manage the active Workspace, restore access, review browser-to-cloud moves and inspect original command outcomes. Saved tasks and confirmed Habitica rewards are shown separately.</p><p>Theme and private device sync preferences remain in <a href="/settings">account Settings</a>; browser task order stays with the selected task list.</p></section>
    <TodoTaskPanel ShowCapture="false" ShowTaskList="false" ExpandSourcePicker="true" ShowSyncLink="false" />
    @if(Services.GetService(typeof(WorkspaceTransferController)) is not null) { <WorkspaceTransferPanel /> }
    <PushDevicePanel />
    <TodoCommandHistoryPanel />
    <WorkspaceSettingsPanel />
    <WorkspaceTagPanel />
</div>
