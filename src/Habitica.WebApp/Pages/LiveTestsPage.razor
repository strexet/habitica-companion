@page "/diagnostics"
@page "/live-tests"
@using System.Text.Json
@implements IDisposable
@inject IAppSessionController SessionController
@inject IJSRuntime JsRuntime

<PageTitle>Diagnostics</PageTitle>

<div class="diagnostics-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Diagnostics</p>
            <h1>Run controlled checks and inspect app behavior</h1>
            <p class="panel-copy">
                Use this workspace for safe checks, guarded live tests, curated API inspection, and the shared
                cross-feature diagnostics log.
            </p>
        </div>
    </section>

    <section class="diagnostics-grid">
        <div class="diagnostics-main">
            <article class="card-surface diagnostics-panel">
                <p class="section-label">Overview</p>
                <h2>Session and snapshot state</h2>
                <div class="diagnostics-overview-grid">
                    <span class="ui-pill">Auth @(SessionController.State.IsAuthenticated ? "Live session ready" : "Offline only")</span>
                    <span class="ui-pill">Warnings @SessionController.State.DiagnosticsWarningCount</span>
                    <span class="ui-pill">User @SessionController.State.UserFreshness</span>
                    <span class="ui-pill">Tasks @SessionController.State.TaskFreshness</span>
                    <span class="ui-pill">Party @SessionController.State.PartyFreshness</span>
                    <span class="ui-pill">Synced @(SessionController.State.LastSyncedAtUtc?.ToLocalTime().ToString("g") ?? "Never")</span>
                </div>
            </article>

            <article class="card-surface diagnostics-panel">
                <p class="section-label">Safe checks</p>
                <h2>Read-only live checks</h2>
                <p class="panel-copy">
                    Refreshes the implemented snapshots sequentially using a small number of live requests.
                </p>
                <MudButton Color="Color.Primary" Disabled="@(!SessionController.State.IsAuthenticated || SessionController.State.IsBusy)" OnClick="RunSafeLiveTestsAsync" Variant="Variant.Filled">
                    Run safe live tests
                </MudButton>
            </article>

            <article class="card-surface diagnostics-panel warning-card">
                <p class="section-label">Guarded tests</p>
                <h2>Reversible and destructive verification</h2>
                <p class="panel-copy">
                    This reversible test temporarily changes equipped battle gear, verifies the change, and restores the original loadout.
                </p>
                <label class="checkbox-row">
                    <input name="acknowledge-gear-test" type="checkbox" @bind="_acknowledgeGearMutation" />
                    <span>I understand that this temporarily changes equipped battle gear during the test.</span>
                </label>
                <MudButton Color="Color.Secondary" Disabled="@(!SessionController.State.IsAuthenticated || SessionController.State.IsBusy || !_acknowledgeGearMutation)" OnClick="RunReversibleGearTestAsync" Variant="Variant.Filled">
                    Run reversible gear test
                </MudButton>
            </article>

            <article class="card-surface diagnostics-panel">
                <p class="section-label">Preset API runner</p>
                <h2>Curated live inspection presets</h2>
                <div class="action-row">
                    <MudButton HtmlTag="button" data-testid="preset-user-account" OnClick="@(() => RunPresetAsync(DiagnosticsPreset.UserAccount))" Variant="Variant.Filled">
                        Run /user account preset
                    </MudButton>
                    <MudButton OnClick="@(() => RunPresetAsync(DiagnosticsPreset.UserInventory))" Variant="Variant.Outlined">
                        Run /user inventory preset
                    </MudButton>
                    <MudButton OnClick="@(() => RunPresetAsync(DiagnosticsPreset.TasksUser))" Variant="Variant.Outlined">
                        Run /tasks/user preset
                    </MudButton>
                    <MudButton OnClick="@(() => RunPresetAsync(DiagnosticsPreset.Party))" Variant="Variant.Outlined">
                        Run /groups/party preset
                    </MudButton>
                </div>

                @if (_lastPresetResult is not null)
                {
                    <div class="diagnostics-preview">
                        <div class="task-group-header">
                            <strong>@_lastPresetResult.Summary</strong>
                            <span class="ui-pill count-pill">@_lastPresetResult.RequestCount request(s)</span>
                        </div>
                        <pre>@_lastPresetResult.ResponsePreview</pre>
                    </div>
                }
            </article>

            @if (_lastRunResult is not null)
            {
                <section class="card-surface live-results-card">
                    <div class="task-group-header">
                        <div>
                            <p class="section-label">Last run</p>
                            <h2>Results</h2>
                        </div>
                        <span class="ui-pill count-pill">@_lastRunResult.TotalRequests requests</span>
                    </div>

                    <div class="live-results-list">
                        @foreach (var result in _lastRunResult.Results)
                        {
                            <article class="live-result-item">
                                <div class="task-group-header">
                                    <strong>@result.Title</strong>
                                    <span class="ui-pill @(GetStatusPillClass(result.Status))">@GetStatusLabel(result.Status)</span>
                                </div>
                                <p class="panel-copy">@result.Message</p>
                                <span class="dashboard-stat-note">@result.RequestCount live request(s) in this test step.</span>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        <aside class="card-surface diagnostics-console">
            <div class="task-group-header">
                <div>
                    <p class="section-label">Shared console</p>
                    <h2>Recent diagnostics history</h2>
                </div>
                <div class="action-row">
                    <MudButton HtmlTag="button" data-testid="copy-diagnostics-jsonl" Color="Color.Default" OnClick="CopyLogsAsync" Variant="Variant.Text">Copy all messages</MudButton>
                    <MudButton HtmlTag="button" data-testid="download-diagnostics-jsonl" Color="Color.Default" OnClick="DownloadLogsAsync" Variant="Variant.Text">Download logs</MudButton>
                    <MudButton Color="Color.Default" OnClick="ClearLogsAsync" Variant="Variant.Text">Clear logs</MudButton>
                </div>
            </div>

            <div class="diagnostics-filter-row">
                <label class="field-row compact">
                    <span>Feature</span>
                    <select class="app-input" @bind="_featureFilter">
                        <option value="">All features</option>
                        @foreach (var feature in FeatureFilters)
                        {
                            <option value="@feature">@feature</option>
                        }
                    </select>
                </label>

                <label class="field-row compact">
                    <span>Severity</span>
                    <select class="app-input" @bind="_severityFilter">
                        <option value="">All severities</option>
                        @foreach (var severity in SeverityFilters)
                        {
                            <option value="@severity">@severity</option>
                        }
                    </select>
                </label>

                <label class="field-row compact">
                    <span>Mode</span>
                    <select class="app-input" @bind="_modeFilter">
                        <option value="">All modes</option>
                        @foreach (var mode in ModeFilters)
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </label>
            </div>

            <div class="diagnostics-log-list">
                @if (FilteredEntries.Count == 0)
                {
                    <p class="panel-copy">No diagnostics entries match the current filters.</p>
                }
                else
                {
                    @foreach (var entry in FilteredEntries)
                    {
                        <button class="diagnostics-log-item" type="button" @onclick="@(() => _selectedEntry = entry)">
                            <div class="task-group-header">
                                <strong>@entry.Operation</strong>
                                <span class="ui-pill @(GetSeverityPillClass(entry.Severity))">@entry.Severity</span>
                            </div>
                            <span>@entry.Message</span>
                            <span class="dashboard-stat-note">@entry.FeatureArea • @entry.Mode • @entry.OccurredAtUtc.ToLocalTime():g</span>
                            <code class="diagnostics-metadata-inline">@FormatMetadataCompact(entry)</code>
                        </button>
                    }
                }
            </div>

            @if (_selectedEntry is not null)
            {
                <div class="diagnostics-preview">
                    <div class="task-group-header">
                        <strong>@_selectedEntry.Operation</strong>
                        <span class="ui-pill count-pill">@_selectedEntry.FeatureArea</span>
                    </div>
                    <p class="panel-copy">@_selectedEntry.Message</p>
                    <pre>@FormatEntryJson(_selectedEntry)</pre>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private bool _acknowledgeGearMutation;
    private LiveTestSuiteResult? _lastRunResult;
    private DiagnosticsPresetRunResult? _lastPresetResult;
    private Habitica.Domain.Diagnostics.DiagnosticsLogEntry? _selectedEntry;
    private string _featureFilter = string.Empty;
    private string _severityFilter = string.Empty;
    private string _modeFilter = string.Empty;

    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private IReadOnlyList<string> FeatureFilters =>
        SessionController.State.DiagnosticsLogEntries?
            .Select(entry => entry.FeatureArea.ToString())
            .Distinct(StringComparer.Ordinal)
            .OrderBy(static value => value, StringComparer.Ordinal)
            .ToArray() ?? Array.Empty<string>();

    private IReadOnlyList<string> SeverityFilters =>
        SessionController.State.DiagnosticsLogEntries?
            .Select(entry => entry.Severity.ToString())
            .Distinct(StringComparer.Ordinal)
            .OrderBy(static value => value, StringComparer.Ordinal)
            .ToArray() ?? Array.Empty<string>();

    private IReadOnlyList<string> ModeFilters =>
        SessionController.State.DiagnosticsLogEntries?
            .Select(entry => entry.Mode.ToString())
            .Distinct(StringComparer.Ordinal)
            .OrderBy(static value => value, StringComparer.Ordinal)
            .ToArray() ?? Array.Empty<string>();

    private IReadOnlyList<Habitica.Domain.Diagnostics.DiagnosticsLogEntry> FilteredEntries =>
        SessionController.State.DiagnosticsLogEntries?
            .Where(entry => string.IsNullOrWhiteSpace(_featureFilter) || string.Equals(entry.FeatureArea.ToString(), _featureFilter, StringComparison.Ordinal))
            .Where(entry => string.IsNullOrWhiteSpace(_severityFilter) || string.Equals(entry.Severity.ToString(), _severityFilter, StringComparison.Ordinal))
            .Where(entry => string.IsNullOrWhiteSpace(_modeFilter) || string.Equals(entry.Mode.ToString(), _modeFilter, StringComparison.Ordinal))
            .ToArray() ?? Array.Empty<Habitica.Domain.Diagnostics.DiagnosticsLogEntry>();

    private async Task RunSafeLiveTestsAsync()
    {
        _lastRunResult = await SessionController.RunSafeLiveTestsAsync();
    }

    private async Task RunReversibleGearTestAsync()
    {
        _lastRunResult = await SessionController.RunReversibleGearTestAsync();
    }

    private async Task RunPresetAsync(DiagnosticsPreset preset)
    {
        _lastPresetResult = await SessionController.RunDiagnosticsPresetAsync(preset);
    }

    private async Task ClearLogsAsync()
    {
        _selectedEntry = null;
        await SessionController.ClearDiagnosticsLogsAsync();
    }

    private async Task CopyLogsAsync()
    {
        var module = await GetExportModuleAsync();
        await module.InvokeVoidAsync("copyText", FormatEntriesJsonl(FilteredEntries));
    }

    private async Task DownloadLogsAsync()
    {
        var module = await GetExportModuleAsync();
        await module.InvokeVoidAsync(
            "downloadTextFile",
            $"habitica-tool-diagnostics-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.jsonl",
            FormatEntriesJsonl(FilteredEntries));
    }

    private static string GetStatusLabel(LiveTestStatus status)
    {
        return status switch
        {
            LiveTestStatus.Passed => "Passed",
            LiveTestStatus.Failed => "Failed",
            _ => "Skipped"
        };
    }

    private static string GetStatusPillClass(LiveTestStatus status)
    {
        return status switch
        {
            LiveTestStatus.Passed => "success-pill",
            LiveTestStatus.Failed => "danger-pill",
            _ => "count-pill"
        };
    }

    private static string GetSeverityPillClass(Habitica.Domain.Diagnostics.DiagnosticsSeverity severity)
    {
        return severity switch
        {
            Habitica.Domain.Diagnostics.DiagnosticsSeverity.Success => "success-pill",
            Habitica.Domain.Diagnostics.DiagnosticsSeverity.Warning => "count-pill",
            Habitica.Domain.Diagnostics.DiagnosticsSeverity.Error => "danger-pill",
            _ => "ui-pill"
        };
    }

    private static string FormatEntryJson(Habitica.Domain.Diagnostics.DiagnosticsLogEntry entry)
    {
        return JsonSerializer.Serialize(entry, JsonOptions);
    }

    private static string FormatMetadataCompact(Habitica.Domain.Diagnostics.DiagnosticsLogEntry entry)
    {
        return entry.Metadata.Count == 0
            ? "{}"
            : string.Join(" ", entry.Metadata.Select(pair => $"{pair.Key}={pair.Value}"));
    }

    private static string FormatEntriesJsonl(IReadOnlyList<Habitica.Domain.Diagnostics.DiagnosticsLogEntry> entries)
    {
        return string.Join(Environment.NewLine, entries.Select(entry => JsonSerializer.Serialize(entry, JsonOptions)));
    }

    private async Task<IJSObjectReference> GetExportModuleAsync()
    {
        _exportModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/diagnosticsExport.js");
        return _exportModule;
    }

    private void HandleStateChanged()
    {
        if (_selectedEntry is not null && !FilteredEntries.Any(entry => entry.Id == _selectedEntry.Id))
        {
            _selectedEntry = null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = false
    };

    private IJSObjectReference? _exportModule;
}
