@page "/spells"
@implements IDisposable
@using System.Globalization
@using Habitica.Application.Dashboard
@using Habitica.Domain.Party
@using Habitica.Storage
@inject SpellViewModelFactory SpellViewModelFactory
@inject IAppSessionController SessionController
@inject IKeyValueStorage KeyValueStorage
@inject ISnackbar Snackbar

<PageTitle>Spells</PageTitle>

<div class="spells-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Skills and buffs</p>
            <h1>Spells</h1>
            <p class="panel-copy">
                Cast current-class skills from fresh Habitica data. Estimates are approximate and use saved stats, task values, and gear data.
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            @if (SessionController.State.IsAuthenticated)
            {
                <span>No saved account data is available yet. Refresh before opening spells.</span>
            }
            else
            {
                <span>No saved account data is available on this device yet. Sign in before opening spells.</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
        </MudAlert>
    }
    else
    {
        var viewModel = CurrentViewModel;
        var canMutate = SessionController.State.IsAuthenticated
            && !SessionController.State.IsBusy
            && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh;

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.UserFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.UserFreshness)
        </MudAlert>

        <section aria-label="Current mana" class="spell-mana-bar" data-testid="spells-mana-bar">
            <div>
                <span class="dashboard-stat-label">Available mana</span>
                <strong>@FormatDecimal(viewModel.Mana) / @FormatDecimal(viewModel.MaxMana) MP</strong>
            </div>
            <div class="spell-mana-bar-meter" aria-hidden="true">
                <span style="@GetManaWidthStyle(viewModel.Mana, viewModel.MaxMana)"></span>
            </div>
            <div class="spell-mana-bar-meta">
                <span class="ui-pill">@FormatReadableName(viewModel.ClassName)</span>
                <span class="dashboard-stat-note">Max @FormatDecimal(viewModel.MaxMana) MP</span>
            </div>
        </section>

        @if (viewModel.Spells.Count == 0)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                No class spells are available for the saved account class.
            </MudAlert>
        }
        else
        {
            var isAnySpellOperationActive = SessionController.State.ActiveSpellCastProgress is not null;
            <section class="spells-grid">
                @foreach (var spell in viewModel.Spells)
                {
                    var count = GetSpellCount(spell.Id);
                    var selectedTarget = GetSelectedTarget(spell, viewModel.TargetTasks);
                    var autoEquip = GetAutoEquip(spell);
                    var selectedRecommendation = GetSelectedRecommendation(spell);
                    var blessingPreview = GetBlessingPreview(spell, autoEquip, selectedRecommendation);
                    var blessingWarningKind = blessingPreview is null ? SpellBlessingWarningKind.None : GetBlessingWarningKind(blessingPreview, count);
                    var isCasting = SessionController.State.ActiveSpellCastProgress?.SpellId == spell.Id;
                    var controlsDisabled = isAnySpellOperationActive;
                    var equipmentProgress = GetEquipmentProgress(spell.Id);
                    var totalMana = spell.ManaCost * count;
                    var hasEnoughMana = totalMana <= viewModel.Mana;
                    var manaAfterCast = viewModel.Mana - totalMana;
                    var maxAffordableCasts = GetMaxAffordableCasts(spell, viewModel.Mana);
                    var bossQuestContext = GetBossQuestContext(SessionController.State.PartySnapshot?.Quest, spell);
                    var showStatPointContext = viewModel.IsStatAllocationUnlocked
                        && viewModel.UnallocatedStatPoints > 0
                        && spell.HasStatPointContext;
                    var canSpendAllMana = canMutate
                        && !controlsDisabled
                        && spell.IsUnlocked
                        && maxAffordableCasts > 0;
                    var castDisabled = !canMutate
                        || controlsDisabled
                        || !spell.IsUnlocked
                        || !hasEnoughMana
                        || (spell.TargetKind == SpellTargetKind.Task && !HasTarget(viewModel.TargetTasks, selectedTarget));

                    <article class="spell-card spell-block">
                        <div class="spell-card-section spell-card-summary">
                            <div class="habitica-spell-identity">
                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Skill(spell.Id, spell.Name)" Loading="eager" />
                                <div>
                                    <p class="section-label">@spell.TargetKind</p>
                                    <h2>@spell.Name</h2>
                                    <p>@GetSpellDescription(spell, selectedTarget)</p>
                                </div>
                            </div>
                            <div class="spell-cost-stack">
                                <span class="ui-pill">@spell.ManaCost MP</span>
                                <span class="ui-pill @(spell.IsUnlocked ? "success-pill" : "warning-pill")">@spell.AvailabilityLabel</span>
                            </div>
                        </div>

                        @if (bossQuestContext is not null)
                        {
                            <div class="spell-card-section spell-effect-preview" data-testid="@($"spell-boss-context-{spell.Id}")">
                                <p class="section-label">Boss quest</p>
                                <p>
                                    @GetQuestTitle(bossQuestContext.Quest): @FormatQuestMetric(bossQuestContext.BossProgress).
                                    Party pending: @FormatQuestMetric(bossQuestContext.PendingPartyDamage).
                                </p>
                            </div>
                        }

                        @if (showStatPointContext)
                        {
                            <div class="spell-card-section spell-effect-preview" data-testid="@($"spell-stat-context-{spell.Id}")">
                                <p class="section-label">Stat points</p>
                                <p>
                                    @viewModel.UnallocatedStatPoints unspent. <a href="/dashboard#stats">Allocate on Dashboard</a> before casting if you want this estimate to include them.
                                </p>
                            </div>
                        }

                        <div class="spell-card-section spell-cast-section">
                            <div class="spell-cast-controls">
                                <div class="spell-cast-inputs">
                                    <label class="field-row compact spell-count-field">
                                        <span>Count</span>
                                        <input class="app-input"
                                               data-testid="@($"spell-count-{spell.Id}")"
                                               disabled="@controlsDisabled"
                                               min="1"
                                               type="number"
                                               value="@count"
                                               @onchange="eventArgs => SetSpellCount(spell.Id, eventArgs.Value?.ToString())" />
                                    </label>

                                    @if (spell.TargetKind == SpellTargetKind.Task)
                                    {
                                        <label class="field-row compact spell-target-field">
                                            <span>Target</span>
                                            <select class="app-input" disabled="@controlsDisabled" value="@selectedTarget" @onchange="eventArgs => SetSelectedTarget(spell.Id, eventArgs.Value?.ToString())">
                                                @foreach (var task in viewModel.TargetTasks)
                                                {
                                                    <option value="@task.Id">@task.Text (@task.Type, value @FormatDecimal(task.Value))</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                </div>

                                <div class="spell-cast-status">
                                    <div class="spell-mana-preview @(hasEnoughMana ? string.Empty : "danger-mana")">
                                        <div class="spell-mana-preview-row">
                                            <span>Mana spent</span>
                                            <strong>@FormatDecimal(totalMana) MP</strong>
                                        </div>
                                        <div class="spell-mana-meter" aria-hidden="true">
                                            <span style="@GetManaWidthStyle(totalMana, viewModel.Mana)"></span>
                                        </div>
                                        <div class="spell-mana-preview-row">
                                            <span>Available</span>
                                            <strong>@FormatDecimal(viewModel.Mana) MP</strong>
                                        </div>
                                        <div class="spell-mana-preview-row">
                                            <span>After cast</span>
                                            <strong>@FormatDecimal(manaAfterCast) MP</strong>
                                        </div>
                                        @if (!hasEnoughMana)
                                        {
                                            <span class="spell-disabled-note">Not enough mana for this cast count.</span>
                                        }
                                    </div>

                                    <div class="spell-action-row">
                                        @if (spell.EquipmentRecommendations.Count > 0)
                                        {
                                            <label class="checkbox-row compact spell-auto-equip-field">
                                                <input data-testid="@($"spell-auto-equip-{spell.Id}")"
                                                       disabled="@controlsDisabled"
                                                       type="checkbox"
                                                       checked="@autoEquip"
                                                       @onchange="eventArgs => SetAutoEquip(spell.Id, eventArgs.Value is true)" />
                                                <span>Auto equip</span>
                                            </label>
                                        }

                                        <MudButton Class="spell-spend-all-button"
                                                   Color="Color.Secondary"
                                                   Disabled="@(!canSpendAllMana)"
                                                   OnClick="() => SpendAllMana(spell.Id, maxAffordableCasts)"
                                                   Variant="Variant.Outlined"
                                                   data-testid="@($"spend-all-mana-{spell.Id}")">
                                            Spend All Mana
                                        </MudButton>

                                        <MudButton Class="spell-cast-button"
                                                   Color="Color.Primary"
                                                   Disabled="@castDisabled"
                                                   OnClick="() => RequestCastSpellAsync(spell, count, selectedTarget, autoEquip, selectedRecommendation)"
                                                   Variant="Variant.Filled"
                                                   data-testid="@($"cast-spell-{spell.Id}")">
                                            Cast
                                        </MudButton>
                                    </div>

                                    @if (blessingPreview is not null && blessingWarningKind != SpellBlessingWarningKind.None)
                                    {
                                        <p class="spell-healing-warning" data-testid="@($"spell-healing-warning-{spell.Id}")">
                                            @GetBlessingWarningText(blessingWarningKind)
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (IsPendingCronWarning(spell.Id))
                        {
                            var unfinishedDailies = GetCronUnfinishedDailies();
                            <div class="spell-card-section spell-cron-warning">
                                <div>
                                    <p class="section-label">Buff timing</p>
                                    <p>
                                        You haven't started your Habitica day yet. Buffs last until CRON. If you cast this buff before starting your new day, it may expire sooner than you expect. Party buffs expire separately for each member on that member's next CRON.
                                    </p>
                                </div>
                                <CronUnfinishedDailiesMiniList Dailies="@unfinishedDailies" OnComplete="CompleteCronDailyAsync" StartCollapsed="true" />
                                <label class="checkbox-row compact">
                                    <input type="checkbox"
                                           checked="@_suppressCronWarningForDay"
                                           @onchange="eventArgs => _suppressCronWarningForDay = eventArgs.Value is true" />
                                    <span>Do not warn again for this Habitica day</span>
                                </label>
                                <div class="spell-cron-warning-actions">
                                    <MudButton Color="Color.Default" Disabled="@SessionController.State.IsBusy" OnClick="CancelPendingCronWarning" Variant="Variant.Text">
                                        Cancel
                                    </MudButton>
                                    <MudButton Color="Color.Secondary" Disabled="@SessionController.State.IsBusy" OnClick="() => ContinuePendingCastAsync(false)" Variant="Variant.Outlined" data-testid="@($"cast-anyway-{spell.Id}")">
                                        Cast anyway
                                    </MudButton>
                                    <MudButton Color="Color.Primary" Disabled="@SessionController.State.IsBusy" OnClick="() => ContinuePendingCastAsync(true)" Variant="Variant.Filled" data-testid="@($"start-day-and-cast-{spell.Id}")">
                                        Start New Day and Cast
                                    </MudButton>
                                </div>
                            </div>
                        }

                        @if (isCasting)
                        {
                            var progress = SessionController.State.ActiveSpellCastProgress!;
                            <div class="spell-card-section spell-progress">
                                <div class="spell-progress-row">
                                    <span>@GetProgressLabel(progress)</span>
                                    <MudButton Color="Color.Secondary"
                                               OnClick="CancelActiveSpellCastAsync"
                                               Variant="Variant.Outlined"
                                               data-testid="@($"cancel-spell-cast-{spell.Id}")">
                                        Cancel
                                    </MudButton>
                                </div>
                                <MudProgressLinear Class="scheme-progress-primary" Color="Color.Primary" Max="@progress.Total" Value="@progress.Completed" />
                            </div>
                        }

                        @if (equipmentProgress is not null)
                        {
                            <div class="spell-card-section spell-progress">
                                <span>@equipmentProgress.Label: @equipmentProgress.Completed of @equipmentProgress.Total</span>
                                <MudProgressLinear Class="scheme-progress-secondary" Color="Color.Secondary" Max="@equipmentProgress.Total" Value="@equipmentProgress.Completed" />
                            </div>
                        }

                        <div class="spell-card-section spell-effect-preview">
                            <p class="section-label">Effect preview</p>
                            <p>@GetEstimatedEffect(spell, selectedTarget, count, autoEquip, selectedRecommendation)</p>
                        </div>

                        @if (spell.EquipmentRecommendations.Count > 0)
                        {
                            <div class="spell-card-section spell-equipment">
                                <p class="section-label">Equipment recommendations</p>
                                @if (spell.EquipmentRecommendations.Count > 1)
                                {
                                    <label class="field-row compact spell-recommendation-selector">
                                        <span>Auto equip option</span>
                                        <select class="app-input" data-testid="@($"spell-recommendation-selector-{spell.Id}")" disabled="@controlsDisabled" value="@selectedRecommendation?.Name" @onchange="eventArgs => SetSelectedRecommendation(spell.Id, eventArgs.Value?.ToString())">
                                            @foreach (var recommendation in spell.EquipmentRecommendations)
                                            {
                                                <option value="@recommendation.Name">@recommendation.Name</option>
                                            }
                                        </select>
                                    </label>
                                }
                                @foreach (var recommendation in spell.EquipmentRecommendations)
                                {
                                    <div class="spell-recommendation">
                                        <div>
                                            <strong>@recommendation.Name</strong>
                                            <div class="habitica-recommendation-gear-row" aria-label="@($"{recommendation.Name} gear")">
                                                @foreach (var gearKey in GetRecommendationGearKeys(recommendation))
                                                {
                                                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(gearKey, GetGearDisplayName(gearKey))" />
                                                }
                                            </div>
                                            <p>@recommendation.Rationale @FormatGearStats(recommendation.TotalStats)</p>
                                        </div>
                                        <MudButton Color="Color.Secondary"
                                                   Disabled="@(recommendation.IsEquipped || !canMutate)"
                                                   OnClick="() => EquipRecommendationAsync(spell, recommendation)"
                                                   Variant="@(recommendation.IsEquipped ? Variant.Outlined : Variant.Filled)"
                                                   data-testid="@($"equip-spell-recommendation-{spell.Id}-{recommendation.Name}")">
                                            @(recommendation.IsEquipped ? "Equipped" : "Equip")
                                        </MudButton>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }
    }
</div>

@code {
    private readonly Dictionary<string, int> _spellCounts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _selectedTargets = new(StringComparer.Ordinal);
    private readonly Dictionary<string, bool> _autoEquip = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _selectedRecommendations = new(StringComparer.Ordinal);
    private readonly HashSet<string> _completedCronDailyIds = new(StringComparer.Ordinal);
    private PendingSpellCast? _pendingCronWarning;
    private bool _suppressCronWarningForDay;

    private SpellsPageViewModel CurrentViewModel => SessionController.State.UserSnapshot is null
        ? new SpellsPageViewModel("unknown", 0, 0m, 0m, 0, false, "Stat allocation unlocks at level 10.", CharacterStatsSnapshot.Zero, Array.Empty<SpellTargetTaskViewModel>(), Array.Empty<SpellCardViewModel>())
        : SpellViewModelFactory.Create(
            SessionController.State.UserSnapshot,
            SessionController.State.TaskSnapshot,
            SessionController.State.GearCatalogSnapshot,
            SessionController.State.PartySnapshot,
            SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh,
            SessionController.State.PartyFreshness == SnapshotFreshnessState.Fresh);

    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private int GetSpellCount(string spellId)
    {
        return _spellCounts.TryGetValue(spellId, out var count) ? Math.Max(1, count) : 1;
    }

    private static int GetMaxAffordableCasts(SpellCardViewModel spell, decimal availableMana)
    {
        return spell.ManaCost <= 0m
            ? 0
            : Math.Clamp((int)Math.Floor(availableMana / spell.ManaCost), 0, 99);
    }

    private void SpendAllMana(string spellId, int count)
    {
        if (count > 0)
        {
            _spellCounts[spellId] = count;
        }
    }

    private void SetSpellCount(string spellId, string? rawValue)
    {
        _spellCounts[spellId] = int.TryParse(rawValue, out var parsed) ? Math.Clamp(parsed, 1, 99) : 1;
    }

    private string? GetSelectedTarget(SpellCardViewModel spell, IReadOnlyList<SpellTargetTaskViewModel> targetTasks)
    {
        if (_selectedTargets.TryGetValue(spell.Id, out var selectedTarget))
        {
            if (spell.TargetKind != SpellTargetKind.Task || HasTarget(targetTasks, selectedTarget))
            {
                return selectedTarget;
            }
        }

        _selectedTargets[spell.Id] = spell.SelectedTargetTaskId;
        return spell.SelectedTargetTaskId;
    }

    private void SetSelectedTarget(string spellId, string? targetId)
    {
        _selectedTargets[spellId] = targetId;
    }

    private bool GetAutoEquip(SpellCardViewModel spell)
    {
        return spell.EquipmentRecommendations.Count > 0
            && (!_autoEquip.TryGetValue(spell.Id, out var enabled) || enabled);
    }

    private void SetAutoEquip(string spellId, bool enabled)
    {
        _autoEquip[spellId] = enabled;
    }

    private SpellEquipmentRecommendation? GetSelectedRecommendation(SpellCardViewModel spell)
    {
        if (_selectedRecommendations.TryGetValue(spell.Id, out var selectedName))
        {
            var selected = spell.EquipmentRecommendations.FirstOrDefault(recommendation => string.Equals(recommendation.Name, selectedName, StringComparison.Ordinal));
            if (selected is not null)
            {
                return selected;
            }
        }

        var defaultRecommendation = spell.EquipmentRecommendations.FirstOrDefault();
        _selectedRecommendations[spell.Id] = defaultRecommendation?.Name;
        return defaultRecommendation;
    }

    private void SetSelectedRecommendation(string spellId, string? recommendationName)
    {
        _selectedRecommendations[spellId] = recommendationName;
    }

    private async Task RequestCastSpellAsync(
        SpellCardViewModel spell,
        int count,
        string? selectedTarget,
        bool autoEquip,
        SpellEquipmentRecommendation? recommendation)
    {
        var request = new SpellCastRequest(
            spell.Id,
            selectedTarget,
            count,
            autoEquip && recommendation is not null,
            autoEquip ? recommendation?.Slots : null);

        if (ShouldWarnBeforeCronSensitiveBuff(spell.Id)
            && !await IsCronWarningSuppressedAsync())
        {
            _suppressCronWarningForDay = false;
            _pendingCronWarning = new PendingSpellCast(spell.Id, request);
            return;
        }

        await CastSpellAsync(request);
    }

    private async Task CastSpellAsync(SpellCastRequest request)
    {
        var result = await SessionController.CastSpellAsync(request);
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private Task CancelActiveSpellCastAsync()
    {
        return SessionController.CancelActiveSpellCastAsync();
    }

    private IReadOnlyList<TaskSnapshot> GetCronUnfinishedDailies()
    {
        return PendingDamageEstimateFactory.GetIncompleteDailies(SessionController.State.TaskSnapshot)
            .Where(task => !_completedCronDailyIds.Contains(task.Id))
            .ToArray();
    }

    private async Task CompleteCronDailyAsync(TaskSnapshot daily)
    {
        var result = await SessionController.ScoreTaskAsync(new TaskScoreRequest(daily.Id, TaskScoreDirection.Up));
        if (result.Succeeded)
        {
            _completedCronDailyIds.Add(daily.Id);
        }

        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private bool ShouldWarnBeforeCronSensitiveBuff(string spellId)
    {
        return SessionController.State.UserSnapshot?.NeedsCron == true
            && IsCronSensitiveBuff(spellId);
    }

    private static bool IsCronSensitiveBuff(string spellId)
    {
        return spellId is "earth"
            or "defensiveStance"
            or "valorousPresence"
            or "intimidate"
            or "toolsOfTrade"
            or "protectAura";
    }

    private bool IsPendingCronWarning(string spellId)
    {
        return _pendingCronWarning is not null
            && string.Equals(_pendingCronWarning.SpellId, spellId, StringComparison.Ordinal);
    }

    private void CancelPendingCronWarning()
    {
        _pendingCronWarning = null;
        _suppressCronWarningForDay = false;
    }

    private async Task ContinuePendingCastAsync(bool startNewDayFirst)
    {
        if (_pendingCronWarning is null)
        {
            return;
        }

        var request = _pendingCronWarning.Request;
        if (_suppressCronWarningForDay)
        {
            await SaveCronWarningSuppressionAsync();
        }

        _pendingCronWarning = null;
        _suppressCronWarningForDay = false;

        if (startNewDayFirst)
        {
            var cronResult = await SessionController.StartNewDayAsync();
            Snackbar.Add(cronResult.Message, cronResult.Succeeded ? Severity.Success : Severity.Error);
            if (!cronResult.Succeeded)
            {
                return;
            }
        }

        await CastSpellAsync(request);
    }

    private async Task<bool> IsCronWarningSuppressedAsync()
    {
        var key = GetCronWarningSuppressionKey();
        return await KeyValueStorage.GetAsync<bool>(key, CancellationToken.None);
    }

    private Task SaveCronWarningSuppressionAsync()
    {
        return KeyValueStorage.SetAsync(GetCronWarningSuppressionKey(), true, CancellationToken.None);
    }

    private string GetCronWarningSuppressionKey()
    {
        var userId = string.IsNullOrWhiteSpace(SessionController.State.UserId)
            ? "local"
            : SessionController.State.UserId;
        var dayKey = SessionController.State.UserSnapshot?.CurrentHabiticaDayKey
            ?? DateTimeOffset.UtcNow.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return $"{StorageKeys.SpellCronWarningSuppression}/{userId}/{dayKey}";
    }

    private async Task EquipRecommendationAsync(SpellCardViewModel spell, SpellEquipmentRecommendation recommendation)
    {
        var result = await SessionController.EquipGearSlotsAsync(
            EquipmentSetKind.Battle,
            recommendation.Slots,
            $"spell:{spell.Id}:{recommendation.Name}",
            $"Equipping {recommendation.Name}");
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private static IEnumerable<string> GetRecommendationGearKeys(SpellEquipmentRecommendation recommendation)
    {
        if (!string.IsNullOrWhiteSpace(recommendation.Slots.Head))
        {
            yield return recommendation.Slots.Head;
        }

        if (!string.IsNullOrWhiteSpace(recommendation.Slots.Armor))
        {
            yield return recommendation.Slots.Armor;
        }

        if (!string.IsNullOrWhiteSpace(recommendation.Slots.Weapon))
        {
            yield return recommendation.Slots.Weapon;
        }

        if (!string.IsNullOrWhiteSpace(recommendation.Slots.Shield))
        {
            yield return recommendation.Slots.Shield;
        }

        if (!string.IsNullOrWhiteSpace(recommendation.Slots.Back))
        {
            yield return recommendation.Slots.Back;
        }
    }

    private string GetGearDisplayName(string key)
    {
        return SessionController.State.GearCatalogSnapshot?.Items.TryGetValue(key, out var item) == true
            ? item.Text
            : FormatReadableName(key);
    }

    private static string FormatGearStats(GearStatBlock stats)
    {
        return $"STR {stats.Strength:0.##} / INT {stats.Intelligence:0.##} / CON {stats.Constitution:0.##} / PER {stats.Perception:0.##}";
    }

    private static string FormatDecimal(decimal value)
    {
        return value.ToString("0.##");
    }

    private static string GetManaWidthStyle(decimal value, decimal total)
    {
        if (total <= 0m)
        {
            return "width: 0%;";
        }

        var percent = Math.Clamp(Math.Round(value / total * 100m, 2), 0m, 100m);
        return $"width: {percent.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private static string FormatReadableName(string value)
    {
        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' ').Replace('-', ' '));
    }

    private static string FormatQuestMetric(PartyQuestMetricSnapshot? metric)
    {
        if (metric is null)
        {
            return "Unknown";
        }

        var value = FormatDecimal(metric.Value);
        return metric.Total is null
            ? $"{value} {metric.Unit}"
            : $"{value}/{FormatDecimal(metric.Total.Value)} {metric.Unit}";
    }

    private static SpellBossQuestContext? GetBossQuestContext(PartyQuestSnapshot? quest, SpellCardViewModel spell)
    {
        if (quest is null
            || !quest.IsActive
            || !IsBossQuest(quest)
            || !CanDamageBoss(spell))
        {
            return null;
        }

        var bossProgress = GetBossProgress(quest);
        var pendingPartyDamage = GetPendingPartyDamage(quest);
        return bossProgress is null || pendingPartyDamage is null
            ? null
            : new SpellBossQuestContext(quest, bossProgress, pendingPartyDamage);
    }

    private static bool IsBossQuest(PartyQuestSnapshot quest)
    {
        return quest.QuestType == PartyQuestType.Boss
            || quest.BossHealthRemaining is not null
            || string.Equals(quest.AppliedProgress?.Unit, "hp", StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanDamageBoss(SpellCardViewModel spell)
    {
        return spell.EstimatedEffectValues.Any(static value => string.Equals(value.Unit, "boss damage", StringComparison.OrdinalIgnoreCase));
    }

    private static PartyQuestMetricSnapshot? GetBossProgress(PartyQuestSnapshot quest)
    {
        if (quest.AppliedProgress is not null)
        {
            return quest.AppliedProgress;
        }

        if (quest.BossHealthRemaining is not null)
        {
            return new PartyQuestMetricSnapshot(
                "Current boss HP",
                quest.BossHealthRemaining.Value,
                quest.BossHealthTotal,
                "hp");
        }

        return null;
    }

    private static PartyQuestMetricSnapshot? GetPendingPartyDamage(PartyQuestSnapshot quest)
    {
        if (quest.PendingPartyProgress is not null
            && string.Equals(quest.PendingPartyProgress.Unit, "damage", StringComparison.OrdinalIgnoreCase))
        {
            return quest.PendingPartyProgress;
        }

        if (quest.TotalPendingDamage is not null)
        {
            return new PartyQuestMetricSnapshot("Pending party damage", quest.TotalPendingDamage.Value, null, "damage");
        }

        if (quest.PendingPartyDamage is not null)
        {
            return new PartyQuestMetricSnapshot("Pending party damage", quest.PendingPartyDamage.Value, null, "damage");
        }

        if (quest.PendingDamage is not null)
        {
            return new PartyQuestMetricSnapshot("Pending party damage", quest.PendingDamage.Value, null, "damage");
        }

        return null;
    }

    private static string GetQuestTitle(PartyQuestSnapshot quest)
    {
        return string.IsNullOrWhiteSpace(quest.Name) ? "Current quest" : quest.Name;
    }

    private static string GetSpellDescription(SpellCardViewModel spell, string? selectedTarget)
    {
        return selectedTarget is not null && spell.TargetDescriptions.TryGetValue(selectedTarget, out var description)
            ? description
            : spell.Description;
    }

    private static string GetEstimatedEffect(
        SpellCardViewModel spell,
        string? selectedTarget,
        int count,
        bool autoEquip,
        SpellEquipmentRecommendation? recommendation)
    {
        var estimateSource = autoEquip && recommendation is not null
            ? new EffectEstimateSource(
                recommendation.EstimatedEffect,
                recommendation.EstimatedEffectValues,
                recommendation.BlessingPreview,
                recommendation.TargetEstimates,
                recommendation.TargetEffectValues)
            : new EffectEstimateSource(
                spell.EstimatedEffect,
                spell.EstimatedEffectValues,
                spell.BlessingPreview,
                spell.TargetEstimates,
                spell.TargetEffectValues);
        if (estimateSource.BlessingPreview is not null)
        {
            return FormatBlessingEstimate(estimateSource.BlessingPreview, count);
        }

        var estimate = selectedTarget is not null && estimateSource.TargetEstimates.TryGetValue(selectedTarget, out var selectedEstimate)
            ? selectedEstimate
            : estimateSource.DefaultEstimate;
        var values = selectedTarget is not null && estimateSource.TargetEffectValues.TryGetValue(selectedTarget, out var selectedValues)
            ? selectedValues
            : estimateSource.DefaultValues;
        if (count <= 1 || values.Count == 0)
        {
            return estimate;
        }

        return $"{estimate} Total for {count} casts: approximately {string.Join(" and ", values.Select(value => $"{value.Value * count:0.##} {value.Unit}"))}.";
    }

    private static SpellBlessingEffectPreview? GetBlessingPreview(
        SpellCardViewModel spell,
        bool autoEquip,
        SpellEquipmentRecommendation? recommendation)
    {
        return autoEquip && recommendation is not null
            ? recommendation.BlessingPreview ?? spell.BlessingPreview
            : spell.BlessingPreview;
    }

    private static string FormatBlessingEstimate(SpellBlessingEffectPreview preview, int count)
    {
        var castCount = Math.Max(1, count);
        var primary = castCount == 1
            ? $"Restores approximately {FormatDecimal(preview.RawHealPerMemberPerCast)} HP per party member."
            : $"Restores approximately {FormatDecimal(preview.RawHealPerMemberPerCast)} HP per party member per cast. Total for {castCount} casts: approximately {FormatDecimal(preview.RawHealPerMemberPerCast * castCount)} HP per party member.";
        var capNote = preview.HasFreshPartyHealth
            && HasBlessingCapping(preview, castCount)
            ? " Effective healing may be lower for members already near full HP."
            : string.Empty;
        var unknownNote = preview.HasUnknownPartyHealth
            ? " Some party HP data is unavailable, so effective healing may differ."
            : string.Empty;

        return primary + capNote + unknownNote;
    }

    private static SpellBlessingWarningKind GetBlessingWarningKind(SpellBlessingEffectPreview preview, int count)
    {
        var castCount = Math.Max(1, count);
        if (!preview.HasFreshPartyHealth || preview.CoveredMemberMissingHealth.Count == 0)
        {
            return preview.WarningKind;
        }

        var rawTotal = preview.RawHealPerMemberPerCast * castCount;
        var effectiveHeals = preview.CoveredMemberMissingHealth
            .Select(missingHealth => Math.Min(rawTotal, Math.Max(0m, missingHealth)))
            .ToArray();
        var fullValueCount = effectiveHeals.Count(heal => heal >= rawTotal);
        var noEffectCount = effectiveHeals.Count(static heal => heal <= 0m);
        var cappedMemberCount = Math.Max(0, effectiveHeals.Length - fullValueCount);
        var totalEffectiveHeal = effectiveHeals.Sum();

        if (noEffectCount == effectiveHeals.Length || totalEffectiveHeal <= 0m)
        {
            return SpellBlessingWarningKind.NoMeaningfulHealing;
        }

        if (cappedMemberCount * 5 >= effectiveHeals.Length * 4)
        {
            return SpellBlessingWarningKind.LowNeed;
        }

        return cappedMemberCount * 2 > effectiveHeals.Length
            ? SpellBlessingWarningKind.LimitedValue
            : SpellBlessingWarningKind.None;
    }

    private static bool HasBlessingCapping(SpellBlessingEffectPreview preview, int count)
    {
        if (!preview.HasFreshPartyHealth || preview.CoveredMemberMissingHealth.Count == 0)
        {
            return false;
        }

        var rawTotal = preview.RawHealPerMemberPerCast * Math.Max(1, count);
        return preview.CoveredMemberMissingHealth.Any(missingHealth => Math.Max(0m, missingHealth) < rawTotal);
    }

    private static string GetBlessingWarningText(SpellBlessingWarningKind warningKind)
    {
        return warningKind switch
        {
            SpellBlessingWarningKind.NoMeaningfulHealing => "No meaningful healing is needed right now.",
            SpellBlessingWarningKind.LowNeed => "Party HP is already high. Blessing is probably not needed right now.",
            SpellBlessingWarningKind.LimitedValue => "Healing value is limited because most covered members are already near full HP.",
            _ => string.Empty
        };
    }

    private EquipmentProgress? GetEquipmentProgress(string spellId)
    {
        var progress = SessionController.State.ActiveEquipmentProgress;
        return progress is not null && progress.OperationId.StartsWith($"spell:{spellId}:", StringComparison.Ordinal)
            ? progress
            : null;
    }

    private static bool HasTarget(IReadOnlyList<SpellTargetTaskViewModel> targetTasks, string? selectedTarget)
    {
        return !string.IsNullOrWhiteSpace(selectedTarget)
            && targetTasks.Any(task => string.Equals(task.Id, selectedTarget, StringComparison.Ordinal));
    }

    private static string GetProgressLabel(SpellCastProgress progress)
    {
        return string.IsNullOrWhiteSpace(progress.Label)
            ? $"Casting {progress.Completed} of {progress.Total}"
            : progress.Label;
    }

    private sealed record EffectEstimateSource(
        string DefaultEstimate,
        IReadOnlyList<SpellEffectValue> DefaultValues,
        SpellBlessingEffectPreview? BlessingPreview,
        IReadOnlyDictionary<string, string> TargetEstimates,
        IReadOnlyDictionary<string, IReadOnlyList<SpellEffectValue>> TargetEffectValues);

    private sealed record PendingSpellCast(
        string SpellId,
        SpellCastRequest Request);

    private sealed record SpellBossQuestContext(
        PartyQuestSnapshot Quest,
        PartyQuestMetricSnapshot BossProgress,
        PartyQuestMetricSnapshot PendingPartyDamage);

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Account data is up to date",
            SnapshotFreshnessState.Stale => "Account data may need refresh",
            SnapshotFreshnessState.Expired => "Account data needs refresh",
            _ => "No saved account data"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }
}
