@page "/inventory"
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@inject InventoryViewModelFactory InventoryViewModelFactory
@inject IAppSessionController SessionController
@inject ISnackbar Snackbar

<PageTitle>Inventory</PageTitle>

<div class="inventory-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Equipment explorer</p>
            <h1>Inventory and equipped gear</h1>
            <p class="panel-copy">
                Compare owned gear, save battle presets, and equip items from fresh Habitica account data.
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            No saved account data is available yet. Sign in or refresh before opening the equipment explorer.
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.UserSnapshot;
        var viewModel = InventoryViewModelFactory.Create(
            snapshot,
            SessionController.State.GearCatalogSnapshot,
            SessionController.State.Presets);
        var recommendation = InventoryViewModelFactory.CreateRecommendation(
            snapshot,
            SessionController.State.GearCatalogSnapshot,
            _optimizationGoal);
        var bulkSellPlan = GetBulkSellPlan(snapshot.Inventory).ToArray();
        var safeBulkSellPlan = bulkSellPlan.Where(static item => item.IsSafe).ToArray();
        var canMutate = SessionController.State.IsAuthenticated
            && !SessionController.State.IsBusy
            && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh;

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.UserFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.UserFreshness)
        </MudAlert>

        <section class="inventory-summary-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Owned gear</span>
                <strong>@snapshot.Inventory.OwnedGearKeys.Length</strong>
                <span class="dashboard-stat-note">Ready for comparison and equipment changes.</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Current companion</span>
                <div class="habitica-image-row">
                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Pet(snapshot.CurrentPetKey, FormatReadableName(snapshot.CurrentPetKey, "No pet"))" Loading="eager" />
                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Mount(snapshot.CurrentMountKey, FormatReadableName(snapshot.CurrentMountKey, "No mount"))" Loading="eager" />
                </div>
                <strong>@FormatReadableName(snapshot.CurrentPetKey, "None")</strong>
                <span class="dashboard-stat-note">Mount: @FormatReadableName(snapshot.CurrentMountKey, "None")</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Item counts</span>
                <div class="habitica-icon-chip-grid">
                    @RenderImageCountChip(HabiticaImageAssetResolver.EggSummary(), snapshot.Inventory.EggCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.FoodSummary(), snapshot.Inventory.FoodCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.HatchingPotionSummary(), snapshot.Inventory.HatchingPotionCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.QuestScrollSummary(), snapshot.Inventory.QuestCount)
                </div>
            </article>
        </section>

        <section class="inventory-management-grid">
            <article class="card-surface inventory-group-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Equipped battle gear</p>
                        <h2>Battle loadout</h2>
                    </div>
                    @RenderStats(viewModel.BattleEquipped.TotalStats)
                </div>

                @RenderEquippedSet(viewModel.BattleEquipped)

                <div class="preset-save-row">
                    <input class="app-input" placeholder="Preset name" @bind="_battlePresetName" @bind:event="oninput" />
                    <MudButton Color="Color.Primary" Disabled="@(!canMutate || string.IsNullOrWhiteSpace(_battlePresetName))" OnClick="@(() => SavePresetAsync(EquipmentSetKind.Battle))" Variant="Variant.Filled">
                        Save battle gear preset
                    </MudButton>
                </div>
            </article>
        </section>

        <section class="inventory-planning-grid">
            <article class="card-surface inventory-group-card optimizer-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Gear planning</p>
                        <h2>Equipment optimizer</h2>
                    </div>
                    <label class="field-row compact">
                        <span>Goal</span>
                        <select class="app-input" value="@_optimizationGoal.ToString()" @onchange="eventArgs => SetOptimizationGoal(eventArgs.Value?.ToString())" data-testid="equipment-optimizer-goal">
                            @foreach (var goal in Enum.GetValues<EquipmentOptimizationGoal>())
                            {
                                <option value="@goal.ToString()">@FormatOptimizationGoal(goal)</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="optimizer-stat-grid">
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Current</span>
                        @RenderStats(recommendation.CurrentStats)
                    </article>
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Recommended</span>
                        @RenderStats(recommendation.RecommendedStats)
                    </article>
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Delta</span>
                        @RenderStatDelta(recommendation.Delta)
                    </article>
                </div>

                @if (recommendation.Items.Count == 0)
                {
                    <p class="panel-copy">No stat-bearing owned gear is available for this recommendation.</p>
                }
                else
                {
                    <div class="preset-item-strip optimizer-item-strip">
                        @foreach (var item in recommendation.Items)
                        {
                            <article class="preset-mini-item">
                                <span class="dashboard-stat-label">@item.SlotTitle</span>
                                <div class="habitica-item-identity">
                                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                    <div>
                                        <strong>@item.DisplayName</strong>
                                        @RenderStats(item.TotalStats)
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }

                <div class="preset-save-row">
                    <input class="app-input" placeholder="Recommendation preset name" @bind="_optimizerPresetName" @bind:event="oninput" data-testid="optimizer-preset-name" />
                    <div class="action-row inventory-actions">
                        <MudButton Color="Color.Primary"
                                   Disabled="@(!canMutate || !recommendation.HasRecommendation)"
                                   OnClick="@(() => EquipRecommendationAsync(recommendation))"
                                   Variant="Variant.Filled"
                                   data-testid="equip-optimizer-recommendation">
                            Equip recommendation
                        </MudButton>
                        <MudButton Color="Color.Secondary"
                                   Disabled="@(!canMutate || !recommendation.HasRecommendation || string.IsNullOrWhiteSpace(_optimizerPresetName))"
                                   OnClick="@(() => SaveRecommendationPresetAsync(recommendation))"
                                   Variant="Variant.Outlined"
                                   data-testid="save-optimizer-recommendation">
                            Save recommendation
                        </MudButton>
                    </div>
                </div>
            </article>

            <article class="card-surface inventory-group-card bulk-sell-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Bulk sell planner</p>
                        <h2>Safe item sell preview</h2>
                    </div>
                    <label class="field-row compact">
                        <span>Keep count</span>
                        <input class="app-input" min="0" max="99" type="number" value="@_bulkSellKeepCount" @onchange="eventArgs => SetBulkSellKeepCount(eventArgs.Value?.ToString())" data-testid="bulk-sell-keep-count" />
                    </label>
                </div>

                @if (bulkSellPlan.Length == 0)
                {
                    <p class="panel-copy">No eggs, food, or hatching potions are available in the cached inventory snapshot.</p>
                }
                else
                {
                    <div class="bulk-sell-list">
                        @foreach (var item in bulkSellPlan)
                        {
                            <article class="@GetBulkSellItemClass(item)">
                                <div>
                                    <strong>@FormatReadableName(item.Key, item.Key)</strong>
                                    <span class="dashboard-stat-note">@FormatSellType(item.Type) • owned @item.OwnedCount • sell @item.SellCount</span>
                                </div>
                                <span class="dashboard-stat-note">@item.Explanation</span>
                            </article>
                        }
                    </div>
                }

                @if (_showBulkSellConfirmation)
                {
                    <div class="preset-remove-confirm">
                        <span>Sell @safeBulkSellPlan.Sum(static item => item.SellCount) planned item(s)?</span>
                        <MudButton Color="Color.Error"
                                   Disabled="@(!canMutate || safeBulkSellPlan.Length == 0)"
                                   OnClick="@(() => SellBulkPlanAsync(safeBulkSellPlan))"
                                   Variant="Variant.Filled"
                                   data-testid="execute-bulk-sell">
                            Sell planned items
                        </MudButton>
                        <MudButton OnClick="@(() => _showBulkSellConfirmation = false)" Variant="Variant.Text">
                            Cancel
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudButton Color="Color.Error"
                               Disabled="@(!canMutate || safeBulkSellPlan.Length == 0)"
                               OnClick="@(() => _showBulkSellConfirmation = true)"
                               Variant="Variant.Outlined"
                               data-testid="confirm-bulk-sell">
                        Confirm bulk sell plan
                    </MudButton>
                }
            </article>
        </section>

        <section class="inventory-preset-section">
            <article class="card-surface inventory-group-card inventory-preset-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Battle gear presets</p>
                        <h2>Saved battle presets</h2>
                    </div>
                    <span class="ui-pill count-pill">@viewModel.BattlePresets.Count</span>
                </div>
                @RenderPresetList(viewModel.BattlePresets, canMutate)
            </article>
        </section>

        @if (viewModel.Groups.Count == 0)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                No owned gear is saved yet. Refresh inventory after signing in.
            </MudAlert>
        }
        else
        {
            <div class="inventory-group-grid">
                @foreach (var group in viewModel.Groups)
                {
                    var otherItemsExpanded = IsOtherItemsExpanded(group.SlotTitle);
                    <section class="card-surface inventory-group-card">
                        <div class="task-group-header">
                            <h2>@group.SlotTitle</h2>
                            <span class="ui-pill count-pill">@group.Items.Count</span>
                        </div>

                        @if (group.BestItems.Count > 0)
                        {
                            <div class="best-category-block">
                                <div class="task-group-header">
                                    <h3>Best in Category</h3>
                                    <span class="ui-pill count-pill">@group.BestItems.Count</span>
                                </div>

                                <div class="preset-item-strip">
                                    @foreach (var item in group.BestItems)
                                    {
                                        <article class="preset-mini-item">
                                            <div class="habitica-item-identity">
                                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                                <div>
                                                    <strong>@item.DisplayName</strong>
                                                    <span class="dashboard-stat-note">@FormatGearInfo(item.SlotTitle, item.ClassName)</span>
                                                    @RenderStats(item.TotalStats)
                                                </div>
                                            </div>
                                            <MudButton HtmlTag="button" data-testid="@($"equip-best-{item.Key}")" Color="Color.Primary" Disabled="@(!canMutate || item.IsBattleEquipped)" OnClick="@(() => EquipItemAsync(EquipmentSetKind.Battle, item.Key))" Size="Size.Small" Variant="Variant.Outlined">
                                                @(item.IsBattleEquipped ? "Equipped battle" : "Equip item")
                                            </MudButton>
                                        </article>
                                    }
                                </div>
                            </div>
                        }

                        <div class="other-items-toggle-row">
                            <MudButton HtmlTag="button" data-testid="@($"toggle-other-items-{group.SlotTitle}")" OnClick="@(() => ToggleOtherItems(group.SlotTitle))" Variant="Variant.Text">
                                @(otherItemsExpanded ? "Hide other items" : $"Show other items ({group.Items.Count})")
                            </MudButton>
                        </div>

                        @if (otherItemsExpanded)
                        {
                            <div class="inventory-item-list">
                                @foreach (var item in group.Items)
                                {
                                    <article class="inventory-item-card">
                                        <div class="task-group-header">
                                            <div class="habitica-item-identity">
                                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                                <div>
                                                    <strong>@item.DisplayName</strong>
                                                    <span class="dashboard-stat-note">@FormatGearInfo(item.SlotTitle, item.ClassName)</span>
                                                </div>
                                            </div>
                                            <div>
                                                @RenderStats(item.TotalStats)
                                                @RenderStatDelta(item.BattleStatDelta)
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <p class="panel-copy">@item.Notes</p>
                                        }
                                        <div class="action-row inventory-actions">
                                            <MudButton HtmlTag="button" data-testid="@($"equip-battle-{item.Key}")" Color="Color.Primary" Disabled="@(!canMutate)" OnClick="@(() => EquipItemAsync(EquipmentSetKind.Battle, item.Key))" Variant="Variant.Outlined">
                                                @(item.IsBattleEquipped ? "Unequip battle" : "Equip battle")
                                            </MudButton>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }

        @if (viewModel.AccessoryGroups.Count > 0)
        {
            <section class="accessory-section">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Cosmetic and no-stat items</p>
                        <h2>Other equipment</h2>
                    </div>
                    <span class="ui-pill count-pill">@viewModel.AccessoryGroups.Sum(group => group.Items.Count)</span>
                </div>

                <div class="other-items-toggle-row">
                    <MudButton HtmlTag="button" data-testid="toggle-non-battle-equipment" OnClick="ToggleNonBattleEquipment" Variant="Variant.Text">
                        @(_nonBattleEquipmentExpanded ? "Hide other equipment" : $"Show other equipment ({viewModel.AccessoryGroups.Sum(group => group.Items.Count)})")
                    </MudButton>
                </div>

                @if (_nonBattleEquipmentExpanded)
                {
                    <div class="inventory-group-grid accessory-group-grid">
                        @foreach (var group in viewModel.AccessoryGroups)
                        {
                            <section class="card-surface inventory-group-card accessory-group-card">
                                <div class="task-group-header">
                                    <h3>@group.SlotTitle</h3>
                                    <span class="ui-pill count-pill">@group.Items.Count</span>
                                </div>

                                <div class="inventory-item-list accessory-item-list">
                                    @foreach (var item in group.Items)
                                    {
                                        <article class="inventory-item-card accessory-item-card">
                                            <div class="habitica-item-identity">
                                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                                <div>
                                                    <strong>@item.DisplayName</strong>
                                                    <span class="dashboard-stat-note">@FormatGearInfo(item.SlotTitle, item.ClassName)</span>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <p class="panel-copy">@item.Notes</p>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private string _battlePresetName = string.Empty;
    private string? _pendingRemovePresetId;
    private string? _renamingPresetId;
    private string _renamePresetName = string.Empty;
    private string _optimizerPresetName = string.Empty;
    private EquipmentOptimizationGoal _optimizationGoal = EquipmentOptimizationGoal.Balanced;
    private int _bulkSellKeepCount = 1;
    private bool _showBulkSellConfirmation;
    private bool _nonBattleEquipmentExpanded;
    private readonly HashSet<string> _expandedOtherItemGroups = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        SessionController.Changed += HandleStateChanged;
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Account data is up to date",
            SnapshotFreshnessState.Stale => "Account data may need refresh",
            SnapshotFreshnessState.Expired => "Account data needs refresh",
            _ => "No saved account data"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private async Task SavePresetAsync(EquipmentSetKind kind)
    {
        var result = await SessionController.SaveEquipmentPresetAsync(kind, _battlePresetName);
        ShowFeedback(result);

        if (result.Succeeded)
        {
            if (kind == EquipmentSetKind.Battle)
            {
                _battlePresetName = string.Empty;
            }
        }
    }

    private async Task SaveRecommendationPresetAsync(EquipmentRecommendationViewModel recommendation)
    {
        var result = await SessionController.SaveEquipmentPresetAsync(
            EquipmentSetKind.Battle,
            _optimizerPresetName,
            recommendation.Slots);
        ShowFeedback(result);

        if (result.Succeeded)
        {
            _optimizerPresetName = string.Empty;
        }
    }

    private async Task EquipRecommendationAsync(EquipmentRecommendationViewModel recommendation)
    {
        var result = await SessionController.EquipGearSlotsAsync(
            EquipmentSetKind.Battle,
            recommendation.Slots,
            $"optimizer:{recommendation.Goal}",
            $"Equipping {recommendation.GoalLabel} recommendation");
        ShowFeedback(result);
    }

    private void SetOptimizationGoal(string? rawValue)
    {
        _optimizationGoal = Enum.TryParse<EquipmentOptimizationGoal>(rawValue, out var goal)
            ? goal
            : EquipmentOptimizationGoal.Balanced;
    }

    private void SetBulkSellKeepCount(string? rawValue)
    {
        _bulkSellKeepCount = int.TryParse(rawValue, out var parsed) ? Math.Clamp(parsed, 0, 99) : 1;
        _showBulkSellConfirmation = false;
    }

    private async Task EquipItemAsync(EquipmentSetKind kind, string key)
    {
        var result = await SessionController.EquipInventoryItemAsync(kind, key);
        ShowFeedback(result);
    }

    private async Task EquipPresetAsync(string presetId)
    {
        var result = await SessionController.EquipEquipmentPresetAsync(presetId);
        ShowFeedback(result);
    }

    private bool IsOtherItemsExpanded(string slotTitle)
    {
        return _expandedOtherItemGroups.Contains(slotTitle);
    }

    private void ToggleOtherItems(string slotTitle)
    {
        if (!_expandedOtherItemGroups.Add(slotTitle))
        {
            _expandedOtherItemGroups.Remove(slotTitle);
        }
    }

    private void ToggleNonBattleEquipment()
    {
        _nonBattleEquipmentExpanded = !_nonBattleEquipmentExpanded;
    }

    private static string FormatGearInfo(string slotTitle, string? className)
    {
        return string.IsNullOrWhiteSpace(className) ? slotTitle : $"{slotTitle} • {FormatReadableName(className, string.Empty)}";
    }

    private static string FormatReadableName(string? value, string emptyLabel)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return emptyLabel;
        }

        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' ').Replace('-', ' '));
    }

    private async Task ConfirmRemovePresetAsync(string presetId)
    {
        var result = await SessionController.RemoveEquipmentPresetAsync(presetId);
        _pendingRemovePresetId = null;
        if (string.Equals(_renamingPresetId, presetId, StringComparison.Ordinal))
        {
            _renamingPresetId = null;
            _renamePresetName = string.Empty;
        }
        ShowFeedback(result);
    }

    private void BeginRenamePreset(InventoryPresetViewModel preset)
    {
        _pendingRemovePresetId = null;
        _renamingPresetId = preset.Id;
        _renamePresetName = preset.Name;
    }

    private async Task SaveRenamePresetAsync(string presetId)
    {
        var result = await SessionController.RenameEquipmentPresetAsync(presetId, _renamePresetName);
        if (result.Succeeded)
        {
            _renamingPresetId = null;
            _renamePresetName = string.Empty;
        }

        ShowFeedback(result);
    }

    private void ShowFeedback(InventoryActionResult result)
    {
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

    private async Task SellBulkPlanAsync(IReadOnlyList<BulkSellPlanItem> plan)
    {
        var soldCount = 0;
        foreach (var item in plan.Where(static item => item.IsSafe && item.SellCount > 0))
        {
            var result = await SessionController.SellInventoryItemAsync(item.Type, item.Key, item.SellCount);
            ShowFeedback(result);
            if (!result.Succeeded)
            {
                _showBulkSellConfirmation = false;
                return;
            }

            soldCount += item.SellCount;
        }

        _showBulkSellConfirmation = false;
        if (soldCount > 0)
        {
            Snackbar.Add($"Sold {soldCount} planned item(s).", Severity.Success);
        }
    }

    private IEnumerable<BulkSellPlanItem> GetBulkSellPlan(InventorySnapshot inventory)
    {
        foreach (var item in BuildBulkSellItems(InventorySellItemType.Egg, inventory.Eggs))
        {
            yield return item;
        }

        foreach (var item in BuildBulkSellItems(InventorySellItemType.Food, inventory.Food))
        {
            yield return item;
        }

        foreach (var item in BuildBulkSellItems(InventorySellItemType.HatchingPotion, inventory.HatchingPotions))
        {
            yield return item;
        }
    }

    private IEnumerable<BulkSellPlanItem> BuildBulkSellItems(
        InventorySellItemType type,
        IReadOnlyDictionary<string, int> items)
    {
        foreach (var item in items.OrderBy(static item => item.Key, StringComparer.OrdinalIgnoreCase))
        {
            var sellCount = Math.Max(0, item.Value - _bulkSellKeepCount);
            var isSafe = sellCount > 0;
            yield return new BulkSellPlanItem(
                type,
                item.Key,
                item.Value,
                sellCount,
                isSafe,
                isSafe
                    ? $"Safe by local rule: keep {_bulkSellKeepCount} cached item(s), sell only the surplus through Habitica's supported sell endpoint."
                    : $"Unsafe by local rule: cached count is at or below the keep threshold.");
        }
    }

    private static RenderFragment RenderImageCountChip(HabiticaImageAsset asset, int count) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "habitica-icon-count-chip");
        RenderHabiticaImage(asset)(builder);
        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, count);
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddContent(sequence++, asset.AltText);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static RenderFragment RenderHabiticaImage(HabiticaImageAsset asset) => builder =>
    {
        builder.OpenComponent<HabiticaImage>(0);
        builder.AddAttribute(1, "Asset", asset);
        builder.CloseComponent();
    };

    private RenderFragment RenderEquippedSet(InventoryEquippedSetViewModel set) => builder =>
    {
        if (set.Items.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "panel-copy");
            builder.AddContent(2, "No equipped gear is saved for this loadout.");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "inventory-item-list");
        var sequence = 5;
        foreach (var item in set.Items)
        {
            builder.OpenElement(sequence++, "article");
            builder.AddAttribute(sequence++, "class", "inventory-item-card compact");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "habitica-item-identity");
            RenderHabiticaImage(HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName))(builder);
            builder.OpenElement(sequence++, "div");
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, item.DisplayName);
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
            builder.AddContent(sequence++, item.SlotTitle);
            builder.CloseElement();
            if (set.Kind == EquipmentSetKind.Battle)
            {
                RenderStats(item.TotalStats)(builder);
            }
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment RenderPresetList(IReadOnlyList<InventoryPresetViewModel> presets, bool canMutate) => builder =>
    {
        if (presets.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "panel-copy");
            builder.AddContent(2, "No presets saved yet.");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "inventory-preset-list");
        var sequence = 5;
        foreach (var preset in presets)
        {
            builder.OpenElement(sequence++, "article");
            builder.AddAttribute(sequence++, "class", "inventory-item-card");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "task-group-header");
            builder.OpenElement(sequence++, "div");
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, preset.Name);
            builder.CloseElement();
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
            builder.AddContent(sequence++, $"{preset.Items.Count} item(s) • {preset.CreatedAtUtc.ToLocalTime():g}");
            builder.CloseElement();
            builder.CloseElement();
            RenderStats(preset.TotalStats)(builder);
            builder.CloseElement();

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "preset-item-strip");
            if (preset.Items.Count == 0)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
                builder.AddContent(sequence++, "No gear saved in this preset.");
                builder.CloseElement();
            }
            else
            {
                foreach (var item in preset.Items)
                {
                    builder.OpenElement(sequence++, "div");
                    builder.AddAttribute(sequence++, "class", "preset-mini-item");
                    builder.OpenElement(sequence++, "div");
                    builder.AddAttribute(sequence++, "class", "habitica-item-identity");
                    RenderHabiticaImage(HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName))(builder);
                    builder.OpenElement(sequence++, "div");
                    builder.OpenElement(sequence++, "strong");
                    builder.AddContent(sequence++, item.DisplayName);
                    builder.CloseElement();
                    builder.OpenElement(sequence++, "span");
                    builder.AddAttribute(sequence++, "class", "dashboard-stat-note");
                    builder.AddContent(sequence++, item.SlotTitle);
                    builder.CloseElement();
                    if (item.TotalStats != GearStatBlock.Zero)
                    {
                        RenderStats(item.TotalStats)(builder);
                    }
                    builder.CloseElement();
                    builder.CloseElement();

                    builder.OpenComponent<MudButton>(sequence++);
                    builder.AddAttribute(sequence++, "HtmlTag", "button");
                    builder.AddAttribute(sequence++, "UserAttributes", new Dictionary<string, object> { ["data-testid"] = $"equip-preset-item-{preset.Id}-{item.Key}" });
                    builder.AddAttribute(sequence++, "Color", Color.Primary);
                    builder.AddAttribute(sequence++, "Disabled", !canMutate);
                    builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => EquipItemAsync(EquipmentSetKind.Battle, item.Key)));
                    builder.AddAttribute(sequence++, "Size", Size.Small);
                    builder.AddAttribute(sequence++, "Variant", Variant.Outlined);
                    builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Equip item")));
                    builder.CloseComponent();

                    builder.CloseElement();
                }
            }

            builder.CloseElement();

            if (string.Equals(_renamingPresetId, preset.Id, StringComparison.Ordinal))
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "preset-save-row");
                builder.OpenElement(sequence++, "input");
                builder.AddAttribute(sequence++, "class", "app-input");
                builder.AddAttribute(sequence++, "data-testid", $"rename-preset-name-{preset.Id}");
                builder.AddAttribute(sequence++, "value", BindConverter.FormatValue(_renamePresetName));
                builder.AddAttribute(sequence++, "oninput", EventCallback.Factory.CreateBinder<string>(this, value => _renamePresetName = value, _renamePresetName));
                builder.CloseElement();
                builder.OpenComponent<MudButton>(sequence++);
                builder.AddAttribute(sequence++, "HtmlTag", "button");
                builder.AddAttribute(sequence++, "UserAttributes", new Dictionary<string, object> { ["data-testid"] = $"save-rename-preset-{preset.Id}" });
                builder.AddAttribute(sequence++, "Color", Color.Primary);
                builder.AddAttribute(sequence++, "Disabled", !canMutate || string.IsNullOrWhiteSpace(_renamePresetName));
                builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => SaveRenamePresetAsync(preset.Id)));
                builder.AddAttribute(sequence++, "Variant", Variant.Filled);
                builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Save name")));
                builder.CloseComponent();
                builder.CloseElement();
            }

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "action-row inventory-actions");
            builder.OpenComponent<MudButton>(sequence++);
            builder.AddAttribute(sequence++, "HtmlTag", "button");
            builder.AddAttribute(sequence++, "UserAttributes", new Dictionary<string, object> { ["data-testid"] = $"equip-preset-{preset.Id}" });
            builder.AddAttribute(sequence++, "Color", Color.Primary);
            builder.AddAttribute(sequence++, "Disabled", !canMutate);
            builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => EquipPresetAsync(preset.Id)));
            builder.AddAttribute(sequence++, "Variant", Variant.Filled);
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Equip")));
            builder.CloseComponent();
            builder.OpenComponent<MudButton>(sequence++);
            builder.AddAttribute(sequence++, "HtmlTag", "button");
            builder.AddAttribute(sequence++, "UserAttributes", new Dictionary<string, object> { ["data-testid"] = $"rename-preset-{preset.Id}" });
            builder.AddAttribute(sequence++, "Disabled", !canMutate);
            builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => BeginRenamePreset(preset)));
            builder.AddAttribute(sequence++, "Variant", Variant.Text);
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Rename")));
            builder.CloseComponent();
            builder.OpenComponent<MudButton>(sequence++);
            builder.AddAttribute(sequence++, "HtmlTag", "button");
            builder.AddAttribute(sequence++, "UserAttributes", new Dictionary<string, object> { ["data-testid"] = $"remove-preset-{preset.Id}" });
            builder.AddAttribute(sequence++, "Color", Color.Error);
            builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => _pendingRemovePresetId = preset.Id));
            builder.AddAttribute(sequence++, "Variant", Variant.Text);
            builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Remove")));
            builder.CloseComponent();
            builder.CloseElement();

            var progress = GetPresetProgress(preset.Id);
            if (progress is not null)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "preset-progress");
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, $"{progress.Label}: {progress.Completed} of {progress.Total}");
                builder.CloseElement();
                builder.OpenComponent<MudProgressLinear>(sequence++);
                builder.AddAttribute(sequence++, "Class", "scheme-progress-primary");
                builder.AddAttribute(sequence++, "Color", Color.Primary);
                builder.AddAttribute(sequence++, "Max", (double)progress.Total);
                builder.AddAttribute(sequence++, "Value", (double)progress.Completed);
                builder.CloseComponent();
                builder.CloseElement();
            }

            if (string.Equals(_pendingRemovePresetId, preset.Id, StringComparison.Ordinal))
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "preset-remove-confirm");
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, $"Remove preset {preset.Name}?");
                builder.CloseElement();
                builder.OpenComponent<MudButton>(sequence++);
                builder.AddAttribute(sequence++, "HtmlTag", "button");
                builder.AddAttribute(sequence++, "UserAttributes", new Dictionary<string, object> { ["data-testid"] = $"confirm-remove-preset-{preset.Id}" });
                builder.AddAttribute(sequence++, "Color", Color.Error);
                builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => ConfirmRemovePresetAsync(preset.Id)));
                builder.AddAttribute(sequence++, "Variant", Variant.Filled);
                builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Confirm remove")));
                builder.CloseComponent();
                builder.OpenComponent<MudButton>(sequence++);
                builder.AddAttribute(sequence++, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => _pendingRemovePresetId = null));
                builder.AddAttribute(sequence++, "Variant", Variant.Text);
                builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(contentBuilder => contentBuilder.AddContent(0, "Cancel")));
                builder.CloseComponent();
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private static RenderFragment RenderStats(GearStatBlock stats) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "ui-pill count-pill stat-pill-group");

        if (stats == GearStatBlock.Zero)
        {
            builder.AddContent(sequence++, "No stats");
            builder.CloseElement();
            return;
        }

        var highest = GetHighestPositiveStat(stats);
        RenderStatValue(builder, ref sequence, "STR", stats.Strength, highest);
        RenderSeparator(builder, ref sequence);
        RenderStatValue(builder, ref sequence, "INT", stats.Intelligence, highest);
        RenderSeparator(builder, ref sequence);
        RenderStatValue(builder, ref sequence, "CON", stats.Constitution, highest);
        RenderSeparator(builder, ref sequence);
        RenderStatValue(builder, ref sequence, "PER", stats.Perception, highest);
        builder.CloseElement();
    };

    private static decimal? GetHighestPositiveStat(GearStatBlock stats)
    {
        var highest = new[] { stats.Strength, stats.Intelligence, stats.Constitution, stats.Perception }.Max();
        return highest > 0m ? highest : null;
    }

    private static void RenderStatValue(RenderTreeBuilder builder, ref int sequence, string label, decimal value, decimal? highest)
    {
        var className = highest is not null && value == highest.Value
            ? "inventory-stat-value highest-stat"
            : "inventory-stat-value";
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", className);
        builder.AddContent(sequence++, $"{label}\u00a0{value:0.#}");
        builder.CloseElement();
    }

    private static void RenderSeparator(RenderTreeBuilder builder, ref int sequence)
    {
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "inventory-stat-separator");
        builder.AddContent(sequence++, "•");
        builder.CloseElement();
    }

    private static RenderFragment RenderStatDelta(GearStatBlock delta) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", GetDeltaClass(delta));
        RenderDeltaValue(builder, ref sequence, "STR", delta.Strength);
        RenderSeparator(builder, ref sequence);
        RenderDeltaValue(builder, ref sequence, "INT", delta.Intelligence);
        RenderSeparator(builder, ref sequence);
        RenderDeltaValue(builder, ref sequence, "CON", delta.Constitution);
        RenderSeparator(builder, ref sequence);
        RenderDeltaValue(builder, ref sequence, "PER", delta.Perception);
        builder.CloseElement();
    };

    private static string GetDeltaClass(GearStatBlock delta)
    {
        var total = delta.Strength + delta.Intelligence + delta.Constitution + delta.Perception;
        return total switch
        {
            > 0m => "ui-pill count-pill stat-pill-group stat-delta-positive",
            < 0m => "ui-pill count-pill stat-pill-group stat-delta-negative",
            _ => "ui-pill count-pill stat-pill-group"
        };
    }

    private static void RenderDeltaValue(RenderTreeBuilder builder, ref int sequence, string label, decimal value)
    {
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", value switch
        {
            > 0m => "inventory-stat-value delta-up",
            < 0m => "inventory-stat-value delta-down",
            _ => "inventory-stat-value"
        });
        builder.AddContent(sequence++, $"{label}\u00a0{FormatSignedDecimal(value)}");
        builder.CloseElement();
    }

    private static string FormatSignedDecimal(decimal value)
    {
        return value > 0m ? $"+{value:0.#}" : value.ToString("0.#", CultureInfo.InvariantCulture);
    }

    private static string FormatOptimizationGoal(EquipmentOptimizationGoal goal)
    {
        return goal switch
        {
            EquipmentOptimizationGoal.Strength => "Strength",
            EquipmentOptimizationGoal.Intelligence => "Intelligence",
            EquipmentOptimizationGoal.Constitution => "Constitution",
            EquipmentOptimizationGoal.Perception => "Perception",
            EquipmentOptimizationGoal.BossDamage => "Boss damage",
            EquipmentOptimizationGoal.Survival => "Survival",
            _ => "Balanced"
        };
    }

    private static string FormatSellType(InventorySellItemType type)
    {
        return type switch
        {
            InventorySellItemType.Egg => "Egg",
            InventorySellItemType.Food => "Food",
            InventorySellItemType.HatchingPotion => "Hatching potion",
            _ => "Inventory"
        };
    }

    private static string GetBulkSellItemClass(BulkSellPlanItem item)
    {
        return item.IsSafe ? "bulk-sell-item safe-sell-item" : "bulk-sell-item unsafe-sell-item";
    }

    private EquipmentProgress? GetPresetProgress(string presetId)
    {
        var progress = SessionController.State.ActiveEquipmentProgress;
        return progress is not null && string.Equals(progress.OperationId, $"preset:{presetId}", StringComparison.Ordinal)
            ? progress
            : null;
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SessionController.Changed -= HandleStateChanged;
    }

    private sealed record BulkSellPlanItem(
        InventorySellItemType Type,
        string Key,
        int OwnedCount,
        int SellCount,
        bool IsSafe,
        string Explanation);
}
