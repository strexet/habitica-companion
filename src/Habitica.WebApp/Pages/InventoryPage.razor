@page "/inventory"
@implements IDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Components.Rendering
@inject InventoryViewModelFactory InventoryViewModelFactory
@inject IAppSessionController SessionController
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>Equipment</PageTitle>

<div class="inventory-shell">
    <section class="card-surface dashboard-hero">
        <div>
            <p class="section-label">Equipment explorer</p>
            <h1>Equipment</h1>
            <p class="panel-copy">
                Compare owned gear, save battle presets, and equip items from fresh Habitica account data.
            </p>
        </div>
    </section>

    @if (SessionController.State.UserSnapshot is null)
    {
        <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Filled">
            @if (SessionController.State.IsAuthenticated)
            {
                <span>No saved account data is available yet. Refresh before opening the equipment explorer.</span>
            }
            else
            {
                <span>No saved account data is available on this device yet. Sign in before opening the equipment explorer.</span>
                <div class="empty-state-actions">
                    <MudButton Href="/sign-in" Variant="Variant.Filled" Color="Color.Primary">Sign in</MudButton>
                </div>
            }
        </MudAlert>
    }
    else
    {
        var snapshot = SessionController.State.UserSnapshot;
        var viewModel = InventoryViewModelFactory.Create(
            snapshot,
            SessionController.State.GearCatalogSnapshot,
            SessionController.State.Presets);
        var ambiguousGearKeys = FindAmbiguousGearKeys(viewModel);
        var recommendation = InventoryViewModelFactory.CreateRecommendation(
            snapshot,
            SessionController.State.GearCatalogSnapshot,
            _optimizationGoal);
        _visibleOwnedSlots.Clear();
        var ownedGroups = viewModel.Groups.Concat(viewModel.AccessoryGroups).ToArray();
        var allOwned = ownedGroups.SelectMany(group=>group.Items).DistinctBy(item=>item.Key,StringComparer.Ordinal).ToArray();
        var matchingOwned = allOwned.Where(MatchesOwnedFilter).ToArray();
        var discoveryActive = IsOwnedDiscoveryActive;
        var pageKeys = matchingOwned.Skip(_ownedPage*OwnedPageSize).Take(OwnedPageSize).Select(item=>item.Key).ToHashSet(StringComparer.Ordinal);
        var shownGroups = OwnedGroups(viewModel.Groups,discoveryActive,pageKeys);
        var shownAccessoryGroups = OwnedGroups(viewModel.AccessoryGroups,discoveryActive,pageKeys);
        foreach(var group in shownGroups)_visibleOwnedSlots.Add("battle:"+group.SlotTitle);
        if(discoveryActive||_nonBattleEquipmentExpanded)foreach(var group in shownAccessoryGroups)_visibleOwnedSlots.Add("other:"+group.SlotTitle);
        var shownFrom = matchingOwned.Length==0?0:_ownedPage*OwnedPageSize+1;
        var shownTo = Math.Min((_ownedPage+1)*OwnedPageSize,matchingOwned.Length);
        var canMutate = SessionController.State.IsAuthenticated
            && !SessionController.State.IsBusy
            && SessionController.State.UserFreshness == SnapshotFreshnessState.Fresh;

        <MudAlert Class="inline-banner" Dense="true" Severity="@GetFreshnessSeverity(SessionController.State.UserFreshness)" Variant="Variant.Filled">
            @GetFreshnessLabel(SessionController.State.UserFreshness)
        </MudAlert>

        <section class="card-surface inventory-group-card inventory-discovery" aria-label="Find owned equipment" data-testid="inventory-discovery">
            <h2>Find owned equipment</h2>
            <p>Search names or item keys, or choose a slot. Equipped gear and optimizer recommendations stay separate.</p>
            <div class="inventory-discovery-fields">
                <label class="field-row" for="inventory-owned-query">Search owned equipment<input id="inventory-owned-query" class="app-input" type="search" maxlength="256" value="@_ownedGearQuery" @oninput="OwnedQueryChanged" @onkeydown="OwnedSearchKey" @ref="_ownedSearch" data-testid="inventory-owned-query" /></label>
                <label class="field-row" for="inventory-owned-slot">Slot or category<select id="inventory-owned-slot" class="app-input" value="@_ownedGearSlot" @onchange="OwnedSlotChanged" data-testid="inventory-owned-slot"><option value="">All slots</option>@foreach(var slot in ownedGroups.Select(group=>group.SlotTitle).Distinct(StringComparer.Ordinal)){<option value="@slot">@(slot=="Two-Handed Weapons"?"Two-handed":slot)</option>}</select></label>
            </div>
            <p role="status" aria-live="polite" aria-atomic="true" data-testid="inventory-owned-count">@matchingOwned.Length @(matchingOwned.Length==1?"match":"matches") · @allOwned.Length searchable owned items</p>
            <div class="action-row inventory-actions"><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ViewOwnedResults" Variant="Variant.Outlined" data-testid="inventory-owned-view">View results</MudButton><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ResetOwnedFilters" Disabled="@(_ownedGearQuery.Length==0&&_ownedGearSlot.Length==0)" Variant="Variant.Text" data-testid="inventory-owned-reset">Reset filters</MudButton></div>
        </section>

        <section class="inventory-summary-grid">
            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Owned gear</span>
                <strong>@snapshot.Inventory.OwnedGearKeys.Length</strong>
                <span class="dashboard-stat-note">Ready for comparison and equipment changes.</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Current companion</span>
                <div class="habitica-image-row">
                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Pet(snapshot.CurrentPetKey, FormatReadableName(snapshot.CurrentPetKey, "No pet"))" Loading="eager" />
                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Mount(snapshot.CurrentMountKey, FormatReadableName(snapshot.CurrentMountKey, "No mount"))" Loading="eager" />
                </div>
                <strong>@FormatReadableName(snapshot.CurrentPetKey, "None")</strong>
                <span class="dashboard-stat-note">Mount: @FormatReadableName(snapshot.CurrentMountKey, "None")</span>
            </article>

            <article class="dashboard-stat-card">
                <span class="dashboard-stat-label">Item counts</span>
                <div class="habitica-icon-chip-grid">
                    @RenderImageCountChip(HabiticaImageAssetResolver.EggSummary(), snapshot.Inventory.EggCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.FoodSummary(), snapshot.Inventory.FoodCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.HatchingPotionSummary(), snapshot.Inventory.HatchingPotionCount)
                    @RenderImageCountChip(HabiticaImageAssetResolver.QuestScrollSummary(), snapshot.Inventory.QuestCount)
                </div>
            </article>
        </section>

        <section class="inventory-management-grid">
            <article class="card-surface inventory-group-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Equipped battle gear</p>
                        <h2>Battle loadout</h2>
                    </div>
                    @RenderStats(viewModel.BattleEquipped.TotalStats)
                </div>

                @RenderEquippedSet(viewModel.BattleEquipped)

                <div class="preset-save-row">
                    <label class="field-row" for="battle-preset-name">Battle preset name<input id="battle-preset-name" data-testid="battle-preset-name" class="app-input" placeholder="Preset name" @bind="_battlePresetName" @bind:event="oninput" /></label>
                    <MudButton Color="Color.Primary" Disabled="@(!canMutate || string.IsNullOrWhiteSpace(_battlePresetName))" OnClick="@(() => SavePresetAsync(EquipmentSetKind.Battle))" Variant="Variant.Filled">
                        Save battle gear preset
                    </MudButton>
                </div>
            </article>
        </section>

        <section class="inventory-planning-grid">
            <article class="card-surface inventory-group-card optimizer-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Gear planning</p>
                        <h2>Equipment optimizer</h2>
                    </div>
                    <label class="field-row compact">
                        <span>Goal</span>
                        <select class="app-input" value="@_optimizationGoal.ToString()" @onchange="eventArgs => SetOptimizationGoal(eventArgs.Value?.ToString())" data-testid="equipment-optimizer-goal">
                            @foreach (var goal in Enum.GetValues<EquipmentOptimizationGoal>())
                            {
                                <option value="@goal.ToString()">@FormatOptimizationGoal(goal)</option>
                            }
                        </select>
                    </label>
                </div>

                <div class="optimizer-stat-grid">
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Current</span>
                        @RenderStats(recommendation.CurrentStats)
                    </article>
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Recommended</span>
                        @RenderStats(recommendation.RecommendedStats)
                    </article>
                    <article class="dashboard-stat-card">
                        <span class="dashboard-stat-label">Delta</span>
                        @RenderStatDelta(recommendation.Delta)
                    </article>
                </div>

                @if (recommendation.Items.Count == 0)
                {
                    <p class="panel-copy">No stat-bearing owned gear is available for this recommendation.</p>
                }
                else
                {
                    <div class="preset-item-strip optimizer-item-strip">
                        @foreach (var item in recommendation.Items)
                        {
                            <article class="preset-mini-item">
                                <span class="dashboard-stat-label">@item.SlotTitle</span>
                                <div class="habitica-item-identity">
                                    <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                    <div>
                                        <strong>@item.DisplayName</strong>
                                        @RenderStats(item.TotalStats)
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }

                <div class="preset-save-row">
                    <label class="field-row" for="optimizer-preset-name">Recommendation preset name<input id="optimizer-preset-name" class="app-input" placeholder="Recommendation preset name" @bind="_optimizerPresetName" @bind:event="oninput" data-testid="optimizer-preset-name" /></label>
                    <div class="action-row inventory-actions">
                        <MudButton Color="Color.Primary"
                                   Disabled="@(!canMutate || !recommendation.HasRecommendation)"
                                   OnClick="@(() => EquipRecommendationAsync(recommendation))"
                                   Variant="Variant.Filled"
                                   aria-label="@($"Equip recommendation for {recommendation.GoalLabel} battle gear")" data-testid="equip-optimizer-recommendation">
                            Equip recommendation
                        </MudButton>
                        <MudButton Color="Color.Secondary"
                                   Disabled="@(!canMutate || !recommendation.HasRecommendation || string.IsNullOrWhiteSpace(_optimizerPresetName))"
                                   OnClick="@(() => SaveRecommendationPresetAsync(recommendation))"
                                   Variant="Variant.Outlined"
                                   aria-label="@($"Save recommendation for {recommendation.GoalLabel} battle gear as a preset")" data-testid="save-optimizer-recommendation">
                            Save recommendation
                        </MudButton>
                    </div>
                </div>
            </article>

        </section>

        <section class="inventory-preset-section">
            <article class="card-surface inventory-group-card inventory-preset-card">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Battle gear presets</p>
                        <h2>Saved battle presets</h2>
                    </div>
                    <span class="ui-pill count-pill">@viewModel.BattlePresets.Count</span>
                </div>
                @RenderPresetList(viewModel.BattlePresets, canMutate, ambiguousGearKeys)
            </article>
        </section>

        <section class="inventory-owned-results" data-testid="inventory-owned-results">
        <h2 tabindex="-1" @ref="_ownedResultsHeading" data-testid="inventory-owned-heading">Owned equipment</h2>
        @if(discoveryActive && matchingOwned.Length==0){<p role="status" data-testid="inventory-owned-empty">No owned equipment matches this search and slot. Reset filters to browse all owned equipment.</p><div class="action-row inventory-actions"><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ResetOwnedFilters" Variant="Variant.Outlined" data-testid="inventory-owned-empty-reset">Reset filters and return to search</MudButton></div>}
        @if (allOwned.Length == 0)
        {
            <MudAlert Dense="true" Severity="Severity.Info" Variant="Variant.Outlined">
                No owned gear is saved yet. Refresh account data after signing in.
            </MudAlert>
        }
        else
        {
            <div class="inventory-group-grid">
                @foreach (var group in shownGroups)
                {
                    var otherItemsExpanded = discoveryActive || IsOtherItemsExpanded(group.SlotTitle);
                    var slotRefKey="battle:"+group.SlotTitle;
                    <section class="card-surface inventory-group-card" @key="slotRefKey">
                        <div class="task-group-header">
                            <h2 id="@OwnedSlotId(group.SlotTitle,false)" tabindex="-1" @ref="_slotHeadings[slotRefKey]">@group.SlotTitle</h2>
                            <span class="ui-pill count-pill">@group.Items.Count</span>
                        </div>

                        @if (group.BestItems.Count > 0)
                        {
                            <div class="best-category-block">
                                <div class="task-group-header">
                                    <h3>Best in Category</h3>
                                    <span class="ui-pill count-pill">@group.BestItems.Count</span>
                                </div>

                                <div class="preset-item-strip">
                                    @foreach (var item in group.BestItems)
                                    {
                                        <article class="preset-mini-item">
                                            <div class="habitica-item-identity">
                                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                                <div>
                                                    <strong>@item.DisplayName</strong>
                                                    <span class="dashboard-stat-note">@FormatGearInfo(item.SlotTitle, item.ClassName)</span>@if(ambiguousGearKeys.Contains(item.Key)){<span class="dashboard-stat-note">Item reference: @item.Key</span>}
                                                    @RenderStats(item.TotalStats)
                                                </div>
                                            </div>
                                            <MudButton HtmlTag="button" data-testid="@($"equip-best-{item.Key}")" aria-label="@($"{(item.IsBattleEquipped ? "Equipped battle" : "Equip item")} {GearActionContext(item.Key,item.DisplayName,item.SlotTitle,ambiguousGearKeys)}")" Color="Color.Primary" Disabled="@(!canMutate || item.IsBattleEquipped)" OnClick="@(() => EquipItemAsync(EquipmentSetKind.Battle, item.Key))" Size="Size.Small" Variant="Variant.Outlined">
                                                @(item.IsBattleEquipped ? "Equipped battle" : "Equip item")
                                            </MudButton>
                                        </article>
                                    }
                                </div>
                            </div>
                        }

                        @if(!discoveryActive){
                        <div class="other-items-toggle-row">
                            <MudButton HtmlTag="button" data-testid="@($"toggle-other-items-{group.SlotTitle}")" aria-label="@($"{(otherItemsExpanded ? "Hide other items" : $"Show other items ({group.Items.Count})")} for {group.SlotTitle}")" OnClick="@(() => ToggleOtherItems(group.SlotTitle))" Variant="Variant.Text">
                                @(otherItemsExpanded ? "Hide other items" : $"Show other items ({group.Items.Count})")
                            </MudButton>
                        </div>

                        }
                        @if (otherItemsExpanded)
                        {
                            <div class="inventory-item-list">
                                @foreach (var item in group.Items)
                                {
                                    <article class="inventory-item-card" @key="item.Key" data-testid="@($"owned-gear-{item.Key}")">
                                        <div class="task-group-header">
                                            <div class="habitica-item-identity">
                                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                                <div>
                                                    <strong>@item.DisplayName</strong>
                                                    <span class="dashboard-stat-note">@FormatGearInfo(item.SlotTitle, item.ClassName)</span>@if(ambiguousGearKeys.Contains(item.Key)){<span class="dashboard-stat-note">Item reference: @item.Key</span>}
                                                </div>
                                            </div>
                                            <div>
                                                @RenderStats(item.TotalStats)
                                                @RenderStatDelta(item.BattleStatDelta)
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <p class="panel-copy">@item.Notes</p>
                                        }
                                        <div class="action-row inventory-actions">
                                            <MudButton HtmlTag="button" data-testid="@($"equip-battle-{item.Key}")" aria-label="@($"{(item.IsBattleEquipped ? "Unequip battle" : "Equip battle")} {GearActionContext(item.Key,item.DisplayName,item.SlotTitle,ambiguousGearKeys)}")" Color="Color.Primary" Disabled="@(!canMutate)" OnClick="@(() => EquipItemAsync(EquipmentSetKind.Battle, item.Key))" Variant="Variant.Outlined">
                                                @(item.IsBattleEquipped ? "Unequip battle" : "Equip battle")
                                            </MudButton>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                }
            </div>
        }

        @if (shownAccessoryGroups.Count > 0)
        {
            <section class="accessory-section">
                <div class="task-group-header">
                    <div>
                        <p class="section-label">Cosmetic and no-stat items</p>
                        <h2>Other equipment</h2>
                    </div>
                    <span class="ui-pill count-pill">@shownAccessoryGroups.Sum(group => group.Items.Count)</span>
                </div>

                @if(!discoveryActive){
                <div class="other-items-toggle-row">
                    <MudButton HtmlTag="button" data-testid="toggle-non-battle-equipment" OnClick="ToggleNonBattleEquipment" Variant="Variant.Text">
                        @(_nonBattleEquipmentExpanded ? "Hide other equipment" : $"Show other equipment ({shownAccessoryGroups.Sum(group => group.Items.Count)})")
                    </MudButton>
                </div>

                }
                @if (discoveryActive || _nonBattleEquipmentExpanded)
                {
                    <div class="inventory-group-grid accessory-group-grid">
                        @foreach (var group in shownAccessoryGroups)
                        {
                            var slotRefKey="other:"+group.SlotTitle;
                            <section class="card-surface inventory-group-card accessory-group-card" @key="slotRefKey">
                                <div class="task-group-header">
                                    <h3 id="@OwnedSlotId(group.SlotTitle,true)" tabindex="-1" @ref="_slotHeadings[slotRefKey]">@group.SlotTitle</h3>
                                    <span class="ui-pill count-pill">@group.Items.Count</span>
                                </div>

                                <div class="inventory-item-list accessory-item-list">
                                    @foreach (var item in group.Items)
                                    {
                                        <article class="inventory-item-card accessory-item-card" @key="item.Key" data-testid="@($"owned-gear-{item.Key}")">
                                            <div class="habitica-item-identity">
                                                <HabiticaImage Asset="@HabiticaImageAssetResolver.Gear(item.Key, item.DisplayName)" />
                                                <div>
                                                    <strong>@item.DisplayName</strong>
                                                    <span class="dashboard-stat-note">@FormatGearInfo(item.SlotTitle, item.ClassName)</span>@if(ambiguousGearKeys.Contains(item.Key)){<span class="dashboard-stat-note">Item reference: @item.Key</span>}
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                                            {
                                                <p class="panel-copy">@item.Notes</p>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            </section>
        }
        @if(discoveryActive && matchingOwned.Length>0){<div class="action-row inventory-owned-paging"><span>@shownFrom–@shownTo of @matchingOwned.Length shown</span><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(_ownedPage==0)" OnClick="PreviousOwned" Variant="Variant.Text" data-testid="inventory-owned-previous">Previous owned results</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(shownTo>=matchingOwned.Length)" OnClick="NextOwned" Variant="Variant.Text" data-testid="inventory-owned-next">Next owned results</MudButton></div>}
        </section>
    }
</div>

@code {
    private const int OwnedPageSize=20;
    private string _ownedGearQuery="",_ownedGearSlot="";
    private int _ownedPage;
    private string? _ownedAccount,_pendingOwnedSlot;
    private string[]? _ownedKeys;
    private GearCatalogSnapshot? _ownedCatalog;
    private bool _focusOwnedResults,_focusOwnedSearch,_disposed;
    private ElementReference _ownedSearch,_ownedResultsHeading;
    private readonly Dictionary<string,ElementReference> _slotHeadings=new(StringComparer.Ordinal);
    private readonly HashSet<string> _visibleOwnedSlots=new(StringComparer.Ordinal);
    private bool IsOwnedDiscoveryActive=>!string.IsNullOrWhiteSpace(_ownedGearQuery)||_ownedGearSlot.Length>0;
    private bool MatchesOwnedFilter(InventoryGearItemViewModel item) => (_ownedGearSlot.Length==0||item.SlotTitle==_ownedGearSlot)
        && (NormalizeDisplayedName(item.DisplayName).Contains(NormalizeDisplayedName(_ownedGearQuery),StringComparison.OrdinalIgnoreCase)||item.Key.Contains(_ownedGearQuery.Trim(),StringComparison.OrdinalIgnoreCase));
    private static IReadOnlyList<InventoryGearGroupViewModel> OwnedGroups(IReadOnlyList<InventoryGearGroupViewModel> groups,bool active,IReadOnlySet<string> pageKeys) => !active?groups:groups.Select(group=>group with {Items=group.Items.Where(item=>pageKeys.Contains(item.Key)).DistinctBy(item=>item.Key,StringComparer.Ordinal).ToArray(),BestItems=Array.Empty<InventoryGearItemViewModel>()}).Where(group=>group.Items.Count>0).ToArray();
    private static string OwnedSlotId(string title,bool other)=>"owned-slot-"+(other?"other-":"battle-")+string.Concat(title.ToLowerInvariant().Select(c=>char.IsLetterOrDigit(c)?c:'-'));
    private void OwnedQueryChanged(ChangeEventArgs args) { _ownedGearQuery=args.Value?.ToString()??"";_ownedPage=0; }
    private void OwnedSlotChanged(ChangeEventArgs args) { _ownedGearSlot=args.Value?.ToString()??"";_ownedPage=0; }
    private void ViewOwnedResults() { _pendingOwnedSlot=_ownedGearSlot.Length==0?null:_ownedGearSlot;_focusOwnedResults=true; }
    private void OwnedSearchKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args) { if(args.Key=="Enter")ViewOwnedResults(); }
    private void ResetOwnedFilters() { _ownedGearQuery=_ownedGearSlot="";_ownedPage=0;_pendingOwnedSlot=null;_focusOwnedSearch=true; }
    private void PreviousOwned() { _ownedPage=Math.Max(0,_ownedPage-1);ViewOwnedResults(); }
    private void NextOwned() { _ownedPage++;ViewOwnedResults(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(_disposed)return;
        try {
            if(_focusOwnedSearch){_focusOwnedSearch=false;await FocusOwnedAndRevealAsync(_ownedSearch);}
            else if(_focusOwnedResults){_focusOwnedResults=false;var slot=_pendingOwnedSlot;_pendingOwnedSlot=null;
                var key=slot is not null&&_visibleOwnedSlots.Contains("battle:"+slot)?"battle:"+slot:"other:"+slot;
                if(slot is not null&&_visibleOwnedSlots.Contains(key)&&_slotHeadings.TryGetValue(key,out var heading))await FocusOwnedAndRevealAsync(heading);else await FocusOwnedAndRevealAsync(_ownedResultsHeading);}
        }catch(JSException){}
    }
    private async Task FocusOwnedAndRevealAsync(ElementReference reference)
    {
        if(_disposed)return;var account=_ownedAccount;
        await reference.FocusAsync();
        await using var module=await Js.InvokeAsync<IJSObjectReference>("import","./js/field-focus.js");
        if(!_disposed&&account==_ownedAccount)await module.InvokeVoidAsync("revealFocusedElement",reference);
    }
    private string _battlePresetName = string.Empty;
    private string? _pendingRemovePresetId;
    private string? _renamingPresetId;
    private string _renamePresetName = string.Empty;
    private string _optimizerPresetName = string.Empty;
    private EquipmentOptimizationGoal _optimizationGoal = EquipmentOptimizationGoal.Intelligence;
    private bool _nonBattleEquipmentExpanded;
    private readonly HashSet<string> _expandedOtherItemGroups = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        _ownedAccount=SessionController.State.UserId;_ownedKeys=SessionController.State.UserSnapshot?.Inventory.OwnedGearKeys;_ownedCatalog=SessionController.State.GearCatalogSnapshot;
        SessionController.Changed += HandleStateChanged;
    }

    private static string GetFreshnessLabel(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => "Account data is up to date",
            SnapshotFreshnessState.Stale => "Account data may need refresh",
            SnapshotFreshnessState.Expired => "Account data needs refresh",
            _ => "No saved account data"
        };
    }

    private static Severity GetFreshnessSeverity(SnapshotFreshnessState freshnessState)
    {
        return freshnessState switch
        {
            SnapshotFreshnessState.Fresh => Severity.Success,
            SnapshotFreshnessState.Stale => Severity.Warning,
            SnapshotFreshnessState.Expired => Severity.Error,
            _ => Severity.Info
        };
    }

    private async Task SavePresetAsync(EquipmentSetKind kind)
    {
        var result = await SessionController.SaveEquipmentPresetAsync(kind, _battlePresetName);
        ShowFeedback(result);

        if (result.Succeeded)
        {
            if (kind == EquipmentSetKind.Battle)
            {
                _battlePresetName = string.Empty;
            }
        }
    }

    private async Task SaveRecommendationPresetAsync(EquipmentRecommendationViewModel recommendation)
    {
        var result = await SessionController.SaveEquipmentPresetAsync(
            EquipmentSetKind.Battle,
            _optimizerPresetName,
            recommendation.Slots);
        ShowFeedback(result);

        if (result.Succeeded)
        {
            _optimizerPresetName = string.Empty;
        }
    }

    private async Task EquipRecommendationAsync(EquipmentRecommendationViewModel recommendation)
    {
        var result = await SessionController.EquipGearSlotsAsync(
            EquipmentSetKind.Battle,
            recommendation.Slots,
            $"optimizer:{recommendation.Goal}",
            $"Equipping {recommendation.GoalLabel} recommendation");
        ShowFeedback(result);
    }

    private void SetOptimizationGoal(string? rawValue)
    {
        _optimizationGoal = Enum.TryParse<EquipmentOptimizationGoal>(rawValue, out var goal) && Enum.IsDefined(goal)
            ? goal
            : EquipmentOptimizationGoal.Intelligence;
    }

    private async Task EquipItemAsync(EquipmentSetKind kind, string key)
    {
        var result = await SessionController.EquipInventoryItemAsync(kind, key);
        ShowFeedback(result);
    }

    private async Task EquipPresetAsync(string presetId)
    {
        var result = await SessionController.EquipEquipmentPresetAsync(presetId);
        ShowFeedback(result);
    }

    private bool IsOtherItemsExpanded(string slotTitle)
    {
        return _expandedOtherItemGroups.Contains(slotTitle);
    }

    private void ToggleOtherItems(string slotTitle)
    {
        if (!_expandedOtherItemGroups.Add(slotTitle))
        {
            _expandedOtherItemGroups.Remove(slotTitle);
        }
    }

    private void ToggleNonBattleEquipment()
    {
        _nonBattleEquipmentExpanded = !_nonBattleEquipmentExpanded;
    }

    private static string FormatGearInfo(string slotTitle, string? className)
    {
        return string.IsNullOrWhiteSpace(className) ? slotTitle : $"{slotTitle} • {FormatReadableName(className, string.Empty)}";
    }

    private static string FormatReadableName(string? value, string emptyLabel)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return emptyLabel;
        }

        return CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.Replace('_', ' ').Replace('-', ' '));
    }

    private async Task ConfirmRemovePresetAsync(string presetId)
    {
        var result = await SessionController.RemoveEquipmentPresetAsync(presetId);
        _pendingRemovePresetId = null;
        if (string.Equals(_renamingPresetId, presetId, StringComparison.Ordinal))
        {
            _renamingPresetId = null;
            _renamePresetName = string.Empty;
        }
        ShowFeedback(result);
    }

    private void BeginRenamePreset(InventoryPresetViewModel preset)
    {
        _pendingRemovePresetId = null;
        _renamingPresetId = preset.Id;
        _renamePresetName = preset.Name;
    }

    private async Task SaveRenamePresetAsync(string presetId)
    {
        var result = await SessionController.RenameEquipmentPresetAsync(presetId, _renamePresetName);
        if (result.Succeeded)
        {
            _renamingPresetId = null;
            _renamePresetName = string.Empty;
        }

        ShowFeedback(result);
    }

    private void ShowFeedback(InventoryActionResult result)
    {
        Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
    }

