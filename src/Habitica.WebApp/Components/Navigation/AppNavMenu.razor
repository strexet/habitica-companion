@inject IAppSessionController SessionController

<MudNavMenu Class="app-nav-menu">
    @if (!SessionController.State.IsAuthenticated)
    {
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Login">
            Sign In
        </MudNavLink>
    }

    @if (SessionController.State.HasCachedTasks || SessionController.State.HasCachedUserSnapshot || SessionController.State.IsAuthenticated)
    {
        <MudNavLink Href="/dashboard" Icon="@Icons.Material.Outlined.DashboardCustomize">
            Dashboard
        </MudNavLink>

        <MudNavLink Href="/inventory" Icon="@Icons.Material.Outlined.Inventory2">
            Inventory
        </MudNavLink>

        <MudNavLink Href="/party" Icon="@Icons.Material.Outlined.Groups2">
            Party
        </MudNavLink>

        @if (SessionController.State.IsAuthenticated)
        {
            <MudNavLink Href="/live-tests" Icon="@Icons.Material.Outlined.Science">
                Live Tests
            </MudNavLink>
        }

        <MudNavLink Href="/tasks" Icon="@Icons.Material.Outlined.TaskAlt">
            Tasks
        </MudNavLink>

        <MudNavLink Href="/settings" Icon="@Icons.Material.Outlined.Settings">
            Settings
        </MudNavLink>
    }
</MudNavMenu>
