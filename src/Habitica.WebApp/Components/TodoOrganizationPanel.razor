@using Habitica.Application.Workspace
@using Habitica.Domain.Workspace
@using System.Globalization
@inject TodoWorkspacePresentation Todo
@inject WorkspaceOrganizationController Organization
@implements IDisposable

<section class="card-surface todo-task-panel todo-organization-panel">
    <div class="task-group-header"><h1 tabindex="-1" @ref="_heading">Projects</h1><a href="/todo/tasks" data-layout-primary="true">Tasks and subtasks</a></div>
    <div class="action-row"><MudButton HtmlTag="a" Href="/todo/convert" data-layout-primary="true" Variant="Variant.Outlined">Convert checklist to project</MudButton></div>
    <p><a href="/todo/sync#habitica-tags">Group tag coverage and recovery</a></p>
    <p class="panel-copy">Organization is optional. Tasks can stay unassigned. Categories, sections, labels and goals help group work without changing Habitica rewards.</p>
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (Organization.Message is not null) { <p role="status">@Organization.Message</p> }
    @if (Organization.LastReceipt is { } receipt)
    { <p role="status" data-testid="organization-receipt">Saved in Companion: @(receipt.SavedInCompanion ? "Yes" : "No") · no gameplay effects · tag metadata may need confirmation · refresh: @(receipt.RefreshSucceeded ? "complete" : "reload required"). Original command: @receipt.CommandId</p> }
    @if (Organization.Preview is { } preview)
    {
        <section class="todo-command-review" aria-label="Review organization change" data-testid="organization-review">
            <h2 tabindex="-1" @ref="_reviewHeading">Review @preview.Command.Operation.ToString().ToLowerInvariant() · @preview.Command.Kind</h2>
            <p><strong>@preview.Snapshot.Name</strong> · @preview.Command.EntityId</p>
            @if (preview.Command.Kind==WorkspaceOrganizationKind.Project)
            {
                <p data-testid="organization-alias-review">Alias: @(preview.Snapshot.Alias??"None")</p>
                @if (preview.Command.Patch?.ClearAlias==true) { <p>Release the alias for reuse. The project name, identity and task assignments stay unchanged.</p> }
            }
            @if (preview.Command.Kind==WorkspaceOrganizationKind.SavedTaskView && preview.Snapshot.Query is { } savedQuery) { <TodoSavedQuerySummary Query="savedQuery" /> }
            @if (preview.Command.Patch is { } patch)
            {
                @if (patch.CategoryId is { } category || patch.ClearCategory) { <p>Category: @(patch.ClearCategory ? "Clear category" : MetadataName(WorkspaceOrganizationKind.Category,patch.CategoryId!.Value))</p> }
                @if (patch.ProjectId is { } project) { <p>Section project: @MetadataName(WorkspaceOrganizationKind.Project,project)</p> }
                @if (patch.Position is { } position) { <p>Section order: @position</p> }
                @if (patch.TaskIds is { } members) { <p>Replace goal membership (@members.Count Todos):</p><ul>@foreach (var member in members) { <li>@TaskName(member) · @member</li> }</ul> }
            }
            <p>No task is completed or deleted. Task history and links to Habitica stay unchanged.</p>
            @if (preview.Command.Operation == WorkspaceOrganizationOperation.Archive) { <p>Archive removes this record from active choices. Existing references remain saved.</p> }
            @if (preview.Command.Patch?.Removal is { } removal)
            {
                <p>Remove this project from active organization. Assigned tasks become visually Unassigned; every task, section and parent link remains saved. Review all affected references before confirming.</p>
                @if (_references.Count == 0) { <p>No directly assigned tasks or sections.</p> }
                else
                {
                    <ul>@foreach (var reference in _references.Skip(_referenceOffset).Take(20)) { <li>@(reference.Section ? "Section: " + MetadataName(WorkspaceOrganizationKind.Section,reference.Id) : "Task: " + TaskName(reference.Id) + " · " + reference.Id)</li> }</ul>
                    <label class="checkbox-row"><input type="checkbox" checked="@_reviewedPages.Contains(_referenceOffset)" @onchange="AcknowledgePage" disabled="@OriginalBusy" data-testid="organization-reference-ack" /><span>Reviewed references @(_referenceOffset + 1)–@(Math.Min(_referenceOffset + 20,_references.Count)) of @_references.Count</span></label>
                    <div class="action-row"><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(OriginalBusy || _referenceOffset == 0)" OnClick="PreviousReferences" Variant="Variant.Text">Previous references</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(OriginalBusy || _referenceOffset + 20 >= _references.Count)" OnClick="NextReferences" Variant="Variant.Text">Next references</MudButton></div>
                }
            }
            <WorkspaceTagChangeReview CommandId="preview.PreparedCommandId" Preview="preview.TagProjection" Tasks="@(Todo.Snapshot?.Document.Tasks??[])" Disabled="@OriginalBusy" Reviewed="value=>TagReviewed(preview.PreparedCommandId,value)" />
            <p>Original command: @preview.PreparedCommandId · expires @preview.ExpiresAtUtc.ToString("u")</p>
            @if (Organization.AcceptanceUnknown) { <p>Acceptance is uncertain. Check the original receipt before considering another change.</p> }
            <div class="action-row">
                <MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(OriginalBusy || (!AllReferencesReviewed||!TagsReady(preview.PreparedCommandId,preview.TagProjection)) && !Organization.AcceptanceUnknown)" OnClick="ConfirmAsync" Color="Color.Primary" Variant="Variant.Filled" data-testid="organization-confirm">@(Organization.AcceptanceUnknown ? "Retry original change" : "Confirm organization change")</MudButton>
                <MudButton HtmlTag="button" data-layout-primary="true" Disabled="@OriginalBusy" OnClick="RecoverAsync" Variant="Variant.Outlined" data-testid="organization-recover">Check original receipt</MudButton>
                <MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(OriginalBusy || Organization.AcceptanceUnknown)" OnClick="Cancel" Variant="Variant.Text">Cancel organization review</MudButton>
            </div>
        </section>
    }
    else if (Organization.HasPendingIntent)
    { <p>Preparation is unresolved. Recover the original request instead of creating another change.</p><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@OriginalBusy" OnClick="RetryAsync" Variant="Variant.Outlined" data-testid="organization-retry">Recover original organization preview</MudButton> }
    @if (Todo.Snapshot is null)
    { <p>Choose or reload the workspace below before creating organization records. An original review remains separate from unavailable task data.</p> }
    else
    {
        <label class="field-row">Organize<select class="app-input" value="@_kind" @onchange="ChangeKind" disabled="@FreshDisabled" data-testid="organization-kind">@foreach (var kind in Kinds) { <option value="@kind">@Plural(kind)</option> }</select></label>
        <form @onsubmit="PrepareAsync" @onsubmit:preventDefault><fieldset disabled="@FreshDisabled">
            <h2 tabindex="-1" @ref="_editorHeading">@(_editing is null ? "Create" : "Edit") @_kind</h2>
            <label class="field-row">Name<input class="app-input" maxlength="256" @bind="_name" @bind:event="oninput" data-testid="organization-name" /></label>
            @if (_kind == WorkspaceOrganizationKind.Project)
            {
                <TodoPlacementPicker Kind="Category" Caption="Optional category" Value="_category" ValueChanged="value => _category = value" Disabled="@FreshDisabled" />
                @if (_editing is null) { <label class="field-row">Optional alias<input class="app-input" maxlength="256" placeholder="codev" @bind="_alias" @bind:event="oninput" data-testid="organization-alias" /></label><p>Alias uses 1–64 letters or digits with single internal hyphens. Surrounding spaces and letter case are normalized. The display name stays exact.</p> }
            }
            @if (_kind == WorkspaceOrganizationKind.Section)
            {
                <TodoPlacementPicker Kind="Project" Caption="Section project" Value="_sectionProject" ValueChanged="value => _sectionProject = value" Disabled="@(FreshDisabled || _editing is not null)" EmptyLabel="Choose project" />
                @if (_editing is not null) { <p>A section keeps the original project. Edit the name or order here.</p> }
                <label class="field-row">Order<input class="app-input" type="number" min="0" max="2147483647" value="@_position" @onchange="args => _position = args.Value?.ToString() ?? string.Empty" data-testid="organization-position" /></label>
            }
            @if (_kind == WorkspaceOrganizationKind.Goal)
            {
                <details open="true"><summary>Goal Todos (@_members.Count of 100 maximum)</summary><p>Membership is a complete replacement. Cancelled and archived Todos do not count toward progress; an empty eligible set has no percentage.</p>
                    @foreach (var member in _members.ToArray()) { <div class="action-row"><span>@TaskName(member)</span><MudButton HtmlTag="button" data-layout-primary="true" OnClick="() => RemoveMember(member)" Variant="Variant.Text" aria-label="@($"Remove goal member {member:D}")">Remove</MudButton></div> }
                    @foreach (var task in _choices) { <label class="checkbox-row"><input type="checkbox" checked="@_members.Contains(task.Id)" @onchange="args => SetMember(task.Id,args.Value is true)" data-testid="@($"goal-member-{task.Id:D}")" /><span>@TaskChoiceName(task) · @task.State</span></label> }
                    <div class="action-row"><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(_choiceOffset == 0)" OnClick="PreviousChoices" Variant="Variant.Text">Previous Todo choices</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(_nextChoices is null)" OnClick="NextChoices" Variant="Variant.Text">Next Todo choices</MudButton></div>
                </details>
            }
            <div class="action-row"><MudButton HtmlTag="button" data-layout-primary="true" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" data-testid="organization-prepare">Review @_kind.ToString().ToLowerInvariant()</MudButton><MudButton HtmlTag="button" data-layout-primary="true" OnClick="New" Variant="Variant.Text">New record</MudButton><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ReloadEditor" Variant="Variant.Text">Reload editor context</MudButton></div>
        </fieldset></form>
        @if (_kind==WorkspaceOrganizationKind.Project && _editing is { } aliasProject)
        {
            <form @onsubmit="PrepareAliasAsync" @onsubmit:preventDefault data-testid="organization-alias-form"><fieldset disabled="@FreshDisabled">
                <h3>Project alias</h3><p>@MetadataName(WorkspaceOrganizationKind.Project,aliasProject)</p>
                <label class="field-row">Alias<input class="app-input" maxlength="256" placeholder="codev" @bind="_alias" @bind:event="oninput" data-testid="organization-alias" /></label>
                <p>Use an alias such as codev for this exact project. Leave blank to release an existing alias. Name changes use a separate review; save the alias before explicitly removing a temporary name marker.</p>
                <MudButton HtmlTag="button" data-layout-primary="true" ButtonType="ButtonType.Submit" Variant="Variant.Outlined" data-testid="organization-alias-prepare">Review alias change</MudButton>
            </fieldset></form>
        }
        <section aria-label="Organization records">
            @if (_rows.Count == 0) { <p>No active @Plural(_kind).ToLowerInvariant().</p> }
            @foreach (var row in _rows)
            {
                <article class="todo-direct-row"><div class="todo-row-content"><strong>@row.Name</strong>
                    @if (row.Alias is {} alias) { <span data-testid="organization-alias-value">Alias: @alias</span> }
                    @if (row.ProjectId is { } ownerProject) { <span>Project: @MetadataName(WorkspaceOrganizationKind.Project,ownerProject) · order @row.Position</span> }
                    @if (_progress.TryGetValue(row.Id,out var progress)) { <span>@(progress.EligibleTodos == 0 ? "Progress unavailable: no eligible Todos." : $"{progress.CompletedTodos} of {progress.EligibleTodos} eligible Todos completed")</span> }
                    <details><summary>Reference</summary><p>@row.Id</p></details>
                </div><div class="todo-row-actions"><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@FreshDisabled" OnClick="() => Edit(row.Id)" Variant="Variant.Text" data-testid="@($"organization-edit-{row.Id:D}")">Edit</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@FreshDisabled" OnClick="() => ArchiveAsync(row.Id)" Variant="Variant.Text" data-testid="@($"organization-archive-{row.Id:D}")">Review archive</MudButton>@if (_kind == WorkspaceOrganizationKind.Project) { <MudButton HtmlTag="button" data-layout-primary="true" Disabled="@FreshDisabled" OnClick="() => RemoveAsync(row.Id)" Variant="Variant.Text" data-testid="@($"organization-remove-{row.Id:D}")">Review project removal</MudButton> }</div></article>
            }
            <div class="action-row"><span>@_total active @Plural(_kind).ToLowerInvariant()</span><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(FreshDisabled || _offset == 0)" OnClick="Previous" Variant="Variant.Text">Previous records</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(FreshDisabled || _next is null)" OnClick="Next" Variant="Variant.Text">Next records</MudButton></div>
        </section>
    }
</section>

@code {
    private Guid _tagReviewId;private bool _tagReviewed;
    private void TagReviewed(Guid id,bool reviewed){_tagReviewId=id;_tagReviewed=reviewed;}
    private bool TagsReady(Guid id,WorkspaceTagChangePreview? preview)=>preview?.RequestsMetadataChanges!=true||_tagReviewId==id&&_tagReviewed;
    private static readonly WorkspaceOrganizationKind[] Kinds=[WorkspaceOrganizationKind.Project,WorkspaceOrganizationKind.Category,WorkspaceOrganizationKind.Section,WorkspaceOrganizationKind.Label,WorkspaceOrganizationKind.Goal];
    private WorkspaceOrganizationKind _kind=WorkspaceOrganizationKind.Project;
    private TodoWorkspaceSelection? _source, _draftSource;
    private long? _revision, _draftRevision;
    private Guid? _editing,_category,_sectionProject,_reviewId;
    private string _name="",_position="0",_alias="";
    private string? _error;
    private List<Guid> _members=[];
    private IReadOnlyList<CompanionTask> _choices=[];
    private IReadOnlyList<WorkspaceOrganizationSnapshot> _rows=[];
    private Dictionary<Guid,WorkspaceGoalSummary> _progress=[];
    private IReadOnlyList<Reference> _references=[];
    private sealed record Reference(Guid Id,bool Section);
    private readonly HashSet<int> _reviewedPages=[];
    private int _offset,_total,_choiceOffset,_referenceOffset;
    private int? _next,_nextChoices;
    private bool _focusReview,_focusEditor;
    private ElementReference _heading,_reviewHeading,_editorHeading;
    private bool FreshDisabled=>Todo.IsReadOnly||Todo.IsBusy||Organization.IsBusy||Organization.HasPendingIntent||Todo.Commands.HasPendingIntent;
    private bool OriginalBusy=>Todo.IsBusy||Organization.IsBusy||Todo.Commands.HasPendingIntent;
    private bool AllReferencesReviewed=>Enumerable.Range(0,(_references.Count+19)/20).All(page=>_reviewedPages.Contains(page*20));
    protected override void OnInitialized(){_source=Todo.Selection;_revision=Todo.Revision;ResetEditor();Todo.Changed+=Changed;Read();}
    protected override async Task OnAfterRenderAsync(bool firstRender){try{if(_focusReview&&Organization.Preview is not null){_focusReview=false;await _reviewHeading.FocusAsync();}else if(_focusEditor){_focusEditor=false;await _editorHeading.FocusAsync();}}catch(JSException){}}
    private void Changed(){if(_source!=Todo.Selection){_source=Todo.Selection;_offset=0;ResetEditor();_reviewId=null;_reviewedPages.Clear();_referenceOffset=0;_error=null;}if(_revision!=Todo.Revision){_revision=Todo.Revision;_offset=_choiceOffset=0;}Read();_ = InvokeAsync(StateHasChanged);}
    private void ResetEditor(){_editing=_category=_sectionProject=null;_name="";_alias="";_position="0";_members=[];_draftSource=Todo.Selection;_draftRevision=Todo.Revision;_choiceOffset=0;}
    private void Read()
    {
        _rows=[];_total=0;_next=null;_choices=[];_progress=[];
        if(_reviewId!=Organization.Preview?.PreparedCommandId){_reviewId=Organization.Preview?.PreparedCommandId;_referenceOffset=0;_reviewedPages.Clear();}
        var removal=Organization.Preview?.Command.Patch?.Removal;
        _references=removal is null?[]:removal.TaskIds.Select(id=>new Reference(id,false)).Concat(removal.SectionIds.Select(id=>new Reference(id,true))).ToArray();
        if(Todo.Snapshot is null)return;if(_draftRevision is null){_draftRevision=Todo.Revision;_draftSource=Todo.Selection;}
        try
        {
            var filter=new WorkspaceReadFilter(20,_offset,_revision);IReadOnlyList<Guid> ids;
            switch(_kind)
            {
                case WorkspaceOrganizationKind.Category:var c=Todo.Categories(filter);ids=c.Items.Select(row=>row.Id).ToArray();Set(c.MatchedCount,c.NextOffset);break;
                case WorkspaceOrganizationKind.Project:var p=Todo.Projects(filter);ids=p.Items.Select(row=>row.Id).ToArray();Set(p.MatchedCount,p.NextOffset);break;
                case WorkspaceOrganizationKind.Section:
                    var all=Todo.Snapshot.Document.Sections.Where(row=>!row.IsArchived).ToArray();ids=all.Skip(_offset).Take(20).Select(row=>row.Id).ToArray();Set(all.Length,_offset+ids.Count<all.Length?_offset+ids.Count:null);break;
                case WorkspaceOrganizationKind.Label:var l=Todo.Labels(filter);ids=l.Items.Select(row=>row.Id).ToArray();Set(l.MatchedCount,l.NextOffset);break;
                default:var g=Todo.Goals(filter);_progress=g.Items.ToDictionary(row=>row.Goal.Id);ids=g.Items.Select(row=>row.Goal.Id).ToArray();Set(g.MatchedCount,g.NextOffset);break;
            }
            _rows=ids.Select(id=>WorkspaceOrganizationSnapshot.From(Todo.Snapshot.Document,_kind,id)!).ToArray();
            var choices=Todo.Tasks(new(Kind:CompanionTaskKind.Todo,Limit:20,Offset:_choiceOffset,ExpectedRevision:_revision));_choices=choices.Tasks;_nextChoices=choices.NextOffset;
        }catch(InvalidOperationException){_error="Organization data changed. Reload the workspace and editor context.";}
    }
    private void Set(int count,int? next){_total=count;_next=next;}
    private string TaskChoiceName(CompanionTask task)=>Todo.Snapshot?.Document.Tasks.Count(row=>row.Kind==CompanionTaskKind.Todo&&!row.IsArchived&&row.Text==task.Text)>1?$"{task.Text} · {task.Id}":task.Text;
    private string TaskName(Guid id)=>Todo.Snapshot?.Document.Tasks.FirstOrDefault(task=>task.Id==id)?.Text??"Retained task";
    private string MetadataName(WorkspaceOrganizationKind kind,Guid id)=>$"{(Todo.Snapshot is { } snapshot?WorkspaceOrganizationSnapshot.From(snapshot.Document,kind,id)?.Name:null)??"Retained record"} · {id}";
    private static string Plural(WorkspaceOrganizationKind kind)=>kind switch{WorkspaceOrganizationKind.Category=>"Categories",WorkspaceOrganizationKind.Section=>"Sections",WorkspaceOrganizationKind.Label=>"Labels",WorkspaceOrganizationKind.Goal=>"Goals",_=>"Projects"};
    private void ChangeKind(ChangeEventArgs args){if(FreshDisabled||!Enum.TryParse<WorkspaceOrganizationKind>(args.Value?.ToString(),out var kind)||!Kinds.Contains(kind))return;_kind=kind;_offset=0;ResetEditor();Read();}
    private void New(){ResetEditor();_error=null;_focusEditor=true;Read();}
    private void Edit(Guid id)
    {
        if(FreshDisabled||Todo.Snapshot is null)return;var row=WorkspaceOrganizationSnapshot.From(Todo.Snapshot.Document,_kind,id);if(row is null||row.IsArchived)return;
        ResetEditor();_editing=id;_name=row.Name;_alias=row.Alias??"";_category=row.CategoryId;_sectionProject=row.ProjectId;_position=row.Position.ToString(CultureInfo.InvariantCulture);_members=row.TaskIds?.ToList()??[];_focusEditor=true;
    }
    private void ReloadEditor(){if(_editing is {} id)Edit(id);else{_draftRevision=Todo.Revision;_draftSource=Todo.Selection;}_error=null;Read();}
    private void SetMember(Guid id,bool selected){if(selected&&!_members.Contains(id)){if(_members.Count>=100){_error="A goal supports at most 100 Todos.";return;}_members.Add(id);}else if(!selected)_members.Remove(id);}
    private void RemoveMember(Guid id)=>_members.Remove(id);
    private void RequireFresh(){if(FreshDisabled||Todo.Snapshot is null||_draftSource!=Todo.Selection||_draftRevision!=Todo.Revision)throw new InvalidOperationException("Reload the workspace and editor context before reviewing organization changes.");}
    private WorkspaceOrganizationPatch Patch()
    {
        if(string.IsNullOrWhiteSpace(_name)||_name.Length>256)throw new InvalidOperationException("Enter a name within 256 characters.");
        var current=_editing is {} id?WorkspaceOrganizationSnapshot.From(Todo.Snapshot!.Document,_kind,id):null;
        int? position=null;if(_kind==WorkspaceOrganizationKind.Section){if(!int.TryParse(_position,NumberStyles.None,CultureInfo.InvariantCulture,out var parsed)||parsed<0)throw new InvalidOperationException("Enter a nonnegative section order.");if(current is null||parsed!=current.Position)position=parsed;}
        if(_kind==WorkspaceOrganizationKind.Section&&current is null&&_sectionProject is null)throw new InvalidOperationException("Choose the project for this section.");
        var patch=new WorkspaceOrganizationPatch(Name:current?.Name==_name?null:_name,CategoryId:_kind==WorkspaceOrganizationKind.Project&&_category!=current?.CategoryId?_category:null,ClearCategory:_kind==WorkspaceOrganizationKind.Project&&current?.CategoryId is not null&&_category is null,
            ProjectId:_kind==WorkspaceOrganizationKind.Section&&current is null?_sectionProject:null,Position:position,TaskIds:_kind==WorkspaceOrganizationKind.Goal&&(current?.TaskIds is null||!_members.SequenceEqual(current.TaskIds))?_members.ToArray():null,
            Alias:_kind==WorkspaceOrganizationKind.Project&&current is null&&!string.IsNullOrWhiteSpace(_alias)?ValidateAlias(_alias):null);
        if(patch==new WorkspaceOrganizationPatch())throw new InvalidOperationException("Change a field before reviewing.");return patch;
    }
    private async Task RunAsync(Func<Task> action){_error=null;try{await action();Read();}catch(InvalidOperationException error){_error=error.Message;}catch{_error="Organization state is unavailable. Keep the original request or command and check the original receipt.";}}
    private static string ValidateAlias(string alias){if(!WorkspaceProjectAliases.IsValid(alias))throw new InvalidOperationException("Enter an alias with 1–64 ASCII letters or digits and single internal hyphens.");return alias;}
    private Task PrepareAliasAsync()=>RunAsync(async()=>
    {
        RequireFresh();if(_kind!=WorkspaceOrganizationKind.Project||_editing is not {} id)throw new InvalidOperationException("Select the exact project before reviewing an alias.");
        var current=WorkspaceOrganizationSnapshot.From(Todo.Snapshot!.Document,_kind,id)!;
        var patch=string.IsNullOrWhiteSpace(_alias)?new WorkspaceOrganizationPatch(ClearAlias:true):new WorkspaceOrganizationPatch(Alias:ValidateAlias(_alias));
        if(patch.ClearAlias&&current.Alias is null||patch.Alias is {} alias&&WorkspaceProjectAliases.Normalize(alias)==current.Alias)throw new InvalidOperationException("Change the alias before reviewing.");
        await Todo.PrepareOrganizationAsync(new(_kind,WorkspaceOrganizationOperation.Update,id,patch));_focusReview=Organization.Preview is not null;
    });
    private Task PrepareAsync()=>RunAsync(async()=>{RequireFresh();await Todo.PrepareOrganizationAsync(new(_kind,_editing is null?WorkspaceOrganizationOperation.Create:WorkspaceOrganizationOperation.Update,_editing,Patch()));_focusReview=Organization.Preview is not null;});
    private Task ArchiveAsync(Guid id)=>RunAsync(async()=>{if(FreshDisabled)throw new InvalidOperationException("Resolve the original change first.");await Todo.PrepareOrganizationAsync(new(_kind,WorkspaceOrganizationOperation.Archive,id));_focusReview=Organization.Preview is not null;});
    private Task RemoveAsync(Guid id)=>RunAsync(async()=>{if(FreshDisabled)throw new InvalidOperationException("Resolve the original change first.");var impact=Todo.ProjectRemoval(id,Todo.Revision);await Todo.PrepareOrganizationAsync(new(WorkspaceOrganizationKind.Project,WorkspaceOrganizationOperation.Remove,id,new(Removal:impact.Removal)));_focusReview=Organization.Preview is not null;});
    private Task ConfirmAsync()=>RunAsync(async()=>{if(Organization.Preview is {} current&&!TagsReady(current.PreparedCommandId,current.TagProjection)&&!Organization.AcceptanceUnknown)throw new InvalidOperationException("Review every tag reference page before confirming.");if(!AllReferencesReviewed&&!Organization.AcceptanceUnknown)throw new InvalidOperationException("Review every reference page before confirming removal.");await Todo.ConfirmOrganizationAsync();if(Organization.LastReceipt?.SavedInCompanion==true)ResetEditor();});
    private Task RecoverAsync()=>RunAsync(async()=>{await Todo.RecoverOrganizationAsync();if(Organization.LastReceipt?.SavedInCompanion==true)ResetEditor();});
    private Task RetryAsync()=>RunAsync(async()=>{await Todo.RetryOrganizationPreviewAsync();_focusReview=Organization.Preview is not null;if(Organization.LastReceipt?.SavedInCompanion==true)ResetEditor();});
    private void Cancel(){Todo.CancelOrganizationPreview();_error=null;_focusEditor=true;Read();}
    private void AcknowledgePage(ChangeEventArgs args){if(args.Value is true)_reviewedPages.Add(_referenceOffset);else _reviewedPages.Remove(_referenceOffset);}
    private void PreviousReferences()=>_referenceOffset=Math.Max(0,_referenceOffset-20);
    private void NextReferences()=>_referenceOffset=Math.Min(_referenceOffset+20,((_references.Count-1)/20)*20);
    private void Previous(){_offset=Math.Max(0,_offset-20);Read();}
    private void Next(){if(_next is {} next){_offset=next;Read();}}
    private void PreviousChoices(){_choiceOffset=Math.Max(0,_choiceOffset-20);Read();}
    private void NextChoices(){if(_nextChoices is {} next){_choiceOffset=next;Read();}}
    public void Dispose()=>Todo.Changed-=Changed;
}
