@using Habitica.Application.Workspace
@using Habitica.Domain.Workspace
@inject TodoWorkspacePresentation Todo
@inject WorkspaceOrganizationController Organization
@inject TimeProvider Clock
@inject IJSRuntime Js
@implements IDisposable
@implements IAsyncDisposable

<section class="card-surface todo-task-panel todo-saved-list-panel">
    <div class="task-group-header"><h1>Saved lists</h1><a href="/todo/tasks" data-layout-primary="true">Tasks and subtasks</a></div>
    <p>Open a saved list to browse matching Companion tasks. Lists do not duplicate tasks or create game effects.</p>
    <TodoTaskPanel ShowCapture="false" ShowTaskList="false" />
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (Organization.Message is { } message) { <p role="status">@message</p> }
    @if (Organization.LastReceipt is {Kind:WorkspaceOrganizationKind.SavedTaskView} receipt) { <p role="status" data-testid="saved-list-receipt">Saved in Companion: @(receipt.SavedInCompanion ? "Yes" : "No") · no task duplication or game effects · refresh: @(receipt.RefreshSucceeded ? "complete" : "reload required") · original command @receipt.CommandId</p> }
    @if (Organization.Preview is { } preview)
    {
        @if (preview.Command.Kind==WorkspaceOrganizationKind.SavedTaskView)
        {
            <section class="todo-command-review" aria-label="Review saved list" data-testid="saved-list-review">
                <h2 tabindex="-1" @ref="_reviewHeading">Review @preview.Command.Operation.ToString().ToLowerInvariant() saved list</h2><p><strong>@preview.Snapshot.Name</strong> · @preview.Command.EntityId</p>
                @if (preview.Snapshot.Query is { } query) { <TodoSavedQuerySummary Query="query" /><RelativeSavedDateSummary Evaluation="_reviewEvaluation" /> }
                <p>Filters above are the complete saved definition. Null filters are cleared or unbounded. Archiving hides the definition while retaining native history; tasks remain unchanged.</p><p>No task, completion or Habitica effect is created. Original command: @preview.PreparedCommandId · expires @preview.ExpiresAtUtc.ToString("u")</p>
                @if (Organization.AcceptanceUnknown) { <p>Acceptance is uncertain. Recover the original receipt or retry the original command; do not create a replacement.</p> }
                <div class="action-row"><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@OriginalBusy" OnClick="ConfirmAsync" Variant="Variant.Filled" Color="Color.Primary" data-testid="saved-list-confirm">@(Organization.AcceptanceUnknown?"Retry original saved list":"Confirm saved list change")</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@OriginalBusy" OnClick="RecoverAsync" Variant="Variant.Outlined" data-testid="saved-list-recover">Check original receipt</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(OriginalBusy||Organization.AcceptanceUnknown)" OnClick="Cancel" Variant="Variant.Text">Cancel saved list review</MudButton></div>
            </section>
        }
        else { <p>Another organization review owns this workspace. <a href="/todo/projects">Open Projects to resolve the original change</a>.</p> }
    }
    else if (Organization.HasPendingIntent) { <p>The original organization preparation is unresolved.</p><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@OriginalBusy" OnClick="RetryAsync" Variant="Variant.Outlined" data-testid="saved-list-retry">Recover original organization preview</MudButton> }
    @if (Todo.Snapshot is not null)
    {
        @if (Stale) { <p role="status">Workspace data changed. Reload the editor before replacing a saved definition.</p> }
        <div class="action-row saved-list-authoring-actions"><button type="button" class="secondary-action-button" data-layout-primary="true" disabled="@Busy" @onclick="New" @ref="_newListButton" data-testid="saved-list-new">New list</button>
            @if (!_editorOpen && HasDraft) { <button type="button" class="secondary-action-button" data-layout-primary="true" disabled="@Busy" @onclick="ResumeAuthoring" data-testid="saved-list-resume">Continue draft</button> }
        </div>
        <section aria-label="Saved definitions"><h2>Saved definitions</h2>
            @if (_rows.Count==0) { <p>No active saved definitions on this page.</p> }
            @foreach(var row in _rows)
            {
                <article class="todo-direct-row"><div class="todo-row-content"><strong>@ListName(row)</strong><span>@row.Query.Source</span><details><summary>Reference</summary><p>@row.Id</p></details></div><div class="todo-row-actions"><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@Todo.IsBusy" OnClick="()=>Select(row.Id)" Variant="Variant.Text" aria-label="@($"Open list {row.Name} {row.Id:D}")" data-testid="@($"saved-list-open-{row.Id:D}")">Open list</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@Busy" OnClick="()=>Edit(row.Id)" Variant="Variant.Text" data-testid="@($"saved-list-edit-{row.Id:D}")">Edit definition</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@Busy" OnClick="()=>ArchiveAsync(row.Id)" Variant="Variant.Text" data-testid="@($"saved-list-archive-{row.Id:D}")">Review archive</MudButton></div></article>
            }
            <div class="action-row"><span>@_total active definitions</span><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(Todo.IsBusy||_listOffset==0)" OnClick="PreviousLists" Variant="Variant.Text">Previous definitions</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(Todo.IsBusy||_listOffset+20>=_total)" OnClick="NextLists" Variant="Variant.Text">Next definitions</MudButton></div>
        </section>
        <section aria-label="Saved list results"><h2 tabindex="-1" @ref="_resultsHeading">Selected list</h2>
            @if (_selected is null) { <p>Open a saved definition to read matching tasks. No implicit all-task fallback is selected.</p> }
            else if (_readError is not null) { <p role="alert" data-testid="saved-list-unavailable">@_readError</p> }
            else if (_page is { } result && _definition is { } definition)
            {
                <h3>@definition.Name</h3><details class="saved-definition-details"><summary>Exact saved filters</summary><TodoSavedQuerySummary Query="definition.Query" /></details><RelativeSavedDateSummary Evaluation="result.Evaluation" /><p data-testid="saved-list-count">@result.MatchedCount matching nonarchived tasks · revision @result.Revision. Mapping state does not confirm game effects.</p>
                @if (result.Tasks.Count==0) { <p>No tasks match this saved definition.</p> }
                @foreach(var task in result.Tasks) { <article class="todo-direct-row" data-testid="@($"saved-list-task-{task.Id:D}")"><div class="todo-row-content"><strong>@task.Text</strong><span>@task.Kind · @task.State · @task.Priority</span>@if(task.PlannedDate is {} planned){<span>Planned: @planned.ToString("yyyy-MM-dd")</span>}@if(task.Deadline is {} deadline){<span>Deadline: @deadline.ToString("yyyy-MM-dd")</span>}<details><summary>Task reference</summary><p>@task.Id</p></details></div></article> }
                <div class="action-row"><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(Todo.IsBusy||_taskOffset==0)" OnClick="PreviousTasks" Variant="Variant.Text">Previous matching tasks</MudButton><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@(Todo.IsBusy||result.NextOffset is null)" OnClick="NextTasks" Variant="Variant.Text">Next matching tasks</MudButton></div>
            }
            <div class="action-row">@if (_selected is not null) { <MudButton HtmlTag="button" data-layout-primary="true" OnClick="ClearSelection" Variant="Variant.Text">Clear selected definition</MudButton> }
            @if(_selected is not null){<MudButton HtmlTag="button" data-layout-primary="true" Disabled="@Todo.IsBusy" OnClick="RestartDay" Variant="Variant.Text" data-testid="saved-list-restart-day">Restart selected list with the current day</MudButton>}</div>
        </section>
        <section id="saved-list-authoring" aria-labelledby="saved-list-editor-title" data-testid="saved-list-authoring" hidden="@(!_editorOpen)">
        <form @onsubmit="PrepareAsync" @onsubmit:preventDefault>
            @if (_fieldErrors.Count > 0)
            { <p @key="_validationAttempt" role="alert" data-testid="saved-list-errors">Fix @InvalidFields.Count() @(InvalidFields.Count()==1?"field":"fields") before review. @FirstFieldErrorMessage Entered values are retained.</p> }
            <fieldset disabled="@FreshDisabled">
                <h2 id="saved-list-editor-title" tabindex="-1" @ref="_editorHeading">@(_editing is null?"New saved list":"Edit saved list")</h2>
                <div class="saved-list-field"><label class="field-row">List name<input class="app-input" maxlength="256" @bind="_draft.Name" @bind:event="oninput" @ref="_fieldName" id="@ControlId(TodoSavedListField.Name)" aria-invalid="@Invalid(TodoSavedListField.Name)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Name)" data-testid="saved-list-name" /></label>@RenderFieldError(TodoSavedListField.Name)</div>
                <div class="saved-list-field"><label class="field-row">Source<select class="app-input" value="@_draft.Source" @onchange="ChangeSource" @ref="_fieldSource" id="@ControlId(TodoSavedListField.Source)" aria-invalid="@Invalid(TodoSavedListField.Source)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Source)" data-testid="saved-list-source"><option value="Tasks">Tasks</option><option value="UnblockedTodos">Unblocked active Todos</option></select></label>@RenderFieldError(TodoSavedListField.Source)</div>
                <div class="saved-list-field"><label class="field-row">Search titles and notes (plain text)<input class="app-input" maxlength="256" @bind="_draft.Search" @bind:event="oninput" @ref="_fieldSearch" id="@ControlId(TodoSavedListField.Search)" aria-invalid="@Invalid(TodoSavedListField.Search)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Search)" data-testid="saved-list-search" /></label>@RenderFieldError(TodoSavedListField.Search)</div>
                <div class="action-row"><button type="button" class="secondary-action-button" data-layout-primary="true" disabled="@FreshDisabled" @onclick="()=>_advancedOpen=!_advancedOpen" aria-expanded="@(_advancedOpen ? "true" : "false")" aria-controls="saved-list-additional-filters" data-testid="saved-list-advanced-toggle">Additional filters (@_draft.AdditionalFilterCount values set)</button></div>
                <p class="panel-copy">All entered filters remain part of the complete definition, including while collapsed.</p>
                <div id="saved-list-additional-filters" data-testid="saved-list-additional-filters" hidden="@(!_advancedOpen)">
                <p>Choose fixed ranges or relative planned/deadline presets in an explicit UTC/IANA timezone. Relative dates are interpreted when read; custom expressions are unavailable.</p>
                <p>Unblocked active Todos requires empty type/state filters because the source already selects active Todos with completed prerequisites. Clear conflicting filters explicitly or choose Tasks. Stage filters only select active Todos.</p>
                <div class="saved-filter-grid">
                    <div class="saved-list-field"><label class="field-row">Task type<select class="app-input" @bind="_draft.Kind" @ref="_fieldKind" id="@ControlId(TodoSavedListField.Kind)" aria-invalid="@Invalid(TodoSavedListField.Kind)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Kind)" data-testid="saved-list-kind"><option value="">Any type permitted by source</option>@foreach(var kind in Enum.GetValues<CompanionTaskKind>()){<option value="@kind">@kind</option>}</select></label>@RenderFieldError(TodoSavedListField.Kind)</div>
                    <div class="saved-list-field"><label class="field-row">Task state<select class="app-input" @bind="_draft.State" @ref="_fieldState" id="@ControlId(TodoSavedListField.State)" aria-invalid="@Invalid(TodoSavedListField.State)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.State)" data-testid="saved-list-state"><option value="">Any state permitted by source</option>@foreach(var state in Enum.GetValues<CompanionTaskState>()){<option value="@state">@state</option>}</select></label>@RenderFieldError(TodoSavedListField.State)</div>
                    <div class="saved-list-field"><label class="field-row">Urgency<select class="app-input" @bind="_draft.Priority" @ref="_fieldPriority" id="@ControlId(TodoSavedListField.Priority)" aria-invalid="@Invalid(TodoSavedListField.Priority)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Priority)" data-testid="saved-list-priority"><option value="">Any urgency</option>@foreach(var priority in Enum.GetValues<CompanionPriority>()){<option value="@priority">@priority</option>}</select></label>@RenderFieldError(TodoSavedListField.Priority)</div>
                    <div class="saved-list-field"><label class="field-row">Active Todo stage<select class="app-input" @bind="_draft.Stage" @ref="_fieldStage" id="@ControlId(TodoSavedListField.Stage)" aria-invalid="@Invalid(TodoSavedListField.Stage)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Stage)" data-testid="saved-list-stage"><option value="">Any stage</option><option value="Inbox">Inbox</option><option value="Next">Next</option><option value="InProgress">In progress</option></select></label>@RenderFieldError(TodoSavedListField.Stage)</div>
                    <div class="saved-list-field"><TodoPlacementPicker Kind="Project" @ref="_projectPicker" InputId="@ControlId(TodoSavedListField.Project)" Invalid="@HasError(TodoSavedListField.Project)" DescribedBy="@ErrorDescriptionId(TodoSavedListField.Project)" Caption="Project filter" EmptyLabel="Any project" Value="_draft.Project" ValueChanged="value=>_draft.Project=value" Disabled="FreshDisabled" />@RenderFieldError(TodoSavedListField.Project)</div>
                    <div class="saved-list-field"><TodoPlacementPicker Kind="Category" @ref="_categoryPicker" InputId="@ControlId(TodoSavedListField.Category)" Invalid="@HasError(TodoSavedListField.Category)" DescribedBy="@ErrorDescriptionId(TodoSavedListField.Category)" Caption="Category filter" EmptyLabel="Any category" Value="_draft.Category" ValueChanged="value=>_draft.Category=value" Disabled="FreshDisabled" />@RenderFieldError(TodoSavedListField.Category)</div>
                    <div class="saved-list-field"><TodoPlacementPicker Kind="Label" @ref="_labelPicker" InputId="@ControlId(TodoSavedListField.Label)" Invalid="@HasError(TodoSavedListField.Label)" DescribedBy="@ErrorDescriptionId(TodoSavedListField.Label)" Caption="Label filter" EmptyLabel="Any label" Value="_draft.Label" ValueChanged="value=>_draft.Label=value" Disabled="FreshDisabled" />@RenderFieldError(TodoSavedListField.Label)</div>
                    <div class="saved-list-field"><label class="field-row">Habitica mapping state<select class="app-input" @bind="_draft.Projection" @ref="_fieldProjection" id="@ControlId(TodoSavedListField.Projection)" aria-invalid="@Invalid(TodoSavedListField.Projection)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Projection)" data-testid="saved-list-projection"><option value="">Any mapping state</option>@foreach(var state in Enum.GetValues<ProjectionState>()){<option value="@state">@state</option>}</select></label>@RenderFieldError(TodoSavedListField.Projection)</div>
                    <div class="saved-list-field"><label class="field-row">Relative planned date<select class="app-input" @bind="_draft.PlannedRelative" @ref="_fieldPlannedRelative" id="@ControlId(TodoSavedListField.PlannedRelative)" aria-invalid="@Invalid(TodoSavedListField.PlannedRelative)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.PlannedRelative)" data-testid="saved-list-planned-relative"><option value="">Use fixed range or any date</option>@foreach(var preset in Enum.GetValues<WorkspaceRelativeDatePreset>()){<option value="@preset">@Preset(preset)</option>}</select></label>@RenderFieldError(TodoSavedListField.PlannedRelative)</div>
                    <div class="saved-list-field"><label class="field-row">Relative deadline<select class="app-input" @bind="_draft.DeadlineRelative" @ref="_fieldDeadlineRelative" id="@ControlId(TodoSavedListField.DeadlineRelative)" aria-invalid="@Invalid(TodoSavedListField.DeadlineRelative)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.DeadlineRelative)" data-testid="saved-list-deadline-relative"><option value="">Use fixed range or any date</option>@foreach(var preset in Enum.GetValues<WorkspaceRelativeDatePreset>()){<option value="@preset">@Preset(preset)</option>}</select></label>@RenderFieldError(TodoSavedListField.DeadlineRelative)</div>
                    @if(_draft.PlannedRelative.Length>0||_draft.DeadlineRelative.Length>0){<div class="saved-list-field"><label class="field-row">Explicit UTC or IANA timezone<input class="app-input" @bind="_draft.TimeZoneId" @ref="_fieldTimezone" id="@ControlId(TodoSavedListField.Timezone)" aria-invalid="@Invalid(TodoSavedListField.Timezone)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.Timezone)" data-testid="saved-list-timezone" /></label>@RenderFieldError(TodoSavedListField.Timezone)</div>}
                    @if(_draft.PlannedRelative.Length>0&&HasPlannedAbsolute){<p role="status">Clear the conflicting fixed planned range before reviewing relative intent.</p><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ClearPlanned" Variant="Variant.Text" data-testid="saved-list-clear-planned">Clear fixed planned range</MudButton>}
                    @if(_draft.DeadlineRelative.Length>0&&HasDeadlineAbsolute){<p role="status">Clear the conflicting fixed deadline range before reviewing relative intent.</p><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ClearDeadline" Variant="Variant.Text" data-testid="saved-list-clear-deadline">Clear fixed deadline range</MudButton>}
                    <div class="saved-list-field"><label class="field-row">Planned from (fixed date)<input class="app-input" type="date" value="@_draft.PlannedFrom" @onchange="args=>_draft.PlannedFrom=args.Value?.ToString()??string.Empty" disabled="@(_draft.PlannedRelative.Length>0&&!HasPlannedAbsolute)" @ref="_fieldPlannedFrom" id="@ControlId(TodoSavedListField.PlannedFrom)" aria-invalid="@Invalid(TodoSavedListField.PlannedFrom)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.PlannedFrom)" data-testid="saved-list-planned-from" /></label>@RenderFieldError(TodoSavedListField.PlannedFrom)</div>
                    <div class="saved-list-field"><label class="field-row">Planned through (fixed date)<input class="app-input" type="date" value="@_draft.PlannedTo" @onchange="args=>_draft.PlannedTo=args.Value?.ToString()??string.Empty" disabled="@(_draft.PlannedRelative.Length>0&&!HasPlannedAbsolute)" @ref="_fieldPlannedTo" id="@ControlId(TodoSavedListField.PlannedTo)" aria-invalid="@Invalid(TodoSavedListField.PlannedTo)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.PlannedTo)" data-testid="saved-list-planned-to" /></label>@RenderFieldError(TodoSavedListField.PlannedTo)</div>
                    <div class="saved-list-field"><label class="field-row">Deadline from (fixed date)<input class="app-input" type="date" value="@_draft.DeadlineFrom" @onchange="args=>_draft.DeadlineFrom=args.Value?.ToString()??string.Empty" disabled="@(_draft.DeadlineRelative.Length>0&&!HasDeadlineAbsolute)" @ref="_fieldDeadlineFrom" id="@ControlId(TodoSavedListField.DeadlineFrom)" aria-invalid="@Invalid(TodoSavedListField.DeadlineFrom)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.DeadlineFrom)" data-testid="saved-list-deadline-from" /></label>@RenderFieldError(TodoSavedListField.DeadlineFrom)</div>
                    <div class="saved-list-field"><label class="field-row">Deadline through (fixed date)<input class="app-input" type="date" value="@_draft.DeadlineTo" @onchange="args=>_draft.DeadlineTo=args.Value?.ToString()??string.Empty" disabled="@(_draft.DeadlineRelative.Length>0&&!HasDeadlineAbsolute)" @ref="_fieldDeadlineTo" id="@ControlId(TodoSavedListField.DeadlineTo)" aria-invalid="@Invalid(TodoSavedListField.DeadlineTo)" aria-describedby="@ErrorDescriptionId(TodoSavedListField.DeadlineTo)" data-testid="saved-list-deadline-to" /></label>@RenderFieldError(TodoSavedListField.DeadlineTo)</div>
                </div>
                </div>
                <div class="action-row"><MudButton HtmlTag="button" data-layout-primary="true" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" data-testid="saved-list-prepare">Review complete definition</MudButton><MudButton HtmlTag="button" data-layout-primary="true" OnClick="ClearFilters" Variant="Variant.Text" data-testid="saved-list-clear">Clear filters (keep source)</MudButton></div>
            </fieldset>
        </form>
        <div class="action-row"><button type="button" class="secondary-action-button" data-layout-primary="true" disabled="@Busy" @onclick="CloseAuthoring" data-testid="saved-list-close-authoring">Close authoring</button><MudButton HtmlTag="button" data-layout-primary="true" Disabled="@Busy" OnClick="ReloadEditor" Variant="Variant.Text" data-testid="saved-list-reload">Reload editor context</MudButton></div>
        </section>
    }
    else { <p>Choose and load a workspace above. Unavailable data does not supply an empty saved list.</p> }
</section>

@code {
    private TodoSavedListDraft _draft=new();
    private TodoWorkspaceSelection? _source,_draftSource;
    private long? _revision,_draftRevision;
    private Guid? _editing,_selected;
    private int _listOffset,_taskOffset,_total;
    private IReadOnlyList<WorkspaceSavedTaskView> _rows=[];
    private WorkspaceSavedTaskView? _definition;
    private WorkspaceTaskPage? _page;
    private string? _error,_readError;
    private DateOnly? _evaluationDay;private WorkspaceRelativeDateEvaluation? _reviewEvaluation;private Guid? _reviewCommand;
    private bool _focusEditor,_focusReview,_focusResults,_focusNew;
    private bool _editorOpen,_advancedOpen;
    private bool HasDraft => _editing is not null || _draft.Name.Length>0 || _draft.Search.Length>0
        || _draft.Source!="Tasks" || _draft.AdditionalFilterCount>0;
    private IReadOnlyList<TodoSavedListIssue> _fieldErrors = [];
    private bool _focusInvalid, _disposed;
    private long _validationAttempt;
    private Task<IJSObjectReference>? _focusModule;
    private TodoSavedListField? _firstInvalid;
    private ElementReference _fieldName, _fieldSource, _fieldSearch, _fieldKind, _fieldState, _fieldPriority, _fieldStage, _fieldProjection, _fieldPlannedRelative, _fieldDeadlineRelative, _fieldTimezone, _fieldPlannedFrom, _fieldPlannedTo, _fieldDeadlineFrom, _fieldDeadlineTo;
    private TodoPlacementPicker? _projectPicker, _categoryPicker, _labelPicker;
    private static readonly TodoSavedListField[] FieldOrder = [TodoSavedListField.Name, TodoSavedListField.Source, TodoSavedListField.Search,
        TodoSavedListField.Kind, TodoSavedListField.State, TodoSavedListField.Priority, TodoSavedListField.Stage,
        TodoSavedListField.Project, TodoSavedListField.Category, TodoSavedListField.Label, TodoSavedListField.Projection,
        TodoSavedListField.PlannedRelative, TodoSavedListField.DeadlineRelative, TodoSavedListField.Timezone,
        TodoSavedListField.PlannedFrom, TodoSavedListField.PlannedTo, TodoSavedListField.DeadlineFrom, TodoSavedListField.DeadlineTo];
    private IEnumerable<TodoSavedListField> InvalidFields => FieldOrder.Where(HasError);
    private string FirstFieldErrorMessage => InvalidFields.SelectMany(field=>_fieldErrors.Where(issue=>issue.Fields.Contains(field))).Select(issue=>issue.Message).FirstOrDefault() ?? "";
    private bool HasError(TodoSavedListField field) => _fieldErrors.Any(issue => issue.Fields.Contains(field));
    private string? Invalid(TodoSavedListField field) => HasError(field) ? "true" : null;
    private static string ControlId(TodoSavedListField field) => "saved-list-" + (field switch
    {
        TodoSavedListField.PlannedRelative => "planned-relative", TodoSavedListField.DeadlineRelative => "deadline-relative",
        TodoSavedListField.PlannedFrom => "planned-from", TodoSavedListField.PlannedTo => "planned-to",
        TodoSavedListField.DeadlineFrom => "deadline-from", TodoSavedListField.DeadlineTo => "deadline-to",
        _ => field.ToString().ToLowerInvariant()
    });
    private string? ErrorDescriptionId(TodoSavedListField field) => HasError(field) ? ControlId(field)+"-error" : null;
    private RenderFragment RenderFieldError(TodoSavedListField field) => builder =>
    {
        if (!HasError(field)) return;
        builder.OpenElement(0,"p"); builder.AddAttribute(1,"id",ErrorDescriptionId(field)); builder.AddAttribute(2,"class","saved-list-field-error");
        builder.AddContent(3,string.Join(" ",_fieldErrors.Where(issue=>issue.Fields.Contains(field)).Select(issue=>issue.Message).Distinct()));
        builder.CloseElement();
    };
    private async Task FocusInvalidAsync(TodoSavedListField field)
    {
        if (field == TodoSavedListField.Project) { if (_projectPicker is not null) await FocusAndRevealAsync(_projectPicker.InputReference); return; }
        if (field == TodoSavedListField.Category) { if (_categoryPicker is not null) await FocusAndRevealAsync(_categoryPicker.InputReference); return; }
        if (field == TodoSavedListField.Label) { if (_labelPicker is not null) await FocusAndRevealAsync(_labelPicker.InputReference); return; }
        var reference = field switch
        {
            TodoSavedListField.Name => _fieldName,
            TodoSavedListField.Source => _fieldSource,
            TodoSavedListField.Search => _fieldSearch,
            TodoSavedListField.Kind => _fieldKind,
            TodoSavedListField.State => _fieldState,
            TodoSavedListField.Priority => _fieldPriority,
            TodoSavedListField.Stage => _fieldStage,
            TodoSavedListField.Projection => _fieldProjection,
            TodoSavedListField.PlannedRelative => _fieldPlannedRelative,
            TodoSavedListField.DeadlineRelative => _fieldDeadlineRelative,
            TodoSavedListField.Timezone => _fieldTimezone,
            TodoSavedListField.PlannedFrom => _fieldPlannedFrom,
            TodoSavedListField.PlannedTo => _fieldPlannedTo,
            TodoSavedListField.DeadlineFrom => _fieldDeadlineFrom,
            TodoSavedListField.DeadlineTo => _fieldDeadlineTo,
            _ => _editorHeading
        };
        await FocusAndRevealAsync(reference);
    }
    private async Task FocusAndRevealAsync(ElementReference reference)
    {
        if (_disposed) return;
        await reference.FocusAsync();
        var module = await (_focusModule ??= Js.InvokeAsync<IJSObjectReference>("import", "./js/field-focus.js").AsTask());
        if (!_disposed) await module.InvokeVoidAsync("revealFocusedElement", reference);
    }

    private ElementReference _editorHeading,_reviewHeading,_resultsHeading,_newListButton;
    private bool HasPlannedAbsolute=>_draft.PlannedFrom.Length>0||_draft.PlannedTo.Length>0;
    private bool HasDeadlineAbsolute=>_draft.DeadlineFrom.Length>0||_draft.DeadlineTo.Length>0;
    private static string Preset(WorkspaceRelativeDatePreset preset)=>preset switch{WorkspaceRelativeDatePreset.BeforeToday=>"Before today",WorkspaceRelativeDatePreset.NextSevenDays=>"Next seven days including today",WorkspaceRelativeDatePreset.ThisWeek=>"This week (Monday–Sunday)",WorkspaceRelativeDatePreset.NoDate=>"No date",_=>"Today"};
    private void ClearPlanned(){_draft.PlannedFrom=_draft.PlannedTo="";}
