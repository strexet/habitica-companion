@inject IServiceProvider Services
@using Habitica.Application.Workspace
@inject WorkspaceDataController Workspace
@inject IAppSessionController Session
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="card-surface settings-card">
    <p class="section-label">Companion workspace</p>
    <h2>Workspace access, execution and backups</h2>
    <p>Cloud access follows the active Workspace choice and remains separate from agent linking and encrypted preference sync. The workspace server can read task names, notes, categories, projects, goals, saved views, completion history and commands. Enabling access also stores encrypted Habitica credentials on the integration server.</p>
    <p>Tasks and command history remain until you delete the cloud workspace. Disconnect pauses access and background execution while retaining cloud data. Frozen browser copies retain original recovery evidence. Habitica records keep separate controls. Background execution requires another opt-in.</p>
    @if (!Workspace.IsAvailable)
    {
        <p data-testid="workspace-unavailable">Cloud workspace is not enabled on this app.</p>
    }
    else if (!Session.State.IsAuthenticated)
    {
        <p>Sign in before connecting cloud task data.</p>
    }
    else if (Workspace.CloudWorkspaceId is null)
    {
        <p role="status" data-testid="workspace-unverified">Existing cloud access is unavailable in this session. Missing local access does not disconnect the server or change the selected Workspace.</p>
        <MudButton data-testid="workspace-connect" Disabled="@(_busy || Session.State.IsBusy || !Guid.TryParse(Session.State.UserId,out _))" OnClick="RestoreExistingAsync" Variant="Variant.Outlined">Restore existing cloud access</MudButton>
        <p>New cloud selection and browser record adoption use the <a href="/todo/sync#workspace-transfer">reviewed Workspace move</a>. Restoring access never enrolls or enables execution.</p>
    }
    else
    {
        <p>Existing cloud Workspace access is available. Saved account settings restore approved access in later sessions; signing out never changes server consent.</p>
        <p role="status" data-testid="workspace-connection-state">@(Workspace.ConnectionStatusVerified ? "Server workspace access verified." : "Server workspace and background execution status are unverified. Check status or renew access.")</p>
        <MudButton Disabled="@_busy" OnClick="CheckOperationsAsync" Variant="Variant.Outlined" data-testid="workspace-check-status">Check connection and saved work status</MudButton>
        @if (_operations is { } operations && _operationsAccount == Session.State.UserId && _operationsWorkspace == Workspace.CloudWorkspaceId)
        {
            <div role="status" data-testid="workspace-operations">
                <p>Checked @operations.CheckedAtUtc.ToLocalTime().ToString("g"). Pending: @operations.Pending. Waiting over 15 minutes: @operations.Stalled. Uncertain: @operations.Uncertain. Blocked: @operations.Blocked. Expired execution leases: @operations.ExpiredLeases.</p>
                @if (operations.OldestPendingAtUtc is { } oldest) { <p>Oldest pending task command: @oldest.ToLocalTime().ToString("g").</p> }
                <p>This check reads saved command state only. Uncertain effects stay paused; checking status never retries an action.</p>
            </div>
        }
        <p>If access expires, restore the existing connection before checking an original receipt. No new consent or executor opt-in is created.</p>
        <MudButton Disabled="@(_busy || Session.State.IsBusy)" OnClick="RestoreExistingAsync" Variant="Variant.Outlined" data-testid="workspace-renew">Restore existing connection</MudButton>
        <div class="action-row">
            <MudButton Disabled="@_busy" OnClick="ExportCloudAsync" Variant="Variant.Outlined">Export cloud task journal</MudButton>
            <MudButton Disabled="@_busy" OnClick="@(() => _cleanup = false)" Variant="Variant.Outlined">Disconnect cloud workspace</MudButton>
            <MudButton Disabled="@_busy" OnClick="@(() => _cleanup = true)" Variant="Variant.Outlined">Delete cloud workspace</MudButton>
        </div>
        <h3>Background task execution</h3>
        <p>When enabled, the server can project accepted commands to Habitica while this tab is closed. Calls run sequentially at least thirty seconds apart. Unknown outcomes pause new effects for review. Pausing prevents new calls; an already transmitted effect can still finish.</p>
        @if (!Workspace.ConnectionStatusVerified)
        {
            <p role="status" data-testid="workspace-executor-unverified">Background execution status is unknown. Verify server status before changing execution settings.</p>
        }
        else if (Workspace.ExecutorEnabled)
        {
            <p role="status" data-testid="workspace-executor-state">@(Workspace.ExecutorAvailable ? "Background execution is enabled on the server." : "Executor opt-in is enabled, but execution is unavailable on this server.")</p>
            <MudButton Disabled="@_busy" OnClick="@(() => SetExecutorAsync(false))" Variant="Variant.Outlined" data-testid="workspace-executor-pause">Pause background execution</MudButton>
        }
        else if (Workspace.ExecutorAvailable)
        {
            <p role="status" data-testid="workspace-executor-state">Background execution is paused. Pending task commands remain saved until execution is explicitly enabled; checking status does not retry an action.</p>
            <label class="checkbox-row"><input type="checkbox" @bind="_executorConsent" data-testid="workspace-executor-consent" /><span>I enable background execution of accepted commands, including Habitica effects, while the app is closed.</span></label>
            <MudButton Disabled="@(_busy || !_executorConsent)" OnClick="@(() => SetExecutorAsync(true))" Variant="Variant.Filled" data-testid="workspace-executor-enable">Enable background execution</MudButton>
        }
        else { <p data-testid="workspace-executor-state">Background execution is unavailable on this server. The saved executor opt-in is off.</p> }
        @if (_cleanup is not null)
        {
            <p>@(_cleanup.Value ? "Permanently delete the cloud task Workspace and task command history? Independent personal Notes and retained transfer archives can require separate cleanup. Export a backup first." : "Disconnect every workspace session and pause execution? Cloud tasks and history will remain stored.")</p>
            <MudButton Disabled="@_busy" OnClick="CleanupAsync" Color="Color.Error" Variant="Variant.Filled">Confirm workspace action</MudButton>
            <MudButton OnClick="@(() => _cleanup = null)" Variant="Variant.Outlined">Cancel</MudButton>
        }
    }
    <h3>Browser backups and recovery copies</h3>
    <p>Workspace backups include readable notes and command history, with no credentials. These files are separate from the Habitica data backup and encrypted private sync below. Saved copies retain exact source identities and preserve existing data on conflicts. Browser copies from an accepted move remain frozen. Clear saved browser data also removes local workspaces.</p>
    @if (Session.State.IsAuthenticated)
    {
        <MudButton Disabled="@_busy" OnClick="RefreshLocalAsync" Variant="Variant.Outlined">Find local workspaces</MudButton>
        @foreach (var id in _localIds)
        {
            <div class="action-row"><span>@id</span><MudButton Disabled="@_busy" OnClick="@(() => ExportLocalAsync(id))" Variant="Variant.Text">Export local workspace</MudButton>
                <MudButton Disabled="@_busy" OnClick="@(() => RecoverLegacyAsync(id))" Variant="Variant.Outlined">Check legacy transfer receipt</MudButton>
                <MudButton Disabled="@_busy" OnClick="@(() => _legacyRetry=id)" Variant="Variant.Text">Recover an unaccepted legacy transfer</MudButton>

            </div>
        }
        @if(_legacyRetry is {} legacyId)
        {
            <p>Retry only the original frozen legacy transfer @legacyId? Restore existing cloud access and pause background execution first. The original identity and archive remain unchanged. A populated target can refuse the legacy transfer; preserve the backup and original receipt.</p>
            <MudButton Disabled="@_busy" OnClick="RetryLegacyAsync" Variant="Variant.Outlined">Retry original legacy transfer</MudButton>
            <MudButton OnClick="@(() => _legacyRetry=null)" Variant="Variant.Text">Cancel legacy recovery</MudButton>
        }
        @if(Workspace.CloudWorkspaceId is null && (Connections is null || Connections.State==CompanionConnectionState.Browser))
        {
        <label class="field-row workspace-restore-field">Restore workspace backup<InputFile class="app-input" disabled="@_busy" OnChange="SelectFileAsync" data-testid="workspace-restore-file" /></label>
        @if (_restoreJson is not null)
        {
            <p>Restore this backup into the current account's browser storage? Cloud data will remain unchanged.</p>
            <MudButton Disabled="@_busy" OnClick="RestoreAsync" Variant="Variant.Filled">Confirm local restore</MudButton>
            <MudButton OnClick="@(() => _restoreJson = null)" Variant="Variant.Outlined">Cancel</MudButton>
        }
        }
    }
    @if (_message is not null) { <p role="status">@_message</p> }
</section>

@code {
    private CompanionConnectionCoordinator? Connections=>Services.GetService(typeof(CompanionConnectionCoordinator)) as CompanionConnectionCoordinator;
    private bool _disposed;
    private Guid? _legacyRetry;
    private int _viewGeneration;
    private (bool Authenticated, string? UserId) _owner;
    protected override void OnInitialized()
    {
        _owner = (Session.State.IsAuthenticated, Session.State.UserId);
        Session.Changed += SessionChanged;
    }
    private void SessionChanged()
    {
        if (_disposed) return;
        var owner = (Session.State.IsAuthenticated, Session.State.UserId);
        if (owner != _owner)
        {
            _owner = owner; _viewGeneration++;
            _executorConsent = _busy = false;
            _operations = null; _cleanup = null; _message = _restoreJson = null; _localIds = Array.Empty<Guid>();
        }
        _ = InvokeAsync(StateHasChanged);
    }
    private bool Current(int generation) => !_disposed && generation == _viewGeneration
        && Session.State.IsAuthenticated && _owner == (Session.State.IsAuthenticated, Session.State.UserId);
    private WorkspaceOperationalStatus? _operations;
    private string? _operationsAccount;
    private Guid? _operationsWorkspace;
    private bool _busy, _executorConsent;
    private bool? _cleanup;
    private string? _message, _restoreJson;
    private IReadOnlyList<Guid> _localIds = Array.Empty<Guid>();
    private IJSObjectReference? _exportModule;
    private async Task RunAsync(Func<Task<WorkspaceActionResult>> action)
    {
        if (_busy) return;
        var generation = _viewGeneration;
        _busy = true; _operations = null;
        try
        {
            var result = await action();
            if (!Current(generation)) return;
            _message = result.Message;
            if (result.Succeeded && result.Json is not null)
            {
                _exportModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/diagnosticsExport.js");
                if (!Current(generation)) return;
                await _exportModule.InvokeVoidAsync("downloadTextFile", $"companion-workspace-{DateTimeOffset.UtcNow:yyyyMMdd-HHmmss}.json", result.Json, "application/json;charset=utf-8");
            }
        }
        catch { if (Current(generation)) _message = "The workspace action could not be confirmed. Check the connection before trying again."; }
        finally { if (Current(generation)) _busy = false; }
    }
    private async Task CheckOperationsAsync()
    {
        if (_busy) return;
        _busy = true; _operations = null;
        var generation = _viewGeneration;
        var account = Session.State.UserId; var workspace = Workspace.CloudWorkspaceId;
        try
        {
            var connection = await Workspace.RefreshConnectionStatusAsync();
            if (!Current(generation)) return;
            _message = connection.Message;
            if (!connection.Succeeded) return;
            var result = await Workspace.ReadOperationalStatusAsync();
            if (!Current(generation) || account != Session.State.UserId || workspace != Workspace.CloudWorkspaceId) return;
            _message = result.Message;
            if (result.Succeeded) { _operations = result.Status; _operationsAccount = account; _operationsWorkspace = workspace; }
        }
        catch { if (Current(generation)) _message = "Saved work status is unavailable. No action was retried."; }
        finally { if (Current(generation)) _busy = false; }
    }
    private Task RestoreExistingAsync() => RunAsync(async()=>{var result=await Session.RestoreExistingConnectionsAsync(true);return new WorkspaceActionResult(result.Succeeded,result.Message);});
    private async Task SetExecutorAsync(bool enabled) { var generation = _viewGeneration; await RunAsync(() => Workspace.SetExecutorAsync(enabled)); if (Current(generation)) _executorConsent = false; }
    private Task RetryLegacyAsync()=>RunAsync(async()=>{var id=_legacyRetry;_legacyRetry=null;return id is {} value?await Workspace.RetryLegacyTransferAsync(value):new WorkspaceActionResult(false,"No original transfer selected.");});
    private Task RecoverLegacyAsync(Guid id)=>RunAsync(()=>Workspace.RecoverLegacyTransferAsync(id));
    private Task ExportCloudAsync() => RunAsync(() => Workspace.ExportCloudAsync());
    private Task ExportLocalAsync(Guid id) => RunAsync(() => Workspace.ExportLocalAsync(id));
    private async Task CleanupAsync() { if (_cleanup is null) return; var generation = _viewGeneration; await RunAsync(() => Workspace.DisconnectAsync(_cleanup.Value)); if (Current(generation)) _cleanup = null; }
    private async Task RefreshLocalAsync()
    {
        try { _localIds = await Workspace.ListLocalAsync(); _message = _localIds.Count == 0 ? "No local workspace backups are saved for this account." : null; }
        catch { _message = "Local workspace storage is unavailable."; }
    }
    private async Task SelectFileAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await using var stream = args.File.OpenReadStream(16 * 1024 * 1024);
            using var reader = new StreamReader(stream); _restoreJson = await reader.ReadToEndAsync();
            _ = Habitica.Domain.Workspace.WorkspaceJournalJson.Deserialize(_restoreJson);
            _message = null;
        }
        catch { _restoreJson = null; _message = "This file is not a valid workspace backup."; }
    }
    private async Task RestoreAsync()
    {
        if (_restoreJson is null) return;
        var json = _restoreJson; _restoreJson = null;
        await RunAsync(() => Workspace.RestoreLocalAsync(json)); var message = _message; await RefreshLocalAsync(); _message = message;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Session.Changed -= SessionChanged;
        if (_exportModule is not null) await _exportModule.DisposeAsync();
    }
}
