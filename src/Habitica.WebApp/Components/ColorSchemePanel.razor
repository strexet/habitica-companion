@using System.Text.Json
@using Habitica.WebApp.Theme
@inject ColorSchemeService ColorSchemeService
@inject IJSRuntime JsRuntime

<div class="color-scheme-panel @(Compact ? "color-scheme-panel--compact" : null)">
    <div class="color-scheme-bar">
        <label class="field-row compact color-scheme-select-row">
            <span>Scheme</span>
            <select class="app-input" data-testid="color-scheme-select" value="@ActiveDisplaySchemeId" @onchange="eventArgs => SelectColorSchemeAsync(eventArgs.Value?.ToString())">
                <optgroup label="Built in">
                    @foreach (var scheme in _colorSchemeState.BuiltInSchemes)
                    {
                        <option value="@scheme.Id">@scheme.Name</option>
                    }
                </optgroup>
                @if (_colorSchemeState.CustomSchemes.Count > 0)
                {
                    <optgroup label="Custom">
                        @foreach (var scheme in _colorSchemeState.CustomSchemes)
                        {
                            <option value="@scheme.Id">@scheme.Name</option>
                        }
                    </optgroup>
                }
                @if (_randomScheme is not null)
                {
                    <optgroup label="Generated">
                        <option value="@ColorSchemeCatalog.RandomSchemeId">@_randomScheme.Name</option>
                    </optgroup>
                }
            </select>
        </label>
        <div class="color-scheme-preview" aria-hidden="true">
            @foreach (var swatch in GetActiveSchemeSwatches())
            {
                <span style="@($"background: {swatch};")"></span>
            }
        </div>
        <div class="action-row color-scheme-random-row">
            <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="random-preset-scheme" OnClick="RandomPresetAsync" Variant="Variant.Filled">
                Random Preset
            </MudButton>
            <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="random-theme-scheme" OnClick="RandomThemeAsync" Variant="Variant.Filled">
                Random Theme
            </MudButton>
            @if (Compact)
            {
                <MudButton Color="Color.Default"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           data-testid="color-scheme-advanced-toggle"
                           OnClick="ToggleAdvanced"
                           EndIcon="@(ShowAdvanced ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">
                    @(ShowAdvanced ? "Less" : "Customize")
                </MudButton>
            }
        </div>
    </div>

    @if (ShowAdvanced)
    {
        <div class="color-scheme-advanced">
            @if (_randomActive)
            {
                <MudPaper Class="card-surface action-card color-scheme-card" Elevation="0">
                    <h2>Save random theme</h2>
                    <p class="panel-copy">Drag chaos up for wilder rerolls. Name it to keep it in your custom schemes.</p>
                    <label class="field-row compact">
                        <span>Name</span>
                        <input class="app-input"
                               data-testid="random-scheme-name"
                               value="@_randomSaveName"
                               @onchange="eventArgs => _randomSaveName = eventArgs.Value?.ToString()?.Trim() ?? string.Empty" />
                    </label>
                    <div class="field-row compact color-scheme-chaos-row" data-testid="chaos-slider">
                        <span>Chaos</span>
                        <MudSlider T="double" Min="0" Max="1" Step="0.05" @bind-Value="_chaos" Color="Color.Secondary" Class="color-scheme-chaos" />
                        <span class="color-scheme-chaos-value">@ChaosLabel</span>
                    </div>
                    <div class="action-row">
                        <MudButton Color="Color.Primary" Size="@ControlSize" data-testid="save-random-scheme" OnClick="SaveRandomSchemeAsync" Variant="Variant.Filled">
                            Save To Custom
                        </MudButton>
                        <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="reroll-random-scheme" OnClick="RerollAsync" Variant="Variant.Outlined">
                            Reroll
                        </MudButton>
                    </div>
                </MudPaper>
            }
            else if (_colorSchemeEditor is not null)
            {
                <MudPaper Class="card-surface action-card color-scheme-card" Elevation="0">
                    <h2>Custom scheme JSON</h2>
                    <p class="panel-copy">
                        Copy this scheme's JSON, edit the colors in any text editor, then paste it back and save.
                        This is how you build a fully custom palette.
                    </p>
                    <label class="field-row compact">
                        <span>Name</span>
                        <input class="app-input"
                               data-testid="custom-scheme-name"
                               value="@_colorSchemeEditor.Name"
                               @onchange="eventArgs => SetCustomSchemeName(eventArgs.Value?.ToString())" />
                    </label>
                    <div class="action-row">
                        <MudButton Color="Color.Secondary" Size="@ControlSize" StartIcon="@Icons.Material.Filled.ContentCopy" data-testid="copy-custom-scheme" OnClick="CopyCustomSchemeAsync" Variant="Variant.Filled">
                            Copy JSON
                        </MudButton>
                        <MudButton Color="Color.Secondary" Size="@ControlSize" StartIcon="@Icons.Material.Filled.ContentPaste" data-testid="paste-custom-scheme" OnClick="PasteCustomSchemeAsync" Variant="Variant.Outlined">
                            Paste JSON
                        </MudButton>
                    </div>
                    <div class="action-row">
                        <MudButton Color="Color.Primary" Size="@ControlSize" data-testid="save-custom-scheme" OnClick="SaveCustomSchemeAsync" Variant="Variant.Filled">
                            Save Scheme
                        </MudButton>
                        <MudButton Color="Color.Secondary" Size="@ControlSize" OnClick="CancelCustomSchemeEdit" Variant="Variant.Outlined">
                            Cancel
                        </MudButton>
                    </div>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="card-surface action-card color-scheme-card" Elevation="0">
                    <h2>Custom schemes</h2>
                    <p class="panel-copy">Copy the active scheme, then edit and paste its JSON to make your own.</p>
                    <div class="action-row">
                        <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="create-custom-scheme" OnClick="CreateCustomScheme" Variant="Variant.Filled">
                            Create Custom Copy
                        </MudButton>
                        @if (!_colorSchemeState.ActiveScheme.IsBuiltIn)
                        {
                            <MudButton Color="Color.Error" Size="@ControlSize" data-testid="delete-custom-scheme" OnClick="DeleteActiveCustomSchemeAsync" Variant="Variant.Outlined">
                                Delete Custom
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_colorSchemeMessage))
    {
        <div class="@($"import-status {(_colorSchemeSucceeded ? "success-pill" : "danger-pill")}")" data-testid="color-scheme-message">
            @_colorSchemeMessage
        </div>
    }
</div>

@code {
    /// <summary>When true, render a condensed bar with advanced controls hidden behind a disclosure toggle.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private string? _colorSchemeMessage;
    private bool _colorSchemeSucceeded = true;
    private bool _showAdvanced;
    private ColorSchemeState _colorSchemeState = new(
        ColorSchemeCatalog.Alpha,
        ColorSchemeCatalog.BuiltInSchemes,
        Array.Empty<ColorSchemeDefinition>());
    private ColorSchemeEditorModel? _colorSchemeEditor;
    private ColorSchemeDefinition? _randomScheme;
    private bool _randomActive;
    private string _randomSaveName = string.Empty;
    private double _chaos;

    private string ChaosLabel => _chaos switch
    {
        <= 0.01 => "Calm",
        < 0.35 => "Mild",
        < 0.7 => "Wild",
        < 0.99 => "Chaotic",
        _ => "Madness"
    };

    // In full mode advanced controls are always shown; in compact mode they stay collapsed
    // unless the user opens them or an active flow (random save / custom edit) needs them.
    private bool ShowAdvanced => !Compact || _showAdvanced || _randomActive || _colorSchemeEditor is not null;

    private Size ControlSize => Compact ? Size.Small : Size.Medium;

    private void ToggleAdvanced() => _showAdvanced = !_showAdvanced;

    private string ActiveDisplaySchemeId => _randomActive
        ? ColorSchemeCatalog.RandomSchemeId
        : _colorSchemeState.ActiveScheme.Id;

    private ColorSchemeDefinition ActiveDisplayScheme => _randomActive && _randomScheme is not null
        ? _randomScheme
        : _colorSchemeState.ActiveScheme;

    protected override async Task OnInitializedAsync()
    {
        _colorSchemeState = await ColorSchemeService.LoadAsync();
        _randomScheme = ColorSchemeService.PendingRandomScheme;
        if (_randomScheme is not null)
        {
            // Re-apply the session's pending random theme so it survives navigation between pages.
            _randomActive = await ColorSchemeService.ReapplyPendingRandomAsync();
        }
    }

    private IReadOnlyList<string> GetActiveSchemeSwatches()
    {
        var tokens = ActiveDisplayScheme.Tokens;
        return new[]
        {
            tokens.Background,
            tokens.CardBackground,
            tokens.Primary,
            tokens.Accent,
            tokens.Danger,
            tokens.Success
        };
    }

    private async Task SelectColorSchemeAsync(string? schemeId)
    {
        if (string.IsNullOrWhiteSpace(schemeId))
        {
            return;
        }

        if (string.Equals(schemeId, ColorSchemeCatalog.RandomSchemeId, StringComparison.Ordinal))
        {
            await ActivateRandomAsync();
            return;
        }

        _colorSchemeState = await ColorSchemeService.SelectAsync(schemeId);
        _randomActive = false;
        _colorSchemeEditor = _colorSchemeState.ActiveScheme.IsBuiltIn
            ? null
            : ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Using {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task RandomPresetAsync()
    {
        var preset = ColorSchemeCatalog.PickRandomPreset(_colorSchemeState.CustomSchemes, _colorSchemeState.ActiveScheme.Id);
        _colorSchemeState = await ColorSchemeService.SelectAsync(preset.Id);
        _randomActive = false;
        _colorSchemeEditor = _colorSchemeState.ActiveScheme.IsBuiltIn
            ? null
            : ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Random preset: {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task RandomThemeAsync()
    {
        await GenerateRandomAsync();
        SetColorSchemeMessage("Generated a random theme. Adjust chaos, reroll, or save it.", true);
    }

    private async Task RerollAsync()
    {
        await GenerateRandomAsync();
        SetColorSchemeMessage($"Rerolled at {ChaosLabel.ToLowerInvariant()} chaos.", true);
    }

    private async Task GenerateRandomAsync()
    {
        _randomScheme = await ColorSchemeService.ApplyRandomThemeAsync(_chaos);
        _randomActive = true;
        _colorSchemeEditor = null;
        _randomSaveName = string.Empty;
    }

    private async Task ActivateRandomAsync()
    {
        if (_randomScheme is null)
        {
            return;
        }

        await ColorSchemeService.ReapplyPendingRandomAsync();
        _randomActive = true;
        _colorSchemeEditor = null;
        SetColorSchemeMessage("Showing the last random theme.", true);
    }

    private async Task SaveRandomSchemeAsync()
    {
        if (_randomScheme is null)
        {
            return;
        }

        var named = ColorSchemeCatalog.CreateCustomCopy(_randomScheme, _randomSaveName);
        var result = await ColorSchemeService.SaveCustomAsync(named, true);
        _colorSchemeState = result.State;
        if (result.Errors.Count > 0)
        {
            SetColorSchemeMessage(string.Join(" ", result.Errors), false);
            return;
        }

        _randomActive = false;
        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Saved {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private void CreateCustomScheme()
    {
        _randomActive = false;
        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(
            ColorSchemeCatalog.CreateCustomCopy(
                _colorSchemeState.ActiveScheme,
                $"{_colorSchemeState.ActiveScheme.Name} custom"));
        SetColorSchemeMessage("Edit and save the custom scheme.", true);
    }

    private void CancelCustomSchemeEdit()
    {
        _colorSchemeEditor = _colorSchemeState.ActiveScheme.IsBuiltIn
            ? null
            : ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage("Custom scheme edit cancelled.", true);
    }

    private void SetCustomSchemeName(string? value)
    {
        if (_colorSchemeEditor is not null)
        {
            _colorSchemeEditor.Name = value?.Trim() ?? string.Empty;
        }
    }

    private async Task SaveCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        var scheme = _colorSchemeEditor.ToScheme();
        var result = await ColorSchemeService.SaveCustomAsync(scheme, true);
        _colorSchemeState = result.State;
        if (result.Errors.Count > 0)
        {
            SetColorSchemeMessage(string.Join(" ", result.Errors), false);
            return;
        }

        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Saved {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task DeleteActiveCustomSchemeAsync()
    {
        if (_colorSchemeState.ActiveScheme.IsBuiltIn)
        {
            return;
        }

        var deletedName = _colorSchemeState.ActiveScheme.Name;
        _colorSchemeState = await ColorSchemeService.DeleteCustomAsync(_colorSchemeState.ActiveScheme.Id);
        _colorSchemeEditor = null;
        SetColorSchemeMessage($"Deleted {deletedName}.", true);
    }

    private void SetColorSchemeMessage(string message, bool succeeded)
    {
        _colorSchemeMessage = message;
        _colorSchemeSucceeded = succeeded;
    }

    private async Task CopyCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        var payload = new ColorSchemeClipboardModel(
            _colorSchemeEditor.Name,
            new Dictionary<string, string>(_colorSchemeEditor.Tokens, StringComparer.Ordinal));
        var json = JsonSerializer.Serialize(payload, ClipboardJsonOptions);

        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
            SetColorSchemeMessage("Copied scheme JSON to clipboard.", true);
        }
        catch (Exception)
        {
            SetColorSchemeMessage("Could not copy to clipboard.", false);
        }
    }

    private async Task PasteCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        string clipboard;
        try
        {
            clipboard = await JsRuntime.InvokeAsync<string>("navigator.clipboard.readText");
        }
        catch (Exception)
        {
            SetColorSchemeMessage("Could not read the clipboard.", false);
            return;
        }

        if (string.IsNullOrWhiteSpace(clipboard))
        {
            SetColorSchemeMessage("Clipboard is empty.", false);
            return;
        }

        if (!TryParseSchemeJson(clipboard, out var name, out var tokens))
        {
            SetColorSchemeMessage("Clipboard does not contain a valid color scheme JSON.", false);
            return;
        }

        if (!string.IsNullOrWhiteSpace(name))
        {
            _colorSchemeEditor.Name = name!.Trim();
        }

        foreach (var token in ColorSchemeCatalog.EditableTokens)
        {
            if (tokens.TryGetValue(token.Name, out var value) && !string.IsNullOrWhiteSpace(value))
            {
                _colorSchemeEditor.Tokens[token.Name] = value.Trim();
            }
        }

        SetColorSchemeMessage("Pasted scheme from clipboard. Review the values and save.", true);
    }

    private static bool TryParseSchemeJson(string json, out string? name, out Dictionary<string, string> tokens)
    {
        name = null;
        tokens = new Dictionary<string, string>(StringComparer.Ordinal);

        try
        {
            using var document = JsonDocument.Parse(json);
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object)
            {
                return false;
            }

            if (TryGetPropertyIgnoreCase(root, "name", out var nameElement) && nameElement.ValueKind == JsonValueKind.String)
            {
                name = nameElement.GetString();
            }

            // Accept either { "tokens": { ... } } or a bare token map at the root.
            var tokensElement = TryGetPropertyIgnoreCase(root, "tokens", out var nested) ? nested : root;
            if (tokensElement.ValueKind != JsonValueKind.Object)
            {
                return false;
            }

            foreach (var token in ColorSchemeCatalog.EditableTokens)
            {
                if (TryGetPropertyIgnoreCase(tokensElement, token.Name, out var value) && value.ValueKind == JsonValueKind.String)
                {
                    var text = value.GetString();
                    if (!string.IsNullOrWhiteSpace(text))
                    {
                        tokens[token.Name] = text!;
                    }
                }
            }

            return tokens.Count > 0;
        }
        catch (JsonException)
        {
            return false;
        }
    }

    private static bool TryGetPropertyIgnoreCase(JsonElement element, string propertyName, out JsonElement value)
    {
        foreach (var property in element.EnumerateObject())
        {
            if (string.Equals(property.Name, propertyName, StringComparison.OrdinalIgnoreCase))
            {
                value = property.Value;
                return true;
            }
        }

        value = default;
        return false;
    }

    private static readonly JsonSerializerOptions ClipboardJsonOptions = new() { WriteIndented = true };

    private sealed record ColorSchemeClipboardModel(string Name, Dictionary<string, string> Tokens);

    private sealed class ColorSchemeEditorModel
    {
        public string Id { get; private init; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public Dictionary<string, string> Tokens { get; } = new(StringComparer.Ordinal);

        public static ColorSchemeEditorModel FromScheme(ColorSchemeDefinition scheme)
        {
            var editor = new ColorSchemeEditorModel
            {
                Id = scheme.Id,
                Name = scheme.Name
            };
            foreach (var token in ColorSchemeCatalog.EditableTokens)
            {
                editor.Tokens[token.Name] = ColorSchemeCatalog.GetTokenValue(scheme.Tokens, token.Name);
            }

            return editor;
        }

        public ColorSchemeDefinition ToScheme()
        {
            var tokens = ColorSchemeCatalog.EditableTokens
                .Aggregate(ColorSchemeCatalog.Alpha.Tokens, (current, token) =>
                    ColorSchemeCatalog.WithTokenValue(current, token.Name, Tokens.GetValueOrDefault(token.Name, string.Empty)));
            return new ColorSchemeDefinition(
                Id,
                ColorSchemeCatalog.NormalizeName(Name, "Custom scheme"),
                false,
                tokens);
        }
    }
}
