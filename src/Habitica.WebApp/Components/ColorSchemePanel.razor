@using Habitica.WebApp.Theme
@inject ColorSchemeService ColorSchemeService
@inject IJSRuntime JsRuntime

<div class="color-scheme-panel @(Compact ? "color-scheme-panel--compact" : null) @(PresetsOnly ? "color-scheme-panel--presets-only" : null)">
    <div class="color-scheme-bar">
        <label class="field-row compact color-scheme-select-row">
            <span>Color scheme</span>
            <select class="app-input" data-testid="color-scheme-select" value="@ActiveDisplaySchemeId" @onchange="eventArgs => SelectColorSchemeAsync(eventArgs.Value?.ToString())">
                <optgroup label="Default">
                    @foreach (var scheme in DefaultSchemes)
                    {
                        <option value="@scheme.Id">@scheme.Name</option>
                    }
                </optgroup>
                <optgroup label="Built-in Light">
                    @foreach (var scheme in BuiltInLightSchemes)
                    {
                        <option value="@scheme.Id">@scheme.Name</option>
                    }
                </optgroup>
                <optgroup label="Built-in Dark">
                    @foreach (var scheme in BuiltInDarkSchemes)
                    {
                        <option value="@scheme.Id">@scheme.Name</option>
                    }
                </optgroup>
                @if (PresetsOnly && !_colorSchemeState.ActiveScheme.IsBuiltIn && !_randomActive)
                {
                    <optgroup label="Current">
                        <option value="@_colorSchemeState.ActiveScheme.Id">@_colorSchemeState.ActiveScheme.Name</option>
                    </optgroup>
                }
                @if (!PresetsOnly && _colorSchemeState.CustomSchemes.Count > 0)
                {
                    <optgroup label="Custom">
                        @foreach (var scheme in _colorSchemeState.CustomSchemes)
                        {
                            <option value="@scheme.Id">@scheme.Name</option>
                        }
                    </optgroup>
                }
                @if (!PresetsOnly && _randomScheme is not null)
                {
                    <optgroup label="Generated">
                        <option value="@ColorSchemeCatalog.RandomSchemeId">@_randomScheme.Name</option>
                    </optgroup>
                }
            </select>
        </label>
        <div class="color-scheme-preview" aria-hidden="true">
            @foreach (var swatch in GetActiveSchemeSwatches())
            {
                <span style="@($"background: {swatch};")"></span>
            }
        </div>
        @if (!PresetsOnly)
        {
            <div class="action-row color-scheme-random-row">
                <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="random-preset-scheme" OnClick="RandomPresetAsync" Variant="Variant.Filled">
                    Random Preset
                </MudButton>
                <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="random-theme-scheme" OnClick="RandomThemeAsync" Variant="Variant.Filled">
                    Random Theme
                </MudButton>
                @if (Compact)
                {
                    <MudButton Color="Color.Default"
                               Size="Size.Small"
                               Variant="Variant.Text"
                               data-testid="color-scheme-advanced-toggle"
                               OnClick="ToggleAdvancedAsync"
                               EndIcon="@ToggleIcon">
                        @ToggleLabel
                    </MudButton>
                }
            </div>
        }
    </div>

    @if (!PresetsOnly && ShowAdvanced)
    {
        <div class="color-scheme-advanced">
            <div class="color-scheme-group-labels" aria-label="Color scheme groups">
                <span>Default</span>
                <span>Built-in Light</span>
                <span>Built-in Dark</span>
                @if (_colorSchemeState.CustomSchemes.Count > 0)
                {
                    <span>Custom</span>
                }
                @if (_randomScheme is not null)
                {
                    <span>Generated</span>
                }
            </div>
            @if (_randomActive)
            {
                <MudPaper Class="card-surface action-card color-scheme-card color-scheme-card--random" Elevation="0">
                    <div class="color-scheme-chaos-row" data-testid="chaos-slider">
                        <MudSlider T="double" Min="0" Max="1" Step="0.01" Immediate="true" Value="_chaos" ValueChanged="OnChaosChangedAsync" Color="Color.Secondary" Class="color-scheme-chaos" />
                        <span class="color-scheme-chaos-value">@ChaosLabel</span>
                        <MudButton Color="Color.Secondary" Size="Size.Small" data-testid="reroll-random-scheme" OnClick="RerollAsync" Variant="Variant.Filled">
                            Reroll
                        </MudButton>
                    </div>
                    <div class="color-scheme-save-row">
                        <input class="app-input"
                               placeholder="Name this theme"
                               aria-label="Theme name"
                               data-testid="random-scheme-name"
                               value="@_randomSaveName"
                               @onchange="eventArgs => _randomSaveName = eventArgs.Value?.ToString()?.Trim() ?? string.Empty" />
                        <MudButton Color="Color.Primary" Size="Size.Small" data-testid="save-random-scheme" OnClick="SaveRandomSchemeAsync" Variant="Variant.Filled">
                            Save
                        </MudButton>
                    </div>
                </MudPaper>
            }
            else if (_colorSchemeEditor is not null)
            {
                <MudPaper Class="card-surface action-card color-scheme-card" Elevation="0">
                    <h2>Custom scheme</h2>
                    <details class="color-scheme-help">
                        <summary>What is this?</summary>
                        <p>Each color controls one part of the app — page background, cards, buttons, text.</p>
                        <div class="color-scheme-mini-mock" aria-label="Color scheme field guide">
                            <span>PageBackground</span><strong>AppBarBackground · AppBarText</strong>
                            <span>DrawerBackground · DrawerText</span><span>CardBackground · CardBorder · CardShadow</span>
                            <span>BodyText · SecondaryText</span><span>Primary · Accent · Danger · Success · FocusOutline</span>
                            <span>SurfaceTint · SurfaceStrongTint</span><span>ChartPrimary · ChartSecondary</span>
                            <span>TaskNegativeTint · TaskNeutralTint · TaskPositiveTint</span>
                            <span>PrimaryButtonText · SecondaryButtonText · DisabledBackground · DisabledText · DisabledBorder</span>
                            <span>InputBackground · InputBorder</span>
                            <span>Gradients.PageBackground · Card · AppBar · Drawer · PrimaryButton · SecondaryButton · AccentChip</span>
                            <span>TextShadows.Headings · AppBar · Drawer</span>
                        </div>
                        <p><strong>Tips:</strong> Hex (<code>#aabbcc</code>), <code>rgba(...)</code>, or <code>color-mix(...)</code> all work. <code>CardShadow</code> is a full CSS <code>box-shadow</code> value. <code>TextShadows.*</code> is a CSS <code>text-shadow</code> value or null.</p>
                    </details>
                    <p class="panel-copy">
                        Copy the preset, tweak the colors, then paste it back and save to build your own palette.
                    </p>
                    <label class="field-row compact">
                        <span>Name</span>
                        <input class="app-input"
                               data-testid="custom-scheme-name"
                               value="@_colorSchemeEditor.Name"
                               @onchange="eventArgs => SetCustomSchemeName(eventArgs.Value?.ToString())" />
                    </label>
                    <label class="checkbox-row compact">
                        <input type="checkbox"
                               data-testid="custom-scheme-dark"
                               checked="@_colorSchemeEditor.IsDark"
                               @onchange="eventArgs => SetCustomSchemeDark(eventArgs.Value)" />
                        <span>Dark theme</span>
                    </label>
                    <details class="color-scheme-gradient-editor">
                        <summary>Advanced</summary>
                        @foreach (var gradient in _colorSchemeEditor.Gradients.Values)
                        {
                            <details class="color-scheme-gradient-surface">
                                <summary>@gradient.Label</summary>
                                <label class="checkbox-row compact">
                                    <input type="checkbox"
                                           checked="@gradient.Enabled"
                                           @onchange="eventArgs => SetGradientEnabled(gradient.Name, eventArgs.Value)" />
                                    <span>Use gradient</span>
                                </label>
                                @foreach (var stop in gradient.Stops)
                                {
                                    <label class="field-row compact">
                                        <span>@stop.Key</span>
                                        <input class="app-input"
                                               value="@stop.Value"
                                               disabled="@(!gradient.Enabled)"
                                               @onchange="eventArgs => SetGradientStop(gradient.Name, stop.Key, eventArgs.Value?.ToString())" />
                                    </label>
                                }
                            </details>
                        }
                        <div class="color-scheme-shadow-editor">
                            <h3>Text shadows</h3>
                            <label class="field-row compact"><span>Headings</span><input class="app-input" value="@_colorSchemeEditor.HeadingTextShadow" @onchange="eventArgs => _colorSchemeEditor.HeadingTextShadow = EmptyToNull(eventArgs.Value?.ToString())" /></label>
                            <label class="field-row compact"><span>App bar</span><input class="app-input" value="@_colorSchemeEditor.AppBarTextShadow" @onchange="eventArgs => _colorSchemeEditor.AppBarTextShadow = EmptyToNull(eventArgs.Value?.ToString())" /></label>
                            <label class="field-row compact"><span>Drawer</span><input class="app-input" value="@_colorSchemeEditor.DrawerTextShadow" @onchange="eventArgs => _colorSchemeEditor.DrawerTextShadow = EmptyToNull(eventArgs.Value?.ToString())" /></label>
                        </div>
                    </details>
                    <div class="action-row">
                        <MudButton Color="Color.Secondary" Size="@ControlSize" StartIcon="@Icons.Material.Filled.ContentCopy" data-testid="copy-custom-scheme" OnClick="CopyCustomSchemeAsync" Variant="Variant.Filled">
                            Copy preset
                        </MudButton>
                        <MudButton Color="Color.Secondary" Size="@ControlSize" StartIcon="@Icons.Material.Filled.ContentPaste" data-testid="paste-custom-scheme" OnClick="PasteCustomSchemeAsync" Variant="Variant.Outlined">
                            Paste preset
                        </MudButton>
                    </div>
                    @if (_showPasteFallback)
                    {
                        <div class="color-scheme-paste-fallback" data-testid="paste-fallback">
                            <textarea class="app-input color-scheme-paste-box"
                                      rows="5"
                                      placeholder="Paste preset JSON here"
                                      aria-label="Preset JSON"
                                      data-testid="paste-fallback-input"
                                      @bind="_pasteFallbackText"
                                      @bind:event="oninput"></textarea>
                            <div class="action-row">
                                <MudButton Color="Color.Primary" Size="@ControlSize" data-testid="apply-pasted-scheme" OnClick="ApplyPastedSchemeFromBox" Variant="Variant.Filled">
                                    Apply
                                </MudButton>
                                <MudButton Color="Color.Secondary" Size="@ControlSize" data-testid="cancel-paste-fallback" OnClick="CancelPasteFallback" Variant="Variant.Outlined">
                                    Cancel
                                </MudButton>
                            </div>
                        </div>
                    }
                    <div class="action-row">
                        <MudButton Color="Color.Primary" Size="@ControlSize" data-testid="save-custom-scheme" OnClick="SaveCustomSchemeAsync" Variant="Variant.Filled">
                            Save Scheme
                        </MudButton>
                        <MudButton Color="Color.Secondary" Size="@ControlSize" OnClick="CancelCustomSchemeEdit" Variant="Variant.Outlined">
                            Cancel
                        </MudButton>
                        @if (IsActiveSchemeSaved)
                        {
                            <MudButton Color="Color.Error" Size="@ControlSize" data-testid="delete-custom-scheme" OnClick="DeleteActiveCustomSchemeAsync" Variant="Variant.Outlined">
                                Delete
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }
        </div>
    }

    @if (!PresetsOnly && !string.IsNullOrWhiteSpace(_colorSchemeMessage))
    {
        <div class="@($"import-status {(_colorSchemeSucceeded ? "success-pill" : "danger-pill")}")" data-testid="color-scheme-message">
            @_colorSchemeMessage
        </div>
    }
</div>

@code {
    /// <summary>When true, render a condensed bar with advanced controls hidden behind a disclosure toggle.</summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>When true, only the built-in preset selector and swatches are shown. No random buttons, no custom editor, no advanced controls.</summary>
    [Parameter]
    public bool PresetsOnly { get; set; }

    private string? _colorSchemeMessage;
    private bool _colorSchemeSucceeded = true;
    private bool _showAdvanced;
    private ColorSchemeState _colorSchemeState = new(
        ColorSchemeCatalog.Alpha,
        ColorSchemeCatalog.BuiltInSchemes,
        Array.Empty<ColorSchemeDefinition>());
    private ColorSchemeEditorModel? _colorSchemeEditor;
    private bool _showPasteFallback;
    private string _pasteFallbackText = string.Empty;
    private ColorSchemeDefinition? _randomScheme;
    private bool _randomActive;
    private string _randomSaveName = string.Empty;
    private double _chaos;

    // Each label reads on its own (no "Chaos" prefix) as an escalating intensity from calm to mad.
    private string ChaosLabel => _chaos switch
    {
        <= 0.01 => "CALM",
        < 0.12 => "MELLOW",
        < 0.24 => "BREEZY",
        < 0.36 => "LIVELY",
        < 0.5 => "WILD",
        < 0.62 => "FERAL",
        < 0.74 => "FRENZIED",
        < 0.86 => "CHAOTIC",
        < 0.99 => "UNHINGED",
        _ => "MADNESS"
    };

    // In full mode advanced controls are always shown; in compact mode they follow the disclosure
    // toggle. Starting a flow (random save / custom edit) opens the disclosure so its card is visible.
    private bool ShowAdvanced => !Compact || _showAdvanced;

    private bool InFlow => _randomActive || _colorSchemeEditor is not null;

    // True only when the editor points at an already-saved custom scheme, so a fresh unsaved copy
    // does not offer a Delete button.
    private bool IsActiveSchemeSaved => _colorSchemeEditor is not null
        && _colorSchemeState.CustomSchemes.Any(scheme =>
            string.Equals(scheme.Id, _colorSchemeEditor.Id, StringComparison.Ordinal));

    private string ToggleLabel => _showAdvanced ? (InFlow ? "Cancel" : "Less") : "Customize";

    private string ToggleIcon => _showAdvanced
        ? (InFlow ? Icons.Material.Filled.Close : Icons.Material.Filled.ExpandLess)
        : Icons.Material.Filled.ExpandMore;

    private Size ControlSize => Compact ? Size.Small : Size.Medium;

    private IEnumerable<ColorSchemeDefinition> DefaultSchemes => _colorSchemeState.BuiltInSchemes
        .Where(scheme => scheme.Id is ColorSchemeCatalog.DefaultLightSchemeId or ColorSchemeCatalog.DefaultDarkSchemeId);

    private IEnumerable<ColorSchemeDefinition> BuiltInLightSchemes => _colorSchemeState.BuiltInSchemes
        .Where(scheme => !scheme.IsDark && scheme.Id != ColorSchemeCatalog.DefaultLightSchemeId);

    private IEnumerable<ColorSchemeDefinition> BuiltInDarkSchemes => _colorSchemeState.BuiltInSchemes
        .Where(scheme => scheme.IsDark && scheme.Id != ColorSchemeCatalog.DefaultDarkSchemeId);

    // Collapsing while a flow is open abandons it and reverts to the persisted scheme so reopening
    // the panel starts clean rather than snapping back to the transient random theme.
    private async Task ToggleAdvancedAsync()
    {
        if (_showAdvanced)
        {
            if (InFlow)
            {
                await CancelFlowAsync();
            }

            _showAdvanced = false;
        }
        else
        {
            _showAdvanced = true;
            EnsureEditor();
        }
    }

    private async Task CancelFlowAsync()
    {
        if (_randomActive)
        {
            // Reapply the persisted active scheme so the visible theme matches the dropdown again.
            _colorSchemeState = await ColorSchemeService.SelectAsync(_colorSchemeState.ActiveScheme.Id);
            _randomActive = false;
        }
        else
        {
            // A pasted preview leaves the live theme out of sync with the persisted active scheme.
            // Re-apply it transiently so collapsing the panel always returns to the saved colors.
            await ColorSchemeService.PreviewAsync(_colorSchemeState.ActiveScheme);
        }

        _colorSchemeEditor = CreateEditorForActive();
        SetColorSchemeMessage($"Using {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private string ActiveDisplaySchemeId => _randomActive
        ? ColorSchemeCatalog.RandomSchemeId
        : _colorSchemeState.ActiveScheme.Id;

    private ColorSchemeDefinition ActiveDisplayScheme => _randomActive && _randomScheme is not null
        ? _randomScheme
        : _colorSchemeState.ActiveScheme;

    protected override async Task OnInitializedAsync()
    {
        _colorSchemeState = await ColorSchemeService.LoadAsync();
        _randomScheme = ColorSchemeService.PendingRandomScheme;
        if (_randomScheme is not null && ColorSchemeService.RandomActive)
        {
            // Re-apply the session's pending random theme so it survives navigation between pages,
            // but only when it is still the active selection. If the user has since picked another
            // scheme, RandomActive is false and we leave their choice intact.
            _randomActive = await ColorSchemeService.ReapplyPendingRandomAsync();
            _showAdvanced = _randomActive;
        }

        // In full mode the advanced editor is always visible, so populate it up front.
        if (ShowAdvanced)
        {
            EnsureEditor();
        }
    }

    private IReadOnlyList<string> GetActiveSchemeSwatches()
    {
        var tokens = ActiveDisplayScheme.Tokens;
        return new[]
        {
            tokens.Background,
            tokens.CardBackground,
            tokens.Primary,
            tokens.Accent,
            tokens.Danger,
            tokens.Success
        };
    }

    private async Task SelectColorSchemeAsync(string? schemeId)
    {
        if (string.IsNullOrWhiteSpace(schemeId))
        {
            return;
        }

        if (string.Equals(schemeId, ColorSchemeCatalog.RandomSchemeId, StringComparison.Ordinal))
        {
            await ActivateRandomAsync();
            return;
        }

        _colorSchemeState = await ColorSchemeService.SelectAsync(schemeId);
        _randomActive = false;
        _colorSchemeEditor = CreateEditorForActive();
        SetColorSchemeMessage($"Using {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task RandomPresetAsync()
    {
        var preset = ColorSchemeCatalog.PickRandomPreset(_colorSchemeState.CustomSchemes, _colorSchemeState.ActiveScheme.Id);
        _colorSchemeState = await ColorSchemeService.SelectAsync(preset.Id);
        _randomActive = false;
        _colorSchemeEditor = CreateEditorForActive();
        SetColorSchemeMessage($"Random preset: {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task RandomThemeAsync()
    {
        await GenerateRandomAsync();
        SetColorSchemeMessage("Generated a random theme. Adjust chaos, reroll, or save it.", true);
    }

    // Dragging the slider re-renders the current random theme at the new chaos using its fixed seed,
    // so the visible palette morphs smoothly between calm and madness without rolling a new one.
    private async Task OnChaosChangedAsync(double value)
    {
        _chaos = value;
        if (_randomActive)
        {
            var adjusted = await ColorSchemeService.AdjustRandomChaosAsync(value);
            if (adjusted is not null)
            {
                _randomScheme = adjusted;
            }
        }
    }

    private async Task RerollAsync()
    {
        await GenerateRandomAsync();
        SetColorSchemeMessage($"Rerolled at {ChaosLabel.ToLowerInvariant()} chaos.", true);
    }

    private async Task GenerateRandomAsync()
    {
        _randomScheme = await ColorSchemeService.ApplyRandomThemeAsync(_chaos);
        _randomActive = true;
        _colorSchemeEditor = null;
        _randomSaveName = string.Empty;
        _showAdvanced = true;
    }

    private async Task ActivateRandomAsync()
    {
        if (_randomScheme is null)
        {
            return;
        }

        await ColorSchemeService.ReapplyPendingRandomAsync();
        _randomActive = true;
        _colorSchemeEditor = null;
        SetColorSchemeMessage("Showing the last random theme.", true);
    }

    private async Task SaveRandomSchemeAsync()
    {
        if (_randomScheme is null)
        {
            return;
        }

        var named = ColorSchemeCatalog.CreateCustomCopy(_randomScheme, _randomSaveName);
        var result = await ColorSchemeService.SaveCustomAsync(named, true);
        _colorSchemeState = result.State;
        if (result.Errors.Count > 0)
        {
            SetColorSchemeMessage(string.Join(" ", result.Errors), false);
            return;
        }

        _randomActive = false;
        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Saved {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    // The editor is always present while the advanced panel is open (outside a random flow): a saved
    // custom scheme edits in place, while a built-in opens as a fresh unsaved copy ready to tweak.
    private ColorSchemeEditorModel CreateEditorForActive()
        => _colorSchemeState.ActiveScheme.IsBuiltIn
            ? ColorSchemeEditorModel.FromScheme(
                ColorSchemeCatalog.CreateCustomCopy(
                    _colorSchemeState.ActiveScheme,
                    $"{_colorSchemeState.ActiveScheme.Name} custom"))
            : ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);

    private void EnsureEditor()
    {
        if (!_randomActive)
        {
            _colorSchemeEditor ??= CreateEditorForActive();
        }
    }

    private async Task CancelCustomSchemeEdit()
    {
        CancelPasteFallback();
        // Restore the previously applied scheme so a live-pasted preview is rolled back when the
        // user cancels without saving. PreviewAsync is transient — no preferences are written.
        await ColorSchemeService.PreviewAsync(_colorSchemeState.ActiveScheme);
        _colorSchemeEditor = CreateEditorForActive();
        SetColorSchemeMessage("Custom scheme edit cancelled.", true);
    }

    private void SetCustomSchemeName(string? value)
    {
        if (_colorSchemeEditor is not null)
        {
            _colorSchemeEditor.Name = value?.Trim() ?? string.Empty;
        }
    }

    private void SetCustomSchemeDark(object? value)
    {
        if (_colorSchemeEditor is not null)
        {
            _colorSchemeEditor.IsDark = value is bool enabled && enabled;
        }
    }

    private void SetGradientEnabled(string name, object? value)
    {
        if (_colorSchemeEditor?.Gradients.TryGetValue(name, out var gradient) == true)
        {
            gradient.Enabled = value is bool enabled && enabled;
        }
    }

    private void SetGradientStop(string gradientName, string stopName, string? value)
    {
        if (_colorSchemeEditor?.Gradients.TryGetValue(gradientName, out var gradient) == true)
        {
            gradient.Stops[stopName] = value?.Trim() ?? string.Empty;
        }
    }

    private static string? EmptyToNull(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task SaveCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        var scheme = _colorSchemeEditor.ToScheme();
        var result = await ColorSchemeService.SaveCustomAsync(scheme, true);
        _colorSchemeState = result.State;
        if (result.Errors.Count > 0)
        {
            SetColorSchemeMessage(string.Join(" ", result.Errors), false);
            return;
        }

        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(_colorSchemeState.ActiveScheme);
        SetColorSchemeMessage($"Saved {_colorSchemeState.ActiveScheme.Name}.", true);
    }

    private async Task DeleteActiveCustomSchemeAsync()
    {
        if (_colorSchemeState.ActiveScheme.IsBuiltIn)
        {
            return;
        }

        var deletedName = _colorSchemeState.ActiveScheme.Name;
        _colorSchemeState = await ColorSchemeService.DeleteCustomAsync(_colorSchemeState.ActiveScheme.Id);
        _colorSchemeEditor = null;
        SetColorSchemeMessage($"Deleted {deletedName}.", true);
    }

    private void SetColorSchemeMessage(string message, bool succeeded)
    {
        _colorSchemeMessage = message;
        _colorSchemeSucceeded = succeeded;
    }

    private async Task CopyCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        var json = ReadableSchemeParser.Serialize(_colorSchemeEditor.ToScheme());

        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
            SetColorSchemeMessage("Copied preset to clipboard.", true);
        }
        catch (Exception)
        {
            SetColorSchemeMessage("Could not copy to clipboard.", false);
        }
    }

    private async Task PasteCustomSchemeAsync()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        // Try the async Clipboard API first. It is unavailable on iOS Safari and any
        // non-secure (http) origin, where readText throws — fall back to a manual paste box.
        string? clipboard = null;
        try
        {
            clipboard = await JsRuntime.InvokeAsync<string>("navigator.clipboard.readText");
        }
        catch (Exception)
        {
            clipboard = null;
        }

        if (string.IsNullOrWhiteSpace(clipboard))
        {
            // Either the browser blocked clipboard reads or it was empty. Reveal the manual
            // paste box so the user can paste the JSON themselves (the only path on iOS).
            _showPasteFallback = true;
            _pasteFallbackText = string.Empty;
            SetColorSchemeMessage("Can't read the clipboard automatically on this device. Paste the preset JSON in the box below, then tap Apply.", false);
            return;
        }

        await ApplyPastedSchemeAsync(clipboard!, "clipboard");
    }

    private async Task ApplyPastedSchemeFromBox()
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_pasteFallbackText))
        {
            SetColorSchemeMessage("Paste the preset JSON into the box first.", false);
            return;
        }

        await ApplyPastedSchemeAsync(_pasteFallbackText, "box");
    }

    private void CancelPasteFallback()
    {
        _showPasteFallback = false;
        _pasteFallbackText = string.Empty;
    }

    // Parses a pasted scheme, applies it as a live preview, and reports a specific reason on failure.
    // Shared by the automatic clipboard read and the manual paste box (source picks the success copy).
    // The preview is transient — nothing is persisted until the user taps Save Scheme.
    private async Task ApplyPastedSchemeAsync(string json, string source)
    {
        if (_colorSchemeEditor is null)
        {
            return;
        }

        var outcome = ReadableSchemeParser.Parse(json, _colorSchemeEditor.ToScheme());
        if (outcome.Result != SchemeParseResult.Success || outcome.Scheme is null)
        {
            SetColorSchemeMessage(DescribeParseFailure(outcome), false);
            return;
        }

        _colorSchemeEditor = ColorSchemeEditorModel.FromScheme(outcome.Scheme);

        // Apply the pasted colors to the live theme right away so the user sees them without saving.
        await ColorSchemeService.PreviewAsync(_colorSchemeEditor.ToScheme());

        _showPasteFallback = false;
        _pasteFallbackText = string.Empty;
        var from = source == "box" ? "Applied pasted preset." : "Pasted preset from clipboard.";
        SetColorSchemeMessage($"{from} Review the live colors and save to keep them.", true);
    }

    private static string DescribeParseFailure(ReadableSchemeParseOutcome outcome) => outcome.Result switch
    {
        SchemeParseResult.Empty => "Nothing to paste — the text was empty.",
        SchemeParseResult.InvalidJson => "That isn't valid JSON. Copy a preset with the Copy button, then paste the whole thing.",
        SchemeParseResult.NotAnObject => "Expected a JSON object holding color tokens, not a list or value.",
        SchemeParseResult.MissingName => "Preset Name is required.",
        SchemeParseResult.NoTokens => "No recognized color tokens found. Make sure you copied a preset from this app.",
        SchemeParseResult.PartialGradient => outcome.Detail ?? "A gradient is missing required stops.",
        SchemeParseResult.ConflictingAliases => outcome.Detail ?? "Two names for the same color conflict.",
        SchemeParseResult.InvalidValue => outcome.Detail ?? "A preset value is not valid CSS.",
        _ => "Could not read a valid color preset from that text."
    };

    private sealed class ColorSchemeEditorModel
    {
        public string Id { get; private init; } = string.Empty;

        public string Name { get; set; } = string.Empty;

        public bool IsDark { get; set; }

        public Dictionary<string, string> Tokens { get; } = new(StringComparer.Ordinal);

        public Dictionary<string, GradientEditorModel> Gradients { get; } = new(StringComparer.Ordinal);

        public string? HeadingTextShadow { get; set; }

        public string? AppBarTextShadow { get; set; }

        public string? DrawerTextShadow { get; set; }

        public static ColorSchemeEditorModel FromScheme(ColorSchemeDefinition scheme)
        {
            var editor = new ColorSchemeEditorModel
            {
                Id = scheme.Id,
                Name = scheme.Name,
                IsDark = scheme.IsDark,
                HeadingTextShadow = scheme.Tokens.HeadingTextShadow,
                AppBarTextShadow = scheme.Tokens.AppBarTextShadow,
                DrawerTextShadow = scheme.Tokens.DrawerTextShadow
            };
            foreach (var token in ColorSchemeCatalog.EditableTokens)
            {
                editor.Tokens[token.Name] = ColorSchemeCatalog.GetTokenValue(scheme.Tokens, token.Name);
            }

            editor.Gradients["PageBackground"] = GradientEditorModel.Create("PageBackground", "Page background", scheme.Tokens.Background, scheme.Tokens.BackgroundGradient);
            editor.Gradients["Card"] = GradientEditorModel.Create("Card", "Card", scheme.Tokens.CardBackground, scheme.Tokens.CardGradient);
            editor.Gradients["AppBar"] = GradientEditorModel.Create("AppBar", "App bar", scheme.Tokens.AppBarBackground, scheme.Tokens.AppBarGradient);
            editor.Gradients["Drawer"] = GradientEditorModel.Create("Drawer", "Drawer", scheme.Tokens.DrawerBackground, scheme.Tokens.DrawerGradient);
            editor.Gradients["PrimaryButton"] = GradientEditorModel.Create("PrimaryButton", "Primary button", scheme.Tokens.Primary, scheme.Tokens.PrimaryButtonGradient);
            editor.Gradients["SecondaryButton"] = GradientEditorModel.Create("SecondaryButton", "Secondary button", scheme.Tokens.CardBackground, scheme.Tokens.SecondaryButtonGradient);
            editor.Gradients["AccentChip"] = GradientEditorModel.Create("AccentChip", "Accent chip", scheme.Tokens.Accent, scheme.Tokens.AccentChipGradient);
            return editor;
        }

        public ColorSchemeDefinition ToScheme()
        {
            var tokens = ColorSchemeCatalog.EditableTokens
                .Aggregate(ColorSchemeCatalog.Alpha.Tokens, (current, token) =>
                    ColorSchemeCatalog.WithTokenValue(current, token.Name, Tokens.GetValueOrDefault(token.Name, string.Empty)));
            tokens = tokens with
            {
                BackgroundGradient = Gradients["PageBackground"].ToStops9(),
                CardGradient = Gradients["Card"].ToStops8(),
                AppBarGradient = Gradients["AppBar"].ToStops6(),
                DrawerGradient = Gradients["Drawer"].ToStops6(),
                PrimaryButtonGradient = Gradients["PrimaryButton"].ToStops4(),
                SecondaryButtonGradient = Gradients["SecondaryButton"].ToStops2(),
                AccentChipGradient = Gradients["AccentChip"].ToStops2(),
                HeadingTextShadow = HeadingTextShadow,
                AppBarTextShadow = AppBarTextShadow,
                DrawerTextShadow = DrawerTextShadow
            };
            return new ColorSchemeDefinition(
                Id,
                ColorSchemeCatalog.NormalizeName(Name, "Custom scheme"),
                false,
                tokens,
                IsDark: IsDark);
        }
    }

    private sealed class GradientEditorModel
    {
        public required string Name { get; init; }

        public required string Label { get; init; }

        public bool Enabled { get; set; }

        public Dictionary<string, string> Stops { get; } = new(StringComparer.Ordinal);

        public static GradientEditorModel Create(string name, string label, string fallback, object? gradient)
        {
            var editor = new GradientEditorModel { Name = name, Label = label, Enabled = gradient is not null };
            var stopNames = name switch
            {
                "PageBackground" => new[] { "TopLeft", "Top", "TopRight", "MiddleLeft", "Middle", "MiddleRight", "BottomLeft", "Bottom", "BottomRight" },
                "Card" => new[] { "TopLeft", "Top", "TopRight", "MiddleLeft", "MiddleRight", "BottomLeft", "Bottom", "BottomRight" },
                "AppBar" or "Drawer" => new[] { "TopLeft", "Top", "TopRight", "BottomLeft", "Bottom", "BottomRight" },
                "PrimaryButton" => new[] { "TopLeft", "TopRight", "BottomLeft", "BottomRight" },
                _ => new[] { "Start", "End" }
            };
            foreach (var stopName in stopNames)
            {
                editor.Stops[stopName] = gradient?.GetType().GetProperty(stopName)?.GetValue(gradient) as string ?? fallback;
            }

            return editor;
        }

        public GradientStops9? ToStops9() => Enabled
            ? new(Stops["TopLeft"], Stops["Top"], Stops["TopRight"], Stops["MiddleLeft"], Stops["Middle"], Stops["MiddleRight"], Stops["BottomLeft"], Stops["Bottom"], Stops["BottomRight"])
            : null;

        public GradientStops8? ToStops8() => Enabled
            ? new(Stops["TopLeft"], Stops["Top"], Stops["TopRight"], Stops["MiddleLeft"], Stops["MiddleRight"], Stops["BottomLeft"], Stops["Bottom"], Stops["BottomRight"])
            : null;

        public GradientStops6? ToStops6() => Enabled
            ? new(Stops["TopLeft"], Stops["Top"], Stops["TopRight"], Stops["BottomLeft"], Stops["Bottom"], Stops["BottomRight"])
            : null;

        public GradientStops4? ToStops4() => Enabled
            ? new(Stops["TopLeft"], Stops["TopRight"], Stops["BottomLeft"], Stops["BottomRight"])
            : null;

        public GradientStops2? ToStops2() => Enabled ? new(Stops["Start"], Stops["End"]) : null;
    }
}
